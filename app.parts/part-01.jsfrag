/**
 * Small shared scheduler for renderer-side work. Tasks with the same key share
 * one promise; completed values may be reused for a bounded time. A scope can be
 * cancelled when navigation makes queued work irrelevant.
 */
class LauncherLoadingManager {
  constructor({ concurrency = 3, onProgress = null } = {}) {
    this.concurrency = Math.max(1, concurrency);
    this.onProgress = onProgress;
    this.queue = [];
    this.running = 0;
    this.inFlight = new Map();
    this.cache = new Map();
    this.sequence = 0;
    this.scopeGenerations = new Map();
  }

  run(key, task, options = {}) {
    const normalizedKey = String(key);
    const ttl = Math.max(0, Number(options.ttl || 0));
    const cached = this.cache.get(normalizedKey);
    if (!options.force && cached && cached.expiresAt > Date.now()) return Promise.resolve(cached.value);
    if (this.inFlight.has(normalizedKey)) return this.inFlight.get(normalizedKey);
    const scope = String(options.scope || 'global');
    const generation = this.scopeGenerations.get(scope) || 0;
    const promise = new Promise((resolve, reject) => {
      this.queue.push({ key: normalizedKey, task, resolve, reject, ttl, scope, generation,
        priority: Number(options.priority || 0), label: String(options.label || ''), sequence: this.sequence++ });
      this.queue.sort((a, b) => b.priority - a.priority || a.sequence - b.sequence);
      this.pump();
    }).finally(() => this.inFlight.delete(normalizedKey));
    this.inFlight.set(normalizedKey, promise);
    return promise;
  }

  cancelScope(scope) {
    const normalizedScope = String(scope || 'global');
    this.scopeGenerations.set(normalizedScope, (this.scopeGenerations.get(normalizedScope) || 0) + 1);
    const retained = [];
    for (const item of this.queue) {
      if (item.scope === normalizedScope) item.reject(Object.assign(new Error('Loading task cancelled'), { name: 'AbortError' }));
      else retained.push(item);
    }
    this.queue = retained;
  }

  invalidate(keyPrefix = '') {
    for (const key of this.cache.keys()) if (!keyPrefix || key.startsWith(keyPrefix)) this.cache.delete(key);
  }

  pump() {
    while (this.running < this.concurrency && this.queue.length) {
      const item = this.queue.shift();
      if (item.generation !== (this.scopeGenerations.get(item.scope) || 0)) {
        item.reject(Object.assign(new Error('Loading task cancelled'), { name: 'AbortError' }));
        continue;
      }
      this.running += 1;
      this.onProgress?.({ state: 'start', label: item.label, queued: this.queue.length, running: this.running });
      Promise.resolve().then(() => item.task()).then((value) => {
        if (item.ttl) this.cache.set(item.key, { value, expiresAt: Date.now() + item.ttl });
        item.resolve(value);
      }, item.reject).finally(() => {
        this.running -= 1;
        this.onProgress?.({ state: 'finish', label: item.label, queued: this.queue.length, running: this.running });
        this.pump();
      });
    }
  }
}

