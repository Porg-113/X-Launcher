ipcMain.handle('login', async (_event, loginInput, _accessToken = '') => {
  if (FORCE_OFFLINE_MODE) {
    const existingUser = (() => {
      if (!fs.existsSync(USER_FILE)) {
        return null;
      }
      try {
        return JSON.parse(fs.readFileSync(USER_FILE, 'utf8'));
      } catch (_error) {
        return null;
      }
    })();
    const offlineUser = createOfflineUser(loginInput, existingUser);
    fs.writeFileSync(USER_FILE, JSON.stringify(offlineUser, null, 2), 'utf8');
    return {
      success: true,
      user: offlineUser,
      warning: 'Dauer-Offline-Modus ist aktiv. Multiplayer geht nur auf Offline-Mode-Servern.'
    };
  }

  try {
    const profile = await loginWithOfficialMicrosoftXboxLogin();
    const userInfo = {
      username: profile.username,
      email: null,
      uuid: profile.uuid,
      loginTime: new Date().toISOString(),
      accessToken: profile.accessToken,
      microsoftAccessToken: profile.microsoftAccessToken || '',
      userType: 'msa',
      loginSource: 'official-sisu',
      tokenSource: 'prismarine-auth'
    };

    fs.writeFileSync(USER_FILE, JSON.stringify(userInfo, null, 2), 'utf8');
    return { success: true, user: userInfo };
  } catch (error) {
    console.error('Login error:', error);
    if (ALLOW_OFFICIAL_LAUNCHER_FALLBACK && shouldUseOfficialLauncherFallback(error)) {
      const importedUser = createOfficialLauncherImportedUser(loginInput);
      if (importedUser) {
        fs.writeFileSync(USER_FILE, JSON.stringify(importedUser, null, 2), 'utf8');
        return {
          success: true,
          user: importedUser,
          warning: 'Microsoft/Xbox-Login war nicht verfügbar. Es wurde automatisch dein offizielles Launcher-Konto übernommen.'
        };
      }
    }

    if (shouldUseOfficialLauncherFallback(error)) {
      return {
        success: false,
        error: `${error.message} Microsoft-Login muss erfolgreich sein, damit Online-Server funktionieren.`
      };
    }

    return { success: false, error: error.message };
  }
});

ipcMain.handle('logout', async () => {
  try {
    if (fs.existsSync(USER_FILE)) {
      fs.unlinkSync(USER_FILE);
    }
    return { success: true };
  } catch (error) {
    return { success: false, error: error.message };
  }
});

