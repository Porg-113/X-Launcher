    scheduleWindowGroupStateSync();
    return { success: true, maximized: false };
  }
  targetWindow.maximize();
  sendWindowStateToRenderer(targetWindow);
  sendWindowGroupStateToRenderer();
  return { success: true, maximized: true };
});
