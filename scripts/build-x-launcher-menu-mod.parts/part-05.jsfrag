  private void drawWeatherEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 14, y = panelY + DETAIL_EDITOR_TOP, w = Math.max(80, panelW - 28);
    int gap = 4, buttonW = Math.max(20, (w - 16 - (gap * 2)) / 3);
    int total = (buttonW * 3) + (gap * 2), startX = x + (w - total) / 2;
    int selected = MenuModules.weatherMode();
    drawEditorCard(graphics, x, y, w, 44, true);
    graphics.centeredText(font, "CLIENT WEATHER: " + MenuModules.weatherModeLabel(), x + (w / 2), y + 6, LauncherTheme.textColor());
    drawButton(graphics, font, startX, y + 22, buttonW, 16, "Clear", selected == 0);
    drawButton(graphics, font, startX + buttonW + gap, y + 22, buttonW, 16, "Rain", selected == 1);
    drawButton(graphics, font, startX + ((buttonW + gap) * 2), y + 22, buttonW, 16, "Thunder", selected == 2);
  }

  private void drawTimeEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 14, y = panelY + DETAIL_EDITOR_TOP, w = Math.max(80, panelW - 28);
    int gap = 4, buttonW = Math.max(17, (w - 20 - (gap * 3)) / 4);
    int total = (buttonW * 4) + (gap * 3), startX = x + (w - total) / 2;
    int selected = MenuModules.timeMode();
    drawEditorCard(graphics, x, y, w, 44, true);
