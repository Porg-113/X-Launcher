  }

  private int effectSliderY(int panelY) {
    return panelY + DETAIL_EDITOR_TOP;
  }

  private int effectSliderW(int panelW) {
    return Math.min(panelW - 28, 278);
  }

  private void drawButton(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, int h, String label, boolean active) {
    boolean lightMode = LauncherTheme.isLightMode();
    int color = active ? (lightMode ? 0xE6C6D4DE : LauncherTheme.argb(205, 0x111820)) : (lightMode ? 0xD8E8F0F4 : LauncherTheme.argb(176, 0x101B25));
    roundedFill(graphics, x, y, w, h, color);
    border(graphics, x, y, w, h, active ? LauncherTheme.accentArgb(235) : (lightMode ? 0xAD7E939E : LauncherTheme.argb(138, 0x50606E)));
    graphics.centeredText(font, fitLabel(label, w - 6), x + (w / 2), y + Math.max(2, (h - 8) / 2), active ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor());
  }

  private void drawDangerButton(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, int h, String label) {
    roundedFill(graphics, x + 1, y + 1, w, h, LauncherTheme.argb(60, 0x000000));
    roundedFill(graphics, x, y, w, h, LauncherTheme.argb(205, 0x000000));
    border(graphics, x, y, w, h, LauncherTheme.argb(245, 0xFFFFFF));
    graphics.centeredText(font, fitLabel(label, w - 4), x + (w / 2), y + Math.max(2, (h - 8) / 2), 0xFFFFFFFF);
  }

  private void drawCodeEditor(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int panelX, int panelY, int panelW, int panelH) {
    int contentX = panelX + 14;
    int contentY = panelY + DETAIL_EDITOR_TOP;
    int contentW = panelW - 28;
    int inputY = contentY + 24;
    int buttonY = inputY + 22;
    drawEditorCard(graphics, contentX, contentY, contentW, buttonY + 18 - contentY, true);
    graphics.centeredText(font, "FPS-BONUS", contentX + (contentW / 2), contentY + 7, LauncherTheme.textColor());
    graphics.centeredText(font, fitLabel(codeStatus, contentW - 20), contentX + (contentW / 2), contentY + 16, LauncherTheme.mutedTextColor());
    String cursor = codeFocused && ((System.currentTimeMillis() / 500L) % 2L == 0L) ? "|" : "";
    String input = codeInput.isBlank() ? (codeFocused ? cursor : "0") : codeInput + cursor;
    roundedFill(graphics, contentX + 8, inputY, contentW - 16, 18, LauncherTheme.argb(205, 0x071018));
    graphics.fill(contentX + 12, inputY + 2, contentX + contentW - 12, inputY + 3, LauncherTheme.argb(38, 0xFFFFFF));
    graphics.fill(contentX + 8, inputY, contentX + 11, inputY + 18, codeFocused ? LauncherTheme.accentArgb(220) : LauncherTheme.argb(130, 0x2A2A2A));
    border(graphics, contentX + 8, inputY, contentW - 16, 18, codeFocused ? LauncherTheme.accentArgb(220) : LauncherTheme.argb(145, 0x2A2A2A));
    graphics.text(font, fitLabel(input, contentW - 32), contentX + 16, inputY + 5, codeInput.isBlank() && !codeFocused ? LauncherTheme.mutedTextColor() : LauncherTheme.textColor());
    drawButton(graphics, font, contentX + 8, buttonY, contentW - 16, 15, "Speichern", true);
    int controlsY = panelY + panelH - 22;
    int[] controls = detailControlBounds(panelX, panelW, module.keyBindable, module.toggleable, false, module.id);
    drawEditorControlDock(graphics, panelX, panelY, panelW, panelH);
    drawButton(graphics, font, controls[0], controlsY, controls[1], 16, capturingKey ? "..." : keyComboLabel(module.keyCode, module.keyModifiers), module.keyCode > 0);
    drawButton(graphics, font, controls[2], controlsY, controls[3], 16, module.enabled ? "EIN" : "AUS", module.enabled);
  }

  private void drawOverlayEditor(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int panelX, int panelY, int panelW) {
  }

  private void drawXrayEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    int max = EspRenderPipeline26.maxRangeChunks();
    int range = Math.min(XraySettings.rangeChunks(), max);
    drawEditorCard(graphics, x, y, w, 25, true);
    String rangeLabel = range + " / " + max + " Chunks";
    if (w >= 150) {
      graphics.text(font, "REICHWEITE", x + 9, y + 4, LauncherTheme.textColor());
      int valueW = Math.min(82, Math.max(58, w - 116));
      int valueX = x + w - valueW - 8;
      roundedFill(graphics, valueX, y + 3, valueW, 11, LauncherTheme.argb(112, 0x000000));
      border(graphics, valueX, y + 3, valueW, 11, LauncherTheme.accentArgb(145));
      graphics.centeredText(font, fitLabel(rangeLabel, valueW - 6), valueX + (valueW / 2), y + 5, LauncherTheme.mutedTextColor());
    } else {
      graphics.centeredText(font, fitLabel(rangeLabel, w - 14), x + (w / 2), y + 4, LauncherTheme.textColor());
    }
    int trackX = x + 10, trackY = y + 14, trackW = Math.max(1, w - 20);
    int filled = max <= 1 ? trackW : Math.round(((range - 1) / (float)(max - 1)) * trackW);
    drawEditorSliderTrack(graphics, trackX, trackY, trackW, filled);

    for (int index = 0; index < XraySettings.ORE_LABELS.length; index++) {
      int[] bounds = xrayOreButtonBounds(panelX, panelY, panelW, index);
      drawXrayOreButton(graphics, bounds[0], bounds[1], bounds[2], XraySettings.ORE_COLORS[index], XraySettings.ore(index));
    }
    int dividerY = y + 52;
    graphics.fill(x + 8, dividerY, x + w - 8, dividerY + 1, LauncherTheme.argb(75, 0xFFFFFF));
    int gap = 4;
    int extraY = y + 58;
    int extraW = Math.max(24, (w - (gap * 2)) / 3);
    drawXrayTargetButton(graphics, font, x, extraY, extraW, 15, "Spieler", 0xFFFF3830, XraySettings.players());
    drawXrayTargetButton(graphics, font, x + extraW + gap, extraY, extraW, 15, "Kisten", 0xFFFF9418, XraySettings.chests());
    drawXrayTargetButton(graphics, font, x + ((extraW + gap) * 2), extraY, Math.max(24, w - ((extraW + gap) * 2)), 15, "Spawner", 0xFFB45CFF, XraySettings.spawners());
  }

  private void drawBlockOutlineEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    drawEditorCard(graphics, x, y, w, 58, true);
    graphics.text(font, "FARBE", x + 8, y + 6, LauncherTheme.textColor());
    roundedFill(graphics, x + w - 24, y + 4, 16, 16, BlockOutlineSettings.color());
    border(graphics, x + w - 24, y + 4, 16, 16, LauncherTheme.argb(210, 0xFFFFFF));
    int thickness = BlockOutlineSettings.thickness();
    graphics.text(font, "DICKE " + thickness, x + 8, y + 36, LauncherTheme.textColor());
    int trackX = x + 62, trackY = y + 37, trackW = Math.max(20, w - 72);
    int filled = Math.round(((thickness - BlockOutlineSettings.MIN_THICKNESS) / (float)(BlockOutlineSettings.MAX_THICKNESS - BlockOutlineSettings.MIN_THICKNESS)) * trackW);
    drawEditorSliderTrack(graphics, trackX, trackY, trackW, filled);
  }

  private int[] xrayOreButtonBounds(int panelX, int panelY, int panelW, int index) {
    int x = panelX + 14;
    int w = Math.max(80, panelW - 28);
    int count = XraySettings.ORE_LABELS.length;
    int gap = count <= 1 ? 0 : Math.max(0, Math.min(XRAY_ORE_BUTTON_GAP, (w - (count * 8)) / (count - 1)));
    int size = Math.max(8, Math.min(XRAY_ORE_BUTTON_SIZE, (w - ((count - 1) * gap)) / count));
    int totalW = (count * size) + ((count - 1) * gap);
    int startX = x + Math.max(0, (w - totalW) / 2);
    return new int[] { startX + (index * (size + gap)), panelY + DETAIL_EDITOR_TOP + 30, size, size };
  }

  private void drawXrayOreButton(GuiGraphicsExtractor graphics, int x, int y, int size, int color, boolean active) {
    graphics.fill(x, y, x + size, y + size, active ? 0xFF000000 : color);
    if (!active) border(graphics, x, y, size, size, LauncherTheme.argb(125, 0xFFFFFF));
  }

  private void drawXrayTargetButton(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, int h, String label, int color, boolean active) {
    int textColor = 0xFFFFFFFF;
    graphics.fill(x, y, x + w, y + h, active ? 0xFF000000 : color);
    if (!active) border(graphics, x, y, w, h, LauncherTheme.argb(125, 0xFFFFFF));
    graphics.centeredText(font, fitLabel(label, w - 6), x + (w / 2), y + 4, textColor);
  }

  private void drawCrosshairEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int top = panelY + DETAIL_EDITOR_TOP;
    int contentX = panelX + 10;
    int contentW = Math.max(100, panelW - 20);
    int cell = crosshairGridCell(panelW);
    int gridSize = CrosshairSettings.SIZE * cell;
    int gridX = contentX + contentW - gridSize;
    int gridY = top + 17;
    int columnGap = 10;
    int leftW = Math.max(1, gridX - contentX - columnGap);
    drawEditorCard(graphics, panelX + 6, top - 4, Math.max(100, panelW - 12), 86, false);
    int compactW = Math.min(leftW, 68);
    int compactX = contentX + Math.max(0, (leftW - compactW) / 2);
    drawButton(graphics, font, compactX, top, compactW, 14, "Template", true);
    drawButton(graphics, font, compactX, top + 18, compactW, 14, "Attack Color", CrosshairSettings.targetAlert());
    int colorGap = 6;
    int colorW = Math.max(1, (leftW - colorGap) / 2);
    int colorY = top + 36;
    graphics.text(font, "Main", contentX + 2, colorY + 3, LauncherTheme.mutedTextColor());
    roundedFill(graphics, contentX + colorW - 14, colorY, 14, 14, CrosshairSettings.normalColor());
    border(graphics, contentX + colorW - 14, colorY, 14, 14, LauncherTheme.argb(185, 0xFFFFFF));
    int attackX = contentX + colorW + colorGap;
    graphics.text(font, "Attack", attackX + 2, colorY + 3, LauncherTheme.mutedTextColor());
    roundedFill(graphics, attackX + colorW - 14, colorY, 14, 14, CrosshairSettings.targetColor());
    border(graphics, attackX + colorW - 14, colorY, 14, 14, LauncherTheme.argb(185, 0xFFFFFF));
    drawCrosshairSizeSlider(graphics, font, contentX, top + 56, leftW);

    for (int y = 0; y < CrosshairSettings.SIZE; y += 1) {
      for (int x = 0; x < CrosshairSettings.SIZE; x += 1) {
        int px = gridX + (x * cell);
        int py = gridY + (y * cell);
        boolean enabled = CrosshairSettings.isOn(x, y);
        graphics.fill(px, py, px + cell - 1, py + cell - 1, enabled ? CrosshairSettings.normalColor() : LauncherTheme.argb(35, 0xFFFFFF));
        border(graphics, px, py, cell - 1, cell - 1, enabled ? LauncherTheme.argb(170, 0xFFFFFF) : LauncherTheme.argb(58, 0xDCE8F2));
      }
    }
  }

  private void drawCrosshairSizeSlider(GuiGraphicsExtractor graphics, Font font, int x, int y, int w) {
    int scale = CrosshairSettings.scale();
    roundedFill(graphics, x + 1, y + 2, w, 17, LauncherTheme.argb(52, 0x000000));
    roundedFill(graphics, x, y, w, 17, LauncherTheme.argb(120, 0x071018));
    border(graphics, x, y, w, 17, LauncherTheme.argb(95, 0xFFFFFF));
    graphics.text(font, "Size", x + 6, y + 4, LauncherTheme.textColor());
    int trackX = crosshairSizeTrackX(x);
    int trackY = y + 5;
    int trackW = crosshairSizeTrackW(w);
    int filled = Math.round(((scale - CrosshairSettings.MIN_SCALE) / (float) Math.max(1, CrosshairSettings.MAX_SCALE - CrosshairSettings.MIN_SCALE)) * trackW);
    drawEditorSliderTrack(graphics, trackX, trackY, trackW, filled);
  }

  private void drawHitboxEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 8;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(120, panelW - 16);
    roundedFill(graphics, x, y, 14, 14, HitboxSettings.color());
    roundedFill(graphics, x + 20, y, 14, 14, HitboxSettings.targetColor());
    border(graphics, x, y, 14, 14, LauncherTheme.argb(130, 0xDCE8F2));
    border(graphics, x + 20, y, 14, 14, LauncherTheme.argb(130, 0xDCE8F2));
    graphics.text(font, fitLabel("Normal / Reichweite", Math.max(40, w - 44)), x + 42, y + 3, LauncherTheme.mutedTextColor());
    int toggleY = y + 22;
    int toggleGap = 4;
    int toggleW = Math.max(32, (w - (toggleGap * 2)) / 3);
    drawButton(graphics, font, x, toggleY, toggleW, 14, "Players", HitboxSettings.players());
    drawButton(graphics, font, x + toggleW + toggleGap, toggleY, toggleW, 14, "Mobs", HitboxSettings.mobs());
    drawButton(graphics, font, x + ((toggleW + toggleGap) * 2), toggleY, Math.max(32, w - ((toggleW + toggleGap) * 2)), 14, "Items", HitboxSettings.items());
    drawHitboxThicknessSlider(graphics, font, x, y + 45, Math.min(w, 220));
  }

  private void drawHitboxThicknessSlider(GuiGraphicsExtractor graphics, Font font, int x, int y, int w) {
    int thickness = HitboxSettings.thickness();
    graphics.fill(x + 1, y + 1, x + w + 1, y + 25, LauncherTheme.argb(48, 0x000000));
    graphics.fill(x, y, x + w, y + 24, LauncherTheme.argb(112, 0x101820));
    border(graphics, x, y, w, 24, LauncherTheme.argb(112, 0xDCE8F2));
    graphics.text(font, "Dicke", x + 6, y + 5, LauncherTheme.textColor());
    graphics.text(font, thickness + "px", x + w - 28, y + 5, LauncherTheme.mutedTextColor());
    int trackX = hitboxThicknessTrackX(x);
    int trackY = y + 6;
    int trackW = hitboxThicknessTrackW(w);
    int range = HitboxSettings.MAX_THICKNESS - HitboxSettings.MIN_THICKNESS;
    int filled = Math.round(((thickness - HitboxSettings.MIN_THICKNESS) / (float) Math.max(1, range)) * trackW);
    drawEditorSliderTrack(graphics, trackX, trackY, trackW, filled);
  }

  private void drawFriendsEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW, int panelH) {
    int top = panelY + DETAIL_EDITOR_TOP;
    SocialManager.PlayerStatus[] players = SocialManager.players();
    SocialManager.FriendRequest[] requests = SocialManager.incomingRequests();
    SocialManager.WorldInvite[] invites = SocialManager.worldInvites();
    int contentX = panelX + 8;
    int contentW = panelW - 16;
    int bottomLimit = panelY + panelH - 8;
    drawNameColorPicker(graphics, font, contentX, top, contentW);
    top += 30;
    int statGap = 5;
    int statW = Math.max(24, (contentW - (statGap * 2)) / 3);
    drawFriendStat(graphics, font, contentX, top, statW, "X", SocialManager.xClientCount(), SocialManager.xClientCount() > 0);
    drawFriendStat(graphics, font, contentX + statW + statGap, top, statW, "Friends", SocialManager.friendCount(), SocialManager.friendCount() > 0);
    drawFriendStat(graphics, font, contentX + ((statW + statGap) * 2), top, Math.max(24, contentW - ((statW + statGap) * 2)), "Requests", SocialManager.incomingRequestCount(), SocialManager.incomingRequestCount() > 0);
    int y = top + 24;
    if (pendingRemoveFriendUuid != null && y + 35 <= bottomLimit) {
      drawFriendRemoveConfirm(graphics, font, contentX, y, contentW);
      y += 42;
    }
    if (y + 16 <= bottomLimit) {
      drawFriendHostControls(graphics, font, contentX, y, contentW);
    }
    y += 24;
    int inviteRows = invites.length > 0 && y + 35 <= bottomLimit ? 1 : 0;
    if (inviteRows > 0) {
      graphics.text(font, "WORLD INVITES", contentX, y, LauncherTheme.mutedTextColor());
      y += 11;
    }
    for (int row = 0; row < inviteRows; row += 1) {
      SocialManager.WorldInvite invite = invites[row];
      int rowY = y + (row * 24);
      int copyX = contentX + contentW - 54;
      int closeX = contentX + contentW - 20;
      int inviteTextW = Math.max(1, copyX - (contentX + 31));
      drawFriendRowChrome(graphics, contentX, rowY, contentW, true, true);
      drawSkinFallback(graphics, font, invite.name, contentX + 7, rowY + 4, 14);
      graphics.text(font, fitLabel(invite.name, inviteTextW), contentX + 27, rowY + 3, LauncherTheme.textColor());
      graphics.text(font, fitLabel(invite.address(), inviteTextW), contentX + 27, rowY + 12, LauncherTheme.mutedTextColor());
      drawButton(graphics, font, copyX, rowY + 4, 30, 13, "Copy", true);
      drawDangerButton(graphics, font, closeX, rowY + 4, 18, 13, "X");
    }
    y += inviteRows * 24;
    if (inviteRows > 0) {
      y += 5;
    }
    int requestRows = requests.length > 0 && y + 35 <= bottomLimit ? 1 : 0;
    if (requestRows > 0) {
      graphics.text(font, "REQUESTS", contentX, y, LauncherTheme.mutedTextColor());
      y += 11;
    }
    for (int row = 0; row < requestRows; row += 1) {
      SocialManager.FriendRequest request = requests[row];
      int rowY = y + (row * 24);
      int acceptX = contentX + contentW - 50;
      int declineX = contentX + contentW - 20;
      int requestTextW = Math.max(1, acceptX - (contentX + 31));
      drawFriendRowChrome(graphics, contentX, rowY, contentW, true, true);
      drawRequestSkinHead(graphics, font, request, contentX + 7, rowY + 4, 14);
      graphics.text(font, fitLabel(request.name, requestTextW), contentX + 27, rowY + 3, LauncherTheme.textColor());
      graphics.text(font, fitLabel("Incoming friend request", requestTextW), contentX + 27, rowY + 12, LauncherTheme.mutedTextColor());
      drawButton(graphics, font, acceptX, rowY + 4, 26, 13, "OK", true);
      drawDangerButton(graphics, font, declineX, rowY + 4, 18, 13, "X");
    }
    y += requestRows * 24;
    if (requestRows > 0) {
      y += 5;
    }
    if (y + 11 > bottomLimit) {
      return;
    }
    graphics.text(font, "FRIENDS / PLAYERS", contentX, y, LauncherTheme.mutedTextColor());
    y += 11;
    if (players.length == 0) {
      if (y + 22 > bottomLimit) {
        return;
      }
      graphics.fill(contentX, y, contentX + contentW, y + 22, LauncherTheme.argb(44, 0xFFFFFF));
      border(graphics, contentX, y, contentW, 22, LauncherTheme.argb(95, 0xDCE8F2));
      graphics.text(font, "No server players detected yet.", contentX + 7, y + 7, LauncherTheme.mutedTextColor());
      return;
    }

    boolean compactRows = requestRows > 0 || inviteRows > 0 || pendingRemoveFriendUuid != null;
    int maxRows = Math.min(compactRows ? 1 : 2, players.length);
    while (maxRows > 0 && y + (maxRows * 24) > bottomLimit) {
      maxRows -= 1;
    }
    for (int row = 0; row < maxRows; row += 1) {
      SocialManager.PlayerStatus player = players[row];
      int rowY = y + (row * 24);
      boolean incoming = SocialManager.hasIncomingRequest(player.uuid);
      boolean outgoing = SocialManager.hasOutgoingRequest(player.uuid);
      int actionW = player.friend ? 68 : Math.min(60, Math.max(38, contentW / 3));
      int actionX = contentX + contentW - actionW - 6;
      int playerTextW = Math.max(1, actionX - (contentX + 31));
      drawFriendRowChrome(graphics, contentX, rowY, contentW, player.friend || incoming, player.xClient || incoming || player.friend);
      drawPlayerSkinHead(graphics, font, player, contentX + 7, rowY + 4, 14);
      String status = player.self ? "YOU" : (player.friend ? "FRIEND" : (incoming ? "INCOMING" : (outgoing ? "SENT" : (player.xClient ? "X CLIENT" : "ONLINE"))));
      graphics.text(font, fitLabel(player.name, playerTextW), contentX + 27, rowY + 3, player.xClient || player.friend ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor());
      graphics.text(font, fitLabel(status, playerTextW), contentX + 27, rowY + 12, LauncherTheme.mutedTextColor());
      if (player.friend) {
        drawButton(graphics, font, actionX, rowY + 4, 44, 13, "Invite", SocialManager.hasHostedWorld());
        drawDangerButton(graphics, font, actionX + 48, rowY + 4, 20, 13, "X");
      } else {
        String action = player.self ? "You" : (incoming ? "Accept" : (outgoing ? "Sent" : "Request"));
        drawButton(graphics, font, actionX, rowY + 4, actionW, 13, action, !player.self && !outgoing);
      }
    }
  }

  private void drawNameColorPicker(GuiGraphicsExtractor graphics, Font font, int x, int y, int w) {
    graphics.text(font, "NAMENSFARBE", x, y, LauncherTheme.mutedTextColor());
    graphics.text(font, "X " + localPlayerName(), x + Math.max(88, w - 94), y, 0xFF000000 | NameTagSettings.color());
    int swatchY = y + 12;
    int gap = 5;
    int swatch = Math.max(12, Math.min(18, (w - (gap * (NameTagSettings.COLORS.length - 1))) / NameTagSettings.COLORS.length));
    for (int index = 0; index < NameTagSettings.COLORS.length; index++) {
      int sx = x + (index * (swatch + gap));
      int color = NameTagSettings.COLORS[index];
      roundedFill(graphics, sx, swatchY, swatch, 12, 0xFF000000 | color);
      border(graphics, sx, swatchY, swatch, 12, color == NameTagSettings.color() ? LauncherTheme.accentArgb(255) : 0x66FFFFFF);
    }
  }

  private String localPlayerName() {
    LocalPlayer player = Minecraft.getInstance().player;
    return player == null ? "Player" : player.getName().getString();
  }

  private void drawFriendHostControls(GuiGraphicsExtractor graphics, Font font, int x, int y, int w) {
    int hostW = 42;
    int keepW = 54;
    int gap = 4;
    int textX = x + hostW + keepW + (gap * 2) + 6;
    int textW = Math.max(1, w - (textX - x) - 4);
    drawButton(graphics, font, x, y, hostW, 16, SocialManager.hasHostedWorld() ? "Online" : "Host", SocialManager.hasHostedWorld());
    drawButton(graphics, font, x + hostW + gap, y, keepW, 16, SocialManager.keepHostedWorldOnline() ? "Keep ON" : "Keep OFF", SocialManager.keepHostedWorldOnline());
    graphics.text(font, fitLabel(SocialManager.hostStatus(), textW), textX, y + 5, LauncherTheme.mutedTextColor());
  }

  private void drawFriendRemoveConfirm(GuiGraphicsExtractor graphics, Font font, int x, int y, int w) {
    graphics.fill(x + 1, y + 1, x + w + 1, y + 36, LauncherTheme.argb(75, 0x000000));
    graphics.fill(x, y, x + w, y + 35, LauncherTheme.argb(150, 0x141018));
    graphics.fill(x, y, x + 3, y + 35, LauncherTheme.argb(225, 0x000000));
    border(graphics, x, y, w, 35, LauncherTheme.argb(210, 0xFFFFFF));
    int removeX = x + w - 54;
    int cancelX = removeX - 58;
    int textW = Math.max(1, cancelX - x - 12);
    graphics.text(font, fitLabel("Remove " + pendingRemoveFriendName + "?", textW), x + 8, y + 6, LauncherTheme.textColor());
    graphics.text(font, fitLabel("Confirm friend removal", textW), x + 8, y + 17, LauncherTheme.mutedTextColor());
    drawButton(graphics, font, cancelX, y + 11, 50, 14, "Cancel", true);
    drawDangerButton(graphics, font, removeX, y + 11, 46, 14, "Remove");
  }

  private void drawFriendRowChrome(GuiGraphicsExtractor graphics, int x, int y, int w, boolean highlighted, boolean strongBorder) {
    graphics.fill(x + 1, y + 1, x + w + 1, y + 23, LauncherTheme.argb(60, 0x000000));
    graphics.fill(x, y, x + w, y + 22, highlighted ? LauncherTheme.accentArgb(62) : LauncherTheme.argb(50, 0xFFFFFF));
    graphics.fill(x, y, x + 3, y + 22, highlighted ? LauncherTheme.accentArgb(210) : LauncherTheme.argb(110, 0xDCE8F2));
    border(graphics, x, y, w, 22, strongBorder ? LauncherTheme.accentArgb(175) : LauncherTheme.argb(95, 0xDCE8F2));
  }

  private void drawFriendStat(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, String label, int value, boolean active) {
    graphics.fill(x + 1, y + 1, x + w + 1, y + 18, LauncherTheme.argb(58, 0x000000));
    graphics.fill(x, y, x + w, y + 17, active ? LauncherTheme.accentArgb(66) : LauncherTheme.argb(45, 0xFFFFFF));
    border(graphics, x, y, w, 17, active ? LauncherTheme.accentArgb(180) : LauncherTheme.argb(95, 0xDCE8F2));
    graphics.centeredText(font, fitLabel(label + " " + value, w - 4), x + (w / 2), y + 5, active ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor());
  }

  private void drawPlayerSkinHead(GuiGraphicsExtractor graphics, Font font, SocialManager.PlayerStatus player, int x, int y, int size) {
    if (drawSkinTexture(graphics, player.skinTexture(), x, y, size)) {
      return;
    }
    if (drawSkinPixels(graphics, player.skinHeadPixels(), x, y, size)) {
      return;
    }
    drawSkinFallback(graphics, font, player.name, x, y, size);
  }

  private void drawRequestSkinHead(GuiGraphicsExtractor graphics, Font font, SocialManager.FriendRequest request, int x, int y, int size) {
    if (drawSkinTexture(graphics, request.skinTexture(), x, y, size)) {
      return;
    }
    if (drawSkinPixels(graphics, request.skinHeadPixels(), x, y, size)) {
      return;
    }
    drawSkinFallback(graphics, font, request.name, x, y, size);
  }

  private boolean drawSkinTexture(Object graphics, Object texture, int x, int y, int size) {
    if (graphics == null || texture == null) {
      return false;
    }
    Object[] candidates = texture instanceof Object[] array ? array : new Object[] { texture };
    String[] rendererClasses = {
        "net.minecraft.client.gui.components.PlayerFaceRenderer",
        "net.minecraft.client.gui.PlayerSkinDrawer",
        "net.minecraft.class_8667"
    };
    for (String className : rendererClasses) {
      try {
        Class<?> renderer = Class.forName(className);
        for (java.lang.reflect.Method method : renderer.getMethods()) {
          if (!java.lang.reflect.Modifier.isStatic(method.getModifiers())) {
            continue;
          }
          Class<?>[] types = method.getParameterTypes();
          for (Object candidate : candidates) {
            if (candidate == null || types.length < 5 || !types[0].isInstance(graphics) || !types[1].isInstance(candidate)
                || types[2] != Integer.TYPE || types[3] != Integer.TYPE || types[4] != Integer.TYPE) {
              continue;
            }
            if (types.length == 5) {
              method.invoke(null, graphics, candidate, x, y, size);
              return true;
            }
            if (types.length == 6 && types[5] == Boolean.TYPE) {
              method.invoke(null, graphics, candidate, x, y, size, false);
              return true;
            }
            if (types.length == 7 && types[5] == Boolean.TYPE && types[6] == Boolean.TYPE) {
              method.invoke(null, graphics, candidate, x, y, size, false, false);
              return true;
            }
            if (types.length == 8 && types[5] == Boolean.TYPE && types[6] == Boolean.TYPE && types[7] == Integer.TYPE) {
              method.invoke(null, graphics, candidate, x, y, size, false, false, 0xFFFFFFFF);
              return true;
            }
          }
        }
      } catch (Throwable ignored) {
        // Try the next renderer name or signature.
      }
    }
    return false;
  }

  private boolean drawSkinPixels(GuiGraphicsExtractor graphics, int[] pixels, int x, int y, int size) {
    if (pixels == null || pixels.length < 64) {
      return false;
    }
    graphics.fill(x, y, x + size, y + size, LauncherTheme.argb(115, 0x101820));
    for (int py = 0; py < 8; py += 1) {
      int y1 = y + ((py * size) / 8);
      int y2 = y + (((py + 1) * size) / 8);
      for (int px = 0; px < 8; px += 1) {
        int x1 = x + ((px * size) / 8);
        int x2 = x + (((px + 1) * size) / 8);
        graphics.fill(x1, y1, Math.max(x1 + 1, x2), Math.max(y1 + 1, y2), pixels[(py * 8) + px]);
      }
    }
    border(graphics, x, y, size, size, LauncherTheme.accentArgb(145));
    return true;
  }

  private void drawSkinFallback(GuiGraphicsExtractor graphics, Font font, String name, int x, int y, int size) {
    graphics.fill(x, y, x + size, y + size, LauncherTheme.argb(115, 0x101820));
    border(graphics, x, y, size, size, LauncherTheme.accentArgb(145));
    graphics.centeredText(font, firstInitial(name), x + (size / 2), y + 1, LauncherTheme.textColor());
  }

  private String firstInitial(String name) {
    String safe = String.valueOf(name == null ? "" : name).trim();
    return safe.isEmpty() ? "?" : safe.substring(0, 1).toUpperCase(java.util.Locale.ROOT);
  }

  private void drawSkinHead(GuiGraphicsExtractor graphics, int headColor, int x, int y, int size) {
    int shade = 0xFF000000 | ((headColor >>> 1) & 0x007F7F7F);
    graphics.fill(x, y, x + size, y + size, headColor);
    graphics.fill(x, y, x + size, y + 2, shade);
    graphics.fill(x + 2, y + 3, x + 3, y + 5, 0xFF101010);
    graphics.fill(x + size - 3, y + 3, x + size - 2, y + 5, 0xFF101010);
    graphics.fill(x + 3, y + size - 3, x + size - 3, y + size - 2, 0xFF2A1612);
  }

  private void drawTile(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int x, int y, int w, int h, boolean hovered, int accent) {
    boolean active = module.toggleable && module.enabled;
    int tileY = y + TILE_LABEL_HEIGHT + Math.round((1.0F - openProgress()) * 4.0F);
    boolean lightMode = LauncherTheme.isLightMode();
    int background = hovered ? LauncherTheme.hoverArgb(210) : LauncherTheme.secondArgb(205);
    roundedFill(graphics, x + 1, tileY + 2, w, h, LauncherTheme.rawArgb(30, 0x000000));
    roundedFill(graphics, x, tileY, w, h, background);
    border(graphics, x, tileY, w, h, active ? LauncherTheme.highlightArgb(225) : (hovered ? LauncherTheme.accentArgb(205) : LauncherTheme.borderArgb(155)));
    drawModuleIcon(graphics, font, module, x, tileY, w, h, accent);
  }

  private void drawModuleIcon(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int x, int y, int w, int h, int accent) {
    if (module != null) {
      boolean active = module.toggleable && module.enabled;
      int title = LauncherTheme.textColor();
      int textX = x + 8;
      int switchX = x + w - 24;
      int switchY = y + 9;
      boolean ownerOnly = MenuModules.isOwnerOnly(module.id);
      int textW = Math.max(24, w - (ownerOnly ? 52 : 40));
      graphics.text(font, fitLabel(module.title, textW), textX, y + 10, title);
      if (ownerOnly) {
        int badgeX = Math.min(switchX - 15, textX + textW + 2);
        roundedFill(graphics, badgeX, y + 8, 12, 12, LauncherTheme.accentArgb(105));
        border(graphics, badgeX, y + 8, 12, 12, LauncherTheme.accentArgb(215));
        graphics.centeredText(font, "A", badgeX + 6, y + 10, LauncherTheme.textColor());
      }
      roundedFill(graphics, switchX, switchY, 18, 10, active ? LauncherTheme.accentArgb(210) : LauncherTheme.argb(150, 0x000000));
      roundedFill(graphics, switchX + (active ? 10 : 2), switchY + 2, 6, 6, active ? LauncherTheme.textOnAccentColor() : LauncherTheme.textColor());
      return;
    }
    int cx = x + (w / 2);
    int cy = y + (h / 2);
    int color = 0xFFFFFFFF;
    if ("zoom".equals(module.id)) {
      border(graphics, cx - 9, cy - 9, 17, 17, color);
      graphics.fill(cx - 5, cy - 1, cx + 4, cy + 1, color);
      graphics.fill(cx - 1, cy - 5, cx + 1, cy + 4, color);
      graphics.fill(cx + 6, cy + 7, cx + 10, cy + 11, color);
      graphics.fill(cx + 9, cy + 10, cx + 13, cy + 14, color);
      return;
    }
    if ("bright".equals(module.id)) {
      graphics.fill(cx - 4, cy - 4, cx + 4, cy + 4, color);
      graphics.fill(cx - 1, cy - 13, cx + 1, cy - 7, color);
      graphics.fill(cx - 1, cy + 7, cx + 1, cy + 13, color);
      graphics.fill(cx - 13, cy - 1, cx - 7, cy + 1, color);
      graphics.fill(cx + 7, cy - 1, cx + 13, cy + 1, color);
      return;
    }
    if ("sprint".equals(module.id)) {
      graphics.fill(cx - 12, cy + 8, cx + 10, cy + 10, color);
      graphics.fill(cx + 6, cy + 5, cx + 12, cy + 10, color);
      graphics.fill(cx - 5, cy - 10, cx - 1, cy + 4, color);
      graphics.fill(cx - 1, cy + 1, cx + 7, cy + 4, color);
      graphics.fill(cx + 5, cy + 4, cx + 9, cy + 11, color);
      return;
    }
    if ("nobob".equals(module.id)) {
      border(graphics, cx - 12, cy - 7, 24, 14, color);
      graphics.fill(cx - 8, cy - 1, cx + 8, cy + 1, color);
      graphics.fill(cx - 2, cy - 4, cx + 2, cy + 4, color);
      return;
    }
    if ("crosshair".equals(module.id)) {
      border(graphics, cx - 12, cy - 12, 7, 7, color);
      border(graphics, cx + 5, cy - 12, 7, 7, color);
      border(graphics, cx - 12, cy + 5, 7, 7, color);
      border(graphics, cx + 5, cy + 5, 7, 7, color);
      graphics.fill(cx - 3, cy - 1, cx + 3, cy + 1, color);
      graphics.fill(cx - 1, cy - 3, cx + 1, cy + 3, color);
      return;
    }
    if ("fps".equals(module.id)) {
      border(graphics, cx - 12, cy - 9, 24, 18, color);
      graphics.fill(cx - 8, cy + 3, cx - 5, cy + 7, color);
      graphics.fill(cx - 2, cy, cx + 1, cy + 7, color);
      graphics.fill(cx + 4, cy - 5, cx + 7, cy + 7, color);
      return;
    }
    if ("coords".equals(module.id)) {
      graphics.fill(cx - 1, cy - 13, cx + 1, cy + 12, color);
      graphics.fill(cx - 13, cy - 1, cx + 13, cy + 1, color);
      border(graphics, cx - 7, cy - 7, 14, 14, color);
      return;
    }
    if ("keys".equals(module.id)) {
      int key = 8;
      drawMiniKey(graphics, font, "", cx - 4, cy - 12, key, key);
      drawMiniKey(graphics, font, "", cx - 13, cy - 3, key, key);
      drawMiniKey(graphics, font, "", cx - 4, cy - 3, key, key);
      drawMiniKey(graphics, font, "", cx + 5, cy - 3, key, key);
      return;
    }
    if ("cps".equals(module.id)) {
      border(graphics, cx - 7, cy - 12, 14, 22, color);
      graphics.fill(cx - 1, cy - 9, cx + 1, cy - 3, color);
      graphics.fill(cx - 5, cy + 12, cx + 5, cy + 14, color);
      return;
    }
    if ("clock".equals(module.id)) {
      border(graphics, cx - 11, cy - 11, 22, 22, color);
      graphics.fill(cx - 1, cy - 8, cx + 1, cy + 1, color);
      graphics.fill(cx, cy, cx + 7, cy + 2, color);
      return;
    }
    if ("ui".equals(module.id)) {
      border(graphics, cx - 12, cy - 9, 24, 18, color);
      graphics.fill(cx - 9, cy - 1, cx + 9, cy + 1, color);
      graphics.fill(cx - 1, cy - 7, cx + 1, cy + 7, color);
      return;
    }
    graphics.centeredText(font, fitLabel(module.title, w - 8), cx, cy - 4, color);
  }

  private void drawModuleMinecraftIcon(GuiGraphicsExtractor graphics, String id, int x, int y, boolean active) {
    String key = id == null ? "" : id;
    int accent = LauncherTheme.accentArgb(active ? 255 : 225);
    int dim = LauncherTheme.argb(190, 0xFFFFFF);
    int white = 0xFFFFFFFF;
    int black = 0xFF000000;
    if ("bright".equals(key)) {
      graphics.fill(x + 7, y + 1, x + 10, y + 4, accent);
      graphics.fill(x + 6, y + 4, x + 11, y + 7, accent);
      graphics.fill(x + 7, y + 7, x + 10, y + 15, dim);
      graphics.fill(x + 8, y + 9, x + 9, y + 15, black);
      return;
    }
    if ("sprint".equals(key) || "speed".equals(key)) {
      graphics.fill(x + 3, y + 9, x + 8, y + 14, accent);
      graphics.fill(x + 8, y + 7, x + 13, y + 14, accent);
      graphics.fill(x + 4, y + 12, x + 14, y + 15, white);
      graphics.fill(x + 10, y + 4, x + 13, y + 7, dim);
      return;
    }
    if ("zoom".equals(key)) {
      border(graphics, x + 2, y + 2, 9, 9, accent);
      graphics.fill(x + 5, y + 5, x + 8, y + 8, dim);
      graphics.fill(x + 10, y + 10, x + 13, y + 13, accent);
      graphics.fill(x + 12, y + 12, x + 15, y + 15, white);
      return;
    }
    if ("xray".equals(key)) {
      int diamond = 0xFF20E8FF;
      graphics.fill(x + 5, y + 2, x + 11, y + 4, diamond);
      graphics.fill(x + 3, y + 4, x + 13, y + 8, diamond);
      graphics.fill(x + 5, y + 8, x + 11, y + 12, diamond);
      graphics.fill(x + 7, y + 12, x + 9, y + 15, white);
      graphics.fill(x + 6, y + 4, x + 8, y + 7, 0xFFA8FAFF);
      return;
    }
    if ("trajectory".equals(key)) {
      graphics.fill(x + 2, y + 3, x + 4, y + 13, accent);
      graphics.fill(x + 4, y + 2, x + 6, y + 5, accent);
      graphics.fill(x + 4, y + 11, x + 6, y + 14, accent);
      graphics.fill(x + 7, y + 8, x + 15, y + 10, white);
      graphics.fill(x + 12, y + 5, x + 15, y + 8, white);
      graphics.fill(x + 12, y + 10, x + 15, y + 13, white);
      return;
    }
    if ("hitboxes".equals(key) || "ghostblocks".equals(key)) {
      border(graphics, x + 3, y + 3, 10, 10, accent);
      graphics.fill(x + 5, y + 1, x + 14, y + 3, dim);
      graphics.fill(x + 13, y + 3, x + 15, y + 12, dim);
      graphics.fill(x + 6, y + 6, x + 10, y + 10, LauncherTheme.argb(90, 0xFFFFFF));
      return;
    }
    if ("mobtrack".equals(key) || "coords".equals(key)) {
      border(graphics, x + 2, y + 2, 12, 12, accent);
      graphics.fill(x + 7, y + 1, x + 9, y + 15, dim);
      graphics.fill(x + 1, y + 7, x + 15, y + 9, dim);
      graphics.fill(x + 6, y + 6, x + 10, y + 10, white);
      return;
    }
    if ("breakspeed".equals(key)) {
      graphics.fill(x + 3, y + 3, x + 11, y + 5, accent);
      graphics.fill(x + 9, y + 5, x + 13, y + 7, accent);
      graphics.fill(x + 7, y + 7, x + 10, y + 10, dim);
      graphics.fill(x + 5, y + 9, x + 8, y + 12, dim);
      graphics.fill(x + 3, y + 11, x + 6, y + 14, white);
      return;
    }
    if ("resistance".equals(key)) {
      graphics.fill(x + 4, y + 2, x + 12, y + 4, accent);
      graphics.fill(x + 3, y + 4, x + 13, y + 9, accent);
      graphics.fill(x + 5, y + 9, x + 11, y + 12, dim);
      graphics.fill(x + 7, y + 12, x + 9, y + 15, white);
      return;
    }
    if ("invisibility".equals(key)) {
      graphics.fill(x + 6, y + 2, x + 10, y + 4, white);
      graphics.fill(x + 5, y + 4, x + 11, y + 6, accent);
      border(graphics, x + 4, y + 6, 8, 8, accent);
      graphics.fill(x + 5, y + 9, x + 11, y + 13, LauncherTheme.argb(110, 0xFFFFFF));
      return;
    }
    if ("keys".equals(key)) {
      graphics.fill(x + 5, y + 1, x + 12, y + 8, accent);
      graphics.fill(x + 1, y + 8, x + 8, y + 15, accent);
      graphics.fill(x + 8, y + 8, x + 15, y + 15, accent);
      border(graphics, x + 5, y + 1, 7, 7, white);
      border(graphics, x + 1, y + 8, 7, 7, white);
      border(graphics, x + 8, y + 8, 7, 7, white);
      return;
    }
    if ("cps".equals(key)) {
      border(graphics, x + 4, y + 1, 8, 13, accent);
      graphics.fill(x + 7, y + 3, x + 9, y + 7, white);
      graphics.fill(x + 5, y + 14, x + 11, y + 15, dim);
      return;
    }
    if ("armor".equals(key)) {
      graphics.fill(x + 4, y + 2, x + 12, y + 5, accent);
      graphics.fill(x + 3, y + 5, x + 13, y + 11, dim);
      graphics.fill(x + 5, y + 11, x + 11, y + 15, accent);
      border(graphics, x + 3, y + 2, 10, 13, white);
      return;
    }
    if ("clock".equals(key) || "timer".equals(key)) {
      border(graphics, x + 2, y + 2, 12, 12, accent);
      graphics.fill(x + 7, y + 4, x + 9, y + 9, white);
      graphics.fill(x + 8, y + 8, x + 12, y + 10, white);
      return;
    }
    if ("smartscreenshot".equals(key)) {
      graphics.fill(x + 2, y + 5, x + 14, y + 13, accent);
      graphics.fill(x + 5, y + 3, x + 10, y + 5, dim);
      border(graphics, x + 6, y + 6, 5, 5, white);
      return;
    }
    if ("code".equals(key) || "fakefps".equals(key)) {
      graphics.fill(x + 3, y + 3, x + 13, y + 14, accent);
      graphics.fill(x + 5, y + 5, x + 12, y + 13, black);
      graphics.fill(x + 6, y + 6, x + 11, y + 7, white);
      graphics.fill(x + 6, y + 9, x + 10, y + 10, white);
      return;
    }
    if ("crosshair".equals(key) || "ui".equals(key) || "fps".equals(key) || "nobob".equals(key)) {
      graphics.fill(x + 7, y + 1, x + 9, y + 15, accent);
      graphics.fill(x + 1, y + 7, x + 15, y + 9, accent);
      border(graphics, x + 4, y + 4, 8, 8, white);
      return;
    }
    border(graphics, x + 3, y + 3, 10, 10, accent);
    graphics.fill(x + 6, y + 6, x + 10, y + 10, white);
  }

  private boolean handleDetailClick(double mouseX, double mouseY, int[] layout) {
    MenuModules.Module module = MenuModules.modules()[selectedIndex];
    int panelX = layout[4];
    int panelY = layout[5];
    int panelW = layout[6];
    int panelH = layout[7];
    if ("keysounds".equals(module.id) && handleKeyboardSoundEditorClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("friends".equals(module.id) && handleFriendsEditorClick(mouseX, mouseY, panelX, panelY, panelW, panelH)) {
      return true;
    }
    if ("fakefps".equals(module.id) && handleCodeEditorClick(mouseX, mouseY, panelX, panelY, panelW, panelH)) {
      return true;
    }
    if ("crosshair".equals(module.id) && handleCrosshairEditorClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("timer".equals(module.id) && handleTimerEditorClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("weather".equals(module.id) && handleWeatherEditorClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("time".equals(module.id) && handleTimeEditorClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("uptimer".equals(module.id) && handleUpTimerEditorClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("xray".equals(module.id) && handleXrayEditorClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("blockoutline".equals(module.id) && handleBlockOutlineClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("armor".equals(module.id) && handleArmorEditorClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if (hasEffectLevelSlider(module) && handleEffectLevelSliderClick(mouseX, mouseY, panelX, panelY, panelW)) {
      return true;
    }
    if ("flight".equals(module.id) && isInside(mouseX, mouseY, panelX + 14, panelY + DETAIL_EDITOR_TOP, Math.max(80, panelW - 28), 38)) {
      draggingFlightSpeed = true;
      updateFlightSpeedFromMouse(mouseX, panelX, panelY, panelW);
      return true;
    }
    boolean resizableUi = OverlaySettings.isOverlay(module.id);
    int[] controls = detailControlBounds(panelX, panelW, module.keyBindable, module.toggleable, resizableUi, module.id);
    int buttonY = panelY + panelH - 22;
    if (module.keyBindable && isInside(mouseX, mouseY, controls[0], buttonY, controls[1], 16)) {
      capturingKey = true;
      return true;
    }
    if (module.toggleable && isInside(mouseX, mouseY, controls[2], buttonY, controls[3], 16)) {
      XLauncherMenuClient.setModuleEnabled(selectedIndex, !module.enabled);
      return true;
    }
    if (resizableUi && OverlaySettings.canShrink(module.id)
        && isInside(mouseX, mouseY, controls[4], buttonY, controls[5], 16)) {
      OverlaySettings.resize(module.id, -1);
      return true;
    }
    if (resizableUi && OverlaySettings.canGrow(module.id)
        && isInside(mouseX, mouseY, controls[6], buttonY, controls[7], 16)) {
      OverlaySettings.resize(module.id, 1);
      return true;
    }
    if (resizableUi && isInside(mouseX, mouseY, controls[8], buttonY, controls[9], 16)) {
      String target = OverlaySettings.hasText(module.id) ? "overlay." + module.id + ".text" : "overlay." + module.id + ".rest";
      int color = OverlaySettings.hasText(module.id) ? OverlaySettings.textColor(module.id) : OverlaySettings.restColor(module.id);
      openColorPicker(target, OverlaySettings.hasText(module.id) ? module.title + " Text" : module.title + " Color", color);
      return true;
    }
    if (resizableUi && OverlaySettings.hasText(module.id) && isInside(mouseX, mouseY, controls[10], buttonY, controls[11], 16)) {
      openColorPicker("overlay." + module.id + ".rest", module.title + " Elements", OverlaySettings.restColor(module.id));
      return true;
    }
    if (resizableUi && isInside(mouseX, mouseY, controls[12], buttonY, controls[13], 16)) {
      centerOverlayOnScreen(module.id, true);
      return true;
    }
    if (resizableUi && isInside(mouseX, mouseY, controls[14], buttonY, controls[15], 16)) {
      centerOverlayOnScreen(module.id, false);
      return true;
    }
    return true;
  }

  private void centerOverlayOnScreen(String id, boolean horizontal) {
    int[] bounds = overlayBounds(id, overlayText(id));
    int nextX = horizontal ? Math.max(0, (width - bounds[2]) / 2) : OverlaySettings.x(id);
    int nextY = horizontal ? OverlaySettings.y(id) : Math.max(0, (height - bounds[3]) / 2);
    OverlaySettings.setPosition(id, nextX, nextY);
  }

  private boolean handleKeyboardSoundEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    int gap = 4;
    int square = Math.max(14, Math.min(20, (w - (gap * 5)) / 6));
    int gridW = (square * 6) + (gap * 5);
    int gridX = x + Math.max(0, (w - gridW) / 2);
    for (int index = 0; index < 12; index += 1) {
      int sx = gridX + ((index % 6) * (square + gap));
      int sy = y + ((index / 6) * (square + gap));
      if (isInside(mouseX, mouseY, sx, sy, square, square)) {
        MenuModules.setKeyboardSound(index + 1);
        KeyboardSoundPlayer.preview();
        return true;
      }
    }
    int volumeY = y + ((square + gap) * 2) + 3;
    if (isInside(mouseX, mouseY, x + 64, volumeY - 3, Math.max(24, w - 64), 14)) {
      draggingKeyboardVolume = true;
      updateKeyboardVolumeFromMouse(mouseX, panelX, panelY, panelW);
      return true;
    }
    return false;
  }

  private void updateKeyboardVolumeFromMouse(double mouseX, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int w = Math.max(80, panelW - 28);
    int trackX = x + 68;
    int trackW = Math.max(20, w - 72);
    double ratio = Math.max(0.0D, Math.min(1.0D, (mouseX - trackX) / (double) trackW));
    int range = MenuModules.MAX_KEYBOARD_VOLUME - MenuModules.MIN_KEYBOARD_VOLUME;
    MenuModules.setKeyboardVolumePercent(MenuModules.MIN_KEYBOARD_VOLUME + (int) Math.round(ratio * range));
  }

  private boolean handleXrayEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    if (isInside(mouseX, mouseY, x, y, w, 24)) {
      draggingXrayRange = true;
      updateXrayRangeFromMouse(mouseX, panelX, panelY, panelW);
      return true;
    }
    for (int index = 0; index < XraySettings.ORE_LABELS.length; index++) {
      int[] bounds = xrayOreButtonBounds(panelX, panelY, panelW, index);
      if (isInside(mouseX, mouseY, bounds[0], bounds[1], bounds[2], bounds[3])) {
        XraySettings.toggleOre(index);
        return true;
      }
    }
    int gap = 4;
    int extraY = y + 58;
    int extraW = Math.max(24, (w - (gap * 2)) / 3);
    if (isInside(mouseX, mouseY, x, extraY, extraW, 15)) { XraySettings.togglePlayers(); return true; }
    if (isInside(mouseX, mouseY, x + extraW + gap, extraY, extraW, 15)) { XraySettings.toggleChests(); return true; }
    if (isInside(mouseX, mouseY, x + ((extraW + gap) * 2), extraY, Math.max(24, w - ((extraW + gap) * 2)), 15)) { XraySettings.toggleSpawners(); return true; }
    return false;
  }

  private void updateFlightSpeedFromMouse(double mouseX, int panelX, int panelY, int panelW) {
    int trackX = panelX + 24;
    int trackW = Math.max(1, panelW - 48);
    double ratio = Math.max(0.0D, Math.min(1.0D, (mouseX - trackX) / (double) trackW));
    int range = MenuModules.MAX_FLIGHT_SPEED - MenuModules.MIN_FLIGHT_SPEED;
    MenuModules.setFlightSpeedPercent(MenuModules.MIN_FLIGHT_SPEED + (int) Math.round(ratio * range));
  }

  private void openColorPicker(String target, String label, int initialColor) {
    Minecraft.getInstance().gui.setScreen(new XClientColorPickerScreen(this, target, label, initialColor));
  }

  private void openStaticColorPicker(String target, String label, int initialColor) {
    Minecraft.getInstance().gui.setScreen(new XClientColorPickerScreen(this, target, label, initialColor, false));
  }

  private boolean handleArmorEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    int gap = 5;
    int innerW = Math.max(60, w - 16);
    int colorW = Math.max(18, (innerW - (gap * 2)) / 3);
    int colorsW = (colorW * 3) + (gap * 2);
    int colorX = x + Math.max(8, (w - colorsW) / 2);
    String[] targets = { "overlay.armor.health.healthy", "overlay.armor.health.warning", "overlay.armor.health.critical" };
    String[] labels = { "Armor Good", "Armor Low", "Armor Critical" };
    int[] colors = { OverlaySettings.armorHealthyColor(), OverlaySettings.armorWarningColor(), OverlaySettings.armorCriticalColor() };
    for (int index = 0; index < 3; index += 1) {
      int swatchX = colorX + (index * (colorW + gap));
      if (isInside(mouseX, mouseY, swatchX, y + 28, colorW, 20)) {
        openStaticColorPicker(targets[index], labels[index], colors[index]);
        return true;
      }
    }
    return false;
  }

  private boolean handleBlockOutlineClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = panelX + 14, y = panelY + DETAIL_EDITOR_TOP, w = Math.max(80, panelW - 28);
    if (isInside(mouseX, mouseY, x + w - 24, y + 4, 16, 16)) {
      openColorPicker("blockoutline", "Block Outline", BlockOutlineSettings.color());
      return true;
    }
    if (isInside(mouseX, mouseY, x + 58, y + 32, Math.max(24, w - 64), 22)) {
      draggingBlockOutlineThickness = true;
      updateBlockOutlineThickness(mouseX, panelX, panelY, panelW);
      return true;
    }
    return false;
  }

  private void updateBlockOutlineThickness(double mouseX, int panelX, int panelY, int panelW) {
    int x = panelX + 14, w = Math.max(80, panelW - 28);
    int trackX = x + 62, trackW = Math.max(20, w - 72);
    double ratio = Math.max(0.0D, Math.min(1.0D, (mouseX - trackX) / trackW));
    int range = BlockOutlineSettings.MAX_THICKNESS - BlockOutlineSettings.MIN_THICKNESS;
    BlockOutlineSettings.setThickness(BlockOutlineSettings.MIN_THICKNESS + (int)Math.round(ratio * range));
  }

  private void updateXrayRangeFromMouse(double mouseX, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int w = Math.max(80, panelW - 28);
    int trackX = x + 10;
    int trackW = Math.max(1, w - 20);
    int max = EspRenderPipeline26.maxRangeChunks();
    double ratio = Math.max(0.0D, Math.min(1.0D, (mouseX - trackX) / (double)trackW));
    XraySettings.setRangeChunks(max <= 1 ? 1 : 1 + (int)Math.round(ratio * (max - 1)));
  }

  private boolean handleEffectLevelSliderClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = effectSliderX(panelX);
    int y = effectSliderY(panelY);
    int w = effectSliderW(panelW);
    if (!isInside(mouseX, mouseY, x, y, w, 38)) {
      return false;
    }
    draggingEffectLevel = true;
    updateEffectLevelFromMouse(mouseX, panelX, panelY, panelW);
    return true;
  }


  private boolean handleZoomSettingsClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = zoomSettingsX(panelX);
    int y = zoomSettingsY(panelY);
    int w = zoomSettingsW(panelW);
    if (!isInside(mouseX, mouseY, x, y, w, 88)) {
      return false;
    }
    draggingZoomStrength = false;
    draggingZoomSmoothness = false;
    if (isInside(mouseX, mouseY, x + 4, y + 25, w - 8, 28)) {
      draggingZoomStrength = true;
      updateZoomSettingsFromMouse(mouseX, panelX, panelY, panelW);
      return true;
    }
    if (isInside(mouseX, mouseY, x + 4, y + 55, w - 8, 28)) {
      draggingZoomSmoothness = true;
      updateZoomSettingsFromMouse(mouseX, panelX, panelY, panelW);
      return true;
    }
    return true;
  }

  private boolean handleTimerEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = timerEditorX(panelX);
    int y = timerEditorY(panelY);
    int w = timerEditorW(panelW);
    if (!isInside(mouseX, mouseY, x, y, w, 76)) {
      return false;
    }
    int rowY = y + 25;
    int[] controls = timerControlBounds(panelX, panelW);
    int buttonW = controls[5];
    if (isInside(mouseX, mouseY, controls[0], rowY, buttonW, 16)) {
      GameTimer.adjustMinutes(-5);
      return true;
    }
    if (isInside(mouseX, mouseY, controls[1], rowY, buttonW, 16)) {
      GameTimer.adjustMinutes(-1);
      return true;
    }
    if (isInside(mouseX, mouseY, controls[3], rowY, buttonW, 16)) {
      GameTimer.adjustMinutes(1);
      return true;
    }
    if (isInside(mouseX, mouseY, controls[4], rowY, buttonW, 16)) {
      GameTimer.adjustMinutes(5);
      return true;
    }
    int autoW = 64;
    int resetW = 48;
    if (isInside(mouseX, mouseY, x + 8, y + 50, autoW, 16)) {
      GameTimer.setAutoStartDaily(!GameTimer.autoStartDaily());
      return true;
    }
    if (isInside(mouseX, mouseY, x + 8 + autoW + 4, y + 50, resetW, 16)) {
      GameTimer.reset();
      return true;
    }
    return true;
  }

  private boolean handleWeatherEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = panelX + 14, y = panelY + DETAIL_EDITOR_TOP, w = Math.max(80, panelW - 28);
    int gap = 4, buttonW = Math.max(20, (w - 16 - (gap * 2)) / 3);
    int total = (buttonW * 3) + (gap * 2), startX = x + (w - total) / 2;
    for (int index = 0; index < 3; index += 1) {
      if (isInside(mouseX, mouseY, startX + (index * (buttonW + gap)), y + 22, buttonW, 16)) {
        MenuModules.setWeatherMode(index);
        XLauncherMenuClient.refreshModule(selectedIndex);
        return true;
      }
    }
    return false;
  }

  private boolean handleTimeEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = panelX + 14, y = panelY + DETAIL_EDITOR_TOP, w = Math.max(80, panelW - 28);
    int gap = 4, buttonW = Math.max(17, (w - 20 - (gap * 3)) / 4);
    int total = (buttonW * 4) + (gap * 3), startX = x + (w - total) / 2;
    for (int index = 0; index < 4; index += 1) {
      if (isInside(mouseX, mouseY, startX + (index * (buttonW + gap)), y + 22, buttonW, 16)) {
        MenuModules.setTimeMode(index);
        XLauncherMenuClient.refreshModule(selectedIndex);
        return true;
      }
    }
    return false;
  }

  private boolean handleUpTimerEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    return false;
  }

  private void updateEffectLevelFromMouse(double mouseX, int panelX, int panelY, int panelW) {
    if (selectedIndex < 0) {
      return;
    }
    MenuModules.Module module = MenuModules.modules()[selectedIndex];
    if (!hasEffectLevelSlider(module)) {
      return;
    }
    int trackX = effectSliderX(panelX) + 10;
    int trackW = Math.max(1, effectSliderW(panelW) - 20);
    double ratio = Math.max(0.0D, Math.min(1.0D, (mouseX - trackX) / (double) trackW));
    int level = 30 + (int) Math.round(ratio * 70.0D);
    MenuModules.setEffectLevel(module.id, level);
    XLauncherMenuClient.refreshModule(selectedIndex);
  }

  private void updateZoomSettingsFromMouse(double mouseX, int panelX, int panelY, int panelW) {
    if (selectedIndex < 0) {
      return;
    }
    MenuModules.Module module = MenuModules.modules()[selectedIndex];
    if (!"zoom".equals(module.id)) {
      return;
    }
    int trackX = zoomSettingsX(panelX) + 10;
    int trackW = Math.max(1, zoomSettingsW(panelW) - 20);
    double ratio = Math.max(0.0D, Math.min(1.0D, (mouseX - trackX) / (double) trackW));
    if (draggingZoomStrength) {
      int range = MenuModules.MAX_ZOOM_STRENGTH - MenuModules.MIN_ZOOM_STRENGTH;
      MenuModules.setZoomStrengthPercent(MenuModules.MIN_ZOOM_STRENGTH + (int) Math.round(ratio * range));
    } else if (draggingZoomSmoothness) {
      int range = MenuModules.MAX_ZOOM_SMOOTHNESS - MenuModules.MIN_ZOOM_SMOOTHNESS;
      MenuModules.setZoomSmoothnessPercent(MenuModules.MIN_ZOOM_SMOOTHNESS + (int) Math.round(ratio * range));
    }
    XLauncherMenuClient.refreshModule(selectedIndex);
  }


  private boolean handleCodeEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW, int panelH) {
    int contentX = panelX + 14;
    int contentY = panelY + DETAIL_EDITOR_TOP;
    int contentW = panelW - 28;
    int inputY = contentY + 24;
    int buttonY = inputY + 22;
    int controlsY = panelY + panelH - 22;
    int[] controls = detailControlBounds(panelX, panelW, true, true, false, "fakefps");
    if (isInside(mouseX, mouseY, controls[0], controlsY, controls[1], 16)) {
      capturingKey = true;
      codeFocused = false;
      return true;
    }
    if (isInside(mouseX, mouseY, controls[2], controlsY, controls[3], 16)) {
      XLauncherMenuClient.setModuleEnabled(selectedIndex, !MenuModules.modules()[selectedIndex].enabled);
      return true;
    }
    if (isInside(mouseX, mouseY, contentX + 8, inputY, contentW - 16, 18)) {
      codeFocused = true;
      searchFocused = false;
      return true;
    }
    if (isInside(mouseX, mouseY, contentX + 8, buttonY, contentW - 16, 15)) {
      submitCode();
      return true;
    }
    codeFocused = false;
    return true;
  }

  private boolean isCodeModuleSelected() {
    return selectedIndex >= 0 && "fakefps".equals(MenuModules.modules()[selectedIndex].id);
  }

  private boolean handleCodeKey(int keyCode) {
    if (keyCode == 259) {
      if (!codeInput.isEmpty()) {
        codeInput = codeInput.substring(0, codeInput.length() - 1);
        codeStatus = "Wert eingeben.";
      }
      return true;
    }
    if (keyCode == 261) {
      codeInput = "";
      codeStatus = "Wert eingeben.";
      return true;
    }
    if (keyCode == 257 || keyCode == 335) {
      submitCode();
      return true;
    }
    return false;
  }

  private boolean appendCodeText(String text) {
    String value = String.valueOf(text == null ? "" : text);
    if (value.isEmpty() || codeInput.length() >= 11) {
      return true;
    }
    char chr = value.charAt(0);
    if (!Character.isDigit(chr) && !(chr == '-' && codeInput.isEmpty())) {
      return true;
    }
    codeInput += chr;
    codeStatus = "Wert eingeben.";
    return true;
  }

  private void submitCode() {
    try {
      long parsed = Long.parseLong(codeInput.isBlank() || "-".equals(codeInput) ? "0" : codeInput);
      int value = (int) Math.max(Integer.MIN_VALUE, Math.min(Integer.MAX_VALUE, parsed));
      MenuModules.setFakeFps(value);
      codeInput = String.valueOf(value);
      codeStatus = "Gespeichert: " + (value >= 0 ? "+" : "") + value + " FPS";
      codeFocused = false;
    } catch (NumberFormatException ignored) {
      codeStatus = "Bitte eine ganze Zahl eingeben.";
      codeFocused = true;
    }
  }

  private boolean handleCrosshairEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int top = panelY + DETAIL_EDITOR_TOP;
    int contentX = panelX + 10;
    int contentW = Math.max(100, panelW - 20);
    int cell = crosshairGridCell(panelW);
    int gridSize = CrosshairSettings.SIZE * cell;
    int gridX = contentX + contentW - gridSize;
    int gridY = top + 17;
    int leftW = Math.max(1, gridX - contentX - 10);
    int compactW = Math.min(leftW, 68);
    int compactX = contentX + Math.max(0, (leftW - compactW) / 2);
    if (isInside(mouseX, mouseY, compactX, top, compactW, 14)) {
      CrosshairSettings.nextTemplate();
      return true;
    }
    if (isInside(mouseX, mouseY, compactX, top + 18, compactW, 14)) {
      CrosshairSettings.toggleTargetAlert();
      return true;
    }
    int colorGap = 6;
    int colorW = Math.max(1, (leftW - colorGap) / 2);
    if (isInside(mouseX, mouseY, contentX, top + 36, colorW, 14)) {
      openColorPicker("crosshair.main", "Crosshair Main", CrosshairSettings.normalColor());
      return true;
    }
    if (isInside(mouseX, mouseY, contentX + colorW + colorGap, top + 36, colorW, 14)) {
      openColorPicker("crosshair.target", "Crosshair Attack", CrosshairSettings.targetColor());
      return true;
    }
    if (isInside(mouseX, mouseY, contentX, top + 56, leftW, 17)) {
      draggingCrosshairSize = true;
      updateCrosshairSizeFromMouse(mouseX, panelX, panelY, panelW);
      return true;
    }
    if (isInside(mouseX, mouseY, gridX, gridY, gridSize, gridSize)) {
      int x = (int) ((mouseX - gridX) / cell);
      int y = (int) ((mouseY - gridY) / cell);
      CrosshairSettings.togglePixel(x, y);
      return true;
    }
    return false;
  }

  private void updateCrosshairSizeFromMouse(double mouseX, int panelX, int panelY, int panelW) {
    int sliderX = panelX + 10;
    int cell = crosshairGridCell(panelW);
    int sliderW = Math.max(1, (panelW - 20) - (CrosshairSettings.SIZE * cell) - 10);
    int trackX = crosshairSizeTrackX(sliderX);
    int trackW = crosshairSizeTrackW(sliderW);
    double ratio = Math.max(0.0D, Math.min(1.0D, (mouseX - trackX) / (double) trackW));
    int range = CrosshairSettings.MAX_SCALE - CrosshairSettings.MIN_SCALE;
    CrosshairSettings.setScale(CrosshairSettings.MIN_SCALE + (int) Math.round(ratio * range));
  }

  private boolean handleHitboxEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW) {
    int x = panelX + 8;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(120, panelW - 16);
    if (isInside(mouseX, mouseY, x, y, 14, 14)) {
      openColorPicker("hitbox.main", "Hitbox Normal", HitboxSettings.color());
      return true;
    }
    if (isInside(mouseX, mouseY, x + 20, y, 14, 14)) {
      openColorPicker("hitbox.target", "Hitbox Range", HitboxSettings.targetColor());
      return true;
    }
    int toggleY = y + 22;
    int toggleGap = 4;
    int toggleW = Math.max(32, (w - (toggleGap * 2)) / 3);
    if (isInside(mouseX, mouseY, x, toggleY, toggleW, 14)) {
      HitboxSettings.togglePlayers();
      return true;
    }
    if (isInside(mouseX, mouseY, x + toggleW + toggleGap, toggleY, toggleW, 14)) {
      HitboxSettings.toggleMobs();
      return true;
    }
    if (isInside(mouseX, mouseY, x + ((toggleW + toggleGap) * 2), toggleY, Math.max(32, w - ((toggleW + toggleGap) * 2)), 14)) {
      HitboxSettings.toggleItems();
      return true;
    }
    if (isInside(mouseX, mouseY, x, y + 45, Math.min(w, 220), 24)) {
      draggingHitboxThickness = true;
      updateHitboxThicknessFromMouse(mouseX, panelX, panelY, panelW);
      return true;
    }
    return false;
  }

  private void updateHitboxThicknessFromMouse(double mouseX, int panelX, int panelY, int panelW) {
    int sliderX = panelX + 8;
    int sliderW = Math.min(Math.max(120, panelW - 16), 220);
    int trackX = hitboxThicknessTrackX(sliderX);
    int trackW = hitboxThicknessTrackW(sliderW);
    double ratio = Math.max(0.0D, Math.min(1.0D, (mouseX - trackX) / (double) trackW));
    int range = HitboxSettings.MAX_THICKNESS - HitboxSettings.MIN_THICKNESS;
    HitboxSettings.setThickness(HitboxSettings.MIN_THICKNESS + (int) Math.round(ratio * range));
  }

  private int hitboxThicknessTrackX(int sliderX) {
    return sliderX + 54;
  }

  private int hitboxThicknessTrackW(int sliderW) {
    return Math.max(1, sliderW - 82);
  }

  private boolean handleFriendsEditorClick(double mouseX, double mouseY, int panelX, int panelY, int panelW, int panelH) {
    int top = panelY + DETAIL_EDITOR_TOP;
    SocialManager.FriendRequest[] requests = SocialManager.incomingRequests();
    SocialManager.WorldInvite[] invites = SocialManager.worldInvites();
    int contentW = panelW - 16;
    int contentX = panelX + 8;
    int swatchGap = 5;
    int swatch = Math.max(12, Math.min(18, (contentW - (swatchGap * (NameTagSettings.COLORS.length - 1))) / NameTagSettings.COLORS.length));
    for (int index = 0; index < NameTagSettings.COLORS.length; index++) {
      int sx = contentX + (index * (swatch + swatchGap));
      if (isInside(mouseX, mouseY, sx, top + 12, swatch, 12)) {
        XClientColorModes.setColor("nametag", NameTagSettings.COLORS[index]);
        openColorPicker("nametag", "Name Color", NameTagSettings.color());
        return true;
      }
    }
    top += 30;
    int y = top + 24;
    int bottomLimit = panelY + panelH - 8;
    if (pendingRemoveFriendUuid != null && y + 35 <= bottomLimit) {
      int removeX = contentX + contentW - 54;
      int cancelX = removeX - 58;
      if (isInside(mouseX, mouseY, cancelX - 4, y + 7, 58, 22)) {
        pendingRemoveFriendUuid = null;
        return true;
      }
      if (isInside(mouseX, mouseY, removeX - 4, y + 7, 54, 22)) {
        SocialManager.removeFriend(pendingRemoveFriendUuid);
        pendingRemoveFriendUuid = null;
        return true;
      }
      if (isInside(mouseX, mouseY, contentX, y, contentW, 35)) {
        return true;
      }
      y += 42;
    }
    if (y + 16 <= bottomLimit && isInside(mouseX, mouseY, contentX, y, 42, 16)) {
      SocialManager.startOwnWorldHost();
      return true;
    }
    if (y + 16 <= bottomLimit && isInside(mouseX, mouseY, contentX + 46, y, 54, 16)) {
      SocialManager.toggleKeepHostedWorldOnline();
      return true;
    }
    y += 24;
    int inviteRows = invites.length > 0 && y + 35 <= bottomLimit ? 1 : 0;
    if (inviteRows > 0) {
      y += 11;
    }
    for (int row = 0; row < inviteRows; row += 1) {
      int rowY = y + (row * 24);
      int copyX = contentX + contentW - 54;
      int closeX = contentX + contentW - 20;
      if (isInside(mouseX, mouseY, copyX, rowY + 4, 30, 13)) {
        SocialManager.copyWorldInviteAddress(invites[row].uuid);
        return true;
      }
      if (isInside(mouseX, mouseY, closeX, rowY + 4, 18, 13)) {
        SocialManager.dismissWorldInvite(invites[row].uuid);
        return true;
      }
    }
    y += inviteRows * 24;
    if (inviteRows > 0) {
      y += 5;
    }
    int requestRows = requests.length > 0 && y + 35 <= bottomLimit ? 1 : 0;
    if (requestRows > 0) {
      y += 11;
    }
    for (int row = 0; row < requestRows; row += 1) {
      int rowY = y + (row * 24);
      int acceptX = panelX + 8 + contentW - 50;
      int declineX = panelX + 8 + contentW - 20;
      if (isInside(mouseX, mouseY, acceptX, rowY + 4, 26, 13)) {
        pendingRemoveFriendUuid = null;
        SocialManager.acceptFriendRequest(requests[row].uuid);
        return true;
      }
      if (isInside(mouseX, mouseY, declineX, rowY + 4, 18, 13)) {
        pendingRemoveFriendUuid = null;
        SocialManager.declineFriendRequest(requests[row].uuid);
        return true;
      }
    }
    y += requestRows * 24;
    if (requestRows > 0) {
      y += 5;
    }
    if (y + 11 > bottomLimit) {
      return false;
    }
    y += 11;
    SocialManager.PlayerStatus[] players = SocialManager.players();
    boolean compactRows = requestRows > 0 || inviteRows > 0 || pendingRemoveFriendUuid != null;
    int maxRows = Math.min(compactRows ? 1 : 2, players.length);
    while (maxRows > 0 && y + (maxRows * 24) > bottomLimit) {
      maxRows -= 1;
    }
    for (int row = 0; row < maxRows; row += 1) {
      int rowY = y + (row * 24);
      if (players[row].self) {
        continue;
      }
      int actionW = players[row].friend ? 68 : Math.min(60, Math.max(38, contentW / 3));
      int actionX = panelX + 8 + contentW - actionW - 6;
      if (players[row].friend && isInside(mouseX, mouseY, actionX - 4, rowY + 1, 48, 20)) {
        pendingRemoveFriendUuid = null;
        SocialManager.inviteFriend(players[row].uuid);
        return true;
      }
      if (isInside(mouseX, mouseY, actionX - 5, rowY + 1, actionW + 10, 20)) {
        if (players[row].friend) {
          pendingRemoveFriendUuid = players[row].uuid;
          pendingRemoveFriendName = players[row].name;
        } else if (SocialManager.hasIncomingRequest(players[row].uuid)) {
          pendingRemoveFriendUuid = null;
          SocialManager.acceptFriendRequest(players[row].uuid);
        } else if (!SocialManager.hasOutgoingRequest(players[row].uuid)) {
          pendingRemoveFriendUuid = null;
          SocialManager.requestFriend(players[row].uuid, players[row].name);
        }
        return true;
      }
    }
    return false;
  }

  private int crosshairButtonWidth(int panelW) {
    return Math.max(18, (Math.max(40, panelW - 16) - 12) / 4);
  }

  private int crosshairSizeSliderW(int panelW) {
    return Math.max(82, Math.min(panelW - 16, 160));
  }

  private int crosshairSizeTrackX(int sliderX) {
    return sliderX + 54;
  }

  private int crosshairSizeTrackW(int sliderW) {
    return Math.max(1, sliderW - 78);
  }

  private int crosshairGridCell(int panelW) {
    return Math.max(4, Math.min(5, Math.max(44, panelW - 16) / CrosshairSettings.SIZE));
  }

  private int[] detailActionBounds(int panelX, int panelW, boolean toggleable, boolean keyBindable) {
    int gap = 8;
    int right = panelX + panelW - 8;
    int x = panelX + 8;
    int enableW = 0;
    int keyX = 0;
    int keyW = 0;
    int clearX = 0;
    int clearW = 0;
    int remaining = right - x;
    if (toggleable && remaining >= 44) {
      enableW = Math.min(62, remaining);
      x += enableW + gap;
      remaining = right - x;
    }
    if (keyBindable && remaining >= 58) {
      boolean fitClear = remaining >= 58 + gap + 44;
      keyX = x;
      keyW = fitClear ? Math.min(94, remaining - gap - 44) : Math.min(94, remaining);
      x += keyW + gap;
      remaining = right - x;
    }
    if (keyBindable && remaining >= 44) {
      clearX = x;
      clearW = Math.min(52, remaining);
    }
    return new int[] { panelX + 8, enableW, keyX, keyW, clearX, clearW };
  }

  private int[] layout() {
    int reservedTabs = 0;
    int boxW = Math.min(PANEL_MAX_WIDTH, Math.max(120, width - (MIN_WINDOW_MARGIN * 2) - reservedTabs));
    int boxH = Math.min(PANEL_MAX_HEIGHT, Math.max(120, height - (MIN_WINDOW_MARGIN * 2)));
    int groupW = reservedTabs + boxW;
    int boxX = Math.max(MIN_WINDOW_MARGIN + reservedTabs, ((width - groupW) / 2) + reservedTabs);
    int boxY = Math.max(MIN_WINDOW_MARGIN, (height - boxH) / 2);
    int contentW = Math.max(160, boxW - 20);
    int columns = getColumns(contentW, boxH);
    int tileWidth = getTileWidth(columns, contentW);
    int totalWidth = (columns * tileWidth) + ((columns - 1) * GAP);
    int gridHeight = currentGridHeight(columns);
    int startX = boxX + 10 + Math.max(0, (contentW - totalWidth) / 2);
    int startY = boxY + PANEL_HEADER_HEIGHT + 4;
    return new int[] { startX, startY, totalWidth, gridHeight, boxX, boxY, boxW, boxH, columns, tileWidth };
  }

  private int searchX(int[] layout) {
    return layout[4] + 10;
  }

  private int searchY(int[] layout) {
    return layout[5] + 10;
  }

  private int searchWidth(int[] layout) {
    int maxSearch = Math.max(42, layout[6] - (PANEL_SIDE_PADDING * 2) - headerButtonsWidth() - (HEADER_BUTTON_GAP * 2) - 74);
    return Math.min(SEARCH_WIDTH, maxSearch);
  }

  private int getColumns(int boxW, int boxH) {
    return boxW >= 220 ? 2 : 1;
  }

  private int getTileWidth(int columns, int boxW) {
    int computed = (boxW - ((columns - 1) * GAP)) / Math.max(1, columns);
    return Math.max(96, computed);
  }

  private int windowMargin() {
    int maxForWidth = Math.max(MIN_WINDOW_MARGIN, (width - MIN_PANEL_SIZE) / 2);
    int maxForHeight = Math.max(MIN_WINDOW_MARGIN, (height - MIN_PANEL_SIZE) / 2);
    return Math.max(MIN_WINDOW_MARGIN, Math.min(WINDOW_MARGIN, Math.min(maxForWidth, maxForHeight)));
  }

  private boolean headerCompact(int[] layout) {
    int menuX = searchX(layout) + searchWidth(layout) + 8;
    int right = layout[4] + layout[6] - 8;
    return right - 152 < menuX + 46;
  }

  private int fixedGridHeight() {
    return (TILE_HEIGHT * 2) + TILE_LABEL_HEIGHT + GAP;
  }

  private int currentGridHeight(int columns) {
    if (selectedIndex >= 0) {
      return fixedGridHeight();
    }
    int rows = Math.max(1, (visibleCount() + columns - 1) / Math.max(1, columns));
    return (rows * TILE_HEIGHT) + ((rows - 1) * (TILE_LABEL_HEIGHT + GAP));
  }

  private int availableGridHeight(int boxH) {
    return Math.max(TILE_HEIGHT, boxH - PANEL_HEADER_HEIGHT - PANEL_FOOTER_HEIGHT);
  }

  private int maxGridRowsForHeight(int availableGridHeight) {
    return Math.max(1, (availableGridHeight + TILE_LABEL_HEIGHT + GAP) / tileRowStep());
  }

  private int maxVisibleTiles(int[] layout) {
    return Math.max(1, layout[8] * maxGridRowsForHeight(availableGridHeight(layout[7])));
  }

  private int maxScrollRows(int[] layout) {
    int columns = Math.max(1, layout[8]);
    int totalRows = Math.max(1, (visibleCount() + columns - 1) / columns);
    int visibleRows = maxGridRowsForHeight(availableGridHeight(layout[7]));
    return Math.max(0, totalRows - visibleRows);
  }

  private void clampScroll(int[] layout) {
    scrollOffset = clampInt(scrollOffset, 0, maxScrollRows(layout));
  }

  private void scrollBy(int rows, int[] layout) {
    scrollOffset = clampInt(scrollOffset + rows, 0, maxScrollRows(layout));
  }

  private void drawScrollbar(GuiGraphicsExtractor graphics, int[] layout, int visibleCount, int maxVisibleTiles) {
    if (visibleCount <= maxVisibleTiles) {
      return;
    }
    int trackX = layout[4] + layout[6] - 7;
    int trackY = layout[1] + TILE_LABEL_HEIGHT;
    int trackH = Math.max(18, availableGridHeight(layout[7]) - TILE_LABEL_HEIGHT);
    int maxScroll = Math.max(1, maxScrollRows(layout));
    int knobH = Math.max(14, trackH / (maxScroll + 1));
    int knobY = trackY + ((trackH - knobH) * scrollOffset / maxScroll);
    graphics.fill(trackX, trackY, trackX + 3, trackY + trackH, LauncherTheme.argb(70, 0xFFFFFF));
    graphics.fill(trackX, knobY, trackX + 3, knobY + knobH, LauncherTheme.accentArgb(190));
  }

  private int tileRowStep() {
    return TILE_HEIGHT + TILE_LABEL_HEIGHT + GAP;
  }

  private int detailGridHeight(MenuModules.Module module) {
    if ("crosshair".equals(module.id)) {
      return 142;
    }
    if ("hitboxes".equals(module.id)) {
      return 122;
    }
    if ("xray".equals(module.id)) {
      return 164;
    }
    return 78;
  }

  private boolean handleHeaderClick(double mouseX, double mouseY, int[] layout) {
    int[] uiBounds = headerButtonBounds(layout, 0);
    if (isInside(mouseX, mouseY, uiBounds[0] - 3, uiBounds[1] - 3, uiBounds[2] + 6, uiBounds[3] + 6)) {
      uiEditorMode = true;
      galleryMode = false;
      selectedIndex = -1;
      capturingKey = false;
      searchFocused = false;
      draggingOverlay = null;
      resizingOverlay = false;
      pendingRemoveFriendUuid = null;
      return true;
    }
    int[] galleryBounds = headerButtonBounds(layout, 1);
    if (isInside(mouseX, mouseY, galleryBounds[0] - 3, galleryBounds[1] - 3, galleryBounds[2] + 6, galleryBounds[3] + 6)) {
      openGalleryPanel();
      return true;
    }
    return false;
  }

  private void openGalleryPanel() {
    galleryMode = true;
    uiEditorMode = false;
    selectedIndex = -1;
    searchFocused = false;
    capturingKey = false;
    pendingRemoveFriendUuid = null;
    galleryScrollOffset = 0;
    enlargedGalleryEntry = null;
    ScreenshotGallery.refresh(Minecraft.getInstance());
  }

  private boolean handleGalleryClick(double mouseX, double mouseY) {
    int[] home = galleryHomeBounds();
    if (isInside(mouseX, mouseY, home[0], home[1], home[2], home[3])) {
      galleryMode = false;
      return true;
    }
    java.util.List<ScreenshotGallery.Entry> entries = ScreenshotGallery.entries(Minecraft.getInstance());
    clampGalleryScroll(entries.size(), width, height);
    if (!entries.isEmpty()) {
      ScreenshotGallery.Entry entry = entries.get(galleryScrollOffset);
      int[] save = gallerySaveBounds();
      if (isInside(mouseX, mouseY, save[0], save[1], save[2], save[3])) {
        ScreenshotGallery.saveWithWindowsDialog(entry);
        return true;
      }
    }
    if (entries.size() <= 1) {
      return true;
    }
    int[] left = galleryLeftArrowBounds();
    if (isInside(mouseX, mouseY, left[0], left[1], left[2], left[3])) {
      scrollGallery(-1);
      return true;
    }
    int[] right = galleryRightArrowBounds();
    if (isInside(mouseX, mouseY, right[0], right[1], right[2], right[3])) {
      scrollGallery(1);
      return true;
    }
    return true;
  }

  private int[] galleryHomeBounds() {
    return new int[] { 8, 8, 42, 20 };
  }

  private int[] gallerySaveBounds() {
    return new int[] { Math.max(58, width - 54), 8, 46, 20 };
  }

  private int[] galleryLeftArrowBounds() {
    int arrowH = Math.min(96, Math.max(58, height / 5));
    return new int[] { 12, Math.max(38, (height - arrowH) / 2), 44, arrowH };
  }

  private int[] galleryRightArrowBounds() {
    int arrowH = Math.min(96, Math.max(58, height / 5));
    return new int[] { Math.max(12, width - 56), Math.max(38, (height - arrowH) / 2), 44, arrowH };
  }

  private int galleryHitIndex(double mouseX, double mouseY, java.util.List<ScreenshotGallery.Entry> entries, int[] layout) {
    if (entries == null || entries.isEmpty()) {
      return -1;
    }
    int boxX = layout[4];
    int boxY = layout[5];
    int boxW = layout[6];
    int boxH = layout[7];
    int columns = galleryColumns(boxW);
    int rows = galleryRows(boxH);
    int cardGap = 6;
    int contentX = boxX + PANEL_SIDE_PADDING;
    int contentY = boxY + PANEL_HEADER_HEIGHT;
    int contentW = boxW - (PANEL_SIDE_PADDING * 2);
    int cardW = Math.max(42, (contentW - (cardGap * (columns - 1))) / columns);
    int cardH = galleryCardHeight(boxH);
    int first = galleryScrollOffset * columns;
    int max = Math.min(entries.size(), first + (columns * rows));
    for (int index = first; index < max; index += 1) {
      int visibleIndex = index - first;
      int column = visibleIndex % columns;
      int row = visibleIndex / columns;
      int x = contentX + (column * (cardW + cardGap));
      int y = contentY + (row * (cardH + cardGap));
      if (isInside(mouseX, mouseY, x, y, cardW, cardH)) {
        return index;
      }
    }
    return -1;
  }

  private int galleryColumns(int boxW) {
    return 2;
  }

  private int galleryRows(int boxH) {
    return 2;
  }

  private int galleryCardHeight(int boxH) {
    int available = Math.max(54, boxH - PANEL_HEADER_HEIGHT - PANEL_FOOTER_HEIGHT);
    return Math.max(24, (available - 6) / 2);
  }

  private void clampGalleryScroll(int count, int boxW, int boxH) {
    galleryScrollOffset = clampInt(galleryScrollOffset, 0, Math.max(0, count - 1));
  }

  private void scrollGallery(int rows) {
    int count = ScreenshotGallery.entries(Minecraft.getInstance()).size();
    if (count <= 0) {
      galleryScrollOffset = 0;
      return;
    }
    galleryScrollOffset = Math.floorMod(galleryScrollOffset + rows, count);
  }

  private int maxGalleryScrollRows(int count, int boxW, int boxH) {
    int columns = galleryColumns(boxW);
    int visibleRows = galleryRows(boxH);
    int totalRows = Math.max(1, (count + columns - 1) / columns);
    return Math.max(0, totalRows - visibleRows);
  }

  private void drawGalleryScrollbar(GuiGraphicsExtractor graphics, int boxX, int boxY, int boxW, int boxH, int count, int columns, int rows) {
    int totalRows = Math.max(1, (count + columns - 1) / columns);
    if (totalRows <= rows) {
      return;
    }
    int trackX = boxX + boxW - 7;
    int trackY = boxY + PANEL_HEADER_HEIGHT;
    int trackH = Math.max(18, boxH - PANEL_HEADER_HEIGHT - PANEL_FOOTER_HEIGHT);
    int maxScroll = Math.max(1, totalRows - rows);
    int knobH = Math.max(14, trackH / (maxScroll + 1));
    int knobY = trackY + ((trackH - knobH) * galleryScrollOffset / maxScroll);
    graphics.fill(trackX, trackY, trackX + 3, trackY + trackH, LauncherTheme.argb(70, 0xFFFFFF));
    graphics.fill(trackX, knobY, trackX + 3, knobY + knobH, LauncherTheme.accentArgb(190));
  }

  private int[] headerButtonBounds(int[] layout, int index) {
    int x = layout[4] + layout[6] - PANEL_SIDE_PADDING;
    int y = searchY(layout);
    for (int i = 0; i <= index; i += 1) {
      int buttonW = headerButtonWidth(i);
      x -= buttonW;
      if (i == index) {
        return new int[] { x, y, buttonW, SEARCH_HEIGHT };
      }
      x -= HEADER_BUTTON_GAP;
    }
    return new int[] { x, y, headerButtonWidth(index), SEARCH_HEIGHT };
  }

  private int headerButtonWidth(int index) {
    if (index == 0) {
      return 24;
    }
    if (index == 1) {
      return 38;
    }
    return 0;
  }

  private int headerButtonsWidth() {
    return headerButtonWidth(0) + headerButtonWidth(1) + HEADER_BUTTON_GAP;
  }

  private int sideTabX(int[] layout) {
    return layout[4] + 16;
  }

  private int sideTabY(int[] layout) {
    return layout[5] + 44;
  }

  private int[] sideTabBounds(int[] layout, int index) {
    int x = sideTabX(layout);
    int y = sideTabY(layout);
    return new int[] { x + (index * (SIDE_TAB_WIDTH + SIDE_TAB_BUTTON_GAP)), y, SIDE_TAB_WIDTH, SIDE_TAB_HEIGHT };
  }

  private boolean handleSideTabClick(double mouseX, double mouseY, int[] layout) {
    for (int index = 0; index < 2; index += 1) {
      int[] bounds = sideTabBounds(layout, index);
      if (!isInside(mouseX, mouseY, bounds[0] - 3, bounds[1] - 3, bounds[2] + 6, bounds[3] + 6)) {
        continue;
      }
      if (index == 0) {
        openHomePanel();
      } else {
        openTab("shop");
      }
      return true;
    }
    return false;
  }

  private int headerGroupWidth() {
    return headerButtonsWidth() + HEADER_BUTTON_GAP + (HEADER_FILTER_WIDTH * 3) + (HEADER_BUTTON_GAP * 2);
  }

  private int[] bottomTabBounds(int[] layout, int index, int count) {
    int available = Math.max(80, layout[6] - (PANEL_SIDE_PADDING * 2));
    int gap = 8;
    int w = Math.max(44, (available - (gap * (count - 1))) / count);
    int x = layout[4] + PANEL_SIDE_PADDING + (index * (w + gap));
    int y = layout[5] + layout[7] - 32;
    return new int[] { x, y, w, 24 };
  }

  private boolean handleBottomTabClick(double mouseX, double mouseY, int[] layout) {
    for (int index = 0; index < 4; index += 1) {
      int[] bounds = bottomTabBounds(layout, index, 4);
      if (!isInside(mouseX, mouseY, bounds[0] - 3, bounds[1] - 3, bounds[2] + 6, bounds[3] + 6)) {
        continue;
      }
      if (index == 0) {
        openHomePanel();
      } else if (index == 1) {
        openTab("pvp");
      } else if (index == 2) {
        openTab("hud");
      } else {
        openTab("social");
      }
      return true;
    }
    return false;
  }

  private void openHomePanel() {
    activeTab = "all";
    searchQuery = "";
    selectedIndex = -1;
    searchFocused = false;
    capturingKey = false;
    uiEditorMode = false;
    galleryMode = false;
    pendingRemoveFriendUuid = null;
    scrollOffset = 0;
  }

  private void openFriendsPanel() {
    activeTab = "friends";
    searchQuery = "";
    searchFocused = false;
    capturingKey = false;
    uiEditorMode = false;
    galleryMode = false;
    pendingRemoveFriendUuid = null;
    int index = moduleIndex("friends");
    if (index >= 0) {
      selectedIndex = index;
    }
  }

  private void openTab(String tab) {
    activeTab = tab;
    searchQuery = "";
    selectedIndex = -1;
    searchFocused = false;
    capturingKey = false;
    uiEditorMode = false;
    galleryMode = false;
    pendingRemoveFriendUuid = null;
    scrollOffset = 0;
  }

  private int moduleIndex(String id) {
    for (int index = 0; index < MenuModules.modules().length; index += 1) {
      if (MenuModules.modules()[index].id.equals(id)) {
        return index;
      }
    }
    return -1;
  }

  private boolean handleUiEditorClick(double mouseX, double mouseY) {
    if (isInside(mouseX, mouseY, (width - 42) / 2, Math.max(8, height - 24), 42, 16)) {
      uiEditorMode = false;
      draggingOverlay = null;
      selectedOverlay = null;
      resizingOverlay = false;
      OverlaySettings.flush();
      return true;
    }
    String hit = overlayAt(mouseX, mouseY);
    if (hit != null) {
      int[] bounds = overlayBounds(hit, overlayText(hit));
      selectedOverlay = hit;
      draggingOverlay = hit;
      resizingOverlay = false;
      dragOffsetX = (int) mouseX - bounds[0];
      dragOffsetY = (int) mouseY - bounds[1];
      dragStartX = bounds[0];
      dragStartY = bounds[1];
      return true;
    }
    draggingOverlay = null;
    selectedOverlay = null;
    resizingOverlay = false;
    return true;
  }

  private void updateUiDrag(double mouseX, double mouseY) {
    if (draggingOverlay == null) {
      return;
    }
    int[] bounds = overlayBounds(draggingOverlay, overlayText(draggingOverlay));
    int nextX = clampInt((int) mouseX - dragOffsetX, 0, Math.max(0, width - bounds[2]));
    int nextY = clampInt((int) mouseY - dragOffsetY, 0, Math.max(0, height - bounds[3]));
    // Store the reference width at the right edge. The actual coordinate text
    // can grow or shrink without changing the saved position away from it.
    if (nextX + bounds[2] >= width - 1) {
      int[] base = overlayBaseBounds(draggingOverlay, OverlaySettings.size(draggingOverlay));
      nextX = Math.max(0, width - base[2]);
    }
    OverlaySettings.setPosition(draggingOverlay, nextX, nextY);
  }

  private void finishUiDrag() {
    if (draggingOverlay != null && overlayOverlaps(draggingOverlay, OverlaySettings.x(draggingOverlay), OverlaySettings.y(draggingOverlay), OverlaySettings.size(draggingOverlay))) {
      OverlaySettings.setPosition(draggingOverlay, dragStartX, dragStartY);
    }
  }

  private String overlayAt(double mouseX, double mouseY) {
    String[] ids = { "effects", "sounddisplay", "armor", "uptimer", "clock", "cps", "keys", "nethercoords", "coords", "fps" };
    for (String id : ids) {
      int[] bounds = overlayBounds(id, overlayText(id));
      if (isInside(mouseX, mouseY, bounds[0], bounds[1], bounds[2], bounds[3])) {
        return id;
      }
    }
    return null;
  }

  private int[] overlayBounds(String id, String text) {
    int size = OverlaySettings.size(id);
    return overlayBoundsForStoredPosition(id, text, OverlaySettings.x(id), OverlaySettings.y(id), size);
  }

  private int[] overlayBoundsForStoredPosition(String id, String text, int savedX, int savedY, int size) {
    int[] raw = overlayBoundsAt(id, text, 0, 0, size);
    int x;
    if (savedX <= 1) {
      x = 0;
    } else if (savedX + overlayBaseBounds(id, size)[2] >= width - 1) {
      x = Math.max(0, width - raw[2]);
    } else {
      x = clampInt(savedX, 0, Math.max(0, width - raw[2]));
    }
    int y = clampInt(savedY, 0, Math.max(0, height - raw[3]));
    return overlayBoundsAt(id, text, x, y, size);
  }

  private int[] overlayBaseBounds(String id, int size) {
    return overlayBoundsAt(id, overlayAnchorText(id), 0, 0, size);
  }

  private String overlayAnchorText(String id) {
    return switch (id) {
      case "fps" -> "FPS 144";
      case "coords" -> "120 64 -32";
      case "nethercoords" -> "NETHER 15 -4";
      case "clock" -> "TIME 12:00";
      case "uptimer" -> "00:00:00";
      case "sounddisplay" -> "Footsteps";
      case "effects" -> "Speed II 1:30";
      default -> overlayText(id);
    };
  }

  private int[] overlayBoundsAt(String id, String text, int x, int y, int size) {
    if ("keys".equals(id)) {
      int key = Math.max(4, 13 + (size * 3)), gap = Math.max(1, 2 + size), pad = Math.max(0, 3 + size);
      int w = (key * 3) + (gap * 2) + (pad * 2);
      int h = (key * 2) + (gap * 2) + Math.max(8, key - 4) + (pad * 2);
      return new int[] { x, y, w, h };
    }
    if ("armor".equals(id)) {
      int slot = 18 + size, gap = 2;
      int w = (slot * 4) + (gap * 3) + 4;
      int h = slot + 7;
      return new int[] { x, y, w, h };
    }
    if ("inventory".equals(id)) {
      int slot = 18, gap = 1;
      return new int[] { x, y, (slot * 9) + (gap * 8) + 4, slot + 4 };
    }
    if ("sounddisplay".equals(id)) {
      return new int[] { x, y, 92 + (size * 4), 30 + (size * 2) };
    }
    if ("effects".equals(id)) {
      return new int[] { x, y, 106 + (size * 4), 30 + (size * 2) };
    }
    if ("cps".equals(id)) {
      int wasdKey = Math.max(4, 13 + (size * 3)), wasdGap = Math.max(1, 2 + size), wasdPadding = Math.max(0, 3 + size);
      int w = (wasdKey * 3) + (wasdGap * 2) + (wasdPadding * 2);
      return new int[] { x, y, w, 14 };
    }
    int textScale = OverlaySettings.textSize(id);
    int paddingX = Math.max(1, 4 + (size * 2)), paddingY = Math.max(1, 2 + size);
    int w = Math.max(12, Math.max(34 + (size * 3), textWidth(text) + (paddingX * 2) + (size * 2) + ((textScale - 1) * 5)));
    int h = Math.max(6, 10 + (paddingY * 2) + ((size - 1) * 3) + ((textScale - 1) * 2));
    return new int[] { x, y, w, h };
  }

  private boolean overlayOverlaps(String id, int nextX, int nextY, int nextSize) {
    int[] next = overlayBoundsForStoredPosition(id, overlayText(id), nextX, nextY, nextSize);
    String[] ids = { "effects", "sounddisplay", "armor", "uptimer", "clock", "cps", "keys", "nethercoords", "coords", "fps" };
    for (String other : ids) {
      if (other.equals(id)) {
        continue;
      }
      int[] current = overlayBounds(other, overlayText(other));
      if (rectanglesOverlap(next, current)) {
        return true;
      }
    }
    return false;
  }

  private boolean rectanglesOverlap(int[] a, int[] b) {
    return a[0] < b[0] + b[2] && a[0] + a[2] > b[0] && a[1] < b[1] + b[3] && a[1] + a[3] > b[1];
  }

  private String overlayText(String id) {
    return switch (id) {
      case "fps" -> "FPS 144";
      case "coords" -> liveCoordsText();
      case "nethercoords" -> liveNetherCoordsText();
      case "cps" -> "";
      case "clock" -> "TIME 12:00";
      case "uptimer" -> "00:00:00";
      case "effects" -> "Speed II 1:30";
      case "armor" -> "ARMOR 100% 429";
      case "inventory" -> "INVENTORY 9 SLOTS";
      case "combo" -> "COMBO 4 | BEST 8";
      case "session" -> "SESSION 12:34 | 1.2 km | HITS 24";
      default -> "";
    };
  }

  private boolean overlayEnabled(String id) {
    for (MenuModules.Module module : MenuModules.modules()) {
      if (module.id.equals(id)) {
        return module.enabled;
      }
    }
    return false;
  }

  private String liveCoordsText() {
    try {
      LocalPlayer player = Minecraft.getInstance().player;
      if (player != null) return (int)Math.floor(player.getX()) + " " + (int)Math.floor(player.getY()) + " " + (int)Math.floor(player.getZ());
    } catch (Throwable ignored) { }
    return "120 64 -32";
  }

  private String liveNetherCoordsText() {
    try {
      Minecraft client = Minecraft.getInstance();
      LocalPlayer player = client.player;
      if (player != null) {
        int x = (int)Math.floor(player.getX()), z = (int)Math.floor(player.getZ());
        boolean inNether = String.valueOf(client.level.dimension()).toLowerCase(java.util.Locale.ROOT).contains("nether");
        return inNether ? "OVERWORLD " + (x * 8) + " " + (z * 8) : "NETHER " + Math.floorDiv(x, 8) + " " + Math.floorDiv(z, 8);
      }
    } catch (Throwable ignored) { }
    return "NETHER 15 -4";
  }

  private int textWidth(String text) {
    if (text == null) return 0;
    try {
      Minecraft client = Minecraft.getInstance();
      if (client != null && client.font != null) return client.font.width(text);
    } catch (Throwable ignored) { }
    return text.length() * 6;
  }

  private int clampInt(int value, int min, int max) {
    return Math.max(min, Math.min(max, value));
  }

  private int hitModule(double mouseX, double mouseY) {
    int[] layout = layout();
    int columns = layout[8];
    int tileWidth = layout[9];
    int startX = layout[0];
    int startY = layout[1];

    int visibleIndex = 0;
    int matchedIndex = 0;
    int firstVisibleIndex = scrollOffset * columns;
    for (int index = 0; index < MenuModules.modules().length; index += 1) {
      if (!matchesModule(MenuModules.modules()[index])) {
        continue;
      }
      if (matchedIndex < firstVisibleIndex) {
        matchedIndex += 1;
        continue;
      }
      int column = visibleIndex % columns;
      int row = visibleIndex / columns;
      int x = startX + (column * (tileWidth + GAP));
      int y = startY + (row * tileRowStep());
      if (visibleIndex >= maxVisibleTiles(layout)) {
        return -1;
      }
      if (isInside(mouseX, mouseY, x, y, tileWidth, TILE_LABEL_HEIGHT + TILE_HEIGHT)) {
        return index;
      }
      visibleIndex += 1;
      matchedIndex += 1;
    }
    return -1;
  }

  private int visibleCount() {
    int count = 0;
    for (MenuModules.Module module : MenuModules.modules()) {
      if (matchesModule(module)) {
        count += 1;
      }
    }
    return count;
  }

  private boolean matchesModule(MenuModules.Module module) {
    if (!MenuModules.isUnlocked(module.id)) {
      return false;
    }
    if (!matchesActiveTab(module)) {
      return false;
    }
    String query = normalize(searchQuery);
    return query.isEmpty()
        || normalize(module.title).contains(query)
        || normalize(module.subtitle).contains(query)
        || normalize(module.id).contains(query);
  }

  private boolean matchesActiveTab(MenuModules.Module module) {
    if ("shop".equals(activeTab)) {
      return false;
    }
    if ("favorites".equals(activeTab)) {
      return MenuModules.isFavorite(module.id);
    }
    if ("pvp".equals(activeTab)) {
      return "zoom".equals(module.id) || "sprint".equals(module.id) || "nobob".equals(module.id)
          || "bright".equals(module.id) || "weather".equals(module.id) || "time".equals(module.id) || "trajectory".equals(module.id) || "hitboxes".equals(module.id) || "xray".equals(module.id) || "mobtrack".equals(module.id) || "breakspeed".equals(module.id) || "ghostblocks".equals(module.id) || "speed".equals(module.id) || "resistance".equals(module.id) || "invisibility".equals(module.id)
          || "crosshair".equals(module.id);
    }
    if ("hud".equals(activeTab)) {
      return "fps".equals(module.id) || "fakefps".equals(module.id) || "coords".equals(module.id) || "keys".equals(module.id)
          || "cps".equals(module.id) || "armor".equals(module.id) || "direction".equals(module.id) || "inventory".equals(module.id) || "session".equals(module.id) || "clock".equals(module.id) || "timer".equals(module.id) || "uptimer".equals(module.id) || "smartscreenshot".equals(module.id) || "ui".equals(module.id);
    }
    if ("social".equals(activeTab)) {
      return "friends".equals(module.id);
    }
    return true;
  }

  private boolean handleSearchKey(int keyCode) {
    if (keyCode == 259) {
      if (!searchQuery.isEmpty()) {
        searchQuery = searchQuery.substring(0, searchQuery.length() - 1);
        scrollOffset = 0;
      }
      return true;
    }
    if (keyCode == 261) {
      searchQuery = "";
      scrollOffset = 0;
      return true;
    }
    if (keyCode == 256 && !searchQuery.isEmpty()) {
      searchQuery = "";
      scrollOffset = 0;
      return true;
    }
    if (keyCode == 256 && searchFocused) {
      searchFocused = false;
      return true;
    }
    return false;
  }

  private boolean appendSearchKey(int keyCode) {
    if (searchQuery.length() >= 20) {
      return true;
    }
    if (keyCode >= 65 && keyCode <= 90) {
      char value = Character.toLowerCase((char) keyCode);
      searchQuery = searchQuery + value;
      lastSearchFallbackChar = value;
      lastSearchFallbackMs = System.currentTimeMillis();
      scrollOffset = 0;
      return true;
    }
    if (keyCode >= 48 && keyCode <= 57) {
      char value = (char) keyCode;
      searchQuery = searchQuery + value;
      lastSearchFallbackChar = value;
      lastSearchFallbackMs = System.currentTimeMillis();
      scrollOffset = 0;
      return true;
    }
    if (keyCode == 32 && !searchQuery.endsWith(" ")) {
      searchQuery = searchQuery + " ";
      lastSearchFallbackChar = ' ';
      lastSearchFallbackMs = System.currentTimeMillis();
      scrollOffset = 0;
      return true;
    }
    return false;
  }

  private boolean appendSearchText(String text) {
    if (text == null || text.isBlank() || searchQuery.length() >= 20) {
      return false;
    }
    String safe = text.trim();
    if (safe.length() == 1
        && Character.toLowerCase(safe.charAt(0)) == lastSearchFallbackChar
        && System.currentTimeMillis() - lastSearchFallbackMs < 90L) {
      return true;
    }
    searchQuery = searchQuery + safe.toLowerCase(java.util.Locale.ROOT);
    scrollOffset = 0;
    return true;
  }

  private static int keyModifiers(Object event) {
    int modifiers = readKeyModifiers(event);
    if (modifiers != 0) {
      return modifiers & (MOD_SHIFT | MOD_CONTROL | MOD_ALT | MOD_SUPER);
    }
    Minecraft client = Minecraft.getInstance();
    if (client == null) {
      return 0;
    }
    int liveModifiers = 0;
    if (XLauncherMenuClient.isKeyDown(client, 340) || XLauncherMenuClient.isKeyDown(client, 344)) {
      liveModifiers |= MOD_SHIFT;
    }
    if (XLauncherMenuClient.isKeyDown(client, 341) || XLauncherMenuClient.isKeyDown(client, 345)) {
      liveModifiers |= MOD_CONTROL;
    }
    if (XLauncherMenuClient.isKeyDown(client, 342) || XLauncherMenuClient.isKeyDown(client, 346)) {
      liveModifiers |= MOD_ALT;
    }
    if (XLauncherMenuClient.isKeyDown(client, 343) || XLauncherMenuClient.isKeyDown(client, 347)) {
      liveModifiers |= MOD_SUPER;
    }
    return liveModifiers;
  }

  private static int readKeyModifiers(Object event) {
    if (event == null) {
      return 0;
    }
    for (String methodName : new String[] { "modifiers", "getModifiers", "mods", "modifier" }) {
      try {
        java.lang.reflect.Method method = event.getClass().getMethod(methodName);
        Object value = method.invoke(event);
        if (value instanceof Number) {
          return ((Number) value).intValue();
        }
      } catch (ReflectiveOperationException | RuntimeException ignored) {
      }
    }
    return 0;
  }

  private static boolean isClearKey(int keyCode) {
    return keyCode == 256 || keyCode == 259 || keyCode == 261;
  }

  private static boolean isModifierKey(int keyCode) {
    return keyCode == 340 || keyCode == 344
        || keyCode == 341 || keyCode == 345
        || keyCode == 342 || keyCode == 346
        || keyCode == 343 || keyCode == 347;
  }

  private static String keyComboLabel(int keyCode, int keyModifiers) {
    if (keyCode <= 0) {
      return "Key";
    }
    StringBuilder label = new StringBuilder();
    int modifiers = normalizeKeyModifiers(keyCode, keyModifiers);
    appendModifierLabel(label, modifiers, MOD_CONTROL, "CTRL");
    appendModifierLabel(label, modifiers, MOD_SHIFT, "SHIFT");
    appendModifierLabel(label, modifiers, MOD_ALT, "ALT");
    appendModifierLabel(label, modifiers, MOD_SUPER, "WIN");
    appendKeyLabel(label, keyName(keyCode));
    return label.toString();
  }

  private static int normalizeKeyModifiers(int keyCode, int keyModifiers) {
    int modifiers = keyModifiers & (MOD_SHIFT | MOD_CONTROL | MOD_ALT | MOD_SUPER);
    if (keyCode == 340 || keyCode == 344) {
      modifiers &= ~MOD_SHIFT;
    } else if (keyCode == 341 || keyCode == 345) {
      modifiers &= ~MOD_CONTROL;
    } else if (keyCode == 342 || keyCode == 346) {
      modifiers &= ~MOD_ALT;
    } else if (keyCode == 343 || keyCode == 347) {
      modifiers &= ~MOD_SUPER;
    }
    return modifiers;
  }

  private static void appendModifierLabel(StringBuilder label, int modifiers, int bit, String value) {
    if ((modifiers & bit) != 0) {
      appendKeyLabel(label, value);
    }
  }

  private static void appendKeyLabel(StringBuilder label, String value) {
    if (label.length() > 0) {
      label.append("+");
    }
    label.append(value);
  }

  private static String keyName(int keyCode) {
    if (keyCode <= 0) {
      return "None";
    }
    if (keyCode >= 65 && keyCode <= 90) {
      return String.valueOf((char) keyCode);
    }
    if (keyCode >= 48 && keyCode <= 57) {
      return String.valueOf((char) keyCode);
    }
    return switch (keyCode) {
      case 32 -> "SPACE";
      case 340 -> "L-SHIFT";
      case 341 -> "L-CTRL";
      case 342 -> "L-ALT";
      case 343 -> "L-WIN";
      case 344 -> "R-SHIFT";
      case 345 -> "R-CTRL";
      case 346 -> "R-ALT";
      case 347 -> "R-WIN";
      case 257 -> "ENTER";
      case 258 -> "TAB";
      default -> "KEY " + keyCode;
    };
  }

  private static String normalize(String value) {
    return value == null ? "" : value.trim().toLowerCase(java.util.Locale.ROOT);
  }

  private static String fitLabel(String value, int width) {
    // Never silently replace readable menu text with '~'. Layouts that need
    // multiple lines use drawDescription; compact controls retain full labels.
    return value == null ? "" : value;
  }

  private static boolean isInside(double mouseX, double mouseY, int x, int y, int w, int h) {
    return mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + h;
  }

  private static void roundedFill(GuiGraphicsExtractor graphics, int x, int y, int w, int h, int color) {
    if (w <= 4 || h <= 4) {
      graphics.fill(x, y, x + w, y + h, color);
      return;
    }
    graphics.fill(x + 2, y, x + w - 2, y + h, color);
    graphics.fill(x + 1, y + 1, x + w - 1, y + h - 1, color);
    graphics.fill(x, y + 2, x + w, y + h - 2, color);
  }

  private static void border(GuiGraphicsExtractor graphics, int x, int y, int w, int h, int color) {
    if (w <= 4 || h <= 4) {
      graphics.fill(x, y, x + w, y + 1, color);
      graphics.fill(x, y + h - 1, x + w, y + h, color);
      graphics.fill(x, y, x + 1, y + h, color);
      graphics.fill(x + w - 1, y, x + w, y + h, color);
      return;
    }
    graphics.fill(x + 2, y, x + w - 2, y + 1, color);
    graphics.fill(x + 2, y + h - 1, x + w - 2, y + h, color);
    graphics.fill(x, y + 2, x + 1, y + h - 2, color);
    graphics.fill(x + w - 1, y + 2, x + w, y + h - 2, color);
    graphics.fill(x + 1, y + 1, x + 2, y + 2, color);
    graphics.fill(x + w - 2, y + 1, x + w - 1, y + 2, color);
    graphics.fill(x + 1, y + h - 2, x + 2, y + h - 1, color);
    graphics.fill(x + w - 2, y + h - 2, x + w - 1, y + h - 1, color);
  }
}
`
};

