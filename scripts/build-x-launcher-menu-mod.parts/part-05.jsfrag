    drawOverlayPreview(graphics, font, "coords", overlayText("coords"), mouseX, mouseY);
    drawOverlayPreview(graphics, font, "nethercoords", overlayText("nethercoords"), mouseX, mouseY);
    drawOverlayPreview(graphics, font, "keys", "", mouseX, mouseY);
    drawOverlayPreview(graphics, font, "cps", "", mouseX, mouseY);
    drawOverlayPreview(graphics, font, "clock", "TIME 12:00", mouseX, mouseY);
    drawOverlayPreview(graphics, font, "uptimer", "00:00:00", mouseX, mouseY);
    drawOverlayPreview(graphics, font, "armor", "ARMOR 100% 429", mouseX, mouseY);
    drawOverlayPreview(graphics, font, "sounddisplay", "Footsteps", mouseX, mouseY);
    drawOverlayPreview(graphics, font, "effects", "Speed II 1:30", mouseX, mouseY);
  }

  private void drawScreenshotGallery(GuiGraphicsExtractor graphics, Font font, int mouseX, int mouseY) {
    drawBlurBackdrop(graphics);
    java.util.List<ScreenshotGallery.Entry> entries = ScreenshotGallery.entries(Minecraft.getInstance());
    clampGalleryScroll(entries.size(), width, height);
    int[] home = galleryHomeBounds();
    int[] save = gallerySaveBounds();

    if (entries.isEmpty()) {
      graphics.fill(0, 0, width, height, LauncherTheme.argb(112, 0x000000));
      graphics.centeredText(font, ScreenshotGallery.isLoading() ? "Lade Screenshots..." : "Noch keine Screenshots.", width / 2, height / 2 - 6, LauncherTheme.textColor());
      drawGalleryControlButton(graphics, font, home, "Home", true);
      return;
    }

    ScreenshotGallery.Entry entry = entries.get(galleryScrollOffset);
    if (entries.size() > 1) {
      ScreenshotGallery.textureId(entries.get(Math.floorMod(galleryScrollOffset - 1, entries.size())), Minecraft.getInstance());
      ScreenshotGallery.textureId(entries.get(Math.floorMod(galleryScrollOffset + 1, entries.size())), Minecraft.getInstance());
    }
    boolean drawn = drawGalleryTexture(graphics, entry, 0, 0, width, height);
    if (!drawn) {
      graphics.fill(0, 0, width, height, LauncherTheme.argb(128, 0x000000));
      graphics.centeredText(font, "Lade Screenshot...", width / 2, height / 2 - 6, LauncherTheme.textColor());
    }
    graphics.fill(0, 0, width, 36, LauncherTheme.argb(132, 0x000000));
    graphics.fill(0, height - 28, width, height, LauncherTheme.argb(104, 0x000000));
    drawGalleryControlButton(graphics, font, home, "Home", true);
    drawGalleryControlButton(graphics, font, save, "Save", true);
    boolean hasMultiple = entries.size() > 1;
    int[] left = galleryLeftArrowBounds();
    int[] right = galleryRightArrowBounds();
    drawGalleryArrow(graphics, font, left, "<", hasMultiple, isInside(mouseX, mouseY, left[0], left[1], left[2], left[3]));
    drawGalleryArrow(graphics, font, right, ">", hasMultiple, isInside(mouseX, mouseY, right[0], right[1], right[2], right[3]));
  }

  private void drawGalleryArrow(GuiGraphicsExtractor graphics, Font font, int[] bounds, String label, boolean active, boolean hovered) {
    int fill = active ? (hovered ? LauncherTheme.accentArgb(176) : LauncherTheme.argb(118, 0x000000)) : LauncherTheme.argb(62, 0x000000);
    int stroke = active ? (hovered ? LauncherTheme.accentArgb(235) : LauncherTheme.argb(160, 0xFFFFFF)) : LauncherTheme.argb(78, 0xFFFFFF);
    roundedFill(graphics, bounds[0] + 2, bounds[1] + 2, bounds[2], bounds[3], LauncherTheme.argb(88, 0x000000));
    roundedFill(graphics, bounds[0], bounds[1], bounds[2], bounds[3], fill);
    border(graphics, bounds[0], bounds[1], bounds[2], bounds[3], stroke);
    graphics.centeredText(font, label, bounds[0] + (bounds[2] / 2), bounds[1] + (bounds[3] / 2) - 4, active ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor());
  }

  private void drawGalleryCard(GuiGraphicsExtractor graphics, Font font, ScreenshotGallery.Entry entry, int x, int y, int w, int h, boolean hovered) {
    roundedFill(graphics, x + 1, y + 1, w, h, LauncherTheme.argb(70, 0x000000));
    roundedFill(graphics, x, y, w, h, hovered ? LauncherTheme.argb(214, 0x202A33) : LauncherTheme.argb(184, 0x1A1A1A));
    graphics.fill(x + 2, y, x + w - 2, y + 1, hovered ? LauncherTheme.accentArgb(220) : LauncherTheme.argb(95, 0x2A2A2A));
    border(graphics, x, y, w, h, hovered ? LauncherTheme.accentArgb(225) : LauncherTheme.argb(145, 0x2A2A2A));
    int thumbX = x + 5;
    int thumbY = y + 5;
    int thumbW = Math.max(32, w - 10);
    int thumbH = Math.max(16, h - 10);
    drawGalleryThumbnail(graphics, entry, thumbX, thumbY, thumbW, thumbH);
  }

  private void drawGalleryThumbnail(GuiGraphicsExtractor graphics, ScreenshotGallery.Entry entry, int x, int y, int w, int h) {
    roundedFill(graphics, x, y, w, h, LauncherTheme.argb(120, 0x081018));
    drawGalleryTexture(graphics, entry, x, y, w, h);
    border(graphics, x, y, w, h, LauncherTheme.accentArgb(145));
  }

  private void drawGalleryViewer(GuiGraphicsExtractor graphics, Font font, ScreenshotGallery.Entry entry) {
    drawBlurBackdrop(graphics);
    int boxX = Math.max(6, Math.min(14, width / 18));
    int boxY = Math.max(6, Math.min(14, height / 18));
    int boxW = Math.max(180, width - (boxX * 2));
    int boxH = Math.max(150, height - (boxY * 2));
    roundedFill(graphics, boxX + 4, boxY + 5, boxW, boxH, LauncherTheme.argb(118, 0x000000));
    roundedFill(graphics, boxX, boxY, boxW, boxH, LauncherTheme.argb(238, 0x050505));
    roundedFill(graphics, boxX + 1, boxY + 1, boxW - 2, boxH - 2, LauncherTheme.argb(178, 0x101010));
    graphics.fill(boxX + 2, boxY, boxX + boxW - 2, boxY + 2, LauncherTheme.accentArgb(232));
    border(graphics, boxX, boxY, boxW, boxH, LauncherTheme.accentArgb(170));
    drawButton(graphics, font, boxX + PANEL_SIDE_PADDING, boxY + 8, 54, 20, "Back", true);
    int sourceW = entry.width > 0 ? entry.width : 16;
    int sourceH = entry.height > 0 ? entry.height : 9;
    int maxW = Math.max(80, boxW - 24);
    int maxH = Math.max(60, boxH - 50);
    double scale = Math.min(maxW / (double) sourceW, maxH / (double) sourceH);
    int imageW = Math.max(1, (int) Math.round(sourceW * scale));
    int imageH = Math.max(1, (int) Math.round(sourceH * scale));
    int imageX = boxX + ((boxW - imageW) / 2);
    int imageY = boxY + 34 + ((maxH - imageH) / 2);
    graphics.fill(imageX - 2, imageY - 2, imageX + imageW + 2, imageY + imageH + 2, LauncherTheme.argb(150, 0x000000));
    drawGalleryTexture(graphics, entry, imageX, imageY, imageW, imageH);
    border(graphics, imageX - 2, imageY - 2, imageW + 4, imageH + 4, LauncherTheme.accentArgb(160));
  }

  private boolean drawGalleryTexture(Object graphics, ScreenshotGallery.Entry entry, int x, int y, int w, int h) {
    Object texture = ScreenshotGallery.textureId(entry, Minecraft.getInstance());
    if (texture == null) {
      return false;
    }
    int sourceW = Math.max(1, entry.width);
    int sourceH = Math.max(1, entry.height);
    double sourceAspect = sourceW / (double) sourceH;
    double frameAspect = Math.max(1, w) / (double) Math.max(1, h);
    int srcX = 0;
    int srcY = 0;
    int srcW = sourceW;
    int srcH = sourceH;
    if (sourceAspect > frameAspect) {
      srcW = Math.min(sourceW, Math.max(1, (int) Math.round(sourceH * frameAspect)));
      srcX = Math.max(0, (sourceW - srcW) / 2);
    } else if (sourceAspect < frameAspect) {
      srcH = Math.min(sourceH, Math.max(1, (int) Math.round(sourceW / frameAspect)));
      srcY = Math.max(0, (sourceH - srcH) / 2);
    }
    float u0 = srcX / (float) sourceW;
    float u1 = (srcX + srcW) / (float) sourceW;
    float v0 = srcY / (float) sourceH;
    float v1 = (srcY + srcH) / (float) sourceH;
    for (java.lang.reflect.Method method : graphics.getClass().getMethods()) {
      Class<?>[] types = method.getParameterTypes();
      if (types.length == 9 && types[0].isInstance(texture)
          && types[1] == Integer.TYPE && types[2] == Integer.TYPE && types[3] == Integer.TYPE && types[4] == Integer.TYPE
          && types[5] == Float.TYPE && types[6] == Float.TYPE && types[7] == Float.TYPE && types[8] == Float.TYPE) {
        try {
          method.invoke(graphics, texture, x, y, w, h, u0, u1, v0, v1);
          return true;
        } catch (Throwable ignored) {
          // Try another compatible blit method.
        }
      }
    }
    Object pipeline = renderPipeline();
    if (pipeline == null) {
      return false;
    }
    for (java.lang.reflect.Method method : graphics.getClass().getMethods()) {
      Class<?>[] types = method.getParameterTypes();
      if (types.length < 10 || !types[0].isInstance(pipeline) || !types[1].isInstance(texture)) {
        continue;
      }
      try {
        if (types.length == 12) {
          method.invoke(graphics, pipeline, texture, x, y, (float) srcX, (float) srcY, w, h, srcW, srcH, sourceW, sourceH);
          return true;
        }
        if (types.length == 13) {
          method.invoke(graphics, pipeline, texture, x, y, (float) srcX, (float) srcY, w, h, srcW, srcH, sourceW, sourceH, 0xFFFFFFFF);
          return true;
        }
        if (types.length == 10) {
          method.invoke(graphics, pipeline, texture, x, y, (float) srcX, (float) srcY, w, h, sourceW, sourceH);
          return true;
        }
        if (types.length == 11) {
          method.invoke(graphics, pipeline, texture, x, y, (float) srcX, (float) srcY, w, h, sourceW, sourceH, 0xFFFFFFFF);
          return true;
        }
      } catch (Throwable ignored) {
        // Try another compatible blit method.
      }
    }
    return false;
  }

  private Object renderPipeline() {
    return ScreenshotGallery.renderPipeline();
  }

  private void drawOverlayPreview(GuiGraphicsExtractor graphics, Font font, String id, String text, int mouseX, int mouseY) {
    int[] bounds = overlayBounds(id, text);
    HudOverlay.drawEditorPreview(graphics, font, id, text, bounds[0], bounds[1]);
    if (id.equals(selectedOverlay) || id.equals(draggingOverlay)) {
      border(graphics, bounds[0] - 1, bounds[1] - 1, bounds[2] + 2, bounds[3] + 2, LauncherTheme.accentArgb(255));
    } else if (isInside(mouseX, mouseY, bounds[0], bounds[1], bounds[2], bounds[3])) {
      border(graphics, bounds[0] - 1, bounds[1] - 1, bounds[2] + 2, bounds[3] + 2, LauncherTheme.argb(150, 0xDCE8F2));
    }
  }

  private void drawCpsPreview(GuiGraphicsExtractor graphics, Font font, int x, int y, int totalW) {
    int gap = 2;
    int keyW = Math.max(8, (totalW - gap) / 2);
    drawMiniKey(graphics, font, "8", x, y, keyW, 14);
    drawMiniKey(graphics, font, "4", x + keyW + gap, y, keyW, 14);
  }

  private void drawArmorPreview(GuiGraphicsExtractor graphics, Font font, int x, int y) {
    int size = OverlaySettings.size("armor");
    int slot = 18 + size;
    int gap = 2;
    int[] durabilityColors = { OverlaySettings.armorHealthyColor(), OverlaySettings.armorWarningColor(), OverlaySettings.armorCriticalColor(), OverlaySettings.armorHealthyColor() };
    for (int index = 0; index < 4; index += 1) {
      int slotX = x + 2 + (index * (slot + gap));
      int slotY = y + 2;
      graphics.fill(slotX, slotY, slotX + slot, slotY + slot, LauncherTheme.argb(220, 0x171717));
      graphics.fill(slotX + 1, slotY + 1, slotX + slot - 1, slotY + slot - 1, LauncherTheme.argb(190, 0x3A3A3A));
      graphics.fill(slotX + 2, slotY + 2, slotX + slot - 2, slotY + slot - 2, LauncherTheme.argb(178, 0x101010));
      int color = index == 0 ? 0x8EA1B3 : (index == 1 ? 0x6F8494 : (index == 2 ? 0x9A8A5D : 0x5F7689));
      graphics.fill(slotX + 6, slotY + 4, slotX + slot - 6, slotY + slot - 6, LauncherTheme.argb(190, color));
      int barY = slotY + slot + 1;
      graphics.fill(slotX + 3, barY, slotX + slot - 3, barY + 2, LauncherTheme.argb(190, 0x050505));
      graphics.fill(slotX + 3, barY, slotX + slot - 3, barY + 2, 0xFF000000 | durabilityColors[index]);
    }
  }

  private void drawWasdPreview(GuiGraphicsExtractor graphics, Font font, int x, int y) {
    int size = OverlaySettings.size("keys");
    boolean labels = size == 1;
    int key = Math.max(4, 13 + (size * 3));
    int gap = Math.max(1, 2 + size);
    int pad = Math.max(0, 3 + size);
    int innerX = x + pad;
    int innerY = y + pad;
    drawMiniKey(graphics, font, labels ? "W" : "", innerX + key + gap, innerY, key, key);
    int rowY = innerY + key + gap;
    drawMiniKey(graphics, font, labels ? "A" : "", innerX, rowY, key, key);
    drawMiniKey(graphics, font, labels ? "S" : "", innerX + key + gap, rowY, key, key);
    drawMiniKey(graphics, font, labels ? "D" : "", innerX + ((key + gap) * 2), rowY, key, key);
    int bottomY = innerY + ((key + gap) * 2);
    int spaceW = (key * 2) + gap;
    int spaceH = Math.max(8, key - 4);
    drawMiniKey(graphics, font, labels ? "SPACE" : "", innerX, bottomY, spaceW, spaceH);
    drawMiniKey(graphics, font, labels ? "LS" : "", innerX + spaceW + gap, bottomY, key, spaceH);
  }

  private void drawMiniKey(GuiGraphicsExtractor graphics, Font font, String label, int x, int y, int w, int h) {
    graphics.fill(x, y, x + w, y + h, LauncherTheme.argb(120, 0x121C25));
    border(graphics, x, y, w, h, LauncherTheme.argb(150, 0xDCE8F2));
    graphics.centeredText(font, fitLabel(label, w - 2), x + (w / 2), y + Math.max(1, (h - 8) / 2), LauncherTheme.textColor());
  }

  private void drawAdaptivePreviewText(GuiGraphicsExtractor graphics, Font font, String text, int x, int y, int color, int size) {
    graphics.text(font, text, x, y, color);
  }

  private void drawSearchBar(GuiGraphicsExtractor graphics, Font font, int[] layout) {
    int searchWidth = searchWidth(layout);
    int searchX = searchX(layout);
    int searchY = searchY(layout);
    boolean lightMode = LauncherTheme.isLightMode();
    int textBase = lightMode ? 0xFF18222B : LauncherTheme.textColor();
    int muted = lightMode ? 0xFF53616C : LauncherTheme.textColor();
    roundedFill(graphics, searchX, searchY, searchWidth, SEARCH_HEIGHT, lightMode ? 0xE6CAD4DC : LauncherTheme.argb(230, 0x000000));
    border(graphics, searchX, searchY, searchWidth, SEARCH_HEIGHT, searchFocused ? LauncherTheme.accentArgb(230) : (lightMode ? 0xD08798A4 : LauncherTheme.accentArgb(190)));
    String cursor = searchFocused && ((System.currentTimeMillis() / 500L) % 2L == 0L) ? "|" : "";
    String text = searchQuery.isBlank() ? (searchFocused ? cursor : "Suchen") : searchQuery + cursor;
    int textColor = searchQuery.isBlank() && !searchFocused ? muted : textBase;
    graphics.text(font, fitLabel(text, searchWidth - 12), searchX + 7, searchY + 6, textColor);
  }

  private void drawHeaderActions(GuiGraphicsExtractor graphics, Font font, int[] layout) {
    drawHeaderButton(graphics, font, headerButtonBounds(layout, 0), "UI", false);
    drawHeaderButton(graphics, font, headerButtonBounds(layout, 1), "▣", false);
  }

  private void drawSideTabs(GuiGraphicsExtractor graphics, Font font, int[] layout, int mouseX, int mouseY) {
    boolean lightMode = LauncherTheme.isLightMode();
    int railX = layout[4] + 12;
    int railY = layout[5] + 40;
    int railW = (SIDE_TAB_WIDTH * 2) + SIDE_TAB_BUTTON_GAP + 8;
    int railH = SIDE_TAB_HEIGHT + 8;
    roundedFill(graphics, railX, railY, railW, railH, lightMode ? 0xB8CBD5DD : LauncherTheme.argb(180, 0x000000));
    border(graphics, railX, railY, railW, railH, lightMode ? LauncherTheme.accentArgb(150) : LauncherTheme.accentArgb(150));
    drawSideTabButton(graphics, font, sideTabBounds(layout, 0), "Home", !"shop".equals(activeTab), mouseX, mouseY);
    drawSideTabButton(graphics, font, sideTabBounds(layout, 1), "Shop", "shop".equals(activeTab), mouseX, mouseY);
  }

  private void drawSideTabButton(GuiGraphicsExtractor graphics, Font font, int[] bounds, String label, boolean active, int mouseX, int mouseY) {
    boolean hovered = isInside(mouseX, mouseY, bounds[0], bounds[1], bounds[2], bounds[3]);
    boolean lightMode = LauncherTheme.isLightMode();
    int fill = active ? (lightMode ? 0xE0C6D1DA : LauncherTheme.argb(230, 0x000000)) : (hovered ? (lightMode ? 0xD8D5DEE5 : LauncherTheme.argb(205, 0x000000)) : (lightMode ? 0xB8CBD5DD : LauncherTheme.argb(180, 0x000000)));
    int line = active ? LauncherTheme.accentArgb(lightMode ? 180 : 220) : (lightMode ? 0xB08495A0 : LauncherTheme.accentArgb(170));
    int text = active ? (lightMode ? 0xFF16232C : 0xFFFFFFFF) : (lightMode ? 0xFF485661 : LauncherTheme.textColor());
    roundedFill(graphics, bounds[0], bounds[1], bounds[2], bounds[3], fill);
    border(graphics, bounds[0], bounds[1], bounds[2], bounds[3], line);
    graphics.centeredText(font, fitLabel(label.toUpperCase(java.util.Locale.ROOT), bounds[2] - 6), bounds[0] + (bounds[2] / 2), bounds[1] + 5, text);
  }

  private void drawHeaderButton(GuiGraphicsExtractor graphics, Font font, int[] bounds, String label, boolean active) {
    int x = bounds[0];
    int y = bounds[1];
    int w = bounds[2];
    int h = bounds[3];
    boolean lightMode = LauncherTheme.isLightMode();
    int fill = active ? LauncherTheme.accentArgb(lightMode ? 105 : 95) : (lightMode ? 0xD8D3DDE5 : LauncherTheme.argb(215, 0x000000));
    int line = active ? LauncherTheme.accentArgb(220) : (lightMode ? 0xC08495A0 : LauncherTheme.accentArgb(190));
    int glyph = active ? (lightMode ? 0xFF111820 : 0xFFFFFFFF) : (lightMode ? 0xFF46545F : LauncherTheme.textColor());
    roundedFill(graphics, x + 2, y + 2, w, h, lightMode ? 0x30000000 : 0x66000000);
    roundedFill(graphics, x, y, w, h, fill);
    border(graphics, x, y, w, h, line);
    if ("▣".equals(label)) {
      int iconSize = 12;
      int iconX = x + ((w - iconSize) / 2);
      int iconY = y + ((h - iconSize) / 2);
      border(graphics, iconX, iconY, iconSize, iconSize, glyph);
      graphics.fill(iconX + 3, iconY + 3, iconX + iconSize - 3, iconY + iconSize - 3, glyph);
      return;
    }
    graphics.centeredText(font, fitLabel(label, w - 6), x + (w / 2), y + 6, glyph);
  }

  private void drawHeaderPixelIcon(GuiGraphicsExtractor graphics, int[] bounds, boolean star, boolean active) {
    int x = bounds[0], y = bounds[1], w = bounds[2], h = bounds[3];
    boolean light = LauncherTheme.isLightMode();
    roundedFill(graphics, x, y, w, h, active ? LauncherTheme.accentArgb(95) : (light ? 0xD8D3DDE5 : LauncherTheme.argb(215, 0x000000)));
    border(graphics, x, y, w, h, active ? LauncherTheme.accentArgb(220) : LauncherTheme.accentArgb(175));
    int cx = x + (w / 2), cy = y + (h / 2), color = active ? LauncherTheme.textOnAccentColor() : LauncherTheme.textColor();
    Object texture = star ? FAVORITE_STAR_TEXTURE : PICTURES_SQUARE_TEXTURE;
    int sourceSize = star ? 1200 : 800;
    if (drawTexture(graphics, texture, cx - 6, cy - 6, 12, 12, sourceSize, sourceSize)) {
      return;
    }
    if (star) {
      graphics.fill(cx - 1, cy - 6, cx + 2, cy + 7, color);
      graphics.fill(cx - 6, cy - 1, cx + 7, cy + 2, color);
      graphics.fill(cx - 4, cy - 4, cx + 5, cy + 5, color);
      graphics.fill(cx - 2, cy + 4, cx + 3, cy + 7, color);
    } else {
      border(graphics, cx - 6, cy - 5, 12, 10, color);
      graphics.fill(cx - 4, cy + 1, cx - 1, cy + 4, color);
      graphics.fill(cx - 1, cy - 1, cx + 2, cy + 4, color);
      graphics.fill(cx + 2, cy - 3, cx + 5, cy + 4, color);
    }
  }

  private void drawGalleryControlButton(GuiGraphicsExtractor graphics, Font font, int[] bounds, String label, boolean active) {
    int x = bounds[0];
    int y = bounds[1];
    int w = bounds[2];
    int h = bounds[3];
    int fill = active ? LauncherTheme.accentArgb(105) : LauncherTheme.argb(130, 0x1A1A1A);
    int glyph = active ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor();
    roundedFill(graphics, x + 2, y + 2, w, h, LauncherTheme.argb(65, 0x000000));
    roundedFill(graphics, x, y, w, h, fill);
    border(graphics, x, y, w, h, active ? LauncherTheme.accentArgb(215) : LauncherTheme.argb(145, 0x2A2A2A));
    graphics.centeredText(font, fitLabel(label, w - 6), x + (w / 2), y + 6, glyph);
  }

  private void drawMenuButtonIcon(GuiGraphicsExtractor graphics, String icon, int x, int y, int color, int accent) {
    String key = icon == null ? "" : icon.toLowerCase();
    if ("layout".equals(key)) {
      graphics.fill(x + 1, y + 1, x + 7, y + 7, color);
      graphics.fill(x + 9, y + 1, x + 15, y + 7, color);
      graphics.fill(x + 1, y + 9, x + 7, y + 15, color);
      graphics.fill(x + 9, y + 9, x + 15, y + 15, color);
      return;
    }
    if ("home".equals(key)) {
      graphics.fill(x + 7, y + 3, x + 9, y + 4, color);
      graphics.fill(x + 5, y + 4, x + 11, y + 5, color);
      graphics.fill(x + 3, y + 5, x + 13, y + 7, color);
      graphics.fill(x + 2, y + 7, x + 14, y + 8, color);
      graphics.fill(x + 4, y + 8, x + 12, y + 14, color);
      return;
    }
    if ("shop".equals(key)) {
      graphics.fill(x + 5, y + 1, x + 13, y + 3, color);
      graphics.fill(x + 3, y + 3, x + 7, y + 5, color);
      graphics.fill(x + 3, y + 5, x + 11, y + 7, color);
      graphics.fill(x + 5, y + 7, x + 13, y + 9, color);
      graphics.fill(x + 9, y + 9, x + 13, y + 12, color);
      graphics.fill(x + 4, y + 12, x + 13, y + 14, color);
      graphics.fill(x + 3, y + 14, x + 10, y + 15, color);
      return;
    }
    if ("gallery".equals(key)) {
      border(graphics, x + 1, y + 1, 14, 14, color);
      graphics.fill(x + 4, y + 4, x + 8, y + 8, accent);
      graphics.fill(x + 4, y + 10, x + 13, y + 14, color);
      return;
    }
    if ("save".equals(key)) {
      graphics.fill(x + 2, y + 2, x + 14, y + 14, color);
      graphics.fill(x + 5, y + 4, x + 11, y + 7, accent);
      graphics.fill(x + 5, y + 10, x + 11, y + 14, accent);
      return;
    }
    if ("fav".equals(key)) {
      drawHeartIcon(graphics, x, y);
      return;
    }
    if ("sun".equals(key)) {
      graphics.fill(x + 7, y + 1, x + 9, y + 3, color);
      graphics.fill(x + 7, y + 13, x + 9, y + 15, color);
      graphics.fill(x + 1, y + 7, x + 3, y + 9, color);
      graphics.fill(x + 13, y + 7, x + 15, y + 9, color);
      graphics.fill(x + 3, y + 3, x + 5, y + 5, color);
      graphics.fill(x + 11, y + 3, x + 13, y + 5, color);
      graphics.fill(x + 3, y + 11, x + 5, y + 13, color);
      graphics.fill(x + 11, y + 11, x + 13, y + 13, color);
      graphics.fill(x + 7, y + 5, x + 9, y + 6, color);
      graphics.fill(x + 6, y + 6, x + 10, y + 7, color);
      graphics.fill(x + 5, y + 7, x + 11, y + 9, color);
      graphics.fill(x + 6, y + 9, x + 10, y + 10, color);
      graphics.fill(x + 7, y + 10, x + 9, y + 11, color);
      return;
    }
    if ("moon".equals(key)) {
      graphics.fill(x + 8, y + 2, x + 11, y + 3, color);
      graphics.fill(x + 6, y + 3, x + 12, y + 4, color);
      graphics.fill(x + 5, y + 4, x + 10, y + 5, color);
      graphics.fill(x + 4, y + 5, x + 9, y + 7, color);
      graphics.fill(x + 3, y + 7, x + 8, y + 10, color);
      graphics.fill(x + 4, y + 10, x + 9, y + 12, color);
      graphics.fill(x + 5, y + 12, x + 11, y + 13, color);
      graphics.fill(x + 7, y + 13, x + 12, y + 14, color);
    }
  }

  private void drawHeartIcon(GuiGraphicsExtractor graphics, int x, int y) {
    int outline = 0xFF3A0000;
    int dark = 0xFF8F0000;
    int red = 0xFFE21B1B;
    int shine = 0xFFFF7A7A;
    graphics.fill(x + 4, y + 2, x + 7, y + 3, outline);
    graphics.fill(x + 9, y + 2, x + 12, y + 3, outline);
    graphics.fill(x + 3, y + 3, x + 8, y + 5, outline);
    graphics.fill(x + 8, y + 3, x + 13, y + 5, outline);
    graphics.fill(x + 2, y + 5, x + 14, y + 9, outline);
    graphics.fill(x + 3, y + 9, x + 13, y + 11, outline);
    graphics.fill(x + 5, y + 11, x + 11, y + 13, outline);
    graphics.fill(x + 7, y + 13, x + 9, y + 15, outline);
    graphics.fill(x + 4, y + 4, x + 8, y + 7, red);
    graphics.fill(x + 8, y + 4, x + 12, y + 7, red);
    graphics.fill(x + 3, y + 6, x + 13, y + 9, red);
    graphics.fill(x + 4, y + 9, x + 12, y + 10, red);
    graphics.fill(x + 6, y + 10, x + 10, y + 12, red);
    graphics.fill(x + 7, y + 12, x + 9, y + 14, red);
    graphics.fill(x + 4, y + 4, x + 6, y + 5, shine);
    graphics.fill(x + 5, y + 5, x + 7, y + 6, shine);
    graphics.fill(x + 10, y + 8, x + 12, y + 10, dark);
    graphics.fill(x + 8, y + 11, x + 10, y + 13, dark);
  }

  private void drawBottomTabs(GuiGraphicsExtractor graphics, Font font, int[] layout) {
    String[] labels = { "ALL", "PVP", "HUD", "SOCIAL" };
    for (int index = 0; index < labels.length; index += 1) {
      int[] bounds = bottomTabBounds(layout, index, labels.length);
      boolean active = (index == 0 && "all".equals(activeTab)) || (index == 1 && "pvp".equals(activeTab))
          || (index == 2 && "hud".equals(activeTab)) || (index == 3 && "social".equals(activeTab));
      drawTabButton(graphics, font, bounds[0], bounds[1], bounds[2], bounds[3], labels[index], active);
    }
  }

  private void drawTabButton(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, int h, String label, boolean active) {
    roundedFill(graphics, x + 1, y + 1, w, h, LauncherTheme.argb(38, 0x000000));
    roundedFill(graphics, x, y, w, h, active ? LauncherTheme.accentArgb(70) : LauncherTheme.argb(90, 0x0B1218));
    border(graphics, x, y, w, h, active ? LauncherTheme.accentArgb(215) : LauncherTheme.argb(148, 0xFFFFFF));
    graphics.centeredText(font, fitLabel(label, w - 8), x + (w / 2), y + 8, active ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor());
  }

  private void drawDetail(GuiGraphicsExtractor graphics, Font font, int[] layout) {
    MenuModules.Module module = MenuModules.modules()[selectedIndex];
    int panelX = layout[4];
    int panelY = layout[5];
    int panelW = layout[6];
    int panelH = layout[7];
    drawEditorIdentity(graphics, font, module, panelX, panelY, panelW);
    if ("friends".equals(module.id)) {
      drawFriendsEditor(graphics, font, panelX, panelY, panelW, panelH);
      return;
    }
    if ("fakefps".equals(module.id)) {
      drawCodeEditor(graphics, font, module, panelX, panelY, panelW, panelH);
      return;
    }

    if (hasEffectLevelSlider(module)) {
      drawEffectLevelSlider(graphics, font, module, panelX, panelY, panelW);
    }
    if ("flight".equals(module.id)) {
      drawFlightSpeedSlider(graphics, font, panelX, panelY, panelW);
    }
    if ("keysounds".equals(module.id)) {
      drawKeyboardSoundEditor(graphics, font, panelX, panelY, panelW);
    }
    if ("crosshair".equals(module.id)) {
      drawCrosshairEditor(graphics, font, panelX, panelY, panelW);
    }
    if ("timer".equals(module.id)) {
      drawTimerEditor(graphics, font, panelX, panelY, panelW);
    }
    if ("weather".equals(module.id)) {
      drawWeatherEditor(graphics, font, panelX, panelY, panelW);
    }
    if ("time".equals(module.id)) {
      drawTimeEditor(graphics, font, panelX, panelY, panelW);
    }
    if ("uptimer".equals(module.id)) {
      drawUpTimerEditor(graphics, font, panelX, panelY, panelW);
    }
    if ("xray".equals(module.id)) {
      drawXrayEditor(graphics, font, panelX, panelY, panelW);
    }
    if ("blockoutline".equals(module.id)) {
      drawBlockOutlineEditor(graphics, font, panelX, panelY, panelW);
    }
    if ("armor".equals(module.id)) {
      drawArmorEditor(graphics, font, panelX, panelY, panelW);
    }
    if (!hasSettingsEditor(module)) {
      drawGenericEditor(graphics, font, module, panelX, panelY, panelW);
    }

    int buttonY = panelY + panelH - 22;
    boolean resizableUi = OverlaySettings.isOverlay(module.id);
    int[] controls = detailControlBounds(panelX, panelW, module.keyBindable, module.toggleable, resizableUi, module.id);
    drawEditorControlDock(graphics, panelX, panelY, panelW, panelH);
    if (module.keyBindable) {
      drawButton(graphics, font, controls[0], buttonY, controls[1], 16, capturingKey ? "..." : keyComboLabel(module.keyCode, module.keyModifiers), module.keyCode > 0);
    }
    if (module.toggleable) {
      drawButton(graphics, font, controls[2], buttonY, controls[3], 16, module.enabled ? "ON" : "OFF", module.enabled);
    }
    if (resizableUi) {
      drawScaleButton(graphics, font, controls[4], buttonY, controls[5], "-", OverlaySettings.canShrink(module.id));
      drawScaleButton(graphics, font, controls[6], buttonY, controls[7], "+", OverlaySettings.canGrow(module.id));
      if (OverlaySettings.hasText(module.id)) {
        roundedFill(graphics, controls[8], buttonY, controls[9], 16, 0xFF000000 | OverlaySettings.textColor(module.id));
        border(graphics, controls[8], buttonY, controls[9], 16, LauncherTheme.argb(210, 0xFFFFFF));
        roundedFill(graphics, controls[10], buttonY, controls[11], 16, 0xFF000000 | OverlaySettings.restColor(module.id));
        border(graphics, controls[10], buttonY, controls[11], 16, LauncherTheme.argb(210, 0xFFFFFF));
      } else {
        roundedFill(graphics, controls[8], buttonY, controls[9], 16, 0xFF000000 | OverlaySettings.restColor(module.id));
        border(graphics, controls[8], buttonY, controls[9], 16, LauncherTheme.argb(210, 0xFFFFFF));
      }
      drawButton(graphics, font, controls[12], buttonY, controls[13], 16, "CX", false);
      drawButton(graphics, font, controls[14], buttonY, controls[15], 16, "CY", false);
    }
  }

  private boolean hasSettingsEditor(MenuModules.Module module) {
    return module != null && ("crosshair".equals(module.id) || "timer".equals(module.id) || "uptimer".equals(module.id) || "xray".equals(module.id) || "flight".equals(module.id) || "armor".equals(module.id)
        || "weather".equals(module.id) || "time".equals(module.id) || "blockoutline".equals(module.id) || "keysounds".equals(module.id) || hasEffectLevelSlider(module));
  }

  private void drawArmorEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    int gap = 5;
    int innerW = Math.max(60, w - 16);
    int colorW = Math.max(18, (innerW - (gap * 2)) / 3);
    int colorsW = (colorW * 3) + (gap * 2);
    int colorX = x + Math.max(8, (w - colorsW) / 2);
    int[] colors = { OverlaySettings.armorHealthyColor(), OverlaySettings.armorWarningColor(), OverlaySettings.armorCriticalColor() };
    String[] labels = { "GOOD", "LOW", "CRITICAL" };
    String[] ranges = { "> 50%", "21-50%", "0-20%" };
    drawEditorCard(graphics, x, y, w, 58, true);
    graphics.text(font, "DURABILITY COLORS", x + 8, y + 6, LauncherTheme.textColor());
    for (int index = 0; index < 3; index += 1) {
      int swatchX = colorX + (index * (colorW + gap));
      graphics.centeredText(font, ranges[index], swatchX + (colorW / 2), y + 17, LauncherTheme.mutedTextColor());
      roundedFill(graphics, swatchX, y + 28, colorW, 20, 0xFF000000 | colors[index]);
      border(graphics, swatchX, y + 28, colorW, 20, LauncherTheme.argb(225, 0xFFFFFF));
      graphics.centeredText(font, labels[index], swatchX + (colorW / 2), y + 34, contrastTextColor(colors[index]));
    }
  }

  private int contrastTextColor(int rgb) {
    int red = (rgb >> 16) & 255;
    int green = (rgb >> 8) & 255;
    int blue = rgb & 255;
    return ((red * 299) + (green * 587) + (blue * 114)) >= 150000 ? 0xFF101010 : 0xFFFFFFFF;
  }

  private void drawEditorIdentity(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int panelX, int panelY, int panelW) {
    int x = panelX + 12;
    int y = panelY + 47;
    int w = Math.max(80, panelW - 24);
    graphics.text(font, fitLabel(module.title, w), x, y + 7, LauncherTheme.textColor());
  }

  private void drawGenericEditor(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    drawDescription(graphics, font, String.valueOf(module.description == null ? "" : module.description), x, y + 5, w, 5);
  }

  private void drawEditorBadge(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, String label, boolean active) {
    roundedFill(graphics, x, y, w, 10, active ? LauncherTheme.accentArgb(92) : LauncherTheme.argb(95, 0x000000));
    border(graphics, x, y, w, 10, active ? LauncherTheme.accentArgb(190) : LauncherTheme.argb(85, 0xFFFFFF));
    graphics.centeredText(font, fitLabel(label, w - 4), x + (w / 2), y + 1, active ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor());
  }

  private void drawEditorControlDock(GuiGraphicsExtractor graphics, int panelX, int panelY, int panelW, int panelH) {
    int x = panelX + 10;
    int y = panelY + panelH - 25;
    int w = Math.max(100, panelW - 20);
    roundedFill(graphics, x, y, w, 22, LauncherTheme.secondArgb(58));
    border(graphics, x, y, w, 22, LauncherTheme.accentArgb(150));
  }

  private int[] detailControlBounds(int panelX, int panelW, boolean keyBindable, boolean toggleable, boolean resizable, String overlayId) {
    int available = Math.max(64, panelW - 28);
    int colorCount = resizable ? (OverlaySettings.hasText(overlayId) ? 2 : 1) : 0;
    int count = (keyBindable ? 1 : 0) + (toggleable ? 1 : 0) + (resizable ? 4 + colorCount : 0);
    int gap = count > 1 ? 4 : 0;
    int scaleW = resizable ? 18 : 0;
    int toggleW = toggleable ? 38 : 0;
    int colorW = resizable ? 16 : 0;
    int centerW = resizable ? 24 : 0;
    int reserved = toggleW + (scaleW * 2) + (colorW * colorCount) + (centerW * 2) + (Math.max(0, count - 1) * gap);
    int keyW = keyBindable ? Math.max(30, Math.min(76, available - reserved)) : 0;
    int total = keyW + reserved;
    int startX = panelX + Math.max(8, (panelW - total) / 2);
    int cursor = startX;
    int keyX = cursor;
    if (keyBindable) cursor += keyW + gap;
    int toggleX = cursor;
    if (toggleable) cursor += toggleW + gap;
    int minusX = cursor;
    if (resizable) cursor += scaleW + gap;
    int plusX = cursor;
    if (resizable) cursor += scaleW + gap;
    int colorX = cursor;
    if (resizable) cursor += colorW + gap;
    int restColorX = cursor;
    if (resizable) cursor += colorW + gap;
    int centerX = cursor;
    if (resizable) cursor += centerW + gap;
    int centerY = cursor;
    return new int[] { keyX, keyW, toggleX, toggleW, minusX, scaleW, plusX, scaleW, colorX, colorW, restColorX, colorW, centerX, centerW, centerY, centerW };
  }

  private void drawScaleButton(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, String label, boolean enabled) {
    if (enabled) {
      drawButton(graphics, font, x, y, w, 16, label, false);
      return;
    }
    roundedFill(graphics, x, y, w, 16, LauncherTheme.argb(105, 0x5A6268));
    border(graphics, x, y, w, 16, LauncherTheme.argb(80, 0xFFFFFF));
    graphics.centeredText(font, label, x + (w / 2), y + 4, LauncherTheme.argb(125, 0xD0D4D7));
  }

  private void drawEditorCard(GuiGraphicsExtractor graphics, int x, int y, int w, int h, boolean accented) {
    boolean lightMode = LauncherTheme.isLightMode();
    roundedFill(graphics, x, y, w, h, lightMode ? 0xE6EAF0F4 : LauncherTheme.argb(195, 0x09131C));
    border(graphics, x, y, w, h, accented ? LauncherTheme.accentArgb(190) : (lightMode ? 0x887A909C : LauncherTheme.argb(105, 0xFFFFFF)));
  }

  private void drawDescription(GuiGraphicsExtractor graphics, Font font, String text, int x, int y, int maxWidth, int maxLines) {
    String[] words = text.split(" ");
    String line = "";
    int drawY = y;
    int lines = 0;
    for (String word : words) {
      String next = line.isEmpty() ? word : line + " " + word;
      if (next.length() > Math.max(18, maxWidth / 6) && !line.isEmpty()) {
        graphics.text(font, fitLabel(line, maxWidth), x, drawY, LauncherTheme.mutedTextColor());
        lines += 1;
        if (lines >= maxLines) {
          return;
        }
        drawY += 9;
        line = word;
      } else {
        line = next;
      }
    }
    if (!line.isEmpty()) {
      graphics.text(font, fitLabel(line, maxWidth), x, drawY, LauncherTheme.mutedTextColor());
    }
  }

  private void drawEffectLevelSlider(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int panelX, int panelY, int panelW) {
    int x = effectSliderX(panelX);
    int y = effectSliderY(panelY);
    int w = effectSliderW(panelW);
    int level = MenuModules.effectLevel(module.id);
    drawEditorCard(graphics, x, y, w, 38, true);
    if (w >= 150) {
      graphics.text(font, "MAUS-SENSITIVITAET", x + 9, y + 5, LauncherTheme.textColor());
      graphics.text(font, "Wie in Minecraft", x + 9, y + 15, LauncherTheme.mutedTextColor());
      int valueX = x + w - 42;
      roundedFill(graphics, valueX, y + 5, 34, 11, LauncherTheme.accentArgb(100));
      border(graphics, valueX, y + 5, 34, 11, LauncherTheme.accentArgb(185));
      graphics.centeredText(font, level + "%", valueX + 17, y + 7, LauncherTheme.textColor());
    } else {
      graphics.centeredText(font, "SENSI " + level + "%", x + (w / 2), y + 7, LauncherTheme.textColor());
    }
    int trackX = x + 10;
    int trackY = y + 27;
    int trackW = Math.max(1, w - 20);
    int filled = Math.round(((level - 30) / 70.0F) * trackW);
    drawEditorSliderTrack(graphics, trackX, trackY, trackW, filled);
  }

  private void drawEditorSliderTrack(GuiGraphicsExtractor graphics, int x, int y, int w, int filled) {
    int safeFilled = Math.max(0, Math.min(w, filled));
    // The thicker track and thumb share the exact center (y + 3.5).
    graphics.fill(x, y + 2, x + w, y + 5, 0xFF000000);
    graphics.fill(x, y + 2, x + safeFilled, y + 5, LauncherTheme.accentArgb(210));
    int thumbX = x + safeFilled;
    graphics.fill(thumbX - 2, y - 1, thumbX + 3, y + 8, 0xFF000000);
    graphics.fill(thumbX - 4, y + 1, thumbX + 5, y + 6, 0xFF000000);
    graphics.fill(thumbX - 2, y, thumbX + 3, y + 7, LauncherTheme.accentArgb(255));
    graphics.fill(thumbX - 3, y + 1, thumbX + 4, y + 6, LauncherTheme.accentArgb(255));
  }

  private boolean hasEffectLevelSlider(MenuModules.Module module) {
    return module != null && "mobtrack".equals(module.id);
  }

  private void drawKeyboardSoundEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    int gap = 4;
    int square = Math.max(14, Math.min(20, (w - (gap * 5)) / 6));
    int gridW = (square * 6) + (gap * 5);
    int gridX = x + Math.max(0, (w - gridW) / 2);
    int selected = MenuModules.keyboardSound();
    for (int index = 0; index < 12; index += 1) {
      int sx = gridX + ((index % 6) * (square + gap));
      int sy = y + ((index / 6) * (square + gap));
      boolean active = selected == index + 1;
      graphics.fill(sx, sy, sx + square, sy + square, active ? LauncherTheme.accentArgb(255) : LauncherTheme.secondArgb(155));
      border(graphics, sx, sy, square, square, active ? LauncherTheme.accentArgb(255) : LauncherTheme.argb(150, 0xFFFFFF));
      if (active) graphics.fill(sx + 3, sy + 3, sx + square - 3, sy + square - 3, 0xFF000000);
      graphics.centeredText(font, String.valueOf(index + 1), sx + (square / 2), sy + Math.max(3, (square - 8) / 2), active ? 0xFFFFFFFF : LauncherTheme.textColor());
    }
    int volumeY = y + ((square + gap) * 2) + 3;
    int volume = MenuModules.keyboardVolumePercent();
    graphics.text(font, "VOLUME " + volume + "%", x + 2, volumeY, LauncherTheme.textColor());
    int trackX = x + 68;
    int trackW = Math.max(20, w - 72);
    int filled = Math.round(((volume - MenuModules.MIN_KEYBOARD_VOLUME) / (float) (MenuModules.MAX_KEYBOARD_VOLUME - MenuModules.MIN_KEYBOARD_VOLUME)) * trackW);
    drawEditorSliderTrack(graphics, trackX, volumeY + 2, trackW, filled);
  }

  private void drawFlightSpeedSlider(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 14;
    int y = panelY + DETAIL_EDITOR_TOP;
    int w = Math.max(80, panelW - 28);
    int value = MenuModules.flightSpeedPercent();
    drawEditorCard(graphics, x, y, w, 38, true);
    graphics.text(font, fitLabel("FLIGHT SPEED", w - 70), x + 9, y + 6, LauncherTheme.textColor());
    graphics.text(font, value + "%", x + w - 48, y + 6, LauncherTheme.textColor());
    int trackW = Math.max(1, w - 20);
    int filled = Math.round(((value - MenuModules.MIN_FLIGHT_SPEED) / (float) (MenuModules.MAX_FLIGHT_SPEED - MenuModules.MIN_FLIGHT_SPEED)) * trackW);
    drawEditorSliderTrack(graphics, x + 10, y + 27, trackW, filled);
  }

  private void drawBreakSpeedSlider(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = breakSpeedSliderX(panelX);
    int y = breakSpeedSliderY(panelY);
    int w = breakSpeedSliderW(panelW);
    int percent = MenuModules.breakSpeedPercent();
    graphics.fill(x + 2, y + 2, x + w + 2, y + 46, LauncherTheme.argb(62, 0x000000));
    graphics.fill(x, y, x + w, y + 44, LauncherTheme.argb(136, 0x101820));
    graphics.fill(x, y, x + 3, y + 44, LauncherTheme.accentArgb(205));
    border(graphics, x, y, w, 44, LauncherTheme.argb(145, 0x2A2A2A));
    graphics.text(font, fitLabel("Break Speed " + breakSpeedLabel(), w - 14), x + 8, y + 6, LauncherTheme.textColor());
    graphics.text(font, fitLabel("Survival Block Break", Math.max(32, w - 16)), x + 8, y + 17, LauncherTheme.mutedTextColor());
    int trackX = x + 10;
    int trackY = y + 33;
    int trackW = Math.max(1, w - 20);
    int range = MenuModules.MAX_BREAK_SPEED - MenuModules.MIN_BREAK_SPEED;
    int filled = Math.round(((percent - MenuModules.MIN_BREAK_SPEED) / (float) Math.max(1, range)) * trackW);
    drawEditorSliderTrack(graphics, trackX, trackY, trackW, filled);
  }

  private String breakSpeedLabel() {
    int percent = MenuModules.breakSpeedPercent();
    int hundredths = (int) Math.round(percent / 1.0D);
    return (hundredths / 100) + "." + String.format(java.util.Locale.ROOT, "%02d", Math.abs(hundredths % 100)) + "x";
  }

