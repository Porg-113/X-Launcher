    drawButton(graphics, font, startX + buttonW + gap, y + 22, buttonW, 16, "Noon", selected == 1);
    drawButton(graphics, font, startX + ((buttonW + gap) * 2), y + 22, buttonW, 16, "Sunset", selected == 2);
    drawButton(graphics, font, startX + ((buttonW + gap) * 3), y + 22, buttonW, 16, "Night", selected == 3);
  }

  private void drawTimerEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = timerEditorX(panelX);
    int y = timerEditorY(panelY);
    int w = timerEditorW(panelW);
    int rowY = y + 25;
    int[] controls = timerControlBounds(panelX, panelW);
    int buttonW = controls[5], valueW = controls[6];
    drawEditorCard(graphics, x, y, w, 76, true);
    if (w >= 150) {
      graphics.text(font, "SPIELZEIT-TIMER", x + 9, y + 7, LauncherTheme.textColor());
      int statusW = Math.min(88, Math.max(48, w - 126));
      int statusX = x + w - statusW - 8;
      roundedFill(graphics, statusX, y + 5, statusW, 12, LauncherTheme.argb(105, 0x000000));
      border(graphics, statusX, y + 5, statusW, 12, LauncherTheme.argb(92, 0xFFFFFF));
      graphics.centeredText(font, fitLabel(GameTimer.statusText(), statusW - 6), statusX + (statusW / 2), y + 7, LauncherTheme.mutedTextColor());
    } else {
      graphics.centeredText(font, "TIMER", x + (w / 2), y + 7, LauncherTheme.textColor());
    }
    drawButton(graphics, font, controls[0], rowY, buttonW, 16, "-5", false);
    drawButton(graphics, font, controls[1], rowY, buttonW, 16, "-1", false);
    roundedFill(graphics, controls[2], rowY, valueW, 16, LauncherTheme.argb(175, 0x071018));
    graphics.fill(controls[2] + 4, rowY + 2, controls[2] + valueW - 4, rowY + 3, LauncherTheme.argb(42, 0xFFFFFF));
    border(graphics, controls[2], rowY, valueW, 16, LauncherTheme.accentArgb(195));
    graphics.centeredText(font, fitLabel(GameTimer.minutes() + " min", valueW - 4), controls[2] + (valueW / 2), rowY + 5, LauncherTheme.textColor());
    drawButton(graphics, font, controls[3], rowY, buttonW, 16, "+1", false);
    drawButton(graphics, font, controls[4], rowY, buttonW, 16, "+5", false);
    int bottomY = y + 50;
    int autoW = 64;
    int resetW = 48;
    int remainingX = x + 8 + autoW + 4 + resetW + 5;
    drawButton(graphics, font, x + 8, bottomY, autoW, 16, GameTimer.autoStartDaily() ? "Auto ON" : "Auto OFF", GameTimer.autoStartDaily());
    drawButton(graphics, font, x + 8 + autoW + 4, bottomY, resetW, 16, "Reset", false);
    int remainingW = Math.max(1, x + w - 8 - remainingX);
    if (remainingW >= 24) {
      roundedFill(graphics, remainingX, bottomY, remainingW, 16, LauncherTheme.argb(72, 0x000000));
      graphics.centeredText(font, fitLabel("Rest " + GameTimer.remainingText(), Math.max(1, remainingW - 8)), remainingX + (remainingW / 2), bottomY + 5, LauncherTheme.mutedTextColor());
    }
  }

  private void drawUpTimerEditor(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = panelX + 14, y = panelY + DETAIL_EDITOR_TOP, w = Math.max(80, panelW - 28);
    drawEditorCard(graphics, x, y, w, 42, true);
    graphics.centeredText(font, "TIMER DISPLAY", x + (w / 2), y + 6, LauncherTheme.textColor());
    graphics.centeredText(font, "00:00:00", x + (w / 2), y + 19, LauncherTheme.textColor());
    graphics.centeredText(font, "Always horizontal", x + (w / 2), y + 30, LauncherTheme.mutedTextColor());
  }

  private int timerEditorX(int panelX) {
    return panelX + 18;
  }

  private int timerEditorY(int panelY) {
    return panelY + DETAIL_EDITOR_TOP;
  }

  private int timerEditorW(int panelW) {
    return Math.min(panelW - 36, 320);
  }

  private int[] timerControlBounds(int panelX, int panelW) {
    int x = timerEditorX(panelX);
    int w = timerEditorW(panelW);
    int gap = w >= 160 ? 4 : 2;
    int valueW = Math.min(58, Math.max(24, w / 3));
    int buttonW = Math.max(10, Math.min(26, (w - valueW - (gap * 4)) / 4));
    int groupW = (buttonW * 4) + valueW + (gap * 4);
    int groupX = x + Math.max(0, (w - groupW) / 2);
    int minus1X = groupX + buttonW + gap;
    int valueX = minus1X + buttonW + gap;
    int plus1X = valueX + valueW + gap;
    int plus5X = plus1X + buttonW + gap;
    return new int[] { groupX, minus1X, valueX, plus1X, plus5X, buttonW, valueW };
  }

