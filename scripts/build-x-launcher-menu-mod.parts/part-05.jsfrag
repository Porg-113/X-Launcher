  }

  private void drawZoomSettings(GuiGraphicsExtractor graphics, Font font, int panelX, int panelY, int panelW) {
    int x = zoomSettingsX(panelX);
    int y = zoomSettingsY(panelY);
    int w = zoomSettingsW(panelW);
    graphics.fill(x + 2, y + 2, x + w + 2, y + 90, LauncherTheme.argb(62, 0x000000));
    graphics.fill(x, y, x + w, y + 88, LauncherTheme.argb(136, 0x101820));
    graphics.fill(x, y, x + 3, y + 88, LauncherTheme.accentArgb(205));
    border(graphics, x, y, w, 88, LauncherTheme.argb(145, 0x2A2A2A));
    graphics.text(font, fitLabel("Zoom Einstellungen", w - 14), x + 8, y + 7, LauncherTheme.textColor());
    drawZoomSettingSlider(graphics, font, x, y + 29, w, "Staerke", zoomStrengthLabel(), MenuModules.zoomStrengthPercent(), MenuModules.MIN_ZOOM_STRENGTH, MenuModules.MAX_ZOOM_STRENGTH);
    drawZoomSettingSlider(graphics, font, x, y + 59, w, "Smoothness", MenuModules.zoomSmoothnessPercent() + "%", MenuModules.zoomSmoothnessPercent(), MenuModules.MIN_ZOOM_SMOOTHNESS, MenuModules.MAX_ZOOM_SMOOTHNESS);
  }

  private void drawZoomSettingSlider(GuiGraphicsExtractor graphics, Font font, int x, int rowY, int w, String label, String value, int current, int min, int max) {
    int valueW = 52;
    graphics.text(font, fitLabel(label, Math.max(32, w - valueW - 20)), x + 8, rowY, LauncherTheme.textColor());
    graphics.text(font, fitLabel(value, valueW), x + w - valueW - 8, rowY, LauncherTheme.mutedTextColor());
    int trackX = x + 10;
    int trackY = rowY + 14;
    int trackW = Math.max(1, w - 20);
    int filled = Math.round(((current - min) / (float) Math.max(1, max - min)) * trackW);
    drawEditorSliderTrack(graphics, trackX, trackY, trackW, filled);
  }

  private String zoomStrengthLabel() {
    int percent = MenuModules.zoomStrengthPercent();
    int tenths = (int) Math.round(percent / 10.0D);
    return (tenths / 10) + "." + Math.abs(tenths % 10) + "x";
  }

