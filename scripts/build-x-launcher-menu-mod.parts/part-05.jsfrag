    graphics.fill(x, y, x + w, y + h, LauncherTheme.argb(232, 0x071018));
    border(graphics, x, y, w, h, LauncherTheme.accentArgb(218));
    graphics.fill(x, y, x + 3, y + h, LauncherTheme.accentArgb(205));
    graphics.text(font, (step + 1) + "/" + TITLES.length, x + 8, y + 6, LauncherTheme.mutedTextColor());
    graphics.fill(x + 8, y + 16, x + w - 8, y + 18, LauncherTheme.argb(70, 0xFFFFFF));
    graphics.fill(x + 8, y + 16, x + 8 + ((w - 16) * (step + 1) / TITLES.length), y + 18, LauncherTheme.accentArgb(225));
    graphics.text(font, TITLES[step], x + 8, y + 24, LauncherTheme.textColor());
    graphics.fill(x + 8, y + 36, x + 11, y + 39, LauncherTheme.accentArgb(230));
    drawWrapped(graphics, font, TEXTS[step], x + 16, y + 34, w - 24, 2);
    drawButton(graphics, font, x + 8, y + h - 17, CARD_SKIP_W, CARD_BUTTON_H, "Skip", false);
    drawButton(graphics, font, x + w - 78, y + h - 17, CARD_BACK_W, CARD_BUTTON_H, "Back", step > 0);
    drawButton(graphics, font, x + w - 42, y + h - 17, CARD_NEXT_W, CARD_BUTTON_H, step >= TITLES.length - 1 ? "Done" : "Next", true);
  }

  private int[] focusBounds() {
    int[] layout = menuLayout();
    if (step == 0) {
      return new int[] { layout[4] + 8, layout[5] + 8, layout[6] - 16, 30 };
    }
    if (step == 1) {
      return new int[] { Math.max(10, width - 108), Math.max(10, height - 50), 86, 24 };
    }
    if (step == 2) {
      return new int[] { layout[4], layout[5], layout[6], layout[7] };
    }
    if (step == 3) {
      return moduleBounds("bright");
    }
    if (step == 4) {
      return moduleBounds("ui");
    }
    if (step == 5) {
      return combineBounds(moduleBounds("crosshair"), moduleBounds("friends"));
    }
    return moduleBounds("tutorial");
  }

  private int[] moduleBounds(String id) {
    int[] layout = menuLayout();
    MenuModules.Module[] modules = MenuModules.modules();
    for (int index = 0; index < modules.length; index += 1) {
      if (!id.equals(modules[index].id)) {
        continue;
      }
      int column = index % layout[8];
      int row = index / layout[8];
      return new int[] {
          layout[0] + (column * (layout[9] + MENU_GAP)),
          layout[1] + (row * (MENU_TILE_HEIGHT + MENU_GAP)),
          layout[9],
          MENU_TILE_HEIGHT
      };
    }
    return new int[] { layout[4], layout[5], layout[6], layout[7] };
  }

  private int[] combineBounds(int[] first, int[] second) {
    int left = Math.min(first[0], second[0]);
    int top = Math.min(first[1], second[1]);
    int right = Math.max(first[0] + first[2], second[0] + second[2]);
    int bottom = Math.max(first[1] + first[3], second[1] + second[3]);
    return new int[] { left, top, right - left, bottom - top };
  }

  private int[] menuLayout() {
    int boxW = Math.min(MENU_MAX_WIDTH, Math.max(120, width - (MENU_MIN_MARGIN * 2)));
    int boxH = Math.min(MENU_MAX_HEIGHT, Math.max(120, height - (MENU_MIN_MARGIN * 2)));
    int boxX = Math.max(MENU_MIN_MARGIN, (width - boxW) / 2);
    int boxY = Math.max(MENU_MIN_MARGIN, (height - boxH) / 2);
    int columns = menuColumns(boxW);
    int tileW = menuTileWidth(columns, boxW);
    int totalW = (columns * tileW) + ((columns - 1) * MENU_GAP);
    int startX = boxX + MENU_SIDE_PADDING;
    int startY = boxY + MENU_HEADER_HEIGHT;
    return new int[] { startX, startY, totalW, 0, boxX, boxY, boxW, boxH, columns, tileW };
  }

  private int menuColumns(int boxW) {
    int maxColumnsForWidth = Math.max(1, (boxW - (MENU_SIDE_PADDING * 2) + MENU_GAP - 6) / (28 + MENU_GAP));
    return Math.max(1, Math.min(5, maxColumnsForWidth));
  }

  private int menuTileWidth(int columns, int boxW) {
    int availableGridWidth = Math.max(28, boxW - (MENU_SIDE_PADDING * 2) - 6);
    int computed = Math.max(24, (availableGridWidth - ((columns - 1) * MENU_GAP)) / columns);
    return Math.min(44, computed);
  }

  private int[] cardBounds(int[] focus) {
    int cardW = Math.min(224, Math.max(178, width - 18));
    int cardH = 86;
    int gap = 12;
    int x;
    int y = clamp(focus[1] + focus[3] / 2 - cardH / 2, 8, Math.max(8, height - cardH - 8));
    if (focus[0] + focus[2] + gap + cardW <= width - 8) {
      x = focus[0] + focus[2] + gap;
    } else if (focus[0] - gap - cardW >= 8) {
      x = focus[0] - gap - cardW;
    } else {
      x = clamp((width - cardW) / 2, 8, Math.max(8, width - cardW - 8));
      y = focus[1] + focus[3] + gap;
      if (y + cardH > height - 8) {
        y = focus[1] - cardH - gap;
      }
      y = clamp(y, 8, Math.max(8, height - cardH - 8));
    }
    return new int[] { x, y, cardW, cardH };
  }

  private void drawWrapped(GuiGraphicsExtractor graphics, Font font, String text, int x, int y, int maxWidth, int maxLines) {
    String[] words = text.split(" ");
    String line = "";
    int lineCount = 0;
    for (String word : words) {
      String next = line.isEmpty() ? word : line + " " + word;
      if (next.length() > Math.max(18, maxWidth / 6) && !line.isEmpty()) {
        graphics.text(font, fit(line, maxWidth), x, y + (lineCount * 10), LauncherTheme.mutedTextColor());
        line = word;
        lineCount += 1;
        if (lineCount >= maxLines) {
          return;
        }
      } else {
        line = next;
      }
    }
    if (!line.isEmpty() && lineCount < maxLines) {
      graphics.text(font, fit(line, maxWidth), x, y + (lineCount * 10), LauncherTheme.mutedTextColor());
    }
  }

  private void drawButton(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, int h, String label, boolean active) {
    graphics.fill(x, y, x + w, y + h, active ? LauncherTheme.accentArgb(100) : LauncherTheme.argb(66, 0xFFFFFF));
    border(graphics, x, y, w, h, active ? LauncherTheme.accentArgb(220) : LauncherTheme.argb(130, 0xFFFFFF));
    graphics.centeredText(font, fit(label, w - 4), x + (w / 2), y + 5, active ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor());
  }

  private String fit(String value, int width) {
    String label = String.valueOf(value == null ? "" : value);
    int maxChars = Math.max(1, width / 6);
    return label.length() <= maxChars ? label : label.substring(0, Math.max(1, maxChars - 1)) + "~";
  }

  private boolean isInside(double mouseX, double mouseY, int x, int y, int w, int h) {
    return mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + h;
  }

  private int clamp(int value, int min, int max) {
    return Math.max(min, Math.min(max, value));
  }

  private void border(GuiGraphicsExtractor graphics, int x, int y, int w, int h, int color) {
    graphics.fill(x, y, x + w, y + 1, color);
    graphics.fill(x, y + h - 1, x + w, y + h, color);
    graphics.fill(x, y, x + 1, y + h, color);
    graphics.fill(x + w - 1, y, x + w, y + h, color);
  }
}
