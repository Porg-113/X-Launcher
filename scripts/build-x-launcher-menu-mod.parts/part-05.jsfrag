    updateUiDrag(mouseX, mouseY);
    drawBlurBackdrop(graphics);
    graphics.fill(2, 2, width - 2, height - 2, LauncherTheme.argb(55, 0xFFFFFF));
    graphics.fill(0, 0, width, height, LauncherTheme.argb(80, 0x05080D));
    drawButton(graphics, font, (width - 42) / 2, Math.max(8, height - 24), 42, 16, "Home", true);
    graphics.centeredText(font, "UI EDITOR", width / 2, 14, LauncherTheme.textColor());
    graphics.centeredText(font, "Drag overlays.", width / 2, 26, LauncherTheme.mutedTextColor());
