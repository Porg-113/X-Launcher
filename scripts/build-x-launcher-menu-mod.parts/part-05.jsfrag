package dev.xlauncher.client;

import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.Font;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.client.input.CharacterEvent;
import net.minecraft.client.input.KeyEvent;
import net.minecraft.client.input.MouseButtonEvent;
import net.minecraft.client.player.LocalPlayer;
import java.lang.reflect.Method;

public final class XLauncherMenuScreen extends Screen {
  private static final Object MENU_BLUR_TEXTURE = identifier("x-client", "textures/gui/menu_blur.png");
  private static final Object FAVORITE_STAR_TEXTURE = identifier("x-client", "textures/gui/favorite_star.png");
  private static final Object PICTURES_SQUARE_TEXTURE = identifier("x-client", "textures/gui/pictures_square.png");
  private static final int TILE_HEIGHT = 28;
  private static final int TILE_LABEL_HEIGHT = 0;
  private static final int GAP = 4;
  private static final int WINDOW_MARGIN = 50;
  private static final int MIN_WINDOW_MARGIN = 10;
  private static final int MIN_PANEL_SIZE = 160;
  private static final int PANEL_SIDE_PADDING = 8;
  private static final int PANEL_HEADER_HEIGHT = 44;
  private static final int PANEL_FOOTER_HEIGHT = 10;
  private static final int DETAIL_EDITOR_TOP = 74;
  private static final int XRAY_ORE_BUTTON_SIZE = 14;
  private static final int XRAY_ORE_BUTTON_GAP = 4;
  private static final int HEADER_ICON_SIZE = 18;
  private static final int HEADER_FILTER_WIDTH = 38;
  private static final int HEADER_BUTTON_GAP = 3;
  private static final int SEARCH_WIDTH = 82;
  private static final int SEARCH_HEIGHT = 18;
  private static final int SIDE_TAB_WIDTH = 54;
  private static final int SIDE_TAB_GAP = 6;
  private static final int SIDE_TAB_HEIGHT = 18;
  private static final int SIDE_TAB_BUTTON_GAP = 6;
  private static final int PANEL_MAX_WIDTH = 292;
  private static final int PANEL_MAX_HEIGHT = 186;
  private static final int MOD_SHIFT = 1;
  private static final int MOD_CONTROL = 2;
  private static final int MOD_ALT = 4;
  private static final int MOD_SUPER = 8;
  private String searchQuery = "";
  private String activeTab = "all";
  private boolean uiEditorMode;
  private boolean galleryMode;
  private String draggingOverlay;
  private String selectedOverlay;
  private boolean resizingOverlay;
  private int dragOffsetX;
  private int dragOffsetY;
  private int dragStartX;
  private int dragStartY;
  private int selectedIndex = -1;
  private boolean capturingKey;
  private boolean searchFocused;
  private String codeInput = "";
  private String codeStatus = "Code eingeben.";
  private boolean codeFocused;
  private boolean draggingEffectLevel;
  private boolean draggingFlightSpeed;
  private boolean draggingKeyboardVolume;
  private boolean draggingZoomStrength;
  private boolean draggingZoomSmoothness;
  private boolean draggingCrosshairSize;
  private boolean draggingHitboxThickness;
  private boolean draggingXrayRange;
  private boolean draggingBlockOutlineThickness;
  private char lastSearchFallbackChar;
  private long lastSearchFallbackMs;
  private java.util.UUID pendingRemoveFriendUuid;
  private String pendingRemoveFriendName = "";
  private int scrollOffset;
  private int galleryScrollOffset;
  private ScreenshotGallery.Entry enlargedGalleryEntry;
  private final long openedMs = System.currentTimeMillis();
  private boolean renderCrashLogged;
  private boolean closing;

  XLauncherMenuScreen() {
    super(TextBridge.literal("X Client"));
  }

  void openUiEditorShortcut() {
    uiEditorMode = true;
    galleryMode = false;
    selectedIndex = -1;
    capturingKey = false;
    searchFocused = false;
    codeFocused = false;
    draggingOverlay = null;
    selectedOverlay = null;
    resizingOverlay = false;
    pendingRemoveFriendUuid = null;
  }

  void openModuleShortcut(String moduleId) {
    uiEditorMode = false;
    galleryMode = false;
    searchQuery = "";
    activeTab = "all";
    selectedIndex = moduleIndex(moduleId);
    capturingKey = false;
    searchFocused = false;
    codeFocused = "fakefps".equals(moduleId);
    pendingRemoveFriendUuid = null;
    scrollOffset = 0;
    if (codeFocused) {
      codeInput = String.valueOf(MenuModules.fakeFps());
      codeStatus = "Wert wird zu den echten FPS addiert.";
    }
  }

  @Override
  public boolean isPauseScreen() {
    return XLauncherMenuClient.shouldPauseInOwnWorld();
  }

  @Override
  public boolean shouldCloseOnEsc() {
    return true;
  }

  @Override
  public void onClose() {
    closeMenu();
  }

  @Override
  public void extractRenderState(GuiGraphicsExtractor graphics, int mouseX, int mouseY, float tickDelta) {
    try {
      draw(graphics, mouseX, mouseY);
    } catch (Throwable error) {
      drawCrashSafeFallback(graphics, Minecraft.getInstance().font, error);
    }
  }

  @Override
  public boolean keyPressed(KeyEvent event) {
    if (event.key() == 256) {
      if (capturingKey) {
        if (selectedIndex >= 0 && selectedIndex < MenuModules.modules().length
            && MenuModules.modules()[selectedIndex].keyCode > 0) {
          XLauncherMenuClient.setModuleKey(selectedIndex, -1, 0);
        }
        capturingKey = false;
        return true;
      }
      return handleEscapeNavigation();
    }
    if (galleryMode) {
      int key = event.key();
      if (key == 263) {
        scrollGallery(-1);
        return true;
      }
      if (key == 262) {
        scrollGallery(1);
        return true;
      }
      return true;
    }
    if (capturingKey && selectedIndex >= 0 && MenuModules.modules()[selectedIndex].keyBindable) {
      int key = event.key();
      if (isClearKey(key)) {
        XLauncherMenuClient.setModuleKey(selectedIndex, -1, 0);
        capturingKey = false;
        return true;
      }
      if (isModifierKey(key)) {
        return true;
      }
      XLauncherMenuClient.setModuleKey(selectedIndex, key, keyModifiers(event));
      capturingKey = false;
      return true;
    }
    if (isCodeModuleSelected() && handleCodeKey(event.key())) {
      return true;
    }
    if (searchFocused && handleSearchKey(event.key())) {
      return true;
    }
    // Text is inserted exclusively by CharacterEvent. Using the physical GLFW
    // key here as well breaks Swiss QWERTZ (Y/Z) and inserts both characters.
    return super.keyPressed(event);
  }

  private boolean handleEscapeNavigation() {
    if (pendingRemoveFriendUuid != null) {
      pendingRemoveFriendUuid = null;
      pendingRemoveFriendName = "";
      return true;
    }
    if (enlargedGalleryEntry != null) {
      enlargedGalleryEntry = null;
      return true;
    }
    if (capturingKey) {
      capturingKey = false;
      return true;
    }
    if (searchFocused) {
      searchFocused = false;
      return true;
    }
    if (codeFocused) {
      codeFocused = false;
      return true;
    }
    if (uiEditorMode && selectedOverlay != null) {
      selectedOverlay = null;
      draggingOverlay = null;
      resizingOverlay = false;
      return true;
    }
    if (uiEditorMode) {
      uiEditorMode = false;
      draggingOverlay = null;
      resizingOverlay = false;
      return true;
    }
    if (galleryMode) {
      galleryMode = false;
      galleryScrollOffset = 0;
      return true;
    }
    if (selectedIndex >= 0) {
      selectedIndex = -1;
      capturingKey = false;
      codeFocused = false;
      pendingRemoveFriendUuid = null;
      pendingRemoveFriendName = "";
      return true;
    }
    closeMenu();
    return true;
  }

  private void closeMenu() {
    if (closing) {
      return;
    }
    Minecraft client = Minecraft.getInstance();
    if (client == null) {
      return;
    }
    closing = true;
    client.execute(() -> {
      if (!XLauncherMenuClient.closeMenuScreen(this)) {
        closing = false;
      }
    });
  }

  @Override
  public boolean charTyped(CharacterEvent event) {
    if (isCodeModuleSelected() && event.isAllowedChatCharacter()) {
      return appendCodeText(event.codepointAsString());
    }
    if (searchFocused && event.isAllowedChatCharacter()) {
      return appendSearchText(event.codepointAsString());
    }
    return false;
  }

  @Override
  public boolean mouseClicked(MouseButtonEvent event, boolean doubleClick) {
    if (event.button() == 0) {
      if (galleryMode) {
        boolean handled = handleGalleryClick(event.x(), event.y());
        if (handled) {
          XLauncherMenuClient.playMenuClickSound();
        }
        return handled;
      }
      if (uiEditorMode) {
        boolean handled = handleUiEditorClick(event.x(), event.y());
        if (handled) {
          XLauncherMenuClient.playMenuClickSound();
        }
        return handled;
      }
      int[] layout = layout();
      if (handleHeaderClick(event.x(), event.y(), layout)) {
        XLauncherMenuClient.playMenuClickSound();
        return true;
      }
      if (isInside(event.x(), event.y(), searchX(layout), searchY(layout), searchWidth(layout), SEARCH_HEIGHT)) {
        XLauncherMenuClient.playMenuClickSound();
        selectedIndex = -1;
        capturingKey = false;
        uiEditorMode = false;
        searchFocused = true;
        codeFocused = false;
        pendingRemoveFriendUuid = null;
        return true;
      }
      if (selectedIndex >= 0) {
        boolean handled = handleDetailClick(event.x(), event.y(), layout);
        if (handled) {
          XLauncherMenuClient.playMenuClickSound();
        }
        return handled;
      }
      int index = hitModule(event.x(), event.y());
      if (index >= 0) {
        XLauncherMenuClient.playMenuClickSound();
        String moduleId = MenuModules.modules()[index].id;
        if ("ui".equals(moduleId)) {
          uiEditorMode = true;
          galleryMode = false;
          selectedIndex = -1;
          capturingKey = false;
          draggingOverlay = null;
          selectedOverlay = null;
          resizingOverlay = false;
          pendingRemoveFriendUuid = null;
          return true;
        }
        selectedIndex = index;
        searchFocused = false;
        codeFocused = "fakefps".equals(moduleId);
        capturingKey = false;
        pendingRemoveFriendUuid = null;
        if ("fakefps".equals(moduleId)) {
          codeInput = String.valueOf(MenuModules.fakeFps());
          codeStatus = "Wert wird zu den echten FPS addiert.";
        }
        return true;
      }
    }
    return super.mouseClicked(event, doubleClick);
  }

  @Override
  public boolean mouseDragged(MouseButtonEvent event, double dragX, double dragY) {
    if (uiEditorMode && draggingOverlay != null) {
      updateUiDrag(event.x(), event.y());
      return true;
    }
    if (draggingEffectLevel && selectedIndex >= 0) {
      int[] layout = layout();
      updateEffectLevelFromMouse(event.x(), layout[4], layout[5], layout[6]);
      return true;
    }
    if (draggingFlightSpeed && selectedIndex >= 0) {
      int[] layout = layout();
      updateFlightSpeedFromMouse(event.x(), layout[4], layout[5], layout[6]);
      return true;
    }
    if (draggingKeyboardVolume && selectedIndex >= 0) {
      int[] layout = layout();
      updateKeyboardVolumeFromMouse(event.x(), layout[4], layout[5], layout[6]);
      return true;
    }
    if ((draggingZoomStrength || draggingZoomSmoothness) && selectedIndex >= 0) {
      int[] layout = layout();
      updateZoomSettingsFromMouse(event.x(), layout[4], layout[5], layout[6]);
      return true;
    }
    if (draggingCrosshairSize && selectedIndex >= 0) {
      int[] layout = layout();
      updateCrosshairSizeFromMouse(event.x(), layout[4], layout[5], layout[6]);
      return true;
    }
    if (draggingHitboxThickness && selectedIndex >= 0) {
      int[] layout = layout();
      updateHitboxThicknessFromMouse(event.x(), layout[4], layout[5], layout[6]);
      return true;
    }
    if (draggingXrayRange && selectedIndex >= 0) {
      int[] layout = layout();
      updateXrayRangeFromMouse(event.x(), layout[4], layout[5], layout[6]);
      return true;
    }
    if (draggingBlockOutlineThickness && selectedIndex >= 0) {
      int[] layout = layout();
      updateBlockOutlineThickness(event.x(), layout[4], layout[5], layout[6]);
      return true;
    }
    return super.mouseDragged(event, dragX, dragY);
  }

  @Override
  public boolean mouseReleased(MouseButtonEvent event) {
    if (draggingEffectLevel) {
      draggingEffectLevel = false;
      return true;
    }
    if (draggingFlightSpeed) {
      draggingFlightSpeed = false;
      return true;
    }
    if (draggingKeyboardVolume) {
      draggingKeyboardVolume = false;
      return true;
    }
    if (draggingZoomStrength || draggingZoomSmoothness) {
      draggingZoomStrength = false;
      draggingZoomSmoothness = false;
      return true;
    }
    if (draggingCrosshairSize) {
      draggingCrosshairSize = false;
      return true;
    }
    if (draggingHitboxThickness) {
      draggingHitboxThickness = false;
      return true;
    }
    if (draggingXrayRange) {
      draggingXrayRange = false;
      return true;
    }
    if (draggingBlockOutlineThickness) {
      draggingBlockOutlineThickness = false;
      return true;
    }
    if (uiEditorMode) {
      finishUiDrag();
      draggingOverlay = null;
      resizingOverlay = false;
      OverlaySettings.flush();
      return true;
    }
    return super.mouseReleased(event);
  }

  @Override
  public boolean mouseScrolled(double mouseX, double mouseY, double horizontalAmount, double verticalAmount) {
    if (galleryMode) {
      scrollGallery(verticalAmount < 0.0D ? 1 : -1);
      return true;
    }
    if (!uiEditorMode && selectedIndex < 0 && isInside(mouseX, mouseY, layout()[4], layout()[5], layout()[6], layout()[7])) {
      scrollBy(verticalAmount < 0.0D ? 1 : -1, layout());
      return true;
    }
    return false;
  }

  private void draw(GuiGraphicsExtractor graphics, int mouseX, int mouseY) {
    Font font = Minecraft.getInstance().font;
    if (uiEditorMode) {
      drawUiEditor(graphics, font, mouseX, mouseY);
      return;
    }
    if (galleryMode) {
      drawScreenshotGallery(graphics, font, mouseX, mouseY);
      return;
    }
    int accent = LauncherTheme.accent();
    int[] layout = layout();
    int startX = layout[0];
    int startY = layout[1];
    int totalWidth = layout[2];
    int gridHeight = layout[3];
    int boxX = layout[4];
    int boxY = layout[5];
    int boxW = layout[6];
    int boxH = layout[7];
    int columns = layout[8];
    int tileWidth = layout[9];
    int visibleCount = visibleCount();
    int maxVisibleTiles = maxVisibleTiles(layout);
    clampScroll(layout);
    clampScroll(layout);
    float open = openProgress();
    int panelShift = Math.round((1.0F - open) * 9.0F);
    if (panelShift > 0) {
      startY += panelShift;
      boxY += panelShift;
      layout[1] = startY;
      layout[5] = boxY;
    }

    boolean lightMode = LauncherTheme.isLightMode();
    drawBlurBackdrop(graphics);
    graphics.fill(0, 0, width, height, 0x24000000);
    graphics.fill(0, 0, width, 18, 0x00000000);
    graphics.fill(0, height - 18, width, height, 0x00000000);
    roundedFill(graphics, boxX + 3, boxY + 4, boxW, boxH, 0x52000000);
    roundedFill(graphics, boxX, boxY, boxW, boxH, 0xD8000000);
    roundedFill(graphics, boxX + 1, boxY + 1, boxW - 2, boxH - 2, 0xB8000000);
    roundedFill(graphics, boxX + 1, boxY + 1, boxW - 2, PANEL_HEADER_HEIGHT - 1, 0xC8000000);
    graphics.fill(boxX + 12, boxY + PANEL_HEADER_HEIGHT - 3, boxX + boxW - 12, boxY + PANEL_HEADER_HEIGHT - 2, 0x00000000);
    graphics.fill(boxX + 12, boxY + PANEL_HEADER_HEIGHT - 1, boxX + boxW - 12, boxY + PANEL_HEADER_HEIGHT + 1, 0x00000000);
    graphics.fill(boxX + 9, boxY + 9, boxX + 12, boxY + boxH - 9, 0x00000000);
    border(graphics, boxX, boxY, boxW, boxH, lightMode ? 0x665B6D7B : 0x664A5562);
    graphics.fill(boxX, boxY, boxX + 3, boxY + boxH, LauncherTheme.accentArgb(235));
    drawSearchBar(graphics, font, layout);
    drawHeaderActions(graphics, font, layout);

    if (selectedIndex >= 0) {
      drawDetail(graphics, font, layout);
      return;
    }

    MenuModules.Module[] modules = MenuModules.modules();
    int visibleIndex = 0;
    int matchedIndex = 0;
    int firstVisibleIndex = scrollOffset * columns;
    for (int index = 0; index < modules.length; index += 1) {
      if (!matchesModule(modules[index])) {
        continue;
      }
      if (matchedIndex < firstVisibleIndex) {
        matchedIndex += 1;
        continue;
      }
      if (visibleIndex >= maxVisibleTiles) {
        break;
      }
      int column = visibleIndex % columns;
      int row = visibleIndex / columns;
      int x = startX + (column * (tileWidth + GAP));
      int y = startY + (row * tileRowStep());
      drawTile(graphics, font, modules[index], x, y, tileWidth, TILE_HEIGHT, isInside(mouseX, mouseY, x, y, tileWidth, TILE_LABEL_HEIGHT + TILE_HEIGHT), accent);
      visibleIndex += 1;
      matchedIndex += 1;
    }
    if (visibleCount == 0) {
      graphics.centeredText(font, "NO MODULES", width / 2, startY + 13, LauncherTheme.mutedTextColor());
    }
    drawScrollbar(graphics, layout, visibleCount, maxVisibleTiles);

  }

  private void drawBlurBackdrop(GuiGraphicsExtractor graphics) {
    // No blur or full-screen texture: the world remains sharp behind the translucent panel.
  }

  private boolean drawTexture(Object graphics, Object texture, int x, int y, int w, int h, int sourceW, int sourceH) {
    if (graphics == null || texture == null) {
      return false;
    }
    for (Method method : graphics.getClass().getMethods()) {
      Class<?>[] types = method.getParameterTypes();
      if (types.length == 9 && types[0].isInstance(texture)
          && types[1] == Integer.TYPE && types[2] == Integer.TYPE && types[3] == Integer.TYPE && types[4] == Integer.TYPE
          && types[5] == Float.TYPE && types[6] == Float.TYPE && types[7] == Float.TYPE && types[8] == Float.TYPE) {
        try {
          method.invoke(graphics, texture, x, y, w, h, 0.0F, 1.0F, 0.0F, 1.0F);
          return true;
        } catch (Throwable ignored) {
          // Try another compatible texture method.
        }
      }
    }
    Object pipeline = renderPipeline();
    if (pipeline == null) {
      return false;
    }
    for (Method method : graphics.getClass().getMethods()) {
      Class<?>[] types = method.getParameterTypes();
      if (types.length < 10 || !types[0].isInstance(pipeline) || !types[1].isInstance(texture)) {
        continue;
      }
      try {
        if (types.length == 12) {
          method.invoke(graphics, pipeline, texture, x, y, 0.0F, 0.0F, w, h, sourceW, sourceH, sourceW, sourceH);
          return true;
        }
        if (types.length == 13) {
          method.invoke(graphics, pipeline, texture, x, y, 0.0F, 0.0F, w, h, sourceW, sourceH, sourceW, sourceH, 0xFFFFFFFF);
          return true;
        }
        if (types.length == 10) {
          method.invoke(graphics, pipeline, texture, x, y, 0.0F, 0.0F, w, h, sourceW, sourceH);
          return true;
        }
        if (types.length == 11) {
          method.invoke(graphics, pipeline, texture, x, y, 0.0F, 0.0F, w, h, sourceW, sourceH, 0xFFFFFFFF);
          return true;
        }
      } catch (Throwable ignored) {
        // Try the next texture rendering signature.
      }
    }
    return false;
  }

  private static Object identifier(String namespace, String path) {
    for (String className : new String[] { "net.minecraft.resources.Identifier", "net.minecraft.resources.ResourceLocation", "net.minecraft.class_2960" }) {
      try {
        Class<?> type = Class.forName(className);
        for (String methodName : new String[] { "fromNamespaceAndPath", "tryBuild", "method_60655" }) {
          try {
            Method method = type.getMethod(methodName, String.class, String.class);
            return method.invoke(null, namespace, path);
          } catch (Throwable ignored) {
            // Try the next factory.
          }
        }
        try {
          return type.getConstructor(String.class, String.class).newInstance(namespace, path);
        } catch (Throwable ignored) {
          // Try the next identifier mapping.
        }
      } catch (Throwable ignored) {
        // Try the next identifier class.
      }
    }
    return null;
  }

  private void drawCrashSafeFallback(GuiGraphicsExtractor graphics, Font font, Throwable error) {
    if (!renderCrashLogged) {
      renderCrashLogged = true;
      System.out.println("[X Client] Menu render recovered: " + error.getClass().getSimpleName() + ": " + error.getMessage());
    }
    graphics.fill(0, 0, width, height, 0xF0000000);
    int boxW = Math.min(260, Math.max(160, width - 30));
    int boxH = 74;
    int boxX = (width - boxW) / 2;
    int boxY = (height - boxH) / 2;
    roundedFill(graphics, boxX + 2, boxY + 2, boxW, boxH, 0x88000000);
    roundedFill(graphics, boxX, boxY, boxW, boxH, 0xFF000000);
    border(graphics, boxX, boxY, boxW, boxH, LauncherTheme.accentArgb(210));
    graphics.centeredText(font, "X Client", width / 2, boxY + 14, LauncherTheme.textColor());
    graphics.centeredText(font, "Menü wurde sicher geöffnet.", width / 2, boxY + 32, LauncherTheme.mutedTextColor());
    graphics.centeredText(font, "ESC schließt diesen Bildschirm.", width / 2, boxY + 46, LauncherTheme.mutedTextColor());
  }

  private float openProgress() {
    float raw = Math.min(1.0F, (System.currentTimeMillis() - openedMs) / 170.0F);
    return raw * raw * (3.0F - (2.0F * raw));
  }

  private float animationPhase() {
    return (System.currentTimeMillis() % 1800L) / 1800.0F;
  }

  private int pulseAlpha(int amount) {
    double wave = (Math.sin(System.currentTimeMillis() / 220.0D) + 1.0D) * 0.5D;
    return (int) Math.round(wave * amount);
  }

  private void drawFriendRequestPopup(GuiGraphicsExtractor graphics, Font font) {
    SocialManager.FriendRequest request = SocialManager.newestIncomingRequest();
    if (request == null) {
      return;
    }
    int[] bounds = friendRequestPopupBounds();
    int x = bounds[0];
    int y = bounds[1];
    int w = bounds[2];
    int h = bounds[3];
    graphics.fill(x + 1, y + 1, x + w + 1, y + h + 1, LauncherTheme.argb(105, 0x000000));
    graphics.fill(x, y, x + w, y + h, LauncherTheme.argb(178, 0x081018));
    border(graphics, x, y, w, h, LauncherTheme.accentArgb(220));
    drawRequestSkinHead(graphics, font, request, x + 8, y + 8, 13);
    graphics.text(font, fitLabel(request.name + " wants to be friends", w - 42), x + 27, y + 7, LauncherTheme.textColor());
    graphics.text(font, fitLabel("Accept or decline", w - 82), x + 27, y + 18, LauncherTheme.mutedTextColor());
    drawButton(graphics, font, x + w - 54, y + h - 16, 26, 13, "OK", true);
    drawButton(graphics, font, x + w - 24, y + h - 16, 18, 13, "X", true);
  }

  private boolean handleFriendRequestPopupClick(double mouseX, double mouseY) {
    SocialManager.FriendRequest request = SocialManager.newestIncomingRequest();
    if (request == null) {
      return false;
    }
    int[] bounds = friendRequestPopupBounds();
    int x = bounds[0];
    int y = bounds[1];
    int w = bounds[2];
    int h = bounds[3];
    if (isInside(mouseX, mouseY, x + w - 54, y + h - 16, 26, 13)) {
      SocialManager.acceptFriendRequest(request.uuid);
      return true;
    }
    if (isInside(mouseX, mouseY, x + w - 24, y + h - 16, 18, 13)) {
      SocialManager.declineFriendRequest(request.uuid);
      return true;
    }
    return isInside(mouseX, mouseY, x, y, w, h);
  }

  private int[] friendRequestPopupBounds() {
    int w = Math.min(190, Math.max(146, width - 16));
    int h = 42;
    int x = Math.max(6, width - w - 8);
    int y = Math.max(6, height - h - 8);
    return new int[] { x, y, w, h };
  }

