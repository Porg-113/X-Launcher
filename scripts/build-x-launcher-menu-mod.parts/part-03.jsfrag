  'dev/xlauncher/client/SoundDisplay.java': String.raw`
package dev.xlauncher.client;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
import java.util.Locale;

public final class SoundDisplay {
  private static final long LIFETIME_MS = 2400L;
  private static final long DEDUP_MS = 300L;
  private static final int MAX_ENTRIES = 5;
  private static final List<Entry> ENTRIES = new ArrayList<>();

  private SoundDisplay() {}

  public static synchronized void record(String soundId) {
    String label = classify(soundId);
    recordLabel(label);
  }

  public static synchronized void recordSubtitle(String subtitle, String soundId) {
    String label = String.valueOf(subtitle == null ? "" : subtitle).trim();
    if (label.isEmpty()) label = classify(soundId);
    recordLabel(label);
  }

  private static void recordLabel(String label) {
    if (label.isEmpty()) return;
    long now = System.currentTimeMillis();
    prune(now);
    for (Entry entry : ENTRIES) {
      if (entry.label.equals(label) && now - entry.lastSeen < DEDUP_MS) {
        entry.lastSeen = now;
        entry.expiresAt = now + LIFETIME_MS;
        return;
      }
    }
    ENTRIES.removeIf(entry -> entry.label.equals(label));
    ENTRIES.add(0, new Entry(label, now, now + LIFETIME_MS));
    while (ENTRIES.size() > MAX_ENTRIES) ENTRIES.remove(ENTRIES.size() - 1);
  }

  static synchronized String[] visible() {
    prune(System.currentTimeMillis());
    return ENTRIES.stream().map(entry -> entry.label).toArray(String[]::new);
  }

  private static void prune(long now) {
    for (Iterator<Entry> iterator = ENTRIES.iterator(); iterator.hasNext();) {
      if (iterator.next().expiresAt <= now) iterator.remove();
    }
  }

  private static String classify(String id) {
    String sound = String.valueOf(id == null ? "" : id).toLowerCase(Locale.ROOT);
    if (sound.contains("step") || sound.contains("footstep")) return "Footsteps";
    if (sound.contains("lava")) return "Lava";
    if (sound.contains("water") || sound.contains("splash") || sound.contains("swim")) return "Water";
    if (sound.contains("explode") || sound.contains("explosion")) return "Explosion";
    if (sound.contains("block") && (sound.contains("break") || sound.contains("destroy"))) return "Block Break";
    if (sound.contains("block") && (sound.contains("place") || sound.contains("hit"))) return "Block Place";
    if (sound.contains("hurt") || sound.contains("death") || sound.contains("ambient")) return "Entity";
    return "";
  }

  private static final class Entry {
    final String label;
    long lastSeen;
    long expiresAt;
    Entry(String label, long lastSeen, long expiresAt) {
      this.label = label; this.lastSeen = lastSeen; this.expiresAt = expiresAt;
    }
  }
}
