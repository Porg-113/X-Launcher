  static String hostStatus() {
    if (SOCIAL_DISABLED) {
      return "";
    }
    refreshHostStatus();
    return hostStatus;
  }

  static String hostedAddress() {
    if (SOCIAL_DISABLED) {
      return "";
    }
    refreshHostStatus();
    return hostedAddress;
  }

  static boolean hasHostedWorld() {
    if (SOCIAL_DISABLED) {
      return false;
    }
    refreshHostStatus();
    return !hostedAddress.isBlank() && hostedPort > 0;
  }

  static boolean startOwnWorldHost() {
    if (SOCIAL_DISABLED) {
      return false;
    }
    Object client = minecraftClient();
    if (client == null || getAnyField(client, "player", "field_1724") == null) {
      hostStatus = "Erst eine eigene Welt laden.";
      return false;
    }
    Object server = integratedServer(client);
    if (server == null) {
      hostStatus = "Nur Singleplayer-Welten koennen lokal gehostet werden.";
      return false;
    }
    if (!publishIntegratedServer(server, 25565) && !publishIntegratedServer(server, 0)) {
      hostStatus = "Welt konnte nicht für LAN geöffnet werden.";
      return false;
    }
    int port = serverPort(server);
    if (port <= 0) {
      port = 25565;
    }
    hostedPort = port;
    String lanHost = localLanAddress();
    hostedLanAddress = (lanHost.isBlank() ? "127.0.0.1" : lanHost) + ":" + port;
    UpnpMapping mapping = tryMapInternetPort(lanHost, port);
    if (mapping.mapped()) {
      hostedAddress = mapping.publicAddress();
      hostStatus = "Internet-Host aktiv: " + hostedAddress;
    } else {
      hostedAddress = hostedLanAddress;
      hostStatus = "LAN aktiv: " + hostedLanAddress + ". Internet: Port " + port + " am Router freigeben oder VPN nutzen.";
    }
    return true;
  }

  static boolean inviteFriend(UUID uuid) {
    if (SOCIAL_DISABLED) {
      return false;
    }
    if (uuid == null || !isFriend(uuid)) {
      hostStatus = "Nur Freunde koennen eingeladen werden.";
      return false;
    }
    if (!hasHostedWorld() && !startOwnWorldHost()) {
      return false;
    }
    String[] address = splitHostedAddress();
    if (address[0].isBlank() || address[1].isBlank()) {
      hostStatus = "Host-Adresse fehlt.";
      return false;
    }
    boolean sent = sendInvitePayload(uuid, address[0], address[1]);
    hostStatus = sent ? "Einladung gesendet: " + hostedAddress : "Einladung konnte nicht gesendet werden.";
    return sent;
  }

  static void dismissWorldInvite(UUID uuid) {
    if (SOCIAL_DISABLED) {
      return;
    }
    if (uuid == null) {
      return;
    }
    synchronized (LOCK) {
      worldInvites.remove(uuid);
    }
  }

  static boolean copyWorldInviteAddress(UUID uuid) {
    if (SOCIAL_DISABLED) {
      return false;
    }
    WorldInvite invite;
    synchronized (LOCK) {
      trimWorldInvitesLocked();
      invite = worldInvites.get(uuid);
    }
    if (invite == null || invite.address().isBlank()) {
      return false;
    }
    try {
      Toolkit.getDefaultToolkit().getSystemClipboard().setContents(new StringSelection(invite.address()), null);
      return true;
    } catch (Throwable ignored) {
      return false;
    }
  }

  static boolean hasIncomingRequest(UUID uuid) {
    if (SOCIAL_DISABLED) {
      return false;
    }
    if (uuid == null) {
      return false;
    }
    load();
    synchronized (LOCK) {
      trimRequestsLocked();
      return incomingRequests.containsKey(uuid);
    }
  }

  static boolean hasOutgoingRequest(UUID uuid) {
    if (SOCIAL_DISABLED) {
      return false;
    }
    if (uuid == null) {
      return false;
    }
    load();
    synchronized (LOCK) {
      trimRequestsLocked();
      return outgoingRequests.containsKey(uuid);
    }
  }

  static void toggleFriend(UUID uuid, String name) {
    if (SOCIAL_DISABLED) {
      return;
    }
    if (uuid == null) {
      return;
    }
    if (isFriend(uuid)) {
      removeFriend(uuid);
      return;
    }
    requestFriend(uuid, name);
  }

  static void requestFriend(UUID uuid, String name) {
    if (SOCIAL_DISABLED) {
      return;
    }
    if (uuid == null) {
      return;
    }
    Profile local = localProfile();
    if (local != null && uuid.equals(local.uuid)) {
      return;
    }
    load();
    if (hasIncomingRequest(uuid)) {
      acceptFriendRequest(uuid);
      return;
    }
    boolean shouldSend = false;
    synchronized (LOCK) {
      if (friends.containsKey(uuid)) {
        return;
      }
      trimRequestsLocked();
      if (!outgoingRequests.containsKey(uuid)) {
        outgoingRequests.put(uuid, requestEntry(uuid, name, System.currentTimeMillis()));
        shouldSend = true;
      }
    }
    if (shouldSend) {
      sendFriendPayload("REQ", uuid);
    }
  }

  static void acceptFriendRequest(UUID uuid) {
    if (SOCIAL_DISABLED) {
      return;
    }
    if (uuid == null) {
      return;
    }
    FriendRequest request;
    load();
    synchronized (LOCK) {
      trimRequestsLocked();
      request = incomingRequests.remove(uuid);
      if (request == null) {
        return;
      }
      outgoingRequests.remove(uuid);
      friends.put(uuid, cleanName(request.name));
      PlayerStatus current = onlinePlayers.get(uuid);
      if (current != null) {
        onlinePlayers.put(uuid, current.withName(request.name).withFlags(true, true));
      }
      saveLocked();
    }
    sendFriendPayload("ACC", uuid);
    applyFriendGlow(minecraftClient(), null);
  }

  static void declineFriendRequest(UUID uuid) {
    if (SOCIAL_DISABLED) {
      return;
    }
    if (uuid == null) {
      return;
    }
    FriendRequest request;
    load();
    synchronized (LOCK) {
      trimRequestsLocked();
      request = incomingRequests.remove(uuid);
    }
    if (request != null) {
      sendFriendPayload("DEN", uuid);
    }
  }

  static void removeFriend(UUID uuid) {
    if (SOCIAL_DISABLED) {
      return;
    }
    if (uuid == null) {
      return;
    }
    load();
    synchronized (LOCK) {
      friends.remove(uuid);
      incomingRequests.remove(uuid);
      outgoingRequests.remove(uuid);
      PlayerStatus current = onlinePlayers.get(uuid);
      if (current != null) {
        onlinePlayers.put(uuid, current.withFlags(knownXClients.containsKey(uuid), false));
      }
      saveLocked();
    }
    applyFriendGlow(minecraftClient(), null);
  }

  private static boolean isFriend(UUID uuid) {
    load();
    synchronized (LOCK) {
      return friends.containsKey(uuid);
    }
  }

  static void markXClient(UUID uuid, String name) {
    markXClient(uuid, name, 0xFFFFFF);
  }

  static void markXClient(UUID uuid, String name, int nameColor) {
    if (SOCIAL_DISABLED) {
      return;
    }
    if (uuid == null) {
      return;
    }
    load();
    synchronized (LOCK) {
      String safeName = cleanName(name);
      knownXClients.put(uuid, safeName);
      knownNameColors.put(uuid, nameColor & 0xFFFFFF);
      PlayerStatus current = onlinePlayers.get(uuid);
      if (current != null) {
        onlinePlayers.put(uuid, current.withName(safeName).withFlags(true, friends.containsKey(uuid)));
      }
      saveLocked();
    }
  }

  public static boolean isXClient(UUID uuid) {
    if (uuid == null) return false;
    Profile local = localProfile();
    if (local != null && uuid.equals(local.uuid)) return true;
    synchronized (LOCK) {
      if (knownXClients.containsKey(uuid)) return true;
    }
    return RemoteCosmetics.isXClient(uuid);
  }

  public static int nameColor(UUID uuid) {
    Profile local = localProfile();
    if (uuid != null && local != null && uuid.equals(local.uuid)) return NameTagSettings.color();
    synchronized (LOCK) {
      return knownNameColors.getOrDefault(uuid, 0xFFFFFF);
    }
  }

  static int headColor(UUID uuid, String name) {
    int hash = uuid != null ? uuid.hashCode() : cleanName(name).hashCode();
    int r = 70 + Math.floorMod(hash, 130);
    int g = 70 + Math.floorMod(hash >> 8, 130);
    int b = 70 + Math.floorMod(hash >> 16, 130);
    return 0xFF000000 | (r << 16) | (g << 8) | b;
  }

  private static void watchPlayers() {
    while (true) {
      try {
        scanOnlinePlayers();
        // Presence changes do not need sub-second polling. Five seconds keeps
        // the UI responsive while avoiding repeated reflective player scans.
        Thread.sleep(5000L);
      } catch (InterruptedException interrupted) {
        Thread.currentThread().interrupt();
        return;
      } catch (Throwable ignored) {
        sleepQuietly(3500L);
      }
    }
  }

  private static void scanOnlinePlayers() {
    Object client = minecraftClient();
    if (client == null) {
      return;
    }

    Map<UUID, PlayerStatus> next = new LinkedHashMap<>();
    Object localPlayer = getAnyField(client, "player", "field_1724");
    Profile localProfile = profileFromPlayer(localPlayer);
    if (localProfile == null) {
      localProfile = profileFromClientUser(client);
    }
    if (localProfile != null) {
      markXClient(localProfile.uuid, localProfile.name);
      next.put(localProfile.uuid, status(localProfile.uuid, localProfile.name, localProfile.skinTexture, true, System.currentTimeMillis()));
    }

    Object connection = getAnyField(localPlayer, "connection", "networkHandler", "field_3944", "field_3944");
    for (Profile profile : onlineProfiles(connection)) {
      next.put(profile.uuid, status(profile.uuid, profile.name, profile.skinTexture, false, System.currentTimeMillis()));
    }

    synchronized (LOCK) {
      for (Map.Entry<UUID, PlayerStatus> entry : onlinePlayers.entrySet()) {
        if (!next.containsKey(entry.getKey()) && System.currentTimeMillis() - entry.getValue().lastSeenMs < 15000L) {
          next.put(entry.getKey(), entry.getValue());
        }
      }
      onlinePlayers.clear();
      onlinePlayers.putAll(next);
      trimRecentLocked();
    }
    applyFriendGlow(client, localProfile == null ? null : localProfile.uuid);
  }

  private static PlayerStatus status(UUID uuid, String name, Object skinTexture, boolean localClient, long seenAt) {
    synchronized (LOCK) {
      boolean xClient = localClient || knownXClients.containsKey(uuid);
      boolean friend = friends.containsKey(uuid);
      String displayName = cleanName(name);
      if (displayName.isBlank()) {
        displayName = knownXClients.getOrDefault(uuid, friends.getOrDefault(uuid, "Player"));
      }
      Object texture = skinTexture != null ? skinTexture : skinTextures.get(uuid);
      if (texture != null) {
        skinTextures.put(uuid, texture);
      }
      int[] headPixels = skinHeadPixels.get(uuid);
      if (headPixels == null || headPixels.length < 64) {
        requestSkinHeadLookup(uuid, displayName);
      }
      return new PlayerStatus(uuid, displayName, xClient, friend, localClient, seenAt, texture, headPixels);
    }
  }

  private static List<Profile> onlineProfiles(Object connection) {
    List<Profile> result = new ArrayList<>();
    if (connection == null) {
      return result;
    }

    for (Method method : connection.getClass().getMethods()) {
      if (method.getParameterCount() != 0 || !Collection.class.isAssignableFrom(method.getReturnType())) {
        continue;
      }
      try {
        Object value = method.invoke(connection);
        if (!(value instanceof Collection<?> collection)) {
          continue;
        }
        int before = result.size();
        for (Object entry : collection) {
          Profile profile = profileFromPlayerInfo(entry);
          if (profile != null && result.stream().noneMatch((existing) -> existing.uuid.equals(profile.uuid))) {
            result.add(profile);
          }
        }
        if (result.size() > before) {
          break;
        }
      } catch (Throwable ignored) {
        // Try the next player-list method.
      }
    }
    return result;
  }

  private static Profile profileFromPlayerInfo(Object entry) {
    if (entry == null) {
      return null;
    }
    Object profile = invokeAny(entry, "getProfile", "method_2966", "comp_1108");
    Profile parsed = profileFromGameProfile(profile);
    return parsed == null ? null : parsed.withSkinTexture(skinTextureFromPlayerInfo(entry));
  }

  private static Profile profileFromPlayer(Object player) {
    if (player == null) {
      return null;
    }
    Object profile = invokeAny(player, "getGameProfile", "method_7334");
    Profile fromProfile = profileFromGameProfile(profile);
    if (fromProfile != null) {
      return fromProfile.withSkinTexture(skinTextureFromPlayer(player));
    }
    Object uuid = invokeAny(player, "getUUID", "getUuid", "method_5667");
    Object name = invokeAny(player, "getName", "method_5477");
    UUID parsedUuid = uuid instanceof UUID ? (UUID) uuid : null;
    String parsedName = componentText(name);
    return parsedUuid == null ? null : new Profile(parsedUuid, parsedName, skinTextureFromPlayer(player));
  }

  private static Profile profileFromClientUser(Object client) {
    Object user = invokeAny(client, "getUser", "method_1548");
    if (user == null) {
      user = getAnyField(client, "user", "field_1726", "session");
    }
    if (user == null) {
      return null;
    }
    Object uuid = invokeAny(user, "getProfileId", "getUuid", "getId", "uuid");
    Object name = invokeAny(user, "getName", "method_1676", "name");
    UUID parsedUuid = parseUuid(uuid);
    String parsedName = cleanName(String.valueOf(name == null ? "" : name));
    return parsedUuid == null ? null : new Profile(parsedUuid, parsedName.isBlank() ? "You" : parsedName, null);
  }

  private static Profile profileFromGameProfile(Object profile) {
    if (profile == null) {
      return null;
    }
    Object uuid = invokeAny(profile, "getId");
    Object name = invokeAny(profile, "getName");
    if (uuid instanceof UUID id) {
      return new Profile(id, cleanName(String.valueOf(name == null ? "" : name)), null);
    }
    return null;
  }

  private static Object skinTextureFromPlayerInfo(Object entry) {
    Object skin = invokeAny(entry, "getSkin", "getSkinTextures", "getSkinLocation", "getSkinTextureLocation", "method_52814", "method_65952", "method_2957");
    return skinRenderData(skin);
  }

  private static Object skinTextureFromPlayer(Object player) {
    Object skin = invokeAny(player, "getSkin", "getSkinTextures", "getSkinTextureLocation", "method_52814", "method_3117");
    return skinRenderData(skin);
  }

  private static Object skinRenderData(Object value) {
    Object texture = extractSkinTexture(value);
    if (value == null) {
      return texture;
    }
    if (texture == null || texture == value) {
      return value;
    }
    return new Object[] { value, texture };
  }

  private static Object extractSkinTexture(Object value) {
    if (value == null) {
      return null;
    }
    String className = value.getClass().getName();
    if (className.endsWith("ResourceLocation") || className.endsWith("Identifier") || className.endsWith("class_2960")) {
      return value;
    }
    for (String methodName : new String[] { "texture", "getTexture", "skin", "getSkin", "method_55836", "method_52831", "method_53469" }) {
      Object next = invokeAny(value, methodName);
      if (next != null && next != value) {
        Object texture = extractSkinTexture(next);
        if (texture != null) {
          return texture;
        }
      }
    }
    return null;
  }

  private static void startSkinResolver() {
    if (skinResolverStarted) {
      return;
    }
    skinResolverStarted = true;
    Thread resolver = new Thread(SocialManager::resolveSkinHeads, "X Client Skin Heads");
    resolver.setDaemon(true);
    resolver.start();
  }

  private static void requestSkinHeadLookup(UUID uuid, String name) {
    if (uuid == null) {
      return;
    }
    long now = System.currentTimeMillis();
    synchronized (LOCK) {
      if (skinHeadPixels.containsKey(uuid) || pendingSkinLookups.containsKey(uuid)) {
        return;
      }
      long lastLookup = skinLookupTimes.getOrDefault(uuid, 0L);
      if (now - lastLookup < SKIN_LOOKUP_RETRY_MS) {
        return;
      }
      skinLookupTimes.put(uuid, now);
      pendingSkinLookups.put(uuid, cleanName(name));
      LOCK.notifyAll();
    }
  }

  private static void resolveSkinHeads() {
    while (true) {
      UUID uuid = null;
      String name = "";
      try {
        synchronized (LOCK) {
          while (pendingSkinLookups.isEmpty()) {
            LOCK.wait(2000L);
          }
          Map.Entry<UUID, String> next = pendingSkinLookups.entrySet().iterator().next();
          uuid = next.getKey();
          name = next.getValue();
          pendingSkinLookups.remove(uuid);
        }
        int[] pixels = fetchOnlineSkinHead(uuid);
        if (pixels != null && pixels.length >= 64) {
          synchronized (LOCK) {
            skinHeadPixels.put(uuid, pixels);
            trimSkinHeadCacheLocked();
            PlayerStatus current = onlinePlayers.get(uuid);
            if (current != null) {
              onlinePlayers.put(uuid, current.withSkinHeadPixels(pixels));
            }
            FriendRequest incoming = incomingRequests.get(uuid);
            if (incoming != null) {
              incomingRequests.put(uuid, incoming.withSkinHeadPixels(pixels));
            }
            FriendRequest outgoing = outgoingRequests.get(uuid);
            if (outgoing != null) {
              outgoingRequests.put(uuid, outgoing.withSkinHeadPixels(pixels));
            }
          }
        }
      } catch (InterruptedException interrupted) {
        Thread.currentThread().interrupt();
        return;
      } catch (Throwable ignored) {
        if (uuid != null) {
          synchronized (LOCK) {
            skinLookupTimes.put(uuid, System.currentTimeMillis());
          }
        }
      }
    }
  }

  private static void trimSkinHeadCacheLocked() {
    while (skinHeadPixels.size() > SKIN_HEAD_CACHE_LIMIT) {
      UUID first = skinHeadPixels.keySet().iterator().next();
      skinHeadPixels.remove(first);
    }
  }

  private static int[] fetchOnlineSkinHead(UUID uuid) {
    String compactUuid = uuid == null ? "" : uuid.toString().replace("-", "");
    if (compactUuid.isBlank()) {
      return null;
    }
    String profileJson = fetchText("https://sessionserver.mojang.com/session/minecraft/profile/" + compactUuid + "?unsigned=false");
    String encodedTextures = extractJsonString(profileJson, "value");
    if (encodedTextures.isBlank()) {
      return null;
    }
    try {
      String decoded = new String(Base64.getDecoder().decode(encodedTextures), StandardCharsets.UTF_8);
      int skinIndex = decoded.indexOf("\"SKIN\"");
      if (skinIndex < 0) {
        return null;
      }
      String textureUrl = normalizeTextureUrl(extractJsonString(decoded.substring(skinIndex), "url"));
      return textureUrl.isBlank() ? null : fetchSkinHeadPixels(textureUrl);
    } catch (RuntimeException ignored) {
      return null;
    }
  }

  private static int[] fetchSkinHeadPixels(String url) {
    HttpURLConnection connection = null;
    try {
      connection = (HttpURLConnection) URI.create(url).toURL().openConnection();
      connection.setConnectTimeout(8000);
      connection.setReadTimeout(8000);
      connection.setRequestProperty("Accept", "image/png");
      connection.setRequestProperty("User-Agent", "X-Client Friends");
      int status = connection.getResponseCode();
      if (status < 200 || status >= 300) {
        return null;
      }
      byte[] skinBytes = connection.getInputStream().readAllBytes();
      if (skinBytes.length == 0 || skinBytes.length > MAX_SKIN_BYTES) {
        return null;
      }
      BufferedImage image = ImageIO.read(new ByteArrayInputStream(skinBytes));
      if (image == null || image.getWidth() < 48 || image.getHeight() < 16) {
        return null;
      }
      int[] pixels = new int[64];
      for (int y = 0; y < 8; y += 1) {
        for (int x = 0; x < 8; x += 1) {
          int base = opaque(image.getRGB(8 + x, 8 + y));
          int overlay = image.getRGB(40 + x, 8 + y);
          pixels[(y * 8) + x] = blend(base, overlay);
        }
      }
      return pixels;
    } catch (Throwable ignored) {
      return null;
    } finally {
      if (connection != null) {
        connection.disconnect();
      }
    }
  }

  private static String fetchText(String url) {
    HttpURLConnection connection = null;
    try {
      connection = (HttpURLConnection) URI.create(url).toURL().openConnection();
      connection.setConnectTimeout(8000);
      connection.setReadTimeout(8000);
      connection.setRequestProperty("Accept", "application/json");
      connection.setRequestProperty("User-Agent", "X-Client Friends");
      int status = connection.getResponseCode();
      if (status < 200 || status >= 300) {
        return "";
      }
      try (java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.InputStreamReader(connection.getInputStream(), StandardCharsets.UTF_8))) {
        StringBuilder body = new StringBuilder();
        String line;
        while ((line = reader.readLine()) != null && body.length() < 200000) {
          body.append(line).append('\n');
        }
        return body.toString();
      }
    } catch (Throwable ignored) {
      return "";
    } finally {
      if (connection != null) {
        connection.disconnect();
      }
    }
  }

  private static String normalizeTextureUrl(String value) {
    try {
      URI uri = URI.create(String.valueOf(value == null ? "" : value).trim());
      if (!"textures.minecraft.net".equalsIgnoreCase(uri.getHost())) {
        return "";
      }
      return new URI("https", uri.getUserInfo(), uri.getHost(), uri.getPort(), uri.getPath(), null, null).toString();
    } catch (Throwable ignored) {
      return "";
    }
  }

  private static String extractJsonString(String json, String key) {
    Matcher matcher = Pattern.compile("\"" + Pattern.quote(String.valueOf(key)) + "\"\\s*:\\s*\"((?:\\\\.|[^\"])*)\"").matcher(String.valueOf(json == null ? "" : json));
    return matcher.find() ? unescapeJsonString(matcher.group(1)) : "";
  }

  private static String unescapeJsonString(String value) {
    String text = String.valueOf(value == null ? "" : value);
    StringBuilder builder = new StringBuilder(text.length());
    boolean escaping = false;
    for (int index = 0; index < text.length(); index += 1) {
      char chr = text.charAt(index);
      if (escaping) {
        builder.append(switch (chr) {
          case '"', '\\', '/' -> chr;
          case 'b' -> '\b';
          case 'f' -> '\f';
          case 'n' -> '\n';
          case 'r' -> '\r';
          case 't' -> '\t';
          default -> chr;
        });
        escaping = false;
      } else if (chr == '\\') {
        escaping = true;
      } else {
        builder.append(chr);
      }
    }
    return builder.toString();
  }

  private static int opaque(int color) {
    return 0xFF000000 | (color & 0x00FFFFFF);
  }

  private static int blend(int base, int overlay) {
    int alpha = (overlay >>> 24) & 0xFF;
    if (alpha <= 0) {
      return opaque(base);
    }
    if (alpha >= 255) {
      return opaque(overlay);
    }
    int inv = 255 - alpha;
    int red = ((((overlay >>> 16) & 0xFF) * alpha) + (((base >>> 16) & 0xFF) * inv)) / 255;
    int green = ((((overlay >>> 8) & 0xFF) * alpha) + (((base >>> 8) & 0xFF) * inv)) / 255;
    int blue = (((overlay & 0xFF) * alpha) + ((base & 0xFF) * inv)) / 255;
    return 0xFF000000 | (red << 16) | (green << 8) | blue;
  }

  private static void applyFriendGlow(Object client, UUID selfUuid) {
    Set<UUID> friendIds;
    synchronized (LOCK) {
      friendIds = new LinkedHashSet<>(friends.keySet());
    }

    Set<UUID> nextGlowing = new LinkedHashSet<>();
    for (Object entity : worldPlayers(client)) {
      Profile profile = profileFromPlayer(entity);
      if (profile == null || profile.uuid.equals(selfUuid)) {
        continue;
      }
      boolean shouldGlow = friendIds.contains(profile.uuid);
      if (shouldGlow) {
        setEntityGlowing(entity, true);
        nextGlowing.add(profile.uuid);
      } else {
        synchronized (LOCK) {
          if (glowingFriends.contains(profile.uuid)) {
            setEntityGlowing(entity, false);
          }
        }
      }
    }

    synchronized (LOCK) {
      glowingFriends.clear();
      glowingFriends.addAll(nextGlowing);
    }
  }

  private static List<Object> worldPlayers(Object client) {
    List<Object> result = new ArrayList<>();
    Object level = getAnyField(client, "level", "world", "field_1687");
    addPlayerEntities(result, invokeAny(level, "players", "getPlayers", "method_18456", "method_18112"));
    if (!result.isEmpty()) {
      return result;
    }

    for (Method method : level == null ? new Method[0] : level.getClass().getMethods()) {
      if (method.getParameterCount() != 0) {
        continue;
      }
      Class<?> returnType = method.getReturnType();
      if (!Collection.class.isAssignableFrom(returnType) && !Iterable.class.isAssignableFrom(returnType) && !returnType.isArray()) {
        continue;
      }
      try {
        addPlayerEntities(result, method.invoke(level));
        if (!result.isEmpty()) {
          return result;
        }
      } catch (Throwable ignored) {
        // Try the next collection-like method.
      }
    }
    return result;
  }

  private static void addPlayerEntities(List<Object> result, Object value) {
    if (value == null) {
      return;
    }
    if (value instanceof Iterable<?> iterable) {
      for (Object entry : iterable) {
        addPlayerEntity(result, entry);
      }
      return;
    }
    if (value.getClass().isArray()) {
      int length = java.lang.reflect.Array.getLength(value);
      for (int index = 0; index < length; index += 1) {
        addPlayerEntity(result, java.lang.reflect.Array.get(value, index));
      }
    }
  }

  private static void addPlayerEntity(List<Object> result, Object entity) {
    if (entity != null && profileFromPlayer(entity) != null && !result.contains(entity)) {
      result.add(entity);
    }
  }

  private static void setEntityGlowing(Object entity, boolean glowing) {
    if (entity == null) {
      return;
    }
    for (String methodName : new String[] { "setGlowingTag", "setGlowing", "method_5834" }) {
      if (invokeBooleanSetter(entity, methodName, glowing)) {
        return;
      }
    }
    for (Method method : entity.getClass().getMethods()) {
      if (method.getParameterCount() == 1
          && method.getParameterTypes()[0] == Boolean.TYPE
          && method.getName().toLowerCase(java.util.Locale.ROOT).contains("glow")) {
        try {
          method.invoke(entity, glowing);
          return;
        } catch (Throwable ignored) {
          // Try the next glow-like setter.
        }
      }
    }
  }

  private static boolean invokeBooleanSetter(Object target, String methodName, boolean value) {
    try {
      target.getClass().getMethod(methodName, boolean.class).invoke(target, value);
      return true;
    } catch (Throwable ignored) {
      return false;
    }
  }

  private static UUID parseUuid(Object value) {
    if (value instanceof UUID uuid) {
      return uuid;
    }
    String text = String.valueOf(value == null ? "" : value).trim();
    if (text.isBlank()) {
      return null;
    }
    try {
      return UUID.fromString(text);
    } catch (RuntimeException ignored) {
      String compact = text.replace("-", "");
      if (!compact.matches("[0-9a-fA-F]{32}")) {
        return null;
      }
      return UUID.fromString(compact.substring(0, 8) + "-" + compact.substring(8, 12) + "-"
          + compact.substring(12, 16) + "-" + compact.substring(16, 20) + "-" + compact.substring(20));
    }
  }

  private static FriendRequest requestEntry(UUID uuid, String name, long timestampMs) {
    Object texture = skinTextures.get(uuid);
    PlayerStatus current = onlinePlayers.get(uuid);
    if (texture == null && current != null) {
      texture = current.skinTexture();
    }
    String safeName = cleanName(name);
    if (safeName.isBlank() && current != null) {
      safeName = current.name;
    }
    if (safeName.isBlank()) {
      safeName = "Player";
    }
    int[] headPixels = skinHeadPixels.get(uuid);
    if ((headPixels == null || headPixels.length < 64) && texture == null) {
      requestSkinHeadLookup(uuid, safeName);
    }
    return new FriendRequest(uuid, safeName, timestampMs, texture, headPixels);
  }

  private static void sendFriendPayload(String type, UUID targetUuid) {
    Profile local = localProfile();
    if (local == null || targetUuid == null) {
      return;
    }
    String name = cleanName(local.name);
    if (name.isBlank()) {
      name = "Player";
    }
    sendHiddenChat(REQUEST_PREFIX + type + ":" + local.uuid + ":" + targetUuid + ":" + name + REQUEST_SUFFIX);
  }

  private static boolean sendInvitePayload(UUID targetUuid, String host, String port) {
    Profile local = localProfile();
    if (local == null || targetUuid == null) {
      return false;
    }
    String name = cleanName(local.name);
    if (name.isBlank()) {
      name = "Player";
    }
    return sendHiddenChat(INVITE_PREFIX + local.uuid + ":" + targetUuid + ":" + sanitizeHost(host) + ":" + parsePort(port) + ":" + name + REQUEST_SUFFIX);
  }

  private static void refreshHostStatus() {
    Object client = minecraftClient();
    Object server = integratedServer(client);
    if (server == null) {
      hostedAddress = "";
      hostedLanAddress = "";
      hostedPort = 0;
      if (hostStatus.startsWith("Internet-Host") || hostStatus.startsWith("LAN aktiv")) {
        hostStatus = "Eigene Welt noch nicht gehostet.";
      }
      return;
    }
    int port = serverPort(server);
    if (port > 0) {
      hostedPort = port;
      String host = localLanAddress();
      String lanAddress = (host.isBlank() ? "127.0.0.1" : host) + ":" + port;
      if (hostedAddress.isBlank() || hostedAddress.equals(hostedLanAddress)) {
        hostedAddress = lanAddress;
        hostStatus = "LAN aktiv: " + hostedAddress + ". Internet: Port " + port + " am Router freigeben oder VPN nutzen.";
      }
      hostedLanAddress = lanAddress;
    }
  }

  private static Object integratedServer(Object client) {
    if (client == null) {
      return null;
    }
    Object server = invokeAny(client, "getSingleplayerServer", "getServer", "method_1576");
    return server != null ? server : getAnyField(client, "singleplayerServer", "integratedServer", "field_1747");
  }

  private static boolean publishIntegratedServer(Object server, int preferredPort) {
    if (server == null) {
      return false;
    }
    if (serverPort(server) > 0) {
      return true;
    }
    for (Method method : allMethods(server.getClass())) {
      if (method.getParameterCount() != 3 || !isBooleanReturn(method)) {
        continue;
      }
      if (!isPublishMethodName(method.getName()) && !hasLanPublishShape(method.getParameterTypes())) {
        continue;
      }
      Object[] args = lanPublishArguments(method.getParameterTypes(), preferredPort);
      if (args == null) {
        continue;
      }
      try {
        method.setAccessible(true);
        Object result = method.invoke(server, args);
        if (Boolean.TRUE.equals(result) || serverPort(server) > 0) {
          return true;
        }
      } catch (Throwable ignored) {
        // Try another LAN publishing signature.
      }
    }
    return false;
  }

  private static boolean isPublishMethodName(String name) {
    String lower = String.valueOf(name == null ? "" : name).toLowerCase(java.util.Locale.ROOT);
    return lower.contains("publish") || lower.contains("open") || "method_30611".equals(lower);
  }

  private static boolean hasLanPublishShape(Class<?>[] types) {
    boolean hasGameMode = false;
    boolean hasBoolean = false;
    boolean hasPort = false;
    for (Class<?> type : types) {
      if (type == Boolean.TYPE) {
        hasBoolean = true;
      } else if (type == Integer.TYPE) {
        hasPort = true;
      } else if (type.isEnum() || type.getName().toLowerCase(java.util.Locale.ROOT).contains("gamemode") || type.getName().toLowerCase(java.util.Locale.ROOT).contains("class_1934")) {
        hasGameMode = true;
      }
    }
    return hasGameMode && hasBoolean && hasPort;
  }

  private static Object[] lanPublishArguments(Class<?>[] types, int preferredPort) {
    Object[] args = new Object[types.length];
    for (int index = 0; index < types.length; index += 1) {
      Class<?> type = types[index];
      if (type == Boolean.TYPE) {
        args[index] = Boolean.FALSE;
      } else if (type == Integer.TYPE) {
        args[index] = Math.max(0, preferredPort);
      } else {
        Object mode = firstGameModeValue(type);
        if (mode == null && !type.isPrimitive()) {
          mode = null;
        }
        args[index] = mode;
      }
    }
    return args;
  }

  private static Object firstGameModeValue(Class<?> type) {
    if (type == null) {
      return null;
    }
    if (type.isEnum()) {
      Object[] constants = type.getEnumConstants();
      if (constants == null || constants.length == 0) {
        return null;
      }
      for (Object constant : constants) {
        if ("SURVIVAL".equalsIgnoreCase(String.valueOf(constant))) {
          return constant;
        }
      }
      return constants[0];
    }
    for (String fieldName : new String[] { "SURVIVAL", "DEFAULT_MODE", "field_9215", "field_9216" }) {
      try {
        return type.getField(fieldName).get(null);
      } catch (Throwable ignored) {
        // Try the next known game mode field.
      }
    }
    return null;
  }

  private static boolean isBooleanReturn(Method method) {
    Class<?> type = method.getReturnType();
    return type == Boolean.TYPE || type == Boolean.class;
  }

  private static List<Method> allMethods(Class<?> type) {
    List<Method> methods = new ArrayList<>();
    while (type != null) {
      for (Method method : type.getDeclaredMethods()) {
        methods.add(method);
      }
      type = type.getSuperclass();
    }
    return methods;
  }

  private static int serverPort(Object server) {
    Object value = invokeAny(server, "getPort", "getServerPort", "getLocalPort", "method_30612", "method_3828");
    int parsed = parsePort(value);
    if (parsed > 0) {
      return parsed;
    }
    for (String fieldName : new String[] { "port", "publishedPort", "serverPort" }) {
      parsed = parsePort(getAnyField(server, fieldName));
      if (parsed > 0) {
        return parsed;
      }
    }
    return 0;
  }

  private static String[] splitHostedAddress() {
    String address = String.valueOf(hostedAddress == null ? "" : hostedAddress).trim();
    int separator = address.lastIndexOf(':');
    if (separator <= 0 || separator >= address.length() - 1) {
      return new String[] { "", "" };
    }
    return new String[] { sanitizeHost(address.substring(0, separator)), String.valueOf(parsePort(address.substring(separator + 1))) };
  }

  private static String localLanAddress() {
    try {
      Enumeration<NetworkInterface> interfaces = NetworkInterface.getNetworkInterfaces();
      while (interfaces.hasMoreElements()) {
        NetworkInterface networkInterface = interfaces.nextElement();
        if (!networkInterface.isUp() || networkInterface.isLoopback() || networkInterface.isVirtual()) {
          continue;
        }
        Enumeration<InetAddress> addresses = networkInterface.getInetAddresses();
        while (addresses.hasMoreElements()) {
          InetAddress address = addresses.nextElement();
          if (address instanceof Inet4Address && !address.isLoopbackAddress() && !address.isLinkLocalAddress()) {
            return address.getHostAddress();
          }
        }
      }
    } catch (Throwable ignored) {
      // Fall back below.
    }
    return "";
  }

  private static UpnpMapping tryMapInternetPort(String lanHost, int port) {
    String localHost = sanitizeHost(lanHost);
    if (localHost.isBlank() || port <= 0) {
      return UpnpMapping.NONE;
    }
    UpnpGateway gateway = discoverUpnpGateway();
    if (gateway == null) {
      return UpnpMapping.NONE;
    }
    String publicIp = upnpExternalIp(gateway);
    if (!isPublicAddress(publicIp)) {
      return UpnpMapping.NONE;
    }
    if (!upnpAddPortMapping(gateway, localHost, port)) {
      return UpnpMapping.NONE;
    }
    return new UpnpMapping(true, publicIp + ":" + port);
  }

  private static UpnpGateway discoverUpnpGateway() {
    String[] searchTargets = {
        "urn:schemas-upnp-org:service:WANIPConnection:1",
        "urn:schemas-upnp-org:service:WANPPPConnection:1",
        "urn:schemas-upnp-org:device:InternetGatewayDevice:1"
    };
    for (String target : searchTargets) {
      UpnpGateway gateway = discoverUpnpGateway(target);
      if (gateway != null) {
        return gateway;
      }
    }
    return null;
  }

  private static UpnpGateway discoverUpnpGateway(String searchTarget) {
    String request = "M-SEARCH * HTTP/1.1\r\n"
        + "HOST: 239.255.255.250:1900\r\n"
        + "MAN: \"ssdp:discover\"\r\n"
        + "MX: 2\r\n"
        + "ST: " + searchTarget + "\r\n\r\n";
    byte[] payload = request.getBytes(StandardCharsets.UTF_8);
    try (DatagramSocket socket = new DatagramSocket()) {
      socket.setSoTimeout(1600);
      socket.send(new DatagramPacket(payload, payload.length, new InetSocketAddress("239.255.255.250", 1900)));
      long deadline = System.currentTimeMillis() + 2200L;
      while (System.currentTimeMillis() < deadline) {
        byte[] buffer = new byte[2048];
        DatagramPacket packet = new DatagramPacket(buffer, buffer.length);
        try {
          socket.receive(packet);
        } catch (SocketTimeoutException timeout) {
          break;
        }
        String response = new String(packet.getData(), 0, packet.getLength(), StandardCharsets.UTF_8);
        String location = ssdpHeader(response, "location");
        UpnpGateway gateway = gatewayFromRootDescription(location);
        if (gateway != null) {
          return gateway;
        }
      }
    } catch (Throwable ignored) {
      return null;
    }
    return null;
  }

  private static String ssdpHeader(String response, String headerName) {
    String target = String.valueOf(headerName == null ? "" : headerName).toLowerCase(java.util.Locale.ROOT) + ":";
    for (String line : String.valueOf(response == null ? "" : response).split("\\r?\\n")) {
      String trimmed = line.trim();
      if (trimmed.toLowerCase(java.util.Locale.ROOT).startsWith(target)) {
        return trimmed.substring(target.length()).trim();
      }
    }
    return "";
  }

  private static UpnpGateway gatewayFromRootDescription(String location) {
    if (String.valueOf(location == null ? "" : location).isBlank()) {
      return null;
    }
    String xml = fetchHttpText(location, 260000);
    if (xml.isBlank()) {
      return null;
    }
    String urlBase = tagValue(xml, "URLBase");
    String base = urlBase.isBlank() ? location : urlBase;
    Matcher serviceMatcher = Pattern.compile("<service\\b[^>]*>(.*?)</service>", Pattern.CASE_INSENSITIVE | Pattern.DOTALL).matcher(xml);
    while (serviceMatcher.find()) {
      String serviceXml = serviceMatcher.group(1);
      String serviceType = tagValue(serviceXml, "serviceType");
      if (!serviceType.contains("WANIPConnection") && !serviceType.contains("WANPPPConnection")) {
        continue;
      }
      String controlUrl = tagValue(serviceXml, "controlURL");
      String absoluteControlUrl = resolveUrl(base, controlUrl);
      if (!absoluteControlUrl.isBlank()) {
        return new UpnpGateway(absoluteControlUrl, serviceType);
      }
    }
    return null;
  }

  private static String upnpExternalIp(UpnpGateway gateway) {
    String response = upnpSoap(gateway, "GetExternalIPAddress", "");
    return sanitizeHost(tagValue(response, "NewExternalIPAddress"));
  }

  private static boolean upnpAddPortMapping(UpnpGateway gateway, String localHost, int port) {
    String body = ""
        + "<NewRemoteHost></NewRemoteHost>"
        + "<NewExternalPort>" + port + "</NewExternalPort>"
        + "<NewProtocol>TCP</NewProtocol>"
        + "<NewInternalPort>" + port + "</NewInternalPort>"
        + "<NewInternalClient>" + localHost + "</NewInternalClient>"
        + "<NewEnabled>1</NewEnabled>"
        + "<NewPortMappingDescription>X Client World</NewPortMappingDescription>"
        + "<NewLeaseDuration>0</NewLeaseDuration>";
    String response = upnpSoap(gateway, "AddPortMapping", body);
    return !response.isBlank();
  }

  private static String upnpSoap(UpnpGateway gateway, String action, String body) {
    if (gateway == null || gateway.controlUrl.isBlank() || gateway.serviceType.isBlank()) {
      return "";
    }
    String envelope = "<?xml version=\"1.0\"?>"
        + "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\" s:encodingStyle=\"http://schemas.xmlsoap.org/soap/encoding/\">"
        + "<s:Body><u:" + action + " xmlns:u=\"" + gateway.serviceType + "\">"
        + String.valueOf(body == null ? "" : body)
        + "</u:" + action + "></s:Body></s:Envelope>";
    HttpURLConnection connection = null;
    try {
      byte[] bytes = envelope.getBytes(StandardCharsets.UTF_8);
      connection = (HttpURLConnection) URI.create(gateway.controlUrl).toURL().openConnection();
      connection.setConnectTimeout(2500);
      connection.setReadTimeout(3500);
      connection.setRequestMethod("POST");
      connection.setDoOutput(true);
      connection.setRequestProperty("Content-Type", "text/xml; charset=\"utf-8\"");
      connection.setRequestProperty("SOAPACTION", "\"" + gateway.serviceType + "#" + action + "\"");
      connection.setRequestProperty("Content-Length", String.valueOf(bytes.length));
      connection.getOutputStream().write(bytes);
      int status = connection.getResponseCode();
      if (status < 200 || status >= 300) {
        return "";
      }
      return readConnectionText(connection, 120000);
    } catch (Throwable ignored) {
      return "";
    } finally {
      if (connection != null) {
        connection.disconnect();
      }
    }
  }

  private static String fetchHttpText(String url, int maxChars) {
    HttpURLConnection connection = null;
    try {
      connection = (HttpURLConnection) URI.create(url).toURL().openConnection();
      connection.setConnectTimeout(2500);
      connection.setReadTimeout(3500);
      connection.setRequestProperty("Accept", "text/xml,application/xml,text/plain");
      int status = connection.getResponseCode();
      if (status < 200 || status >= 300) {
        return "";
      }
      return readConnectionText(connection, maxChars);
    } catch (Throwable ignored) {
      return "";
    } finally {
      if (connection != null) {
        connection.disconnect();
      }
    }
  }

  private static String readConnectionText(HttpURLConnection connection, int maxChars) throws IOException {
    try (java.io.BufferedReader reader = new java.io.BufferedReader(new java.io.InputStreamReader(connection.getInputStream(), StandardCharsets.UTF_8))) {
      StringBuilder body = new StringBuilder();
      String line;
      while ((line = reader.readLine()) != null && body.length() < Math.max(1024, maxChars)) {
        body.append(line).append('\n');
      }
      return body.toString();
    }
  }

  private static String tagValue(String xml, String tagName) {
    Matcher matcher = Pattern.compile("<\\s*" + Pattern.quote(String.valueOf(tagName)) + "\\s*>\\s*(.*?)\\s*</\\s*" + Pattern.quote(String.valueOf(tagName)) + "\\s*>", Pattern.CASE_INSENSITIVE | Pattern.DOTALL).matcher(String.valueOf(xml == null ? "" : xml));
    return matcher.find() ? unescapeXml(matcher.group(1).trim()) : "";
