        .replace("&lt;", "<")
        .replace("&gt;", ">")
        .replace("&quot;", "\"")
        .replace("&apos;", "'")
        .replace("&amp;", "&");
  }

  private static String resolveUrl(String base, String relative) {
    try {
      URI baseUri = URI.create(String.valueOf(base == null ? "" : base).trim());
      return baseUri.resolve(String.valueOf(relative == null ? "" : relative).trim()).toString();
    } catch (Throwable ignored) {
