  private static final String INVITE_PREFIX = "\u2063XCINV:";
  private static final String REQUEST_SUFFIX = "\u2063";
  private static final Pattern REQUEST_PATTERN = Pattern.compile(REQUEST_PREFIX + "(REQ|ACC|DEN):([0-9a-fA-F-]{32,36}):([0-9a-fA-F-]{32,36}):([A-Za-z0-9_]{1,16})" + REQUEST_SUFFIX);
  private static final Pattern INVITE_PATTERN = Pattern.compile(INVITE_PREFIX + "([0-9a-fA-F-]{32,36}):([0-9a-fA-F-]{32,36}):([A-Za-z0-9_.-]{1,253}):(\\d{1,5}):([A-Za-z0-9_]{1,16})" + REQUEST_SUFFIX);
  private static final Pattern SECTION_PATTERN_TEMPLATE = Pattern.compile("\"%s\"\\s*:\\s*\\[(.*?)\\]", Pattern.DOTALL);
  private static final Pattern ENTRY_PATTERN = Pattern.compile("\\{\\s*\"uuid\"\\s*:\\s*\"([^\"]+)\"\\s*,\\s*\"name\"\\s*:\\s*\"([^\"]*)\"\\s*\\}");
  private static final int RECENT_LIMIT = 6;
  private static final long RECENT_MS = 18000L;
  private static final long REQUEST_MS = 900000L;
  private static final long SKIN_LOOKUP_RETRY_MS = 900000L;
  private static final int MAX_SKIN_BYTES = 512 * 1024;
  private static final int SKIN_HEAD_CACHE_LIMIT = 256;
  private static final Object LOCK = new Object();
  private static final Map<UUID, PlayerStatus> onlinePlayers = new LinkedHashMap<>();
  private static final Map<UUID, String> friends = new LinkedHashMap<>();
  private static final Map<UUID, String> knownXClients = new LinkedHashMap<>();
  private static final Map<UUID, Integer> knownNameColors = new LinkedHashMap<>();
  private static final Map<UUID, Object> skinTextures = new LinkedHashMap<>();
  private static final Map<UUID, int[]> skinHeadPixels = new LinkedHashMap<>();
  private static final Map<UUID, Long> skinLookupTimes = new LinkedHashMap<>();
  private static final Map<UUID, String> pendingSkinLookups = new LinkedHashMap<>();
  private static final Map<UUID, FriendRequest> incomingRequests = new LinkedHashMap<>();
  private static final Map<UUID, FriendRequest> outgoingRequests = new LinkedHashMap<>();
  private static final Map<UUID, WorldInvite> worldInvites = new LinkedHashMap<>();
  private static final Set<UUID> glowingFriends = new LinkedHashSet<>();
  private static final List<ChatEntry> recentMessages = new ArrayList<>();
  private static volatile boolean loaded;
  private static volatile boolean started;
  private static volatile boolean skinResolverStarted;
  private static volatile boolean messageEventsRegistered;
  private static volatile boolean keepHostedWorldOnline;
  private static volatile String hostedAddress = "";
  private static volatile String hostedLanAddress = "";
  private static volatile int hostedPort;
  private static volatile String hostStatus = "Eigene Welt noch nicht gehostet.";

  private SocialManager() {
  }

  static void start() {
    if (SOCIAL_DISABLED) {
      return;
    }
    if (started) {
      return;
    }
    started = true;
    load();
    registerMessageEvents();
    startSkinResolver();
    Thread watcher = new Thread(SocialManager::watchPlayers, "X Client Social");
    watcher.setDaemon(true);
    watcher.start();
  }

  static PlayerStatus[] players() {
    if (SOCIAL_DISABLED) {
      return new PlayerStatus[0];
    }
    load();
    synchronized (LOCK) {
      long cutoff = System.currentTimeMillis() - 15000L;
      List<PlayerStatus> result = new ArrayList<>();
      for (PlayerStatus player : onlinePlayers.values()) {
        if (player.lastSeenMs >= cutoff) {
          result.add(player);
        }
      }
      for (Map.Entry<UUID, String> entry : friends.entrySet()) {
        boolean alreadyVisible = false;
        for (PlayerStatus player : result) {
          if (entry.getKey().equals(player.uuid)) {
            alreadyVisible = true;
            break;
          }
        }
        if (!alreadyVisible) {
          requestSkinHeadLookup(entry.getKey(), entry.getValue());
          result.add(new PlayerStatus(entry.getKey(), entry.getValue(), knownXClients.containsKey(entry.getKey()), true, false, 0L, skinTextures.get(entry.getKey()), skinHeadPixels.get(entry.getKey())));
        }
      }
      return result.stream()
          .sorted(Comparator
              .comparing((PlayerStatus player) -> !player.self)
              .thenComparing((PlayerStatus player) -> !player.friend)
              .thenComparing((PlayerStatus player) -> !player.xClient)
              .thenComparing((PlayerStatus player) -> player.name.toLowerCase(java.util.Locale.ROOT)))
          .toArray(PlayerStatus[]::new);
    }
  }

  static ChatEntry[] recentMessages() {
    if (SOCIAL_DISABLED) {
      return new ChatEntry[0];
    }
    load();
    synchronized (LOCK) {
      trimRecentLocked();
      return recentMessages.toArray(ChatEntry[]::new);
    }
  }

  static int xClientCount() {
    if (SOCIAL_DISABLED) {
      return 0;
    }
    int count = 0;
    for (PlayerStatus player : players()) {
      if (player.xClient) {
        count += 1;
      }
    }
    return count;
  }

