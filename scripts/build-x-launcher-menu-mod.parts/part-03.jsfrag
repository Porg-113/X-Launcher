    }
  }

  private static boolean isPublicAddress(String value) {
    try {
      InetAddress address = InetAddress.getByName(sanitizeHost(value));
      if (!(address instanceof Inet4Address) || address.isAnyLocalAddress() || address.isLoopbackAddress()
          || address.isLinkLocalAddress() || address.isSiteLocalAddress() || address.isMulticastAddress()) {
        return false;
      }
      byte[] raw = address.getAddress();
      int first = raw[0] & 0xFF;
      int second = raw[1] & 0xFF;
      return !(first == 100 && second >= 64 && second <= 127);
    } catch (Throwable ignored) {
      return false;
    }
  }

  private static String sanitizeHost(String value) {
    return String.valueOf(value == null ? "" : value).replaceAll("[^A-Za-z0-9_.-]", "").trim();
  }

  private static int parsePort(Object value) {
    if (value instanceof Number number) {
      int port = number.intValue();
      return port > 0 && port <= 65535 ? port : 0;
    }
    try {
      int port = Integer.parseInt(String.valueOf(value == null ? "" : value).trim());
      return port > 0 && port <= 65535 ? port : 0;
    } catch (RuntimeException ignored) {
      return 0;
    }
  }

  private static Profile localProfile() {
    Object client = minecraftClient();
    if (client == null) {
      return null;
    }
    Object player = getAnyField(client, "player", "field_1724");
    Profile profile = profileFromPlayer(player);
    return profile != null ? profile : profileFromClientUser(client);
  }

  private static boolean sendHiddenChat(String message) {
    Object client = minecraftClient();
    Object player = getAnyField(client, "player", "field_1724");
    Object connection = getAnyField(player, "connection", "networkHandler", "field_3944");
    return invokeStringSender(connection, message, "sendChat", "sendChatMessage", "method_45729", "method_3142")
        || invokeStringSender(player, message, "chat", "sendChat", "sendChatMessage", "method_7353", "method_3142");
  }

  private static boolean invokeStringSender(Object target, String message, String... names) {
    if (target == null) {
      return false;
    }
    for (String name : names) {
      try {
        target.getClass().getMethod(name, String.class).invoke(target, message);
        return true;
      } catch (Throwable ignored) {
        // Try the next chat sender name.
      }
    }
    for (Method method : target.getClass().getMethods()) {
      if (method.getParameterCount() != 1 || method.getParameterTypes()[0] != String.class) {
        continue;
      }
      String lower = method.getName().toLowerCase(java.util.Locale.ROOT);
      if (!lower.contains("chat")) {
        continue;
      }
      try {
        method.invoke(target, message);
        return true;
      } catch (Throwable ignored) {
        // Try another chat-like sender.
      }
    }
    return false;
  }

  private static void registerMessageEvents() {
    if (messageEventsRegistered) {
      return;
    }
    messageEventsRegistered = true;
    registerMessageEvent("net.fabricmc.fabric.api.client.message.v1.ClientSendMessageEvents", "MODIFY_CHAT", true);
    registerMessageEvent("net.fabricmc.fabric.api.client.message.v1.ClientReceiveMessageEvents", "ALLOW_CHAT", false);
    registerMessageEvent("net.fabricmc.fabric.api.client.message.v1.ClientReceiveMessageEvents", "CHAT", false);
    registerMessageEvent("net.fabricmc.fabric.api.client.message.v1.ClientReceiveMessageEvents", "GAME", false);
  }

  private static void registerMessageEvent(String className, String fieldName, boolean outgoing) {
    try {
      Object event = Class.forName(className).getField(fieldName).get(null);
      Object invoker = event.getClass().getMethod("invoker").invoke(event);
      Class<?> listenerType = listenerInterface(invoker);
      if (listenerType == null) {
        return;
      }
      InvocationHandler handler = (proxy, method, args) -> {
        if (method.getDeclaringClass() == Object.class) {
          return method.invoke(SocialManager.class, args);
        }
        if (outgoing && method.getReturnType().equals(String.class) && args != null && args.length > 0 && args[0] instanceof String text) {
          return tagOutgoingMessage(text);
        }
        boolean hiddenMessage = parseIncomingMessage(args);
        if (method.getReturnType().equals(Boolean.TYPE)) {
          return !hiddenMessage;
        }
        if (method.getReturnType().equals(String.class) && args != null && args.length > 0 && args[0] instanceof String text) {
          return text;
        }
        return null;
      };
      Object listener = Proxy.newProxyInstance(listenerType.getClassLoader(), new Class<?>[] { listenerType }, handler);
      event.getClass().getMethod("register", Object.class).invoke(event, listener);
    } catch (Throwable ignored) {
      // Fabric message API names changed across versions; missing hooks only disable auto-detection for that runtime.
    }
  }

  private static Class<?> listenerInterface(Object invoker) {
    if (invoker == null) {
      return null;
    }
    for (Class<?> candidate : invoker.getClass().getInterfaces()) {
      if (!candidate.getName().startsWith("java.")) {
        return candidate;
      }
    }
    return null;
  }

  private static String tagOutgoingMessage(String message) {
    String normalized = String.valueOf(message == null ? "" : message);
    if (normalized.isBlank() || normalized.startsWith("/") || normalized.contains(MARKER_PREFIX) || normalized.contains(REQUEST_PREFIX) || normalized.contains(INVITE_PREFIX)) {
      return normalized;
    }
    return normalized + MARKER_PREFIX + MOD_PROTOCOL_VERSION + ":"
        + String.format(java.util.Locale.ROOT, "%06X", NameTagSettings.color()) + "\u2063";
  }

  private static boolean parseIncomingMessage(Object[] args) {
    if (args == null || args.length == 0) {
      return false;
    }
    String text = "";
    Profile sender = null;
    for (Object arg : args) {
      if (arg == null) {
        continue;
      }
      Profile profile = profileFromGameProfile(arg);
      if (profile != null) {
        sender = profile;
        continue;
      }
      String candidateText = componentText(arg);
      if (candidateText.contains(REQUEST_PREFIX) || candidateText.contains(INVITE_PREFIX)) {
        text = candidateText;
      } else if (candidateText.contains(MARKER_PREFIX)) {
        text = candidateText;
      } else if (text.isBlank() && !candidateText.isBlank() && candidateText.length() < 512) {
        text = candidateText;
      }
    }
    if (text.contains(REQUEST_PREFIX) && handleFriendPayload(text, sender)) {
      return true;
    }
    if (text.contains(INVITE_PREFIX) && handleInvitePayload(text, sender)) {
      return true;
    }
    Matcher marker = MARKER_PATTERN.matcher(text);
    if (!marker.find()) {
      return false;
    }
    if (sender == null) {
      sender = profileFromChatText(text);
    }
    if (sender == null) {
      return false;
    }
    markXClient(sender.uuid, sender.name, Integer.parseInt(marker.group(1), 16));
    synchronized (LOCK) {
      recentMessages.add(0, new ChatEntry(sender.uuid, cleanName(sender.name), System.currentTimeMillis()));
      trimRecentLocked();
    }
    return false;
  }

  private static boolean handleFriendPayload(String text, Profile sender) {
    Matcher matcher = REQUEST_PATTERN.matcher(String.valueOf(text == null ? "" : text));
    boolean found = false;
    while (matcher.find()) {
      found = true;
      UUID fromUuid = parseUuid(matcher.group(2));
      UUID toUuid = parseUuid(matcher.group(3));
      String type = matcher.group(1);
      String fromName = cleanName(matcher.group(4));
      Profile local = localProfile();
      if (local == null || fromUuid == null || toUuid == null || fromUuid.equals(local.uuid) || !toUuid.equals(local.uuid)) {
        continue;
      }
      if (fromName.isBlank() && sender != null) {
        fromName = cleanName(sender.name);
      }
      if (fromName.isBlank()) {
        fromName = "Player";
      }
      boolean accepted = false;
      load();
      synchronized (LOCK) {
        trimRequestsLocked();
        knownXClients.put(fromUuid, fromName);
        if ("REQ".equals(type)) {
          if (!friends.containsKey(fromUuid)) {
            incomingRequests.put(fromUuid, requestEntry(fromUuid, fromName, System.currentTimeMillis()));
          }
        } else if ("ACC".equals(type)) {
          outgoingRequests.remove(fromUuid);
          incomingRequests.remove(fromUuid);
          friends.put(fromUuid, fromName);
          accepted = true;
          saveLocked();
        } else if ("DEN".equals(type)) {
          outgoingRequests.remove(fromUuid);
          incomingRequests.remove(fromUuid);
        }
        PlayerStatus current = onlinePlayers.get(fromUuid);
        if (current != null) {
          onlinePlayers.put(fromUuid, current.withName(fromName).withFlags(true, friends.containsKey(fromUuid)));
        }
      }
      if (accepted) {
        applyFriendGlow(minecraftClient(), null);
      }
    }
    return found;
  }

  private static boolean handleInvitePayload(String text, Profile sender) {
    Matcher matcher = INVITE_PATTERN.matcher(String.valueOf(text == null ? "" : text));
    boolean found = false;
    while (matcher.find()) {
      found = true;
      UUID fromUuid = parseUuid(matcher.group(1));
      UUID toUuid = parseUuid(matcher.group(2));
      String host = sanitizeHost(matcher.group(3));
      int port = parsePort(matcher.group(4));
      String fromName = cleanName(matcher.group(5));
      Profile local = localProfile();
      if (local == null || fromUuid == null || toUuid == null || fromUuid.equals(local.uuid) || !toUuid.equals(local.uuid) || host.isBlank() || port <= 0) {
        continue;
      }
      if (fromName.isBlank() && sender != null) {
        fromName = cleanName(sender.name);
      }
      if (fromName.isBlank()) {
        fromName = "Player";
      }
      load();
      synchronized (LOCK) {
        knownXClients.put(fromUuid, fromName);
        worldInvites.put(fromUuid, new WorldInvite(fromUuid, fromName, host, port, System.currentTimeMillis()));
        trimWorldInvitesLocked();
      }
    }
    return found;
  }

  private static Profile profileFromChatText(String text) {
    String clean = text == null ? "" : MARKER_PATTERN.matcher(text).replaceAll("");
    Matcher angle = Pattern.compile("^\\s*<([^>]{1,32})>").matcher(clean);
    String name = angle.find() ? angle.group(1) : "";
    if (name.isBlank()) {
      Matcher prefix = Pattern.compile("^\\s*([A-Za-z0-9_]{3,16})\\s*:").matcher(clean);
      if (prefix.find()) {
        name = prefix.group(1);
      }
    }
    if (name.isBlank()) {
      return null;
    }
    synchronized (LOCK) {
      for (PlayerStatus player : onlinePlayers.values()) {
        if (player.name.equalsIgnoreCase(name)) {
          return new Profile(player.uuid, player.name, player.skinTexture());
        }
      }
    }
    return null;
  }

  private static void trimRecentLocked() {
    long cutoff = System.currentTimeMillis() - RECENT_MS;
    recentMessages.removeIf((entry) -> entry.timestampMs < cutoff);
    while (recentMessages.size() > RECENT_LIMIT) {
      recentMessages.remove(recentMessages.size() - 1);
    }
  }

  private static void trimRequestsLocked() {
    long cutoff = System.currentTimeMillis() - REQUEST_MS;
    incomingRequests.entrySet().removeIf((entry) -> entry.getValue().timestampMs < cutoff);
    outgoingRequests.entrySet().removeIf((entry) -> entry.getValue().timestampMs < cutoff);
  }

  private static void trimWorldInvitesLocked() {
    long cutoff = System.currentTimeMillis() - REQUEST_MS;
    worldInvites.entrySet().removeIf((entry) -> entry.getValue().timestampMs < cutoff);
    while (worldInvites.size() > 4) {
      UUID first = worldInvites.keySet().iterator().next();
      worldInvites.remove(first);
    }
  }

  private static String componentText(Object component) {
    if (component == null) {
      return "";
    }
    if (component instanceof String text) {
      return text;
    }
    for (String methodName : new String[] { "getString", "getContents", "getText", "method_10851", "method_54160" }) {
      try {
        Object value = component.getClass().getMethod(methodName).invoke(component);
        if (value != null) {
          return String.valueOf(value);
        }
      } catch (Throwable ignored) {
        // Try the next common text method.
      }
    }
    return String.valueOf(component);
  }

  private static Object minecraftClient() {
    Object official = staticInvoke("net.minecraft.client.Minecraft", "getInstance");
    if (official != null) {
      return official;
    }
    return staticInvoke("net.minecraft.class_310", "method_1551");
  }

  private static Object staticInvoke(String className, String methodName) {
    try {
      return Class.forName(className).getMethod(methodName).invoke(null);
    } catch (Throwable ignored) {
      return null;
    }
  }

  private static Object getAnyField(Object target, String... names) {
    if (target == null) {
      return null;
    }
    for (String name : names) {
      try {
        return target.getClass().getField(name).get(target);
      } catch (Throwable ignored) {
        try {
          java.lang.reflect.Field field = target.getClass().getDeclaredField(name);
          field.setAccessible(true);
          return field.get(target);
        } catch (Throwable alsoIgnored) {
          // Try the next field name.
        }
      }
    }
    return null;
  }

  private static Object invokeAny(Object target, String... names) {
    if (target == null) {
      return null;
    }
    for (String name : names) {
      try {
        return target.getClass().getMethod(name).invoke(target);
      } catch (Throwable ignored) {
        // Try the next method name.
      }
    }
    return null;
  }

  private static void load() {
    if (loaded) {
      return;
    }
    loaded = true;
    Path path = statePath();
    if (!Files.exists(path)) {
      return;
    }
    try {
      String json = Files.readString(path, StandardCharsets.UTF_8);
      synchronized (LOCK) {
        readEntries(json, "friends", friends);
        readEntries(json, "xClients", knownXClients);
        keepHostedWorldOnline = readBoolean(json, "keepHostedWorldOnline", keepHostedWorldOnline);
      }
    } catch (IOException | RuntimeException ignored) {
      // Social state is optional.
    }
  }

  private static void readEntries(String json, String section, Map<UUID, String> target) {
    Pattern sectionPattern = Pattern.compile(String.format(SECTION_PATTERN_TEMPLATE.pattern(), section), Pattern.DOTALL);
    Matcher sectionMatcher = sectionPattern.matcher(json);
    if (!sectionMatcher.find()) {
      return;
    }
    Matcher entryMatcher = ENTRY_PATTERN.matcher(sectionMatcher.group(1));
    while (entryMatcher.find()) {
      try {
        target.put(UUID.fromString(entryMatcher.group(1)), cleanName(unescapeJson(entryMatcher.group(2))));
      } catch (RuntimeException ignored) {
        // Skip broken entries.
      }
    }
  }

  private static boolean readBoolean(String json, String key, boolean fallback) {
    Matcher matcher = Pattern.compile("\"" + Pattern.quote(String.valueOf(key)) + "\"\\s*:\\s*(true|false)", Pattern.CASE_INSENSITIVE).matcher(String.valueOf(json == null ? "" : json));
    return matcher.find() ? Boolean.parseBoolean(matcher.group(1)) : fallback;
  }

  private static void saveLocked() {
    Path path = statePath();
    try {
      Files.createDirectories(path.getParent());
      String json = "{\n"
          + "  \"friends\": " + entriesJson(friends) + ",\n"
          + "  \"xClients\": " + entriesJson(knownXClients) + ",\n"
          + "  \"keepHostedWorldOnline\": " + keepHostedWorldOnline + "\n"
          + "}\n";
      Files.writeString(path, json, StandardCharsets.UTF_8);
    } catch (IOException ignored) {
      // Settings persistence is optional.
    }
  }

  private static String entriesJson(Map<UUID, String> entries) {
    StringBuilder builder = new StringBuilder("[");
    boolean first = true;
    for (Map.Entry<UUID, String> entry : entries.entrySet()) {
      if (!first) {
        builder.append(", ");
      }
      first = false;
      builder.append("{\"uuid\":\"").append(entry.getKey()).append("\",\"name\":\"")
          .append(escapeJson(entry.getValue())).append("\"}");
    }
    return builder.append("]").toString();
  }

  private static Path statePath() {
    String appData = System.getenv("APPDATA");
    if (appData == null || appData.isBlank()) {
      appData = Path.of(System.getProperty("user.home"), "AppData", "Roaming").toString();
    }
    return Path.of(appData, ".minecraft-launcher", "x-client-social.json");
  }

  private static String cleanName(String name) {
    return String.valueOf(name == null ? "" : name).replaceAll("[^A-Za-z0-9_]", "").trim();
  }

  private static String escapeJson(String value) {
    return String.valueOf(value == null ? "" : value).replace("\\", "\\\\").replace("\"", "\\\"");
  }

  private static String unescapeJson(String value) {
    return String.valueOf(value == null ? "" : value).replace("\\\"", "\"").replace("\\\\", "\\");
  }

  private static void sleepQuietly(long millis) {
    try {
      Thread.sleep(millis);
    } catch (InterruptedException interrupted) {
      Thread.currentThread().interrupt();
    }
  }

  private record Profile(UUID uuid, String name, Object skinTexture) {
    Profile withSkinTexture(Object nextSkinTexture) {
      return nextSkinTexture == null ? this : new Profile(uuid, name, nextSkinTexture);
    }
  }

  static final class PlayerStatus {
    final UUID uuid;
    final String name;
    final boolean xClient;
    final boolean friend;
    final boolean self;
    final long lastSeenMs;
    final Object skinTexture;
    final int[] skinHeadPixels;

    PlayerStatus(UUID uuid, String name, boolean xClient, boolean friend, boolean self, long lastSeenMs, Object skinTexture, int[] skinHeadPixels) {
      this.uuid = uuid;
      this.name = cleanName(name);
      this.xClient = xClient;
      this.friend = friend;
      this.self = self;
      this.lastSeenMs = lastSeenMs;
      this.skinTexture = skinTexture;
      this.skinHeadPixels = skinHeadPixels == null ? new int[0] : skinHeadPixels;
    }

    int headColor() {
      return SocialManager.headColor(uuid, name);
    }

    Object skinTexture() {
      return skinTexture;
    }

    int[] skinHeadPixels() {
      return skinHeadPixels;
    }

    PlayerStatus withName(String nextName) {
      return new PlayerStatus(uuid, nextName, xClient, friend, self, lastSeenMs, skinTexture, skinHeadPixels);
    }

    PlayerStatus withFlags(boolean nextXClient, boolean nextFriend) {
      return new PlayerStatus(uuid, name, nextXClient, nextFriend, self, lastSeenMs, skinTexture, skinHeadPixels);
    }

    PlayerStatus withSkinHeadPixels(int[] nextSkinHeadPixels) {
      return new PlayerStatus(uuid, name, xClient, friend, self, lastSeenMs, skinTexture, nextSkinHeadPixels);
    }
  }

  static final class ChatEntry {
    final UUID uuid;
    final String name;
    final long timestampMs;

    ChatEntry(UUID uuid, String name, long timestampMs) {
      this.uuid = uuid;
      this.name = cleanName(name);
      this.timestampMs = timestampMs;
    }

    int headColor() {
      return SocialManager.headColor(uuid, name);
    }
  }

  static final class FriendRequest {
    final UUID uuid;
    final String name;
    final long timestampMs;
    final Object skinTexture;
    final int[] skinHeadPixels;

    FriendRequest(UUID uuid, String name, long timestampMs, Object skinTexture, int[] skinHeadPixels) {
      this.uuid = uuid;
      this.name = cleanName(name);
      this.timestampMs = timestampMs;
      this.skinTexture = skinTexture;
      this.skinHeadPixels = skinHeadPixels == null ? new int[0] : skinHeadPixels;
    }

    int headColor() {
      return SocialManager.headColor(uuid, name);
    }

    Object skinTexture() {
      return skinTexture;
    }

    int[] skinHeadPixels() {
      return skinHeadPixels;
    }

    FriendRequest withSkinHeadPixels(int[] nextSkinHeadPixels) {
      return new FriendRequest(uuid, name, timestampMs, skinTexture, nextSkinHeadPixels);
    }
  }

  static final class WorldInvite {
    final UUID uuid;
    final String name;
    final String host;
    final int port;
    final long timestampMs;

    WorldInvite(UUID uuid, String name, String host, int port, long timestampMs) {
      this.uuid = uuid;
      this.name = cleanName(name);
      this.host = sanitizeHost(host);
      this.port = port;
      this.timestampMs = timestampMs;
    }

    String address() {
      return host.isBlank() || port <= 0 ? "" : host + ":" + port;
    }
  }

  private record UpnpGateway(String controlUrl, String serviceType) {
  }

  private record UpnpMapping(boolean mapped, String publicAddress) {
    static final UpnpMapping NONE = new UpnpMapping(false, "");
  }
}
