package dev.xlauncher.client;

import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.lang.reflect.Modifier;

public final class AutoReconnectManager {
  private static final String STATUS = "Verbindung verloren. Wiederverbindung wird versucht...";
  private static final long BASE_DELAY_MS = 3000L;
  private static final long MAX_DELAY_MS = 15000L;
  private static final int MAX_ATTEMPTS = 12;
  private static Object lastServerData;
  private static boolean reconnecting;
  private static int attempts;
  private static long nextAttemptMs;

  private AutoReconnectManager() {
  }

  public static void tick(Object client) {
    if (client == null) {
      return;
    }
    Object player = fieldValue(client, "player", "field_1724");
    if (player != null) {
      Object server = currentServerData(client);
      if (server != null) {
        lastServerData = server;
      }
      clear();
      return;
    }
    if (!reconnecting || lastServerData == null || attempts >= MAX_ATTEMPTS || System.currentTimeMillis() < nextAttemptMs) {
      return;
    }
    attempts += 1;
    scheduleNextAttempt();
    tryReconnect(client);
  }

  public static void onScreenOpening(Object screen) {
    if (!isDisconnectedScreen(screen)) {
      return;
    }
    Object client = minecraftClient();
    Object server = currentServerData(client);
    if (server != null) {
      lastServerData = server;
    }
    if (lastServerData == null || reconnecting) {
      return;
    }
    reconnecting = true;
    attempts = 0;
    nextAttemptMs = System.currentTimeMillis() + BASE_DELAY_MS;
  }

  public static void drawStatus(Object graphics) {
    if (!reconnecting || graphics == null) {
      return;
    }
    Object client = minecraftClient();
    Object screen = fieldValue(client, "screen", "field_1755");
    if (!isDisconnectedScreen(screen)) {
      return;
    }
    Object font = fieldValue(client, "font", "field_1772");
    int width = intField(screen, 320, "width", "field_22789");
    int height = intField(screen, 240, "height", "field_22790");
    drawCentered(graphics, font, STATUS, width / 2, Math.max(12, height - 30), 0xFFFFFFFF);
  }

  private static void clear() {
    reconnecting = false;
    attempts = 0;
    nextAttemptMs = 0L;
  }

  private static void scheduleNextAttempt() {
    long delay = Math.min(MAX_DELAY_MS, BASE_DELAY_MS + (long) attempts * 2500L);
    nextAttemptMs = System.currentTimeMillis() + delay;
  }

  private static void tryReconnect(Object client) {
    if (client == null || lastServerData == null) {
      return;
    }
    Object parent = fieldValue(client, "screen", "field_1755");
    Object address = serverAddress(lastServerData);
    for (String className : new String[] { "net.minecraft.client.gui.screens.ConnectScreen", "net.minecraft.class_412" }) {
      try {
        Class<?> connectClass = Class.forName(className);
        for (Method method : connectClass.getDeclaredMethods()) {
          if (!Modifier.isStatic(method.getModifiers()) || method.getParameterCount() < 3) {
