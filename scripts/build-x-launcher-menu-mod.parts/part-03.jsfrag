package dev.xlauncher.client;

import java.lang.reflect.Method;
import java.lang.reflect.Proxy;
import java.time.LocalTime;
import java.time.format.DateTimeFormatter;
import java.util.function.Function;
import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.screens.PauseScreen;

public final class HudOverlay {
  private static final DateTimeFormatter TIME_FORMATTER = DateTimeFormatter.ofPattern("HH:mm");
  private static volatile boolean registered;
  private static volatile boolean crosshairReplaced;
  private static volatile long smartScreenshotToastUntilMs;
  private static float leftCpsPressAnimation;
  private static float rightCpsPressAnimation;
  private static long upTimerStartedMs;
  private static Object cachedPlayer;
  private static long nextFastHudUpdateMs;
  private static long nextSlowHudUpdateMs;
  private static String cachedFpsText = "FPS 0";
  private static String cachedCoordsText = "0 0 0";
  private static String cachedNetherCoordsText = "NETHER 0 0";
  private static String cachedDirectionText = "N | Biome | NETHER 0 0";
  private static String cachedClockText = "TIME 00:00";
  private static Object cachedArmorPlayer;
  private static Object[] cachedArmorItems = new Object[] { null, null, null, null };
  private static long nextArmorLookupMs;
  private static long nextTargetLookupMs;
  private static boolean cachedTargetInReach;

  private HudOverlay() {
  }

  static void showSmartScreenshotToast() {
    smartScreenshotToastUntilMs = System.currentTimeMillis() + 900L;
  }

  public static void drawTimerStatus(Object graphics) {
    try {
      Object client = clientInstance();
      Object font = getAnyField(client, "font", "field_1772");
      if (client == null || font == null) {
        return;
      }
      String text = GameTimer.pauseOverlayText();
      if (text.isEmpty()) {
        text = GameTimer.noticeText();
      }
      if (!text.isEmpty()) {
        drawTimerNotice(graphics, font, client, text);
      }
    } catch (Throwable ignored) {
      // Timer status drawing is optional.
    }
  }

  static void register() {
    if (registered) {
      return;
    }
    registered = true;
    try {
      Class<?> identifierClass = Class.forName("net.minecraft.resources.Identifier");
      Class<?> hudElementClass = Class.forName("net.fabricmc.fabric.api.client.rendering.v1.hud.HudElement");
      Class<?> registryClass = Class.forName("net.fabricmc.fabric.api.client.rendering.v1.hud.HudElementRegistry");
      Object identifier = identifierClass
          .getMethod("fromNamespaceAndPath", String.class, String.class)
          .invoke(null, "x-client", "overlay");
      Object element = Proxy.newProxyInstance(
          hudElementClass.getClassLoader(),
          new Class<?>[] { hudElementClass },
          (proxy, method, args) -> {
            if ("extractRenderState".equals(method.getName()) && args != null && args.length > 0) {
              draw(args[0]);
            }
            return null;
          });
      registryClass.getMethod("addLast", identifierClass, hudElementClass).invoke(null, identifier, element);
      crosshairReplaced = replaceVanillaCrosshair(identifierClass, hudElementClass, registryClass);
      replaceVanillaStatusEffects(identifierClass, hudElementClass, registryClass);
    } catch (Throwable ignored) {
      // Old or obfuscated runtimes may not expose the modern Fabric HUD API.
    }
  }

  private static boolean replaceVanillaCrosshair(Class<?> identifierClass, Class<?> hudElementClass, Class<?> registryClass) {
    try {
      Class<?> vanillaClass = Class.forName("net.fabricmc.fabric.api.client.rendering.v1.hud.VanillaHudElements");
      Object crosshairId = vanillaClass.getField("CROSSHAIR").get(null);
      Function<Object, Object> wrapper = oldElement -> Proxy.newProxyInstance(
          hudElementClass.getClassLoader(),
          new Class<?>[] { hudElementClass },
          (proxy, method, args) -> {
            if ("extractRenderState".equals(method.getName()) && args != null && args.length > 0) {
              if (!isVanillaPauseScreenOpen() && moduleEnabled("crosshair")) {
                Object client = Class.forName("net.minecraft.client.Minecraft").getMethod("getInstance").invoke(null);
                if (isFirstPersonView(client)) {
                  drawCrosshair(args[0], client, CrosshairSettings.targetAlert() && cachedTargetInReach(client) ? CrosshairSettings.targetColor() : CrosshairSettings.normalColor());
                  return null;
                }
              }
              if (oldElement != null) {
                return method.invoke(oldElement, args);
              }
            }
            return null;
          });
      registryClass.getMethod("replaceElement", identifierClass, Function.class).invoke(null, crosshairId, wrapper);
      return true;
    } catch (Throwable ignored) {
      return false;
    }
  }

  /** Moves the one existing vanilla effect-icon element; it never draws a copy. */
  private static boolean replaceVanillaStatusEffects(Class<?> identifierClass, Class<?> hudElementClass, Class<?> registryClass) {
    try {
      Class<?> vanillaClass = Class.forName("net.fabricmc.fabric.api.client.rendering.v1.hud.VanillaHudElements");
      Object effectId = null;
      for (String fieldName : new String[] { "MOB_EFFECTS", "STATUS_EFFECTS", "POTION_ICONS" }) {
        try {
          effectId = vanillaClass.getField(fieldName).get(null);
          break;
        } catch (Throwable ignored) {
          // Try the next Fabric API name.
        }
      }
      if (effectId == null) return false;
      Function<Object, Object> wrapper = oldElement -> Proxy.newProxyInstance(
          hudElementClass.getClassLoader(),
          new Class<?>[] { hudElementClass },
          (proxy, method, args) -> {
            if ("extractRenderState".equals(method.getName()) && args != null && args.length > 0) {
              renderVanillaEffectIcons(oldElement, method, args);
            }
            return null;
          });
      registryClass.getMethod("replaceElement", identifierClass, Function.class).invoke(null, effectId, wrapper);
      return true;
    } catch (Throwable ignored) {
      return false;
    }
  }

  private static void renderVanillaEffectIcons(Object oldElement, Method callbackMethod, Object[] args) {
    if (oldElement == null) return;
    Object graphics = args[0];
    Object client = clientInstance();
    Object player = getAnyField(client, "player", "field_1724");
    int[] nativeBounds = vanillaEffectIconBounds(graphics, player);
    if (nativeBounds[2] <= 0 || nativeBounds[3] <= 0) {
      invokeHudElement(oldElement, callbackMethod, args);
      return;
    }
    int[] target = effectIconTargetBounds(client, nativeBounds[2], nativeBounds[3]);
    Object pose = invokeAny(graphics, "pose");
    if (pose == null || !pushPose(pose)) {
      invokeHudElement(oldElement, callbackMethod, args);
      return;
    }
    try {
      translatePose(pose, target[0] - nativeBounds[0], target[1] - nativeBounds[1]);
      invokeHudElement(oldElement, callbackMethod, args);
    } finally {
      popPose(pose);
    }
  }

  private static void invokeHudElement(Object element, Method callbackMethod, Object[] args) {
    try {
      callbackMethod.invoke(element, args);
    } catch (Throwable ignored) {
      // A failed optional HUD replacement must not prevent the vanilla HUD.
    }
  }

  private static int[] vanillaEffectIconBounds(Object graphics, Object player) {
    int positive = 0, negative = 0;
    Object active = invokeAny(player, "getActiveEffects", "method_6026");
    if (active instanceof Iterable<?> iterable) {
      for (Object instance : iterable) {
        if (!effectIconVisible(instance)) continue;
        Object holder = invokeAny(instance, "getEffect", "method_5576", "method_6112");
        Object effect = invokeAny(holder, "value", "method_63500");
        Object beneficial = invokeAny(effect == null ? holder : effect, "isBeneficial", "method_5573");
        if (Boolean.TRUE.equals(beneficial)) positive += 1;
        else negative += 1;
      }
    }
    int count = Math.max(positive, negative);
    if (count <= 0) return new int[] { 0, 0, 0, 0 };
    int screenW = guiWidth(graphics);
    return new int[] { Math.max(0, screenW - (count * 25)), 1, count * 25, negative > 0 ? 50 : 24 };
  }

  private static boolean effectIconVisible(Object instance) {
    Object visible = invokeAny(instance, "showIcon", "method_5592");
    return !(visible instanceof Boolean value) || value.booleanValue();
  }

  private static int[] effectIconTargetBounds(Object client, int width, int height) {
    int screenW = Math.max(1, scaledWidth(client));
    int screenH = Math.max(1, scaledHeight(client));
    int savedX = OverlaySettings.x("effects");
    int savedY = OverlaySettings.y("effects");
    int x = savedX + width >= screenW - 1 ? Math.max(0, screenW - width) : Math.max(0, Math.min(screenW - width, savedX));
    int y = Math.max(0, Math.min(screenH - height, savedY));
    return new int[] { x, y };
  }

  private static int guiWidth(Object graphics) {
    Object value = invokeAny(graphics, "guiWidth", "method_25364");
    return value instanceof Number number ? Math.max(1, number.intValue()) : scaledWidth(clientInstance());
  }

  private static boolean pushPose(Object pose) {
    return invokePose(pose, "pushMatrix") || invokePose(pose, "push");
  }

  private static void popPose(Object pose) {
    if (!invokePose(pose, "popMatrix")) invokePose(pose, "pop");
  }

  private static void translatePose(Object pose, int x, int y) {
    if (!invokePose(pose, "translate", Float.valueOf(x), Float.valueOf(y))) {
      invokePose(pose, "translate", Double.valueOf(x), Double.valueOf(y));
    }
  }

  private static boolean invokePose(Object target, String name, Number... values) {
    if (target == null) return false;
    for (Method method : allMethods(target.getClass())) {
      if (!name.equals(method.getName()) || method.getParameterCount() != values.length) continue;
      Object[] arguments = new Object[values.length];
      boolean compatible = true;
      for (int index = 0; index < values.length; index += 1) {
        arguments[index] = poseNumber(values[index], method.getParameterTypes()[index]);
        if (arguments[index] == null) compatible = false;
      }
      if (!compatible) continue;
      try {
        method.setAccessible(true);
        method.invoke(target, arguments);
        return true;
      } catch (Throwable ignored) {
        // Try another overload.
      }
    }
    return false;
  }

  private static Object poseNumber(Number value, Class<?> type) {
    if (type == Float.TYPE || type == Float.class) return Float.valueOf(value.floatValue());
    if (type == Double.TYPE || type == Double.class) return Double.valueOf(value.doubleValue());
    if (type == Integer.TYPE || type == Integer.class) return Integer.valueOf(value.intValue());
    return null;
  }

  private static void draw(Object graphics) {
    try {
      if (isVanillaPauseScreenOpen()) {
        return;
      }
      Object client = clientInstance();
      Object options = getAnyField(client, "options", "field_1690");
      if (client == null || options == null || Boolean.TRUE.equals(getAnyField(options, "hideGui", "field_1842"))) {
        return;
      }
      Object font = getAnyField(client, "font", "field_1772");
      Object player = getAnyField(client, "player", "field_1724");
      if (font == null) {
        return;
      }
      updateHudDataCache(client, player);
      if (smartScreenshotToastUntilMs > System.currentTimeMillis()) {
        drawSmartScreenshotToast(graphics, font);
      }
      String timerNotice = GameTimer.noticeText();
      if (!timerNotice.isEmpty()) {
        drawTimerNotice(graphics, font, client, timerNotice);
      }
      if (moduleEnabled("fps")) {
        drawOverlayCard(graphics, font, "fps", cachedFpsText);
      }
      if (moduleEnabled("coords") && player != null) {
        drawOverlayCard(graphics, font, "coords", cachedCoordsText);
      }
      if (moduleEnabled("nethercoords") && player != null) {
        drawOverlayCard(graphics, font, "nethercoords", cachedNetherCoordsText);
      }
      if (moduleEnabled("direction") && player != null) {
        drawOverlayCard(graphics, font, "direction", cachedDirectionText);
      }
      if (moduleEnabled("keys")) {
        drawWasdOverlay(graphics, font, client);
      }
      if (moduleEnabled("cps")) {
        drawCpsOverlay(graphics, font);
      }
      if (moduleEnabled("clock")) {
        drawOverlayCard(graphics, font, "clock", cachedClockText);
      }
      if (moduleEnabled("uptimer")) {
        drawUpTimer(graphics, font);
      }
      if (moduleEnabled("sounddisplay")) {
        drawSoundDisplay(graphics, font, client);
      }
      if (moduleEnabled("armor") && player != null) {
        drawArmorStatus(graphics, font, player);
      }
      if (player != null) {
        SessionHud.update(client, player);
        if (moduleEnabled("inventory")) drawInventoryHud(graphics, font, player);
        if (moduleEnabled("combo")) drawOverlayCard(graphics, font, "combo", SessionHud.comboText());
        if (moduleEnabled("session")) drawOverlayCard(graphics, font, "session", SessionHud.sessionText());
      }
      if (!crosshairReplaced && moduleEnabled("crosshair") && isFirstPersonView(client)) {
        drawCrosshair(graphics, client, CrosshairSettings.targetAlert() && cachedTargetInReach(client) ? CrosshairSettings.targetColor() : CrosshairSettings.normalColor());
      }
    } catch (Throwable ignored) {
      // HUD drawing must never crash the game.
    }
  }

  private static void updateHudDataCache(Object client, Object player) throws ReflectiveOperationException {
    long now = System.currentTimeMillis();
    if (player != cachedPlayer) {
      cachedPlayer = player;
      nextFastHudUpdateMs = 0L;
      nextSlowHudUpdateMs = 0L;
    }
    if (now >= nextFastHudUpdateMs) {
      nextFastHudUpdateMs = now + 100L;
      int displayedFps = invokeInt(client, "getFps");
      if (moduleEnabled("fakefps")) {
        long adjusted = (long) displayedFps + MenuModules.fakeFps();
        displayedFps = (int) Math.max(0L, Math.min(Integer.MAX_VALUE, adjusted));
      }
      cachedFpsText = "FPS " + displayedFps;
      if (player != null) {
        int x = (int) Math.floor(invokeDouble(player, "getX"));
        int y = (int) Math.floor(invokeDouble(player, "getY"));
        int z = (int) Math.floor(invokeDouble(player, "getZ"));
        cachedCoordsText = x + " " + y + " " + z;
        cachedNetherCoordsText = convertedDimensionCoords(client, player);
      }
    }
    if (now >= nextSlowHudUpdateMs) {
      nextSlowHudUpdateMs = now + 500L;
      cachedClockText = "TIME " + LocalTime.now().format(TIME_FORMATTER);
      if (player != null) cachedDirectionText = directionBiomeText(client, player);
    }
  }

  private static boolean isVanillaPauseScreenOpen() {
    try {
      Minecraft client = Minecraft.getInstance();
      return client != null && client.gui != null && client.gui.screen() instanceof PauseScreen;
    } catch (Throwable ignored) {
      return false;
    }
  }

  private static void drawSmartScreenshotToast(Object graphics, Object font) throws ReflectiveOperationException {
    long remaining = smartScreenshotToastUntilMs - System.currentTimeMillis();
    if (remaining <= 0L) {
      return;
    }
    int alpha = Math.max(55, Math.min(210, 80 + (int) (remaining / 5L)));
    int x = 6;
    int y = 6;
    int width = 118;
    int height = 20;
    fill(graphics, x + 1, y + 1, x + width + 1, y + height + 1, LauncherTheme.argb(85, 0x000000));
    fill(graphics, x, y, x + width, y + height, LauncherTheme.argb(alpha, 0x081018));
    fill(graphics, x, y, x + 3, y + height, LauncherTheme.accentArgb(Math.min(240, alpha + 35)));
    border(graphics, x, y, width, height, LauncherTheme.accentArgb(Math.min(220, alpha + 25)));
    drawText(graphics, font, fitHudText(font, "Screenshot gespeichert", width - 14), x + 8, y + 6, 0xFFFFFFFF);
  }

  private static void drawTimerNotice(Object graphics, Object font, Object client, String text) throws ReflectiveOperationException {
    int screenW = scaledWidth(client);
    int width = Math.min(Math.max(108, screenW - 12), Math.max(132, textWidth(font, text) + 22));
    int height = 20;
    int x = Math.max(4, screenW - width - 6);
    int y = 6;
    fill(graphics, x + 1, y + 1, x + width + 1, y + height + 1, LauncherTheme.argb(90, 0x000000));
    fill(graphics, x, y, x + width, y + height, LauncherTheme.argb(174, 0x081018));
    fill(graphics, x, y, x + 3, y + height, LauncherTheme.accentArgb(225));
    border(graphics, x, y, width, height, LauncherTheme.accentArgb(190));
    drawText(graphics, font, fitHudText(font, text, width - 14), x + 8, y + 6, 0xFFFFFFFF);
  }

  private static void drawWasdOverlay(Object graphics, Object font, Object client) throws ReflectiveOperationException {
    int size = OverlaySettings.size("keys");
    int x = OverlaySettings.x("keys");
    int y = OverlaySettings.y("keys");
    int key = Math.max(4, 13 + (size * 3)), gap = Math.max(1, 2 + size), pad = Math.max(0, 3 + size);
    int totalW = (key * 3) + (gap * 2) + (pad * 2);
    int spaceH = Math.max(8, key - 4);
    int totalH = (key * 2) + (gap * 2) + spaceH + (pad * 2);
    int[] anchored = anchoredOverlayPosition(client, "keys", totalW, totalH, totalW, totalH);
    x = anchored[0];
    y = anchored[1];
    if (OverlaySettings.shadow("keys")) {
      roundedFill(graphics, x + 1, y + 1, totalW, totalH, OverlaySettings.radius("keys"), LauncherTheme.argb(85, 0x000000));
    }
    if (OverlaySettings.background("keys")) {
      roundedFill(graphics, x, y, totalW, totalH, OverlaySettings.radius("keys"), LauncherTheme.rawArgb(OverlaySettings.opacity("keys"), OverlaySettings.restColor("keys")));
      border(graphics, x, y, totalW, totalH, LauncherTheme.rawArgb(255, OverlaySettings.restColor("keys")));
    }
    int innerX = x + pad;
    int innerY = y + pad;
    boolean labels = size == 1;
    drawKeyCap(graphics, font, labels ? "W" : "", innerX + key + gap, innerY, key, key, XLauncherMenuClient.isKeyDown(client, 87));
    int rowY = innerY + key + gap;
    drawKeyCap(graphics, font, labels ? "A" : "", innerX, rowY, key, key, XLauncherMenuClient.isKeyDown(client, 65));
    drawKeyCap(graphics, font, labels ? "S" : "", innerX + key + gap, rowY, key, key, XLauncherMenuClient.isKeyDown(client, 83));
    drawKeyCap(graphics, font, labels ? "D" : "", innerX + ((key + gap) * 2), rowY, key, key, XLauncherMenuClient.isKeyDown(client, 68));
    int bottomY = innerY + ((key + gap) * 2);
    int spaceW = (key * 2) + gap;
    drawKeyCap(graphics, font, labels ? "SPACE" : "", innerX, bottomY, spaceW, spaceH, XLauncherMenuClient.isKeyDown(client, 32));
    drawKeyCap(graphics, font, labels ? "LS" : "", innerX + spaceW + gap, bottomY, key, spaceH, XLauncherMenuClient.isKeyDown(client, 340));
  }

  private static void drawUpTimer(Object graphics, Object font) throws ReflectiveOperationException {
    long now = System.currentTimeMillis();
    if (upTimerStartedMs <= 0L) upTimerStartedMs = now;
    long seconds = Math.max(0L, (now - upTimerStartedMs) / 1000L);
    long hours = seconds / 3600L, minutes = (seconds / 60L) % 60L, secs = seconds % 60L;
    int x = OverlaySettings.x("uptimer"), y = OverlaySettings.y("uptimer"), color = 0xFF000000 | OverlaySettings.textColor("uptimer");
    drawText(graphics, font, String.format(java.util.Locale.ROOT, "%02d:%02d:%02d", hours, minutes, secs), x, y, color);
  }

  private static void drawKeyCap(Object graphics, Object font, String label, int x, int y, int w, int h, boolean pressed) throws ReflectiveOperationException {
    int textRgb = OverlaySettings.textColor("keys");
    int restRgb = OverlaySettings.restColor("keys");
    int textColor = pressed ? LauncherTheme.rawArgb(255, restRgb) : (0xFF000000 | textRgb);
    drawCenteredText(graphics, font, label, x, y + Math.max(1, (h - 8) / 2), w, textColor);
  }

  private static void drawCpsOverlay(Object graphics, Object font) throws ReflectiveOperationException {
    int size = OverlaySettings.size("cps");
    int x = OverlaySettings.x("cps");
    int y = OverlaySettings.y("cps");
    int wasdKey = Math.max(4, 13 + (size * 3)), wasdGap = Math.max(1, 2 + size), wasdPadding = Math.max(0, 3 + size);
    int baseW = (wasdKey * 3) + (wasdGap * 2) + (wasdPadding * 2);
    int totalH = 14;
    int gap = 2;
    int leftCps = XLauncherMenuClient.getLeftCps();
    int rightCps = XLauncherMenuClient.getRightCps();
    int keyW = Math.max(Math.max(8, (baseW - gap) / 2), Math.max(textWidth(font, String.valueOf(leftCps)), textWidth(font, String.valueOf(rightCps))) + 8);
    int totalW = (keyW * 2) + gap;
    int[] anchored = anchoredOverlayPosition(clientInstance(), "cps", totalW, totalH, baseW, totalH);
    x = anchored[0];
    y = anchored[1];
    leftCpsPressAnimation += ((XLauncherMenuClient.isLeftMouseDown() ? 1.0F : 0.0F) - leftCpsPressAnimation) * 0.42F;
    rightCpsPressAnimation += ((XLauncherMenuClient.isRightMouseDown() ? 1.0F : 0.0F) - rightCpsPressAnimation) * 0.42F;
    if (OverlaySettings.shadow("cps")) {
      roundedFill(graphics, x + 1, y + 1, totalW, totalH, OverlaySettings.radius("cps"), LauncherTheme.argb(90, 0x000000));
    }
    if (OverlaySettings.background("cps")) {
      roundedFill(graphics, x, y, totalW, totalH, OverlaySettings.radius("cps"), LauncherTheme.rawArgb(OverlaySettings.opacity("cps"), OverlaySettings.restColor("cps")));
      border(graphics, x, y, totalW, totalH, LauncherTheme.rawArgb(255, OverlaySettings.restColor("cps")));
    }
    drawCpsKey(graphics, font, leftCps, x, y, keyW, totalH, leftCpsPressAnimation);
    drawCpsKey(graphics, font, rightCps, x + keyW + gap, y, keyW, totalH, rightCpsPressAnimation);
  }

  private static void drawCpsKey(Object graphics, Object font, int cps, int x, int y, int w, int h, float animation) throws ReflectiveOperationException {
    int inset = Math.max(0, Math.min(1, Math.round(animation)));
    int drawX = x + inset;
    int drawY = y + inset;
    int drawW = Math.max(12, w - (inset * 2));
    int drawH = Math.max(4, h - (inset * 2));
    int textColor = animation > 0.45F ? LauncherTheme.textOnAccentColor() : (0xFF000000 | OverlaySettings.color("cps"));
    drawCenteredText(graphics, font, String.valueOf(cps), drawX, drawY + Math.max(1, (drawH - 8) / 2), drawW, textColor);
  }

  private static void drawOverlayCard(Object graphics, Object font, String id, String text) throws ReflectiveOperationException {
    int size = OverlaySettings.size(id);
    int x = OverlaySettings.x(id);
    int y = OverlaySettings.y(id);
    int textScale = OverlaySettings.textSize(id);
    int paddingX = Math.max(1, 4 + (size * 2)), paddingY = Math.max(1, 2 + size);
    int textWidth = textWidth(font, text);
    int width = Math.max(34 + (size * 3), textWidth + (paddingX * 2) + (size * 2) + ((textScale - 1) * 5));
    int height = Math.max(6, 10 + (paddingY * 2) + ((size - 1) * 3) + ((textScale - 1) * 2));
    String sampleText = overlaySampleText(id);
    int sampleTextWidth = textWidth(font, sampleText);
    int baseWidth = Math.max(34 + (size * 3), sampleTextWidth + (paddingX * 2) + (size * 2) + ((textScale - 1) * 5));
    int[] anchored = anchoredOverlayPosition(clientInstance(), id, width, height, baseWidth, height);
    x = anchored[0];
    y = anchored[1];
    int accent = 0xFF000000 | OverlaySettings.restColor(id);
    if (OverlaySettings.shadow(id)) {
      roundedFill(graphics, x + 1, y + 1, width, height, OverlaySettings.radius(id), LauncherTheme.argb(95, 0x000000));
    }
    if (OverlaySettings.background(id)) {
      roundedFill(graphics, x, y, width, height, OverlaySettings.radius(id), LauncherTheme.rawArgb(OverlaySettings.opacity(id), OverlaySettings.restColor(id)));
      border(graphics, x, y, width, height, LauncherTheme.rawArgb(255, OverlaySettings.restColor(id)));
    }
    int align = OverlaySettings.alignment(id);
    int textX = align == 0 ? x + paddingX + size : (align == 2 ? x + width - paddingX - textWidth : x + Math.max(2, (width - textWidth) / 2));
    int textY = y + paddingY + ((size - 1) / 2);
    drawAdaptiveText(graphics, font, text, textX, textY, 0xFF000000 | OverlaySettings.color(id), textScale);
  }

  private static void drawSoundDisplay(Object graphics, Object font, Object client) throws ReflectiveOperationException {
    String[] entries = SoundDisplay.visible();
    if (entries.length == 0) return;
    int size = OverlaySettings.size("sounddisplay");
    int rowH = 11 + size, width = 88 + (size * 4);
    for (String entry : entries) width = Math.max(width, textWidth(font, entry) + 16);
    int height = entries.length * rowH + 6;
    int[] anchored = anchoredOverlayPosition(client, "sounddisplay", width, height, 92 + (size * 4), (4 * rowH) + 6);
    int x = anchored[0], y = anchored[1];
    if (OverlaySettings.shadow("sounddisplay")) roundedFill(graphics, x + 1, y + 1, width, height, 3, LauncherTheme.argb(90, 0x000000));
    if (OverlaySettings.background("sounddisplay")) {
      roundedFill(graphics, x, y, width, height, 0, LauncherTheme.rawArgb(OverlaySettings.opacity("sounddisplay"), OverlaySettings.restColor("sounddisplay")));
      border(graphics, x, y, width, height, LauncherTheme.rawArgb(255, OverlaySettings.restColor("sounddisplay")));
    }
    for (int index = 0; index < entries.length; index += 1) {
      int rowY = y + 3 + (index * rowH);
      drawText(graphics, font, entries[index], x + 9, rowY + 1, 0xFF000000 | OverlaySettings.color("sounddisplay"));
    }
  }

  // The UI editor renders these with the same primitives and measurements as
  // the live HUD. Only the data is a stable preview sample, never player data.
  public static void drawEditorPreview(Object graphics, Object font, String id, String sampleText, int x, int y) {
    try {
      switch (id) {
        case "keys" -> drawEditorWasdPreview(graphics, font, x, y);
        case "cps" -> drawEditorCpsPreview(graphics, font, x, y);
        case "armor" -> drawEditorArmorPreview(graphics, x, y);
        case "sounddisplay" -> drawEditorSoundPreview(graphics, font, x, y);
        case "effects" -> drawEditorEffectsPreview(graphics, font, x, y);
        case "uptimer" -> drawEditorUpTimerPreview(graphics, font, x, y);
        default -> drawEditorOverlayCard(graphics, font, id, sampleText, x, y);
      }
    } catch (Throwable ignored) {
      // The menu remains usable even if an optional item renderer is absent.
    }
  }

  private static void drawEditorOverlayCard(Object graphics, Object font, String id, String text, int x, int y) throws ReflectiveOperationException {
    int size = OverlaySettings.size(id);
    int textScale = OverlaySettings.textSize(id);
    int paddingX = Math.max(1, 4 + (size * 2));
    int paddingY = Math.max(1, 2 + size);
    int labelWidth = textWidth(font, text);
    int width = Math.max(34 + (size * 3), labelWidth + (paddingX * 2) + (size * 2) + ((textScale - 1) * 5));
    int height = Math.max(6, 10 + (paddingY * 2) + ((size - 1) * 3) + ((textScale - 1) * 2));
    if (OverlaySettings.shadow(id)) {
      roundedFill(graphics, x + 1, y + 1, width, height, OverlaySettings.radius(id), LauncherTheme.argb(95, 0x000000));
    }
    if (OverlaySettings.background(id)) {
      roundedFill(graphics, x, y, width, height, OverlaySettings.radius(id), LauncherTheme.rawArgb(OverlaySettings.opacity(id), OverlaySettings.restColor(id)));
      border(graphics, x, y, width, height, LauncherTheme.rawArgb(255, OverlaySettings.restColor(id)));
    }
    int align = OverlaySettings.alignment(id);
    int textX = align == 0 ? x + paddingX + size : (align == 2 ? x + width - paddingX - labelWidth : x + Math.max(2, (width - labelWidth) / 2));
    int textY = y + paddingY + ((size - 1) / 2);
    drawAdaptiveText(graphics, font, text, textX, textY, 0xFF000000 | OverlaySettings.color(id), textScale);
  }

  private static void drawEditorWasdPreview(Object graphics, Object font, int x, int y) throws ReflectiveOperationException {
    int size = OverlaySettings.size("keys");
    int key = Math.max(4, 13 + (size * 3));
    int gap = Math.max(1, 2 + size);
    int pad = Math.max(0, 3 + size);
    int totalW = (key * 3) + (gap * 2) + (pad * 2);
    int spaceH = Math.max(8, key - 4);
    int totalH = (key * 2) + (gap * 2) + spaceH + (pad * 2);
    if (OverlaySettings.shadow("keys")) {
      roundedFill(graphics, x + 1, y + 1, totalW, totalH, OverlaySettings.radius("keys"), LauncherTheme.argb(85, 0x000000));
    }
    if (OverlaySettings.background("keys")) {
      roundedFill(graphics, x, y, totalW, totalH, OverlaySettings.radius("keys"), LauncherTheme.rawArgb(OverlaySettings.opacity("keys"), OverlaySettings.restColor("keys")));
      border(graphics, x, y, totalW, totalH, LauncherTheme.rawArgb(255, OverlaySettings.restColor("keys")));
    }
    Object client = clientInstance();
    boolean labels = size == 1;
    int innerX = x + pad;
    int innerY = y + pad;
    drawKeyCap(graphics, font, labels ? "W" : "", innerX + key + gap, innerY, key, key, XLauncherMenuClient.isKeyDown(client, 87));
    int rowY = innerY + key + gap;
    drawKeyCap(graphics, font, labels ? "A" : "", innerX, rowY, key, key, XLauncherMenuClient.isKeyDown(client, 65));
    drawKeyCap(graphics, font, labels ? "S" : "", innerX + key + gap, rowY, key, key, XLauncherMenuClient.isKeyDown(client, 83));
    drawKeyCap(graphics, font, labels ? "D" : "", innerX + ((key + gap) * 2), rowY, key, key, XLauncherMenuClient.isKeyDown(client, 68));
    int bottomY = innerY + ((key + gap) * 2);
    int spaceW = (key * 2) + gap;
    drawKeyCap(graphics, font, labels ? "SPACE" : "", innerX, bottomY, spaceW, spaceH, XLauncherMenuClient.isKeyDown(client, 32));
    drawKeyCap(graphics, font, labels ? "LS" : "", innerX + spaceW + gap, bottomY, key, spaceH, XLauncherMenuClient.isKeyDown(client, 340));
  }

  private static void drawEditorCpsPreview(Object graphics, Object font, int x, int y) throws ReflectiveOperationException {
    int size = OverlaySettings.size("cps");
    int wasdKey = Math.max(4, 13 + (size * 3));
    int wasdGap = Math.max(1, 2 + size);
    int wasdPadding = Math.max(0, 3 + size);
    int baseW = (wasdKey * 3) + (wasdGap * 2) + (wasdPadding * 2);
    int totalH = 14;
    int gap = 2;
    int leftCps = 8;
    int rightCps = 4;
    int keyW = Math.max(Math.max(8, (baseW - gap) / 2), Math.max(textWidth(font, String.valueOf(leftCps)), textWidth(font, String.valueOf(rightCps))) + 8);
    int totalW = (keyW * 2) + gap;
    if (OverlaySettings.shadow("cps")) {
      roundedFill(graphics, x + 1, y + 1, totalW, totalH, OverlaySettings.radius("cps"), LauncherTheme.argb(90, 0x000000));
    }
    if (OverlaySettings.background("cps")) {
      roundedFill(graphics, x, y, totalW, totalH, OverlaySettings.radius("cps"), LauncherTheme.rawArgb(OverlaySettings.opacity("cps"), OverlaySettings.restColor("cps")));
      border(graphics, x, y, totalW, totalH, LauncherTheme.rawArgb(255, OverlaySettings.restColor("cps")));
    }
    drawCpsKey(graphics, font, leftCps, x, y, keyW, totalH, 0.0F);
    drawCpsKey(graphics, font, rightCps, x + keyW + gap, y, keyW, totalH, 0.0F);
  }

