package dev.xlauncher.client;

import net.minecraft.client.Minecraft;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraft.world.level.chunk.status.ChunkStatus;

/** Diagnoses client-side chunk holes and rebuilds only render data already present locally. */
final class MoreChunksController {
  private static Object lastLevel;
  private static long nextScanMs;
  private static String lastLoggedStatus = "";
  private static volatile String status = "Wartet auf Welt";

  private MoreChunksController() {}

  static void reset() {
    lastLevel = null;
    nextScanMs = 0L;
    status = "Wartet auf Welt";
  }

  static String statusText() {
    return status;
  }

  static void tick(Minecraft client, boolean enabled) {
    if (!enabled) {
      reset();
      status = "Aus";
      return;
    }
    if (client == null || client.level == null || client.player == null) {
      status = "Wartet auf Welt";
      return;
    }
    if (lastLevel != client.level) {
      reset();
      lastLevel = client.level;
    }
    long now = System.currentTimeMillis();
    if (now < nextScanMs) return;
    nextScanMs = now + 1000L;

    int configured = optionDistance(client);
    int server = serverDistance(client);
    int effective = Math.max(2, Math.min(configured, server > 0 ? server : configured));
    int radius = Math.min(effective, 12); // bounded diagnostic cost
    int cx = ((int)Math.floor(client.player.getX())) >> 4;
    int cz = ((int)Math.floor(client.player.getZ())) >> 4;
    int missing = 0;
    int internalHoles = 0;
    for (int x = cx - radius; x <= cx + radius; x++) {
      for (int z = cz - radius; z <= cz + radius; z++) {
        if (Math.max(Math.abs(x - cx), Math.abs(z - cz)) >= radius || hasChunk(client.level, x, z)) continue;
        missing++;
        if (hasChunk(client.level, x - 1, z) && hasChunk(client.level, x + 1, z)
            && hasChunk(client.level, x, z - 1) && hasChunk(client.level, x, z + 1)) internalHoles++;
      }
    }
    boolean limited = server > 0 && server < configured;
    if (limited) {
      status = "Server-Limit aktiv: " + server + " / eingestellt " + configured;
    } else if (internalHoles > 0) {
      status = "Echte Daten fehlen: " + internalHoles + " interne Chunk-Luecken";
    } else if (missing > 0) {
      status = "Ladebegrenzung erkannt: " + missing + " Chunks fehlen";
    } else {
      status = "Kein Chunk-Limit erkannt (" + effective + ")";
    }
    if (!status.equals(lastLoggedStatus)) {
      lastLoggedStatus = status;
      System.out.println("[X Client] More Chunks: " + status + ". Fehlende Chunks werden nicht erzeugt oder rekonstruiert.");
    }
  }

  static boolean hasChunk(ClientLevel level, int x, int z) {
    if (level == null) return false;
    // A requested/placeholder chunk is not world data. Only a FULL chunk already
    // present in ClientChunkCache is authoritative; the false flag forbids loads.
    return level.getChunkSource().getChunk(x, z, ChunkStatus.FULL, false) != null;
  }

  private static int optionDistance(Minecraft client) {
    try {
      Object option = client.options.getClass().getMethod("renderDistance").invoke(client.options);
      Object value = option.getClass().getMethod("get").invoke(option);
      if (value instanceof Number number) return Math.max(2, number.intValue());
    } catch (Throwable ignored) {}
    return 8;
  }

  private static int serverDistance(Minecraft client) {
    try {
      Object connection = client.getConnection();
      if (connection == null) return 0;
      for (String name : new String[] { "getServerChunkRadius", "getServerSimulationDistance" }) {
        try {
          Object value = connection.getClass().getMethod(name).invoke(connection);
          if (value instanceof Number number && number.intValue() > 0) return number.intValue();
        } catch (Throwable ignored) {}
      }
    } catch (Throwable ignored) {}
    return 0;
  }

}
