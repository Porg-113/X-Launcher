  private static final int[] EDITOR_ARMOR_PREVIEW_PERCENT = {
    15 + (int) (Math.random() * 80.0D),
    15 + (int) (Math.random() * 80.0D),
    15 + (int) (Math.random() * 80.0D),
    15 + (int) (Math.random() * 80.0D)
  };

  private static void drawEditorArmorPreview(Object graphics, int x, int y) throws ReflectiveOperationException {
    Object[] armor = editorDiamondArmor();
    int size = OverlaySettings.size("armor");
    int slot = 18 + size;
    int icon = 16;
    int gap = 2;
    int width = (slot * 4) + (gap * 3) + 4;
    int height = slot + 7;
    if (OverlaySettings.shadow("armor")) {
      roundedFill(graphics, x + 1, y + 1, width, height, 3, LauncherTheme.argb(110, 0x000000));
    }
    if (OverlaySettings.background("armor")) {
      roundedFill(graphics, x, y, width, height, 0, LauncherTheme.rawArgb(OverlaySettings.opacity("armor"), OverlaySettings.restColor("armor")));
      border(graphics, x, y, width, height, LauncherTheme.rawArgb(255, OverlaySettings.restColor("armor")));
    }
    for (int index = 0; index < armor.length; index += 1) {
      int slotX = x + 2 + (index * (slot + gap));
      int slotY = y + 2;
      drawItemStack(graphics, armor[index], slotX + Math.max(1, (slot - icon) / 2), slotY + 2, icon);
      drawArmorDurabilityBar(graphics, slotX + 3, slotY + slot + 1, slot - 6, armor[index]);
    }
  }

  private static Object[] editorDiamondArmor() {
    String[] fields = { "DIAMOND_HELMET", "DIAMOND_CHESTPLATE", "DIAMOND_LEGGINGS", "DIAMOND_BOOTS" };
    Object[] armor = new Object[fields.length];
    for (int index = 0; index < fields.length; index += 1) {
      Object item = editorDiamondItem(fields[index]);
      Object stack = editorItemStack(item);
      setEditorArmorDamage(stack, EDITOR_ARMOR_PREVIEW_PERCENT[index]);
      armor[index] = stack;
    }
    return armor;
  }

  private static Object editorDiamondItem(String fieldName) {
    for (String className : new String[] { "net.minecraft.world.item.Items", "net.minecraft.item.Items" }) {
      try {
        return Class.forName(className).getField(fieldName).get(null);
      } catch (Throwable ignored) {
        // Try the next runtime namespace.
      }
    }
    return null;
  }

  private static Object editorItemStack(Object item) {
    if (item == null) return null;
    for (String className : new String[] { "net.minecraft.world.item.ItemStack", "net.minecraft.item.ItemStack", "net.minecraft.class_1799" }) {
      try {
        for (java.lang.reflect.Constructor<?> constructor : Class.forName(className).getConstructors()) {
          Class<?>[] types = constructor.getParameterTypes();
          if (types.length == 1 && types[0].isInstance(item)) return constructor.newInstance(item);
        }
      } catch (Throwable ignored) {
        // Try the next runtime namespace.
      }
    }
    return null;
  }

  private static void setEditorArmorDamage(Object stack, int remainingPercent) {
    if (stack == null) return;
    int maxDamage = safeInvokeInt(stack, "getMaxDamage");
    if (maxDamage <= 0) maxDamage = safeInvokeInt(stack, "method_7936");
    if (maxDamage <= 0) return;
    int damage = Math.max(1, Math.min(maxDamage - 1, maxDamage - Math.round(maxDamage * (remainingPercent / 100.0F))));
    for (Method method : allMethods(stack.getClass())) {
      if (method.getParameterCount() != 1 || method.getParameterTypes()[0] != Integer.TYPE) continue;
      String name = method.getName();
      if (!("setDamageValue".equals(name) || "setDamage".equals(name) || "method_7611".equals(name))) continue;
      try {
        method.setAccessible(true);
        method.invoke(stack, Integer.valueOf(damage));
        return;
      } catch (Throwable ignored) {
        // Try another compatible setter.
      }
    }
  }

  private static void drawArmorStatus(Object graphics, Object font, Object player) throws ReflectiveOperationException {
    Object[] armor = armorItems(player);
    int size = OverlaySettings.size("armor");
    int slot = 18 + size, icon = 16, gap = 2;
    int x = OverlaySettings.x("armor");
    int y = OverlaySettings.y("armor");
    int width = (slot * 4) + (gap * 3) + 4;
    int height = slot + 7;
    int[] anchored = anchoredOverlayPosition(clientInstance(), "armor", width, height, width, height);
    x = anchored[0];
    y = anchored[1];
    if (OverlaySettings.shadow("armor")) {
      roundedFill(graphics, x + 1, y + 1, width, height, 3, LauncherTheme.argb(110, 0x000000));
    }
    if (OverlaySettings.background("armor")) {
      roundedFill(graphics, x, y, width, height, 0, LauncherTheme.rawArgb(OverlaySettings.opacity("armor"), OverlaySettings.restColor("armor")));
      border(graphics, x, y, width, height, LauncherTheme.rawArgb(255, OverlaySettings.restColor("armor")));
    }
    int startX = x + 2;
    for (int index = 0; index < armor.length && index < 4; index += 1) {
      Object stack = armor[index];
      int slotX = startX + (index * (slot + gap));
      int slotY = y + 2;
      int itemX = slotX + Math.max(1, (slot - icon) / 2);
      int itemY = slotY + 2;
      drawItemStack(graphics, stack, itemX, itemY, icon);
      drawArmorDurabilityBar(graphics, slotX + 3, slotY + slot + 1, slot - 6, stack);
    }
  }

  private static void drawArmorSlot(Object graphics, int x, int y, int size, int rgb) throws ReflectiveOperationException {
    fill(graphics, x, y, x + size, y + size, LauncherTheme.rawArgb(255, rgb));
    fill(graphics, x + 1, y + 1, x + size - 1, y + size - 1, LauncherTheme.rawArgb(225, rgb));
    fill(graphics, x + 2, y + 2, x + size - 2, y + size - 2, LauncherTheme.rawArgb(205, rgb));
  }

  private static void drawArmorDurabilityBar(Object graphics, int x, int y, int width, Object stack) throws ReflectiveOperationException {
    float ratio = armorDurabilityRatio(stack);
    if (ratio < 0.0F) {
      return;
    }
    int color = ratio > 0.50F ? OverlaySettings.armorHealthyColor()
        : (ratio > 0.20F ? OverlaySettings.armorWarningColor() : OverlaySettings.armorCriticalColor());
    int filledWidth = ratio <= 0.0F ? 0 : Math.max(1, Math.min(width, Math.round(ratio * width)));
    // Tint the complete track with the active status color. Even nearly broken
    // armor therefore keeps a clearly visible CRITICAL color instead of a
    // single hard-to-see pixel.
    fill(graphics, x, y, x + width, y + 2, LauncherTheme.rawArgb(90, color));
    if (filledWidth > 0) {
      fill(graphics, x, y, x + filledWidth, y + 2, 0xFF000000 | color);
    }
  }

  private static boolean moduleEnabled(String id) {
    return MenuModules.enabled(id);
  }

  private static String overlaySampleText(String id) {
    return switch (id) {
      case "fps" -> "FPS 144";
      case "coords" -> "120 64 -32";
      case "nethercoords" -> "NETHER 15 -4";
      case "direction" -> "N | Plains | NETHER 15 -4";
      case "combo" -> "COMBO 4 | BEST 8";
      case "session" -> "SESSION 12:34 | 1.2 km | HITS 24";
      case "inventory" -> "INVENTORY 9 SLOTS";
      case "clock" -> "TIME 12:00";
      case "uptimer" -> "00:00:00";
      case "sounddisplay" -> "Footsteps";
      default -> "";
    };
  }

  private static String convertedDimensionCoords(Object client, Object player) {
    try {
      int x = (int)Math.floor(invokeDouble(player, "getX"));
      int z = (int)Math.floor(invokeDouble(player, "getZ"));
      Object level = getAnyField(client, "level", "world", "field_1687");
      String dimension = String.valueOf(invokeAny(level, "dimension", "dimensionType", "method_27983")).toLowerCase(java.util.Locale.ROOT);
      boolean inNether = dimension.contains("nether");
      return inNether
          ? "OVERWORLD " + (x * 8) + " " + (z * 8)
          : "NETHER " + Math.floorDiv(x, 8) + " " + Math.floorDiv(z, 8);
    } catch (Throwable ignored) {
      return "NETHER 15 -4";
    }
  }

  private static String directionBiomeText(Object client, Object player) throws ReflectiveOperationException {
    double yaw = invokeDouble(player, "getYRot");
    int direction = Math.floorMod((int)Math.floor((yaw / 90.0D) + 0.5D), 4);
    String compass = new String[] { "S", "W", "N", "E" }[direction];
    int x = (int)Math.floor(invokeDouble(player, "getX"));
    int z = (int)Math.floor(invokeDouble(player, "getZ"));
    String biome = biomeName(client, player);
    return compass + " | " + biome + " | NETHER " + Math.floorDiv(x, 8) + " " + Math.floorDiv(z, 8);
  }

  private static String biomeName(Object client, Object player) {
    try {
      Object level = getAnyField(client, "level", "world", "field_1687");
      Object pos = invokeAny(player, "blockPosition", "getBlockPos", "method_24515");
      Object holder = invokeCompatibleOneArg(level, "getBiome", pos);
      if (holder == null) holder = invokeCompatibleOneArg(level, "method_23753", pos);
      String raw = String.valueOf(holder == null ? "Biome" : holder);
      java.util.regex.Matcher matcher = java.util.regex.Pattern.compile("(?:minecraft:)?([a-z0-9_]+)").matcher(raw.toLowerCase(java.util.Locale.ROOT));
      String last = "biome";
      while (matcher.find()) last = matcher.group(1);
      String[] words = last.split("_");
      StringBuilder name = new StringBuilder();
      for (String word : words) if (!word.isEmpty()) name.append(name.length() == 0 ? "" : " ").append(Character.toUpperCase(word.charAt(0))).append(word.substring(1));
      return name.length() == 0 ? "Biome" : name.toString();
    } catch (Throwable ignored) { return "Biome"; }
  }

  private static void drawInventoryHud(Object graphics, Object font, Object player) throws ReflectiveOperationException {
    Object inventory = getAnyField(player, "inventory", "field_7514");
    Object items = getAnyField(inventory, "items", "main", "mainInventory", "field_7547");
    int slot = 18, gap = 1, width = (slot * 9) + (gap * 8) + 4, height = slot + 4;
    int[] anchored = anchoredOverlayPosition(clientInstance(), "inventory", width, height, width, height);
    int x = anchored[0], y = anchored[1];
    if (OverlaySettings.shadow("inventory")) roundedFill(graphics, x + 1, y + 1, width, height, 3, LauncherTheme.argb(100, 0));
    if (OverlaySettings.background("inventory")) { roundedFill(graphics, x, y, width, height, 3, LauncherTheme.rawArgb(OverlaySettings.opacity("inventory"), OverlaySettings.restColor("inventory"))); border(graphics, x, y, width, height, LauncherTheme.rawArgb(255, OverlaySettings.restColor("inventory"))); }
    for (int index = 0; index < 9; index++) {
      Object stack = listItem(items, index);
      int sx = x + 2 + index * (slot + gap);
      drawArmorSlot(graphics, sx, y + 2, slot, OverlaySettings.restColor("inventory"));
      drawItemStack(graphics, stack, sx + 1, y + 3, 16);
      int count = safeInvokeInt(stack, "getCount");
      if (count > 1) drawText(graphics, font, String.valueOf(count), sx + 9, y + 11, 0xFFFFFFFF);
    }
  }

  private static Object listItem(Object list, int index) {
    try {
      if (list instanceof java.util.List<?> values) return index < values.size() ? values.get(index) : null;
      if (list != null && list.getClass().isArray() && index < java.lang.reflect.Array.getLength(list)) return java.lang.reflect.Array.get(list, index);
      Object value = invokeCompatibleOneArg(list, "get", Integer.valueOf(index));
      return value;
    } catch (Throwable ignored) { return null; }
  }

  private static final class SessionHud {
    private static Object world;
    private static long startedMs;
    private static long lastHitMs;
    private static int hits, combo, best;
    private static double lastX, lastY, lastZ, distance;
    private static boolean ready, attackDown;
    private static long lastUpdateMs;
    static void update(Object client, Object player) throws ReflectiveOperationException {
      long now = System.currentTimeMillis();
      if (now - lastUpdateMs < 50L) return;
      lastUpdateMs = now;
      Object nextWorld = getAnyField(client, "level", "world", "field_1687");
      if (world != nextWorld) { world = nextWorld; startedMs = now; hits = combo = best = 0; distance = 0; ready = false; }
      double x = invokeDouble(player, "getX"), y = invokeDouble(player, "getY"), z = invokeDouble(player, "getZ");
      if (ready) { double step = Math.sqrt(Math.pow(x-lastX,2)+Math.pow(y-lastY,2)+Math.pow(z-lastZ,2)); if (step < 20) distance += step; }
      lastX=x; lastY=y; lastZ=z; ready=true;
      boolean down = XLauncherMenuClient.isLeftMouseDown();
      if (down && !attackDown && hasTargetInReach(client)) { hits++; combo = now-lastHitMs > 1800 ? 1 : combo+1; best=Math.max(best,combo); lastHitMs=now; }
      if (now-lastHitMs > 1800) combo=0;
      attackDown=down;
    }
    static String comboText() { return "COMBO " + combo + " | BEST " + best; }
    static String sessionText() { long seconds=Math.max(0,(System.currentTimeMillis()-startedMs)/1000); return String.format(java.util.Locale.ROOT,"SESSION %02d:%02d | %.1f km | HITS %d",seconds/60,seconds%60,distance/1000.0,hits); }
  }

  private static int[] anchoredOverlayPosition(Object client, String id, int width, int height, int baseWidth, int baseHeight) {
    int savedX = OverlaySettings.x(id);
    int savedY = OverlaySettings.y(id);
    int screenW = Math.max(1, scaledWidth(client));
    int screenH = Math.max(1, scaledHeight(client));
    int x;
    if (savedX <= 1) {
      x = 0;
    } else if (savedX + baseWidth >= screenW - 1) {
      x = Math.max(0, screenW - width);
    } else {
      x = Math.max(0, Math.min(Math.max(0, screenW - width), savedX));
    }
    int y = Math.max(0, Math.min(Math.max(0, screenH - height), savedY));
    return new int[] { x, y };
  }

  private static Object[] armorItems(Object player) {
    long now = System.currentTimeMillis();
    if (player == cachedArmorPlayer && now < nextArmorLookupMs) return cachedArmorItems;
    cachedArmorPlayer = player;
    nextArmorLookupMs = now + 250L;
    Object[] result = armorItemsFromEquipmentSlots(player);
    if (hasAnyStack(result)) {
      cachedArmorItems = result;
      return cachedArmorItems;
    }
    Object value = invokeAny(player, "getArmorSlots", "method_5661");
    java.util.List<Object> items = new java.util.ArrayList<>();
    if (value instanceof Iterable<?> iterable) {
      for (Object item : iterable) {
        items.add(item);
      }
    } else if (value != null && value.getClass().isArray()) {
      int length = java.lang.reflect.Array.getLength(value);
      for (int index = 0; index < length; index += 1) {
        items.add(java.lang.reflect.Array.get(value, index));
      }
    }
    for (int index = 0; index < Math.min(4, items.size()); index += 1) {
      result[3 - index] = items.get(index);
    }
    if (!hasAnyStack(result)) {
      fillArmorFromInventory(player, result);
    }
    cachedArmorItems = result;
    return cachedArmorItems;
  }

  private static boolean cachedTargetInReach(Object client) {
    long now = System.currentTimeMillis();
    if (now >= nextTargetLookupMs) {
      nextTargetLookupMs = now + 50L;
      cachedTargetInReach = hasTargetInReach(client);
    }
    return cachedTargetInReach;
  }

  private static Object[] armorItemsFromEquipmentSlots(Object player) {
    Object[] result = new Object[] { null, null, null, null };
    result[0] = itemByEquipmentSlot(player, "HEAD", 5);
    result[1] = itemByEquipmentSlot(player, "CHEST", 4);
    result[2] = itemByEquipmentSlot(player, "LEGS", 3);
    result[3] = itemByEquipmentSlot(player, "FEET", 2);
    return result;
  }

  private static Object itemByEquipmentSlot(Object player, String slotName, int fallbackOrdinal) {
    Object slot = equipmentSlot(slotName, fallbackOrdinal);
    if (slot == null) {
      return null;
    }
    for (String methodName : new String[] { "getItemBySlot", "getEquippedStack", "method_6118" }) {
      Object stack = invokeCompatibleOneArg(player, methodName, slot);
      if (stack != null) {
        return stack;
      }
    }
    return null;
  }

  private static Object equipmentSlot(String slotName, int fallbackOrdinal) {
    for (String className : new String[] { "net.minecraft.world.entity.EquipmentSlot", "net.minecraft.entity.EquipmentSlot", "net.minecraft.class_1304" }) {
      try {
        Class<?> type = Class.forName(className);
        Object[] constants = type.getEnumConstants();
        if (constants == null) {
          continue;
        }
        for (Object constant : constants) {
          if (constant instanceof Enum<?> enumValue && slotName.equalsIgnoreCase(enumValue.name())) {
            return constant;
          }
          String text = String.valueOf(constant);
          if (text.toLowerCase(java.util.Locale.ROOT).contains(slotName.toLowerCase(java.util.Locale.ROOT))) {
            return constant;
          }
        }
        if (fallbackOrdinal >= 0 && fallbackOrdinal < constants.length) {
          return constants[fallbackOrdinal];
        }
      } catch (Throwable ignored) {
        // Try the next namespace.
      }
    }
    return null;
  }

  private static boolean hasAnyStack(Object[] stacks) {
    for (Object stack : stacks) {
      if (stack != null && !isEmptyStack(stack)) {
        return true;
      }
    }
    return false;
  }

  private static void fillArmorFromInventory(Object player, Object[] result) {
