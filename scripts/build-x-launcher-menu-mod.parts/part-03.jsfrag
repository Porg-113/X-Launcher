  static FriendRequest newestIncomingRequest() {
    if (SOCIAL_DISABLED) {
      return null;
    }
    load();
    synchronized (LOCK) {
      trimRequestsLocked();
      FriendRequest newest = null;
      for (FriendRequest request : incomingRequests.values()) {
        if (newest == null || request.timestampMs > newest.timestampMs) {
          newest = request;
        }
      }
      return newest;
    }
  }

