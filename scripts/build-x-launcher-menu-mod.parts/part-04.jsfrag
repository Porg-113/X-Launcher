  private static Object integratedServerPlayer(Object server, Object client) {
    Object playerList = invokeAnyNullable(server, "getPlayerList", "getPlayerManager", "method_3760", "method_13949");
    if (playerList == null) {
      return null;
    }
    String localName = playerName(playerObject(client));
    if (!localName.isEmpty()) {
      Object byName = invokeStringReturn(playerList, localName, "getPlayerByName", "method_14566");
      if (byName != null) {
        return byName;
      }
    }
    Object players = invokeAnyNullable(playerList, "getPlayers", "getPlayerList", "method_14571", "method_18456");
    if (players instanceof Iterable<?> iterable) {
      Object first = null;
      for (Object candidate : iterable) {
        if (first == null) {
          first = candidate;
        }
        if (!localName.isEmpty() && localName.equalsIgnoreCase(playerName(candidate))) {
          return candidate;
        }
      }
      return first;
    }
    return null;
  }

