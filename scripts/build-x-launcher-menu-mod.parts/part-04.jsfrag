  'dev/xlauncher/client/mixin/XLauncherPauseScreenMixin.java': String.raw`
package dev.xlauncher.client.mixin;

import dev.xlauncher.client.XLauncherMenuClient;
import net.minecraft.client.gui.components.AbstractWidget;
import net.minecraft.client.gui.components.Button;
import net.minecraft.client.gui.screens.PauseScreen;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.network.chat.Component;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Shadow;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;

@Mixin(PauseScreen.class)
public abstract class XLauncherPauseScreenMixin extends Screen {
  @Shadow
  private Button disconnectButton;

  protected XLauncherPauseScreenMixin(Component title) {
    super(title);
  }

  @Inject(method = "init", at = @At("TAIL"), require = 0)
  private void xclient$addPauseMenuButton(CallbackInfo callback) {
    if (!((PauseScreen) (Object) this).showsPauseMenu()) {
      return;
    }
    int buttonW = 20;
    int buttonH = 20;
    java.util.List<AbstractWidget> compactButtons = new java.util.ArrayList<>();
    int rowY = -1;
    for (var child : children()) {
      if (child instanceof AbstractWidget widget && widget.getWidth() == 20 && widget.getHeight() == 20) {
        compactButtons.add(widget);
        if (rowY < 0) rowY = widget.getY();
      }
    }
    compactButtons.sort(java.util.Comparator.comparingInt(AbstractWidget::getX));
    int spacing = 4;
    int count = compactButtons.size() + 1;
    int totalW = (count * buttonW) + ((count - 1) * spacing);
    int x = (width - totalW) / 2;
    int y = rowY < 0 ? Math.min(height - buttonH - 6, (height / 2) + 76) : rowY;
    for (int index = 0; index < compactButtons.size(); index += 1) {
      compactButtons.get(index).setPosition(x + ((index + 1) * (buttonW + spacing)), y);
    }
    addRenderableWidget(Button.builder(Component.empty(), button -> XLauncherMenuClient.openMenuFromPause())
        .bounds(x, y, buttonW, buttonH)
        .build());
    final int iconX = x + 6;
    final int iconY = y + 5;
    addRenderableOnly((graphics, mouseX, mouseY, delta) -> {
      int[] rows = { 0b1000001, 0b1000001, 0b0100010, 0b0010100, 0b0001000, 0b0010100, 0b0100010, 0b1000001, 0b1000001 };
      for (int row = 0; row < rows.length; row += 1) {
        for (int column = 0; column < 7; column += 1) {
          if ((rows[row] & (1 << (6 - column))) == 0) continue;
          int px = iconX + column, py = iconY + row;
          graphics.fill(px + 1, py + 1, px + 3, py + 3, 0xC0000000);
          int shade = row >= 6 ? 0xFFB8BEC4 : ((row + column) % 3 == 0 ? 0xFFD9DEE2 : 0xFFFFFFFF);
          graphics.fill(px, py, px + 2, py + 2, shade);
        }
      }
    });
  }
}
`,
  'dev/xlauncher/client/NativeHitboxController.java': String.raw`
package dev.xlauncher.client;

import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.components.debug.DebugScreenEntries;
import net.minecraft.client.gui.components.debug.DebugScreenEntryStatus;

/** Bridges the module to the exact vanilla renderer used by Minecraft's F3+B shortcut. */
final class NativeHitboxController {
  private NativeHitboxController() {
  }

  static void setEnabled(boolean enabled) {
    Minecraft client = Minecraft.getInstance();
    if (client == null || client.debugEntries == null) {
      return;
    }
    client.debugEntries.setStatus(
        DebugScreenEntries.ENTITY_HITBOXES,
        enabled ? DebugScreenEntryStatus.ALWAYS_ON : DebugScreenEntryStatus.NEVER);
  }
}
