        }
        type = type.getSuperclass();
      }
    }
    return null;
  }

  private static void updateClicks(Minecraft client) {
    try {
      long handle = windowHandle(client);
      Class<?> glfw = Class.forName("org.lwjgl.glfw.GLFW");
      int press = glfw.getField("GLFW_PRESS").getInt(null);
      int leftButton = glfw.getField("GLFW_MOUSE_BUTTON_LEFT").getInt(null);
      int rightButton = glfw.getField("GLFW_MOUSE_BUTTON_RIGHT").getInt(null);
      int leftState = ((Number) glfw.getMethod("glfwGetMouseButton", long.class, int.class).invoke(null, handle, leftButton)).intValue();
      int rightState = ((Number) glfw.getMethod("glfwGetMouseButton", long.class, int.class).invoke(null, handle, rightButton)).intValue();
      boolean leftDown = leftState == press;
      boolean rightDown = rightState == press;
      long now = System.currentTimeMillis();
      if (leftDown && !leftMouseDown) {
        LEFT_CLICK_TIMES[leftClickSlot] = now;
        leftClickSlot = (leftClickSlot + 1) % LEFT_CLICK_TIMES.length;
      }
      if (rightDown && !rightMouseDown) {
        RIGHT_CLICK_TIMES[rightClickSlot] = now;
        rightClickSlot = (rightClickSlot + 1) % RIGHT_CLICK_TIMES.length;
      }
      leftMouseDown = leftDown;
      rightMouseDown = rightDown;
    } catch (Throwable ignored) {
      leftMouseDown = false;
      rightMouseDown = false;
    }
  }

  private static long windowHandle(Object client) throws ReflectiveOperationException {
    Object window = invokeAny(client, "getWindow", "method_22683");
    Object handle = invokeAny(window, "handle", "method_4490");
    return ((Number) handle).longValue();
  }

  private static Object invokeAny(Object target, String... names) throws ReflectiveOperationException {
    ReflectiveOperationException failure = null;
    for (String name : names) {
      try {
        return target.getClass().getMethod(name).invoke(target);
      } catch (ReflectiveOperationException exception) {
        failure = exception;
      }
    }
    throw failure == null ? new NoSuchMethodException() : failure;
  }

  private static void ensureKeyRegistered(Minecraft client) {
    if (client.options == null || menuKey == null) {
      return;
    }

    syncModuleKeyMappings(client);
    syncZoomKeyMapping(client);
    if (!keyRegistered) {
      tryFabricKeyBindingHelper();
      boolean optionsRegistered = tryAddKeyToOptions(client);
      keyRegistered = optionsRegistered || helperRegistered;
    }
    for (int index = 0; index < moduleKeys.length; index += 1) {
      MenuModules.Module module = MenuModules.modules()[index];
      if (!module.keyBindable || moduleKeys[index] == null || moduleKeyRegistered[index]) {
        continue;
      }
      moduleKeyRegistered[index] = tryAddOrReplaceKeyToOptions(client, moduleKeys[index], moduleKeyId(module));
      if ("zoom".equals(module.id)) {
        zoomKeyRegistered = moduleKeyRegistered[index];
      }
    }
    syncMenuKeysFromControls(client);
  }

  private static boolean tryAddKeyToOptions(Minecraft client) {
    try {
      Field field = keyMappingsField(client.options);
      if (field == null) {
        throw new NoSuchFieldException("key mappings");
      }
      KeyMapping[] mappings = (KeyMapping[]) field.get(client.options);
      if (mappings == null) {
        mappings = new KeyMapping[0];
      }
      for (KeyMapping mapping : mappings) {
        if (isMenuKey(mapping)) {
          menuKey = mapping;
          KeyMapping.resetMapping();
          log("Key mapping is present in Minecraft options.");
          return true;
        }
      }

      KeyMapping[] next = Arrays.copyOf(mappings, mappings.length + 1);
      next[next.length - 1] = menuKey;
      field.set(client.options, next);
      KeyMapping.resetMapping();
      log("Added key mapping to Minecraft options fallback.");
      return true;
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      // The key still works in-session; the controls list only needs this path as a fallback.
      if (!fallbackFailureLogged) {
        fallbackFailureLogged = true;
        log("Could not add key mapping to Minecraft options fallback.");
      }
      return false;
    }
  }

  private static boolean tryAddOrReplaceKeyToOptions(Minecraft client, KeyMapping keyMapping, String keyId) {
    try {
      Field field = keyMappingsField(client.options);
      if (field == null) {
        throw new NoSuchFieldException("key mappings");
      }
      KeyMapping[] mappings = (KeyMapping[]) field.get(client.options);
      if (mappings == null) {
        mappings = new KeyMapping[0];
      }
      for (int index = 0; index < mappings.length; index += 1) {
        if (isNamedKey(mappings[index], keyId)) {
          if (mappings[index] != keyMapping) {
            KeyMapping[] next = Arrays.copyOf(mappings, mappings.length);
            next[index] = keyMapping;
            field.set(client.options, next);
          }
          KeyMapping.resetMapping();
          log("Updated key mapping " + keyId + " in Minecraft options.");
          return true;
        }
      }

      KeyMapping[] next = Arrays.copyOf(mappings, mappings.length + 1);
      next[next.length - 1] = keyMapping;
      field.set(client.options, next);
      KeyMapping.resetMapping();
      log("Added key mapping " + keyId + " to Minecraft options fallback.");
      return true;
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      if (!fallbackFailureLogged) {
        fallbackFailureLogged = true;
        log("Could not add key mapping to Minecraft options fallback.");
      }
      return false;
    }
  }

  private static Field keyMappingsField(Object options) {
    String[] knownNames = { "keyMappings", "allKeys", "field_1839" };
    for (String name : knownNames) {
      try {
        Field field = options.getClass().getDeclaredField(name);
        if (KeyMapping[].class.isAssignableFrom(field.getType())) {
          field.setAccessible(true);
          return field;
        }
      } catch (ReflectiveOperationException | RuntimeException ignored) {
      }
    }

    Class<?> type = options.getClass();
    while (type != null) {
      for (Field field : type.getDeclaredFields()) {
        if (KeyMapping[].class.isAssignableFrom(field.getType())) {
          field.setAccessible(true);
          return field;
        }
      }
      type = type.getSuperclass();
    }
    return null;
  }

  private static boolean isMenuKey(KeyMapping mapping) {
    return isNamedKey(mapping, MENU_KEY_ID);
  }

  private static void releaseConflictingMenuKeyMappings(Minecraft client) {
    if (client == null || client.options == null || menuKey == null) {
      return;
    }
    int menuCode = keyCodeFromMapping(menuKey);
    if (menuCode <= 0) {
      menuCode = RIGHT_SHIFT;
    }
    try {
      Field field = keyMappingsField(client.options);
      KeyMapping[] mappings = field == null ? null : (KeyMapping[]) field.get(client.options);
      if (mappings == null) {
        return;
      }
      for (KeyMapping mapping : mappings) {
        if (mapping == null || mapping == menuKey || isMenuKey(mapping) || keyCodeFromMapping(mapping) != menuCode) {
          continue;
        }
        setMappingDown(mapping, false);
        while (mapping.consumeClick()) {
          // Drain queued clicks so another menu cannot consume this X Client key press.
        }
      }
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      // The raw keyboard callback is already cancelled; this only clears queued conflicts.
    }
  }

  private static boolean isNamedKey(KeyMapping mapping, String keyId) {
    try {
      return mapping != null && keyId.equals(mapping.getName());
    } catch (RuntimeException ignored) {
      return false;
    }
  }

  private static void syncMenuKeysFromControls(Minecraft client) {
    if (client == null || moduleKeys == null) {
      return;
    }
    MenuModules.Module[] modules = MenuModules.modules();
    int limit = Math.min(modules.length, moduleKeys.length);
    for (int index = 0; index < limit; index += 1) {
      MenuModules.Module module = modules[index];
      KeyMapping mapping = moduleKeys[index];
      if (!module.keyBindable || mapping == null || !isNamedKey(mapping, moduleKeyId(module))) {
        continue;
      }
      String saved = keyMappingSaveString(mapping).toLowerCase(java.util.Locale.ROOT);
      int mappedCode = keyCodeFromMapping(mapping);
      int menuCode = mappedCode > 0 ? mappedCode : -1;
      if (saved.contains("unknown") || saved.endsWith(".none") || saved.contains("unbound")) {
        menuCode = -1;
      }
      if (module.keyCode == menuCode) {
        moduleKeyCodeSnapshots[index] = menuCode;
        continue;
      }
      MenuModules.setKeyCombo(index, menuCode, 0);
      moduleKeyCodeSnapshots[index] = menuCode;
      if ("zoom".equals(module.id)) {
        zoomKey = mapping;
        zoomKeyCodeSnapshot = menuCode;
        zoomKeyRegistered = index < moduleKeyRegistered.length && moduleKeyRegistered[index];
      }
    }
  }

  private static int keyCodeFromMapping(Object mapping) {
    Object key = getAnyField(mapping, "key", "boundKey", "field_1655");
    int value = readIntFromObject(key, Integer.MIN_VALUE, "getValue", "method_1444");
    if (value == Integer.MIN_VALUE) {
      value = readIntFromObject(mapping, Integer.MIN_VALUE, "getKey", "getDefaultKey", "method_1429");
    }
    return value == Integer.MIN_VALUE ? -1 : value;
  }

  private static boolean tryFabricKeyBindingHelper() {
    if (helperRegistered || helperAttempted || menuKey == null) {
      return helperRegistered;
    }
    helperAttempted = true;
    syncModuleKeyMappings(Minecraft.getInstance());
    String[][] helpers = {
        { "net.fabricmc.fabric.api.client.keymapping.v1.KeyMappingHelper", "registerKeyMapping" },
        { "net.fabricmc.fabric.api.client.keybinding.v1.KeyBindingHelper", "registerKeyBinding" }
    };
    for (String[] candidate : helpers) {
      try {
        Class<?> helper = Class.forName(candidate[0]);
        for (Method method : helper.getMethods()) {
          if (!candidate[1].equals(method.getName()) || method.getParameterCount() != 1) {
            continue;
          }
          if (!method.getParameterTypes()[0].isInstance(menuKey)) {
            continue;
          }
          boolean registeredAny = false;
          Object registered = method.invoke(null, menuKey);
          if (registered instanceof KeyMapping) {
            menuKey = (KeyMapping) registered;
          }
          registeredAny = true;
          for (int index = 0; index < moduleKeys.length; index += 1) {
            if (moduleKeys[index] == null) {
              continue;
            }
            Object moduleRegistered = method.invoke(null, moduleKeys[index]);
            if (moduleRegistered instanceof KeyMapping) {
              moduleKeys[index] = (KeyMapping) moduleRegistered;
              if ("zoom".equals(MenuModules.modules()[index].id)) {
                zoomKey = moduleKeys[index];
              }
            }
            moduleKeyRegistered[index] = false;
            registeredAny = true;
          }
          helperRegistered = registeredAny;
          log("Registered key mapping through " + candidate[0] + "." + candidate[1] + ".");
          return true;
        }
      } catch (ReflectiveOperationException | RuntimeException ignored) {
        // Try the next Fabric API naming variant.
      }
    }
    log("Fabric key mapping helper not available; using fallback registration.");
    return false;
  }

  private static boolean isZoomActive() {
    MenuModules.Module module = zoomModule();
    if (module == null || !MenuModules.isUnlocked(module.id) || !isClientGameplayFocused()) {
      return false;
    }
    int zoomIndex = moduleIndex("zoom");
    if (module.keyCode > 0 || (zoomIndex >= 0 && isKeyMappingAssigned(zoomIndex))) {
      return zoomKeyHeld || isZoomKeyCurrentlyDown(module);
    }
    return module.enabled;
  }

  private static boolean isKeyMappingAssigned(int index) {
    if (index < 0 || index >= moduleKeys.length || moduleKeys[index] == null) {
      return false;
    }
    String saved = keyMappingSaveString(moduleKeys[index]);
    if (saved.isEmpty()) {
      return MenuModules.modules()[index].keyCode > 0;
    }
    String normalized = saved.toLowerCase(java.util.Locale.ROOT);
    return !normalized.contains("unknown") && !normalized.endsWith(".none") && !normalized.contains("unbound");
  }

  private static String keyMappingSaveString(Object keyMapping) {
    if (keyMapping == null) {
      return "";
    }
    for (String methodName : new String[] { "saveString", "method_1428" }) {
      try {
        Object value = keyMapping.getClass().getMethod(methodName).invoke(keyMapping);
        return String.valueOf(value == null ? "" : value);
      } catch (Throwable ignored) {
        // Try the next mapping name.
      }
    }
    return "";
  }

  private static MenuModules.Module zoomModule() {
    for (MenuModules.Module module : MenuModules.modules()) {
      if ("zoom".equals(module.id)) {
        return module;
      }
    }
    return null;
  }

  private static boolean isClientGameplayFocused() {
    try {
      return isGameplayFocused(Minecraft.getInstance());
    } catch (Throwable ignored) {
      return false;
    }
  }

  private static boolean isZoomKeyCurrentlyDown(MenuModules.Module module) {
    try {
      Minecraft client = Minecraft.getInstance();
      return client != null && isZoomKeyDown(client, module);
    } catch (Throwable ignored) {
      return false;
    }
  }

  private static void ensureScrollCallback(Minecraft client) {
    try {
      long handle = windowHandle(client);
      if (scrollCallbackProxy != null && scrollCallbackHandle == handle) {
        return;
      }
      Class<?> callbackType = Class.forName("org.lwjgl.glfw.GLFWScrollCallbackI");
      InvocationHandler handler = (proxy, method, args) -> {
        if ("invoke".equals(method.getName()) && args != null && args.length >= 3) {
          double yOffset = ((Number) args[2]).doubleValue();
          if (isGameplayFocused(client) && isZoomActive()) {
            adjustZoom(yOffset);
            return null;
          }
          forwardScroll(args);
        }
        return null;
      };
      Object proxy = Proxy.newProxyInstance(callbackType.getClassLoader(), new Class<?>[] { callbackType }, handler);
      Class<?> glfw = Class.forName("org.lwjgl.glfw.GLFW");
      Object previous = glfw.getMethod("glfwSetScrollCallback", long.class, callbackType).invoke(null, handle, proxy);
      previousScrollCallback = previous;
      scrollCallbackProxy = proxy;
      scrollCallbackHandle = handle;
    } catch (Throwable ignored) {
      // Zoom still works; only mouse-wheel strength control is unavailable.
    }
  }

  private static void forwardScroll(Object[] args) {
    Object callback = previousScrollCallback;
    if (callback == null) {
      return;
    }
    for (Method method : callback.getClass().getMethods()) {
      if (!"invoke".equals(method.getName()) || method.getParameterCount() != args.length) {
        continue;
      }
      try {
        method.invoke(callback, args);
        return;
      } catch (Throwable ignored) {
        // Try another invoke signature.
      }
    }
  }

  public static boolean handleZoomScroll(double yOffset) {
    return false;
  }

  private static void adjustZoom(double yOffset) {
    if (yOffset == 0.0D) {
      return;
    }
    int direction = yOffset > 0.0D ? 1 : -1;
    int steps = Math.max(1, Math.min(MAX_ZOOM_SCROLL_STEPS, (int) Math.ceil(Math.abs(yOffset))));
    int next = MenuModules.zoomStrengthPercent() + (direction * ZOOM_SCROLL_STEP_PERCENT * steps);
    MenuModules.setZoomStrengthPercent(next);
    zoomFactor = MenuModules.zoomStrength();
    try {
      updateZoom(Minecraft.getInstance());
    } catch (Throwable ignored) {
      // The watcher will apply it on the next tick.
    }
  }

  private static void updateMovementTweaks(Minecraft client) {
    if (client == null || client.options == null) {
      return;
    }
    updateNoBob(client.options);
    updateSprint(client);
    updateSpeedEffect(client);
    updateResistanceEffect(client);
    updateInvisibilityEffect(client);
    updateInstantBreak(client);
    if (moduleEnabled("freecam") && freecamApplied) {
      freezePlayerMovement(client);
    }
    MobCameraTracker.update(client, moduleEnabled("mobtrack") && isGameplayFocused(client));
    AutoHitController.update(client, moduleEnabled("autohit") && isGameplayFocused(client));
    HotbarAttributeController.update(client, moduleEnabled("atribute") && isGameplayFocused(client));
  }

  private static void updateInstantBreak(Minecraft client) {
    if (!moduleEnabled("breakspeed") || !isGameplayFocused(client) || !isMouseButtonDown(client, 0)) {
      return;
    }
    Object hitResult = getAnyField(client, "hitResult", "field_1765");
    Object pos = blockHitPos(hitResult);
    if (pos == null) {
      return;
    }
    if (destroyIntegratedServerBlock(client, pos)) {
      swingMainHand(playerObject(client));
    }
  }

  private static boolean destroyIntegratedServerBlock(Object client, Object pos) {
    Object server = integratedServer(client);
    if (server == null || pos == null) {
      return false;
    }
    Runnable task = () -> destroyIntegratedServerBlockNow(server, client, pos);
    if (server instanceof Executor executor) {
      executor.execute(task);
    } else {
      task.run();
    }
    return true;
  }

  private static void destroyIntegratedServerBlockNow(Object server, Object client, Object pos) {
    Object serverPlayer = integratedServerPlayer(server, client);
    if (serverPlayer == null) {
      return;
    }
    Object serverGameMode = getAnyField(serverPlayer, "gameMode", "gameModeForPlayer", "field_13987");
    if (invokeBlockDestroy(serverGameMode, pos)) {
      return;
    }
    Object level = invokeAnyNullable(serverPlayer, "serverLevel", "level", "getCommandSenderWorld", "method_51469", "method_37908", "method_5681");
    if (level == null) {
      level = getAnyField(serverPlayer, "level", "serverLevel", "field_6002", "field_37908");
    }
    invokeLevelDestroyBlock(level, pos, serverPlayer);
  }

  private static boolean invokeLevelDestroyBlock(Object level, Object pos, Object player) {
    if (level == null || pos == null) {
      return false;
    }
    for (String name : new String[] { "destroyBlock", "removeBlock", "method_8650", "method_22352" }) {
      for (Method method : level.getClass().getMethods()) {
        if (!name.equals(method.getName())) {
          continue;
        }
        Class<?>[] types = method.getParameterTypes();
        if (types.length < 2 || types.length > 4 || !types[0].isInstance(pos) || types[1] != Boolean.TYPE) {
          continue;
        }
        try {
          Object result;
          if (types.length == 2) {
            result = method.invoke(level, pos, Boolean.TRUE);
          } else if (types.length == 3) {
            Object third = types[2] == Integer.TYPE ? Integer.valueOf(512) : player;
            if (third != null && !types[2].isPrimitive() && !types[2].isInstance(third)) {
              continue;
            }
            result = method.invoke(level, pos, Boolean.TRUE, third);
          } else {
            if (player != null && !types[2].isInstance(player)) {
              continue;
            }
            result = method.invoke(level, pos, Boolean.TRUE, player, Integer.valueOf(512));
          }
          return !(result instanceof Boolean bool) || bool.booleanValue();
        } catch (Throwable ignored) {
          // Try another destroy/remove signature.
