  private static void initFreecam(Object camera, Minecraft client) {
    Object player = playerObject(client);
    double[] playerPosition = readPosition(player);
    if (playerPosition != null) {
      freecamPlayerX = playerPosition[0];
      freecamPlayerY = playerPosition[1];
      freecamPlayerZ = playerPosition[2];
    }
    freecamPlayerYaw = readFloat(player, 0.0F, "getYRot", "getYaw", "method_36454", "method_5705", "yRot", "yaw");
    freecamPlayerPitch = readFloat(player, 0.0F, "getXRot", "getPitch", "method_36455", "method_5695", "xRot", "pitch");
    freecamPlayerHeadYaw = readFloat(player, freecamPlayerYaw, "getYHeadRot", "getHeadYaw", "method_5791", "yHeadRot", "headYaw");
    freecamPlayerBodyYaw = readFloat(player, freecamPlayerYaw, "getYBodyRot", "getBodyYaw", "method_43078", "yBodyRot", "bodyYaw");
    double[] position = readPosition(camera);
    if (position == null) {
      position = readPosition(playerObject(client));
    }
    if (position == null) {
      position = new double[] { 0.0D, 80.0D, 0.0D };
    }
    freecamX = position[0];
    freecamY = position[1];
    freecamZ = position[2];
    freecamYaw = readFloat(camera, 0.0F, "yRot", "yaw", "method_19330");
    freecamPitch = readFloat(camera, 25.0F, "xRot", "method_19329");
    freecamPitch = clampFloat(freecamPitch, -89.0F, 89.0F);
    freecamApplied = true;
    freecamChunkAvailable = null;
    freecamMouseReady = false;
    lastFreecamMoveMs = System.currentTimeMillis();
  }

  private static void updateFreecam(Minecraft client) {
    updateFreecamChunkRendering(true);
    long now = System.currentTimeMillis();
    double seconds = lastFreecamMoveMs <= 0L ? 0.0D : Math.min(0.08D, (now - lastFreecamMoveMs) / 1000.0D);
    lastFreecamMoveMs = now;
    if (!isGameplayFocused(client)) {
      freecamMouseReady = false;
      return;
    }

    updateFreecamLook(client);
    restoreFreecamPlayerTransform(client);
    freezePlayerMovement(client);

    double forward = (isKeyDown(client, 87) ? 1.0D : 0.0D) - (isKeyDown(client, 83) ? 1.0D : 0.0D);
    double strafe = (isKeyDown(client, 65) ? 1.0D : 0.0D) - (isKeyDown(client, 68) ? 1.0D : 0.0D);
    double vertical = (isKeyDown(client, 32) ? 1.0D : 0.0D) - (isKeyDown(client, 340) ? 1.0D : 0.0D);
    double length = Math.sqrt((forward * forward) + (strafe * strafe) + (vertical * vertical));
    if (length <= 0.0D || seconds <= 0.0D) {
      return;
    }

    forward /= length;
    strafe /= length;
    vertical /= length;
    double yawRad = Math.toRadians(freecamYaw);
    double forwardX = -Math.sin(yawRad);
    double forwardZ = Math.cos(yawRad);
    double rightX = Math.cos(yawRad);
    double rightZ = Math.sin(yawRad);
    double speed = freecamSpeed;
    if (isKeyDown(client, 341) || isKeyDown(client, 345)) {
      speed *= 2.6D;
    }
    if (isKeyDown(client, 342) || isKeyDown(client, 346)) {
      speed *= 0.35D;
    }
    double distance = speed * seconds * 8.0D;
    freecamX += ((forwardX * forward) + (rightX * strafe)) * distance;
    freecamY += vertical * distance;
    freecamZ += ((forwardZ * forward) + (rightZ * strafe)) * distance;
    boolean available = client.level.hasChunk(((int)Math.floor(freecamX)) >> 4, ((int)Math.floor(freecamZ)) >> 4);
    if (freecamChunkAvailable == null || freecamChunkAvailable.booleanValue() != available) {
      freecamChunkAvailable = Boolean.valueOf(available);
      log(available ? "Freecam entered a received client chunk." : "Freecam entered an unavailable chunk; no world data will be synthesized.");
    }
  }

  /** Sodium normally defers off-screen chunk mesh uploads. Freecam needs all
   * already-received chunks around the camera ready before they enter view. */
  private static void updateFreecamChunkRendering(boolean enabled) {
    try {
      Class<?> sodium = Class.forName("net.caffeinemc.mods.sodium.client.SodiumClientMod");
      Object options = sodium.getMethod("options").invoke(null);
      Object performance = options.getClass().getField("performance").get(options);
      java.lang.reflect.Field modeField = performance.getClass().getField("chunkBuildDeferMode");
      if (enabled) {
        if (previousSodiumChunkDeferMode == null) previousSodiumChunkDeferMode = modeField.get(performance);
        Object immediate = Enum.valueOf((Class) modeField.getType(), "ZERO_FRAMES");
        modeField.set(performance, immediate);
      } else if (previousSodiumChunkDeferMode != null) {
        modeField.set(performance, previousSodiumChunkDeferMode);
        previousSodiumChunkDeferMode = null;
      }
    } catch (Throwable ignored) {
      // Sodium is optional; vanilla rendering already builds received chunks normally.
    }
  }

  private static void updateFreecamLook(Minecraft client) {
    try {
      long handle = windowHandle(client);
      double[] x = new double[1];
      double[] y = new double[1];
      Class<?> glfw = Class.forName("org.lwjgl.glfw.GLFW");
      glfw.getMethod("glfwGetCursorPos", long.class, double[].class, double[].class).invoke(null, handle, x, y);
      if (freecamMouseReady) {
        double dx = x[0] - lastFreecamMouseX;
        double dy = y[0] - lastFreecamMouseY;
        double sensitivity = 0.12D;
        freecamYaw = wrapDegrees((float) (freecamYaw + (dx * sensitivity)));
        freecamPitch = clampFloat((float) (freecamPitch + (dy * sensitivity)), -89.0F, 89.0F);
      }
      lastFreecamMouseX = x[0];
      lastFreecamMouseY = y[0];
      freecamMouseReady = true;
    } catch (Throwable ignored) {
      freecamMouseReady = false;
    }
  }

  private static void restoreFreecamPlayerTransform(Object client) {
    Object player = playerObject(client);
    if (player == null) return;
    invokePosition(player, freecamPlayerX, freecamPlayerY, freecamPlayerZ, "setPos", "setPosition", "method_5814");
    invokePosition(player, 0.0D, 0.0D, 0.0D, "setDeltaMovement", "setVelocity", "method_18799");
    invokeFloat(player, freecamPlayerYaw, "setYRot", "setYaw", "method_36456");
    invokeFloat(player, freecamPlayerPitch, "setXRot", "setPitch", "method_36457");
    invokeFloat(player, freecamPlayerHeadYaw, "setYHeadRot", "setHeadYaw", "method_5847");
    invokeFloat(player, freecamPlayerBodyYaw, "setYBodyRot", "setBodyYaw", "method_5784");
    setDoubleFields(player, freecamPlayerX, "xo", "xOld", "lastRenderX", "field_6014");
    setDoubleFields(player, freecamPlayerY, "yo", "yOld", "lastRenderY", "field_6036");
    setDoubleFields(player, freecamPlayerZ, "zo", "zOld", "lastRenderZ", "field_5969");
    setFloatFields(player, freecamPlayerYaw, "yRot", "yaw", "yRotO", "lastYaw", "field_6031", "field_5982");
    setFloatFields(player, freecamPlayerPitch, "xRot", "pitch", "xRotO", "lastPitch", "field_5965", "field_6030");
    setFloatFields(player, freecamPlayerHeadYaw, "yHeadRot", "headYaw", "yHeadRotO", "lastHeadYaw", "field_6241", "field_6259");
    setFloatFields(player, freecamPlayerBodyYaw, "yBodyRot", "bodyYaw", "yBodyRotO", "lastBodyYaw", "field_6283");
  }

  private static void invokePosition(Object target, double x, double y, double z, String... methodNames) {
    if (target == null) return;
    for (String methodName : methodNames) {
      for (Class<?> type = target.getClass(); type != null; type = type.getSuperclass()) {
        try {
          Method method = type.getDeclaredMethod(methodName, Double.TYPE, Double.TYPE, Double.TYPE);
          method.setAccessible(true);
          method.invoke(target, x, y, z);
          return;
        } catch (Throwable ignored) {
          // Try the next mapping or superclass.
        }
      }
    }
  }

  private static boolean isGameplayFocused(Object client) {
    return client instanceof Minecraft minecraft
        && minecraft.level != null
        && minecraft.player != null
        && currentScreen(minecraft) == null;
  }

  private static Object playerObject(Object client) {
    return getAnyField(client, "player", "field_1724");
  }

  private static double[] readPosition(Object target) {
    if (target == null) {
      return null;
    }
    try {
      Object pos = invokeAny(target, "position", "getPosition", "method_19538", "method_19326");
      double x = readDouble(pos, Double.NaN, "x", "method_10216", "getX", "x");
      double y = readDouble(pos, Double.NaN, "y", "method_10214", "getY", "y");
      double z = readDouble(pos, Double.NaN, "z", "method_10215", "getZ", "z");
      if (Double.isFinite(x) && Double.isFinite(y) && Double.isFinite(z)) {
        return new double[] { x, y, z };
      }
    } catch (Throwable ignored) {
      // Try entity coordinate methods below.
    }
    double x = readDouble(target, Double.NaN, "getX", "method_23317", "x");
    double y = readDouble(target, Double.NaN, "getEyeY", "method_23320", "getY", "method_23318", "y");
    double z = readDouble(target, Double.NaN, "getZ", "method_23321", "z");
    if (Double.isFinite(x) && Double.isFinite(y) && Double.isFinite(z)) {
      return new double[] { x, y, z };
    }
    return null;
  }

  private static double readDouble(Object target, double fallback, String... names) {
    if (target == null) {
      return fallback;
    }
    for (String name : names) {
      try {
        Method method = target.getClass().getMethod(name);
        if (method.getParameterCount() == 0 && Number.class.isAssignableFrom(wrapType(method.getReturnType()))) {
          return ((Number) method.invoke(target)).doubleValue();
        }
      } catch (Throwable ignored) {
        // Try a field with the same name.
      }
      try {
        Field field = target.getClass().getField(name);
        Object value = field.get(target);
        if (value instanceof Number number) {
          return number.doubleValue();
        }
      } catch (Throwable ignored) {
        // Try the next candidate.
      }
    }
    return fallback;
  }

  private static float readFloat(Object target, float fallback, String... names) {
    return (float) readDouble(target, fallback, names);
  }

  private static void setCameraPosition(Object camera, double x, double y, double z) {
    for (String methodName : new String[] { "setPosition", "method_19327" }) {
      try {
        Method method = camera.getClass().getDeclaredMethod(methodName, Double.TYPE, Double.TYPE, Double.TYPE);
        method.setAccessible(true);
        method.invoke(camera, x, y, z);
        return;
      } catch (Throwable ignored) {
        // Try the next mapping name.
      }
    }
    setDoubleFields(camera, x, "x", "cameraX");
    setDoubleFields(camera, y, "y", "cameraY");
    setDoubleFields(camera, z, "z", "cameraZ");
  }

  private static void setCameraRotation(Object camera, float yaw, float pitch) {
    for (String methodName : new String[] { "setRotation", "method_19325" }) {
      try {
        Method method = camera.getClass().getDeclaredMethod(methodName, Float.TYPE, Float.TYPE);
        method.setAccessible(true);
        method.invoke(camera, yaw, pitch);
        return;
      } catch (Throwable ignored) {
        // Try the next mapping name.
      }
    }
  }

  private static void freezePlayerMovement(Minecraft client) {
    Object player = playerObject(client);
    if (player == null) {
      return;
    }
    if (freecamApplied) restoreFreecamPlayerTransform(client);
    // KeyMapping state is what LocalPlayer reads during its tick. Clearing it at
    // START_CLIENT_TICK prevents WASD/jump/sneak/sprint from reaching the player,
    // while updateFreecam can still read the physical keys directly from GLFW.
    if (client.options != null) {
      client.options.keyUp.setDown(false);
      client.options.keyDown.setDown(false);
      client.options.keyLeft.setDown(false);
      client.options.keyRight.setDown(false);
      client.options.keyJump.setDown(false);
      client.options.keyShift.setDown(false);
      client.options.keySprint.setDown(false);
    }
    setFloatFields(player, 0.0F, "xxa", "yya", "zza", "field_6250", "field_6261", "field_6212");
    setBooleanFields(player, false, "jumping", "field_3913");
    invokeBoolean(player, false, "setJumping", "method_6043");
    Object input = getAnyField(player, "input", "field_3913");
    if (input == null) {
      return;
    }
    setStaticValueByName(input, "EMPTY", "keyPresses", "field_3903");
    setStaticValueByName(input, "ZERO", "moveVector", "field_3904");
  }

  private static void setStaticValueByName(Object target, String staticName, String... targetFieldNames) {
    Object value = null;
    Class<?> type = target.getClass();
    for (Field field : type.getDeclaredFields()) {
      try {
        Field staticField = field.getType().getField(staticName);
        value = staticField.get(null);
        break;
      } catch (Throwable ignored) {
        // Try the next field type.
      }
    }
    if (value != null) {
      setObjectFields(target, value, targetFieldNames);
    }
  }

  private static void invokeBoolean(Object target, boolean value, String... methodNames) {
    for (String methodName : methodNames) {
      try {
        Method method = target.getClass().getMethod(methodName, Boolean.TYPE);
        method.invoke(target, value);
        return;
      } catch (Throwable ignored) {
        // Try the next method.
      }
    }
  }

  private static void invokeFloat(Object target, float value, String... methodNames) {
    for (String methodName : methodNames) {
      try {
        Method method = target.getClass().getMethod(methodName, Float.TYPE);
        method.invoke(target, value);
        return;
      } catch (Throwable ignored) {
        // Try the next method.
      }
    }
  }

  private static void setObjectFields(Object target, Object value, String... names) {
    setFields(target, field -> field.getType().isInstance(value), field -> field.set(target, value), names);
  }

  private static void setIntFields(Object target, int value, String... names) {
    setFields(target, field -> field.getType() == Integer.TYPE || field.getType() == Integer.class, field -> {
      if (field.getType() == Integer.TYPE) {
        field.setInt(target, value);
      } else {
        field.set(target, Integer.valueOf(value));
      }
    }, names);
  }

  private static void setDoubleFields(Object target, double value, String... names) {
    setFields(target, field -> field.getType() == Double.TYPE || field.getType() == Double.class, field -> {
      if (field.getType() == Double.TYPE) {
        field.setDouble(target, value);
      } else {
        field.set(target, Double.valueOf(value));
      }
    }, names);
  }

  private static void setFloatFields(Object target, float value, String... names) {
    setFields(target, field -> field.getType() == Float.TYPE || field.getType() == Float.class, field -> {
      if (field.getType() == Float.TYPE) {
        field.setFloat(target, value);
      } else {
        field.set(target, Float.valueOf(value));
      }
    }, names);
  }

  private static void setBooleanFields(Object target, boolean value, String... names) {
    setFields(target, field -> field.getType() == Boolean.TYPE || field.getType() == Boolean.class, field -> {
      if (field.getType() == Boolean.TYPE) {
        field.setBoolean(target, value);
      } else {
        field.set(target, Boolean.valueOf(value));
      }
    }, names);
  }

  private static void setFields(Object target, FieldFilter filter, FieldSetter setter, String... names) {
    if (target == null) {
      return;
    }
    for (String name : names) {
      Class<?> type = target.getClass();
      while (type != null) {
        try {
          Field field = type.getDeclaredField(name);
          if (!java.lang.reflect.Modifier.isStatic(field.getModifiers()) && filter.matches(field)) {
            field.setAccessible(true);
            setter.set(field);
            return;
          }
        } catch (Throwable ignored) {
          // Try superclass or next name.
        }
        type = type.getSuperclass();
      }
    }
  }

  private interface FieldFilter {
    boolean matches(Field field);
  }

  private interface FieldSetter {
    void set(Field field) throws IllegalAccessException;
  }

  private static Class<?> wrapType(Class<?> type) {
    if (!type.isPrimitive()) {
      return type;
    }
    if (type == Double.TYPE) {
      return Double.class;
    }
    if (type == Float.TYPE) {
      return Float.class;
    }
    if (type == Integer.TYPE) {
      return Integer.class;
    }
    if (type == Long.TYPE) {
      return Long.class;
    }
    return type;
  }

  private static float clampFloat(float value, float min, float max) {
    return Math.max(min, Math.min(max, value));
  }

  private static float wrapDegrees(float value) {
    float result = value % 360.0F;
    if (result >= 180.0F) {
      result -= 360.0F;
    }
    if (result < -180.0F) {
      result += 360.0F;
    }
    return result;
  }

  private static double smoothZoomFactor(double current, double target) {
    double delta = target - current;
    if (Math.abs(delta) < 0.01D) {
      return target;
    }
    return current + (delta * MenuModules.zoomSmoothness());
  }

  private static boolean moduleEnabled(String id) {
    return MenuModules.enabled(id);
  }

  public static boolean isModuleEnabled(String id) {
    return moduleEnabled(id);
  }

  private static void log(String message) {
    System.out.println("[X Client] " + message);
  }

  private static void applyModule(MenuModules.Module module) {
    Minecraft client = Minecraft.getInstance();
    if (client == null || client.options == null) {
      return;
    }

    if ("bright".equals(module.id)) {
      updateFullbright(client);
    } else if ("speed".equals(module.id)) {
      updateSpeedEffect(client);
    } else if ("resistance".equals(module.id)) {
      updateResistanceEffect(client);
    } else if ("invisibility".equals(module.id)) {
      updateInvisibilityEffect(client);
    } else if ("zoom".equals(module.id)) {
      updateZoom(client);
    } else if ("hitboxes".equals(module.id)) {
      NativeHitboxController.setEnabled(module.enabled);
    } else if ("flight".equals(module.id)) {
      AdminFlightModule.moduleChanged(client, module.enabled);
    }
  }

  private static void updateFullbright(Minecraft client) {
    if (client == null || client.options == null) {
      return;
    }

    if (moduleEnabled("bright")) {
      if (!fullbrightApplied) {
        previousGamma = getOptionNumber(client.options, "gamma");
        previousDarknessScale = getOptionNumber(client.options, "darknessEffectScale");
      }
      forceOptionNumber(client.options, "gamma", FULLBRIGHT_GAMMA);
      forceOptionNumber(client.options, "darknessEffectScale", 0.0D);
      applyNightVisionEffect(client);
      boostLightTexture(client);
      fullbrightApplied = true;
      return;
    }

    if (fullbrightApplied) {
      clearNightVisionEffect(client);
    }
    if (fullbrightApplied && previousGamma != null) {
      forceOptionNumber(client.options, "gamma", previousGamma.doubleValue());
      if (previousDarknessScale != null) {
        forceOptionNumber(client.options, "darknessEffectScale", previousDarknessScale.doubleValue());
      }
    }
    fullbrightApplied = false;
    previousGamma = null;
    previousDarknessScale = null;
  }

  private static void applyNightVisionEffect(Minecraft client) {
    try {
      LocalPlayer player = client.player;
      if (player == null) {
        return;
      }
      MobEffectInstance current = player.getEffect(MobEffects.NIGHT_VISION);
      if (current != null && (current.getDuration() < 0 || current.getDuration() > NIGHT_VISION_REFRESH_THRESHOLD_TICKS)
          && current.getAmplifier() >= NIGHT_VISION_EFFECT_AMPLIFIER && !current.showIcon()) {
        return;
      }
      MobEffectInstance effect = new MobEffectInstance(MobEffects.NIGHT_VISION, NIGHT_VISION_DURATION_TICKS, NIGHT_VISION_EFFECT_AMPLIFIER, false, false, false);
      skipEffectBlend(effect);
      player.addEffect(effect);
      fullbrightAddedNightVision = true;
    } catch (Throwable ignored) {
      // Shader fullbright still falls back to gamma and lightmap changes.
    }
  }

  private static void skipEffectBlend(MobEffectInstance effect) {
    try {
      if (effect != null) {
        effect.skipBlending();
      }
    } catch (Throwable ignored) {
      // Older mappings may not expose blend controls.
    }
  }

  private static void clearNightVisionEffect(Minecraft client) {
    try {
      LocalPlayer player = client == null ? null : client.player;
      if (player != null) {
        MobEffectInstance current = player.getEffect(MobEffects.NIGHT_VISION);
        if (current != null && (fullbrightAddedNightVision || (!current.isVisible() && !current.showIcon()))) {
          player.removeEffect(MobEffects.NIGHT_VISION);
        }
      }
    } catch (Throwable ignored) {
      // Leave externally supplied night vision untouched when cleanup fails.
    }
    fullbrightAddedNightVision = false;
  }

  private static void boostLightTexture(Minecraft client) {
    long now = System.currentTimeMillis();
    if (now - lastFullbrightLightmapMs < 150L) {
      return;
    }
    lastFullbrightLightmapMs = now;
    try {
      Object renderer = findObjectByClassName(client, "GameRenderer", "class_757");
      Object lightTexture = findObjectByClassName(renderer, "Lightmap", "LightTexture", "class_765");
      Object image = findObjectByClassName(lightTexture, "NativeImage", "class_1011");
      if (image != null) {
        fillNativeImageWhite(image);
      }
      Object dynamicTexture = findObjectByClassName(lightTexture, "DynamicTexture", "class_1043");
      uploadTexture(dynamicTexture);
    } catch (Throwable ignored) {
      // Some shader pipelines do not expose the vanilla lightmap.
    }
  }

  private static Object findObjectByClassName(Object target, String... classNameParts) {
    if (target == null) {
      return null;
    }
    Class<?> type = target.getClass();
    while (type != null) {
      for (Field field : type.getDeclaredFields()) {
        if (java.lang.reflect.Modifier.isStatic(field.getModifiers())) {
          continue;
        }
        try {
          field.setAccessible(true);
          Object value = field.get(target);
          if (value == null) {
            continue;
          }
          String className = value.getClass().getName();
          for (String part : classNameParts) {
            if (className.contains(part)) {
              return value;
            }
          }
        } catch (Throwable ignored) {
          // Try the next field.
        }
      }
      type = type.getSuperclass();
    }
    return null;
  }

  private static void fillNativeImageWhite(Object image) {
    for (String methodName : new String[] { "setPixelRGBA", "method_4305" }) {
      for (Method method : image.getClass().getMethods()) {
        if (!methodName.equals(method.getName()) || method.getParameterCount() != 3) {
          continue;
        }
        Class<?>[] parameterTypes = method.getParameterTypes();
        if (parameterTypes[0] != Integer.TYPE || parameterTypes[1] != Integer.TYPE || parameterTypes[2] != Integer.TYPE) {
          continue;
        }
        try {
          for (int x = 0; x < 16; x += 1) {
            for (int y = 0; y < 16; y += 1) {
              method.invoke(image, Integer.valueOf(x), Integer.valueOf(y), Integer.valueOf(0xFFFFFFFF));
            }
          }
          return;
        } catch (Throwable ignored) {
          // Try the next pixel setter.
        }
      }
    }
  }

  private static void uploadTexture(Object texture) {
    if (texture == null) {
      return;
    }
    for (String methodName : new String[] { "upload", "method_4625" }) {
      try {
        Method method = texture.getClass().getMethod(methodName);
        method.invoke(texture);
        return;
      } catch (Throwable ignored) {
        // Try the next upload name.
      }
    }
  }

  private static double currentBaseFov(Options options) {
    Number value = getOptionNumber(options, "fov");
    if (value == null) {
      return 70.0D;
    }
    return Math.max(30.0D, Math.min(110.0D, value.doubleValue()));
  }

  private static Number getOptionNumber(Options options, String methodName) {
    try {
      Object option = Options.class.getMethod(methodName).invoke(options);
      Object value = option.getClass().getMethod("get").invoke(option);
      return value instanceof Number ? (Number) value : null;
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      return null;
    }
  }

  private static Boolean getOptionBoolean(Options options, String methodName) {
    Object option = null;
    try {
      option = Options.class.getMethod(methodName).invoke(options);
      Object value = option.getClass().getMethod("get").invoke(option);
      if (value instanceof Boolean bool) {
        return bool;
      }
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      option = optionByName(options, methodName);
    }
    if (option == null) {
      option = optionByName(options, methodName);
    }
    return getOptionBooleanValue(option);
  }

  private static void setOptionNumber(Options options, String methodName, Object value) {
    try {
      Object option = Options.class.getMethod(methodName).invoke(options);
      option.getClass().getMethod("set", Object.class).invoke(option, value);
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      // Option names changed; keep the rest of the client usable.
    }
  }

  private static void forceOptionNumber(Options options, String methodName, double value) {
    Object option = null;
    try {
      option = Options.class.getMethod(methodName).invoke(options);
      option.getClass().getMethod("set", Object.class).invoke(option, Double.valueOf(value));
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      option = optionByName(options, methodName);
    }
    if (option == null) {
      option = optionByName(options, methodName);
    }
    forceOptionValue(option, Double.valueOf(value));
  }

  private static void forceOptionInteger(Options options, String methodName, int value) {
    Object option = null;
    Integer boxed = Integer.valueOf(value);
    try {
      option = Options.class.getMethod(methodName).invoke(options);
      option.getClass().getMethod("set", Object.class).invoke(option, boxed);
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      option = optionByName(options, methodName);
    }
    if (option == null) {
      option = optionByName(options, methodName);
    }
    forceOptionValue(option, boxed);
  }

  private static void forceOptionBoolean(Options options, String methodName, boolean value) {
    Object option = null;
    Boolean boxed = Boolean.valueOf(value);
    try {
      option = Options.class.getMethod(methodName).invoke(options);
      option.getClass().getMethod("set", Object.class).invoke(option, boxed);
      return;
    } catch (ReflectiveOperationException | RuntimeException ignored) {
      option = optionByName(options, methodName);
    }
    if (option == null) {
      option = optionByName(options, methodName);
    }
    forceOptionBooleanValue(option, value);
  }

  private static Object optionByName(Object options, String name) {
    Class<?> type = options.getClass();
    while (type != null) {
      for (Field field : type.getDeclaredFields()) {
        if (!field.getName().equals(name)) {
          continue;
        }
        try {
          field.setAccessible(true);
          return field.get(options);
        } catch (Throwable ignored) {
          return null;
        }
      }
      type = type.getSuperclass();
    }
    return null;
  }

  private static void forceOptionValue(Object option, Number value) {
    if (option == null) {
      return;
    }
    Class<?> type = option.getClass();
    while (type != null) {
      for (Field field : type.getDeclaredFields()) {
        if (java.lang.reflect.Modifier.isStatic(field.getModifiers())) {
          continue;
        }
        Class<?> fieldType = field.getType();
        if (fieldType != Double.class && fieldType != Double.TYPE && fieldType != Integer.class
            && fieldType != Integer.TYPE && fieldType != Number.class && fieldType != Object.class) {
          continue;
        }
        try {
          field.setAccessible(true);
          Object current = field.get(option);
          if (current == null || current instanceof Number) {
            if (fieldType == Double.TYPE) {
              field.setDouble(option, value.doubleValue());
            } else if (fieldType == Integer.TYPE) {
              field.setInt(option, value.intValue());
            } else if (fieldType == Integer.class) {
              field.set(option, Integer.valueOf(value.intValue()));
            } else if (fieldType == Double.class) {
              field.set(option, Double.valueOf(value.doubleValue()));
            } else {
              field.set(option, value);
            }
          }
        } catch (Throwable ignored) {
          // Try the next field.
        }
      }
      type = type.getSuperclass();
    }
  }

  private static Boolean getOptionBooleanValue(Object option) {
    if (option == null) {
      return null;
    }
    try {
      Object value = option.getClass().getMethod("get").invoke(option);
      if (value instanceof Boolean bool) {
        return bool;
      }
    } catch (Throwable ignored) {
      // Fall back to field scan.
    }
    Class<?> type = option.getClass();
    while (type != null) {
      for (Field field : type.getDeclaredFields()) {
        if (java.lang.reflect.Modifier.isStatic(field.getModifiers())) {
          continue;
        }
        if (field.getType() != Boolean.class && field.getType() != Boolean.TYPE && field.getType() != Object.class) {
          continue;
        }
        try {
          field.setAccessible(true);
          Object value = field.get(option);
          if (value instanceof Boolean bool) {
            return bool;
          }
        } catch (Throwable ignored) {
          // Try the next field.
        }
      }
      type = type.getSuperclass();
    }
    return null;
  }

  private static void forceOptionBooleanValue(Object option, boolean value) {
    if (option == null) {
      return;
    }
    Class<?> type = option.getClass();
    while (type != null) {
      for (Field field : type.getDeclaredFields()) {
        if (java.lang.reflect.Modifier.isStatic(field.getModifiers())) {
          continue;
        }
        Class<?> fieldType = field.getType();
        if (fieldType != Boolean.class && fieldType != Boolean.TYPE && fieldType != Object.class) {
          continue;
        }
        try {
          field.setAccessible(true);
          Object current = field.get(option);
          if (current == null || current instanceof Boolean) {
            if (fieldType == Boolean.TYPE) {
              field.setBoolean(option, value);
            } else {
              field.set(option, Boolean.valueOf(value));
            }
          }
        } catch (Throwable ignored) {
          // Try the next field.
        }
      }
      type = type.getSuperclass();
    }
  }

  private static Boolean getSmoothCamera(Options options) {
    try {
      return Boolean.valueOf(options.smoothCamera);
    } catch (Throwable ignored) {
      return null;
    }
  }

  private static void setSmoothCamera(Options options, boolean value) {
    try {
      options.smoothCamera = value;
    } catch (Throwable ignored) {
      // Option names changed; keep zoom FOV active without smooth camera.
    }
  }

  private static void sleepQuietly(long millis) {
    try {
      Thread.sleep(millis);
    } catch (InterruptedException interrupted) {
      Thread.currentThread().interrupt();
    }
  }
}
