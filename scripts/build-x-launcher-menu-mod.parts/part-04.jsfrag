  'dev/xlauncher/client/BlockOutlineSettings.java': String.raw`
package dev.xlauncher.client;

import java.util.prefs.Preferences;

public final class BlockOutlineSettings {
  public static final int MIN_THICKNESS = 1;
  public static final int MAX_THICKNESS = 5;
  public static final int[] COLORS = {
      0x66000000, 0xFFFFFFFF, 0xFFFF3B30, 0xFFFFCC00,
      0xFF34C759, 0xFF00BFFF, 0xFF5856D6, 0xFFFF2D95
  };
  private static final Preferences PREFS = Preferences.userNodeForPackage(BlockOutlineSettings.class);
  private static int color = PREFS.getInt("color", COLORS[0]);
  private static int thickness = clamp(PREFS.getInt("thickness", MIN_THICKNESS));

  private BlockOutlineSettings() {}

  public static int color() { return XClientColorModes.resolve("blockoutline", color); }
  public static int thickness() { return thickness; }

  public static void setColor(int value) {
    color = value;
    PREFS.putInt("color", color);
  }

  public static void setThickness(int value) {
    thickness = clamp(value);
    PREFS.putInt("thickness", thickness);
  }

  private static int clamp(int value) {
    return Math.max(MIN_THICKNESS, Math.min(MAX_THICKNESS, value));
  }
}
`,
