  'dev/xlauncher/client/XClientTutorialScreen.java': String.raw`
package dev.xlauncher.client;

import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.Font;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.client.input.KeyEvent;
import net.minecraft.client.input.MouseButtonEvent;

public final class XClientTutorialScreen extends Screen {
  private static final String[] TITLES = {
      "X Client Tutorial",
      "Rechts-Shift",
      "X-Client-Menü",
      "Fullbright",
      "HUD & UI Editor",
      "Crosshair & Social",
      "Tutorial wiederholen"
  };
  private static final String[] TEXTS = {
      "Folge dem Pfeil. Normale Klicks sind gesperrt.",
      "Rechts-Shift öffnet dieses Menü.",
      "Kachel anklicken. Danach Toggle, Keybind oder Optionen nutzen.",
      "BRIGHT macht alles hell: Nacht, Höhlen und dunkle Räume.",
      "HUD-Module anzeigen. Mit UI verschiebst du alles.",
      "AIM stellt dein Crosshair ein. FRIENDS zeigt Spieler.",
      "HELP spielt das Tutorial nochmal ab."
  };
  private static final int MENU_TILE_HEIGHT = 44;
  private static final int MENU_GAP = 4;
  private static final int MENU_SIDE_PADDING = 10;
  private static final int MENU_HEADER_HEIGHT = 42;
  private static final int MENU_FOOTER_HEIGHT = 8;
  private static final int MENU_MAX_WIDTH = 270;
  private static final int MENU_MAX_HEIGHT = 200;
  private static final int MENU_MIN_MARGIN = 10;
  private static final int CARD_SKIP_W = 32;
  private static final int CARD_BACK_W = 34;
  private static final int CARD_NEXT_W = 34;
  private static final int CARD_BUTTON_H = 12;
  private int step;

  XClientTutorialScreen(boolean replay) {
    super(TextBridge.literal("X Client Tutorial"));
    if (replay) {
      XClientTutorialState.reset();
    }
  }

  @Override
  public boolean isPauseScreen() {
    return XLauncherMenuClient.shouldPauseInOwnWorld();
  }

  @Override
  public void extractRenderState(GuiGraphicsExtractor graphics, int mouseX, int mouseY, float tickDelta) {
    Font font = Minecraft.getInstance().font;
    int[] focus = focusBounds();
    int[] card = cardBounds(focus);

    drawWorldBackdrop(graphics, font);
    drawShowcase(graphics, font, focus);
    drawSpotlight(graphics, focus);
    drawArrow(graphics, focus, card);
    drawCard(graphics, font, card);
  }

  @Override
  public boolean keyPressed(KeyEvent event) {
    int key = event.key();
    if (key == 256) {
      finish();
      return true;
    }
    if (key == 257 || key == 32 || key == 262) {
      next();
      return true;
    }
    if (key == 263 && step > 0) {
      step -= 1;
      return true;
    }
    return true;
  }

  @Override
  public boolean mouseClicked(MouseButtonEvent event, boolean doubleClick) {
    if (event.button() != 0) {
      return true;
    }
    int[] card = cardBounds(focusBounds());
    double mouseX = event.x();
    double mouseY = event.y();
    if (isInside(mouseX, mouseY, card[0] + 8, card[1] + card[3] - 17, CARD_SKIP_W, CARD_BUTTON_H)) {
      finish();
      return true;
    }
    if (isInside(mouseX, mouseY, card[0] + card[2] - 78, card[1] + card[3] - 17, CARD_BACK_W, CARD_BUTTON_H)) {
      if (step > 0) {
        step -= 1;
      }
      return true;
    }
    if (isInside(mouseX, mouseY, card[0] + card[2] - 42, card[1] + card[3] - 17, CARD_NEXT_W, CARD_BUTTON_H)) {
      next();
      return true;
    }
    return true;
  }

  private void next() {
    if (step >= TITLES.length - 1) {
      finish();
      return;
    }
    step += 1;
  }

  private void finish() {
    XClientTutorialState.markCompleted();
    Minecraft.getInstance().setScreen(null);
  }

  private void drawWorldBackdrop(GuiGraphicsExtractor graphics, Font font) {
    graphics.fill(0, 0, width, height, LauncherTheme.argb(170, 0x03070B));
    for (int y = 0; y < height; y += 18) {
      int shade = (y / 18) % 2 == 0 ? 0x0A141D : 0x081019;
      graphics.fill(0, y, width, Math.min(height, y + 18), LauncherTheme.argb(52, shade));
    }
    graphics.fill(0, height - 22, width, height, LauncherTheme.argb(95, 0x000000));
    graphics.centeredText(font, "+", width / 2, Math.max(18, height / 2 - 4), LauncherTheme.argb(170, 0xFFFFFF));
  }

  private void drawShowcase(GuiGraphicsExtractor graphics, Font font, int[] focus) {
    drawMenuPreview(graphics, font);
    drawHudPreview(graphics, font);
    if (step == 1) {
      drawKeycap(graphics, font, focus[0], focus[1], focus[2], focus[3], "R-SHIFT", true);
    }
  }

  private void drawMenuPreview(GuiGraphicsExtractor graphics, Font font) {
    int[] layout = menuLayout();
    int boxX = layout[4];
    int boxY = layout[5];
    int boxW = layout[6];
    int boxH = layout[7];
    int columns = layout[8];
    int tileW = layout[9];
    int accent = LauncherTheme.accent();
    graphics.fill(boxX + 2, boxY + 2, boxX + boxW + 2, boxY + boxH + 2, LauncherTheme.argb(54, 0x000000));
    graphics.fill(boxX, boxY, boxX + boxW, boxY + boxH, LauncherTheme.argb(150, 0x070D12));
    border(graphics, boxX, boxY, boxW, boxH, LauncherTheme.argb(118, 0xDCE8F2));
    drawMenuSearch(graphics, font, layout);
    drawMenuHeader(graphics, font, layout);

    MenuModules.Module[] modules = MenuModules.modules();
    for (int index = 0; index < modules.length; index += 1) {
      int row = index / columns;
      int column = index % columns;
      int x = layout[0] + (column * (tileW + MENU_GAP));
      int y = layout[1] + (row * (MENU_TILE_HEIGHT + MENU_GAP));
      if (y + MENU_TILE_HEIGHT > boxY + boxH - MENU_FOOTER_HEIGHT) {
        break;
      }
      drawMenuTile(graphics, font, modules[index], x, y, tileW, MENU_TILE_HEIGHT, isHighlighted(modules[index].id), accent);
    }
  }

  private void drawMenuSearch(GuiGraphicsExtractor graphics, Font font, int[] layout) {
    int x = layout[4] + 10;
    int y = layout[5] + 10;
    int w = Math.min(78, Math.max(42, layout[6] - (MENU_SIDE_PADDING * 2) - 32));
    graphics.fill(x + 1, y + 1, x + w + 1, y + 25, LauncherTheme.argb(44, 0x000000));
    graphics.fill(x, y, x + w, y + 24, LauncherTheme.argb(128, 0x0B1218));
    border(graphics, x, y, w, 24, LauncherTheme.argb(148, 0xFFFFFF));
    graphics.text(font, "Search", x + 7, y + 8, LauncherTheme.mutedTextColor());
  }

  private void drawMenuHeader(GuiGraphicsExtractor graphics, Font font, int[] layout) {
    graphics.centeredText(font, "X Client", layout[4] + (layout[6] / 2), layout[5] + 18, LauncherTheme.textColor());
    int x = layout[4] + layout[6] - 34;
    int y = layout[5] + 10;
    graphics.fill(x + 1, y + 1, x + 25, y + 25, LauncherTheme.argb(42, 0x000000));
    graphics.fill(x, y, x + 24, y + 24, step == 4 ? LauncherTheme.accentArgb(84) : LauncherTheme.argb(104, 0x0B1218));
    border(graphics, x, y, 24, 24, step == 4 ? LauncherTheme.accentArgb(215) : LauncherTheme.argb(148, 0xFFFFFF));
    graphics.centeredText(font, "UI", x + 12, y + 8, step == 4 ? LauncherTheme.textColor() : LauncherTheme.mutedTextColor());
  }

  private void drawMenuTile(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int x, int y, int w, int h, boolean highlighted, int accent) {
    boolean active = highlighted || (module.toggleable && module.enabled);
    int background = active ? LauncherTheme.accentArgb(highlighted ? 98 : 66) : LauncherTheme.argb(92, 0x101820);
    graphics.fill(x + 1, y + 1, x + w + 1, y + h + 1, LauncherTheme.argb(54, 0x000000));
    graphics.fill(x, y, x + w, y + h, background);
    if (active) {
      graphics.fill(x, y + h - 4, x + w, y + h, 0xFF000000 | accent);
    }
    border(graphics, x, y, w, h, highlighted ? LauncherTheme.accentArgb(245) : LauncherTheme.argb(172, 0xFFFFFF));
    drawMenuIcon(graphics, font, module, x, y, w, h, accent);
  }

  private void drawMenuIcon(GuiGraphicsExtractor graphics, Font font, MenuModules.Module module, int x, int y, int w, int h, int accent) {
    if (module != null) {
      String label = module.subtitle == null || module.subtitle.trim().isEmpty() ? module.title : module.subtitle;
      graphics.centeredText(font, fit(label, w - 8), x + (w / 2), y + (h / 2) - 4, 0xFFFFFFFF);
      return;
    }
    int cx = x + (w / 2);
    int cy = y + (h / 2);
    int color = 0xFFFFFFFF;
    if ("zoom".equals(module.id)) {
      border(graphics, cx - 9, cy - 9, 17, 17, color);
      graphics.fill(cx - 5, cy - 1, cx + 4, cy + 1, color);
      graphics.fill(cx - 1, cy - 5, cx + 1, cy + 4, color);
      graphics.fill(cx + 6, cy + 7, cx + 10, cy + 11, color);
      graphics.fill(cx + 9, cy + 10, cx + 13, cy + 14, color);
      return;
    }
    if ("bright".equals(module.id)) {
      graphics.fill(cx - 4, cy - 4, cx + 4, cy + 4, color);
      graphics.fill(cx - 1, cy - 13, cx + 1, cy - 7, color);
      graphics.fill(cx - 1, cy + 7, cx + 1, cy + 13, color);
      graphics.fill(cx - 13, cy - 1, cx - 7, cy + 1, color);
      graphics.fill(cx + 7, cy - 1, cx + 13, cy + 1, color);
      return;
    }
    if ("sprint".equals(module.id)) {
      graphics.fill(cx - 12, cy + 8, cx + 10, cy + 10, color);
      graphics.fill(cx + 6, cy + 5, cx + 12, cy + 10, color);
      graphics.fill(cx - 5, cy - 10, cx - 1, cy + 4, color);
      graphics.fill(cx - 1, cy + 1, cx + 7, cy + 4, color);
      graphics.fill(cx + 5, cy + 4, cx + 9, cy + 11, color);
      return;
    }
    if ("nobob".equals(module.id)) {
      border(graphics, cx - 12, cy - 7, 24, 14, color);
      graphics.fill(cx - 8, cy - 1, cx + 8, cy + 1, color);
      graphics.fill(cx - 2, cy - 4, cx + 2, cy + 4, color);
      return;
    }
    if ("crosshair".equals(module.id)) {
      border(graphics, cx - 12, cy - 12, 7, 7, color);
      border(graphics, cx + 5, cy - 12, 7, 7, color);
      border(graphics, cx - 12, cy + 5, 7, 7, color);
      border(graphics, cx + 5, cy + 5, 7, 7, color);
      graphics.fill(cx - 3, cy - 1, cx + 3, cy + 1, color);
      graphics.fill(cx - 1, cy - 3, cx + 1, cy + 3, color);
      return;
    }
    if ("fps".equals(module.id)) {
      border(graphics, cx - 12, cy - 9, 24, 18, color);
      graphics.fill(cx - 8, cy + 3, cx - 5, cy + 7, color);
      graphics.fill(cx - 2, cy, cx + 1, cy + 7, color);
      graphics.fill(cx + 4, cy - 5, cx + 7, cy + 7, color);
      return;
    }
    if ("coords".equals(module.id)) {
      graphics.fill(cx - 1, cy - 13, cx + 1, cy + 12, color);
      graphics.fill(cx - 13, cy - 1, cx + 13, cy + 1, color);
      border(graphics, cx - 7, cy - 7, 14, 14, color);
      return;
    }
    if ("keys".equals(module.id)) {
      int key = 8;
      drawTinyKey(graphics, cx - 4, cy - 12, key, key);
      drawTinyKey(graphics, cx - 13, cy - 3, key, key);
      drawTinyKey(graphics, cx - 4, cy - 3, key, key);
      drawTinyKey(graphics, cx + 5, cy - 3, key, key);
      return;
    }
    if ("cps".equals(module.id)) {
      border(graphics, cx - 7, cy - 12, 14, 22, color);
      graphics.fill(cx - 1, cy - 9, cx + 1, cy - 3, color);
      graphics.fill(cx - 5, cy + 12, cx + 5, cy + 14, color);
      return;
    }
    if ("clock".equals(module.id)) {
      border(graphics, cx - 11, cy - 11, 22, 22, color);
      graphics.fill(cx - 1, cy - 8, cx + 1, cy + 1, color);
      graphics.fill(cx, cy, cx + 7, cy + 2, color);
      return;
    }
    if ("ui".equals(module.id)) {
      border(graphics, cx - 12, cy - 9, 24, 18, color);
      graphics.fill(cx - 9, cy - 1, cx + 9, cy + 1, color);
      graphics.fill(cx - 1, cy - 7, cx + 1, cy + 7, color);
      return;
    }
    graphics.centeredText(font, fit(module.title, w - 8), cx, cy - 4, color);
  }

  private void drawTinyKey(GuiGraphicsExtractor graphics, int x, int y, int w, int h) {
    graphics.fill(x, y, x + w, y + h, LauncherTheme.argb(120, 0x121C25));
    border(graphics, x, y, w, h, LauncherTheme.argb(150, 0xDCE8F2));
  }

  private boolean isHighlighted(String id) {
    return (step == 3 && "bright".equals(id)) || (step == 4 && "ui".equals(id))
        || (step == 5 && ("crosshair".equals(id) || "friends".equals(id)))
        || (step == 6 && "tutorial".equals(id));
  }

  private void drawHudPreview(GuiGraphicsExtractor graphics, Font font) {
    drawPill(graphics, font, 9, 9, 68, 16, "FPS 144");
    drawPill(graphics, font, 9, 29, 86, 16, "12 64 -8");
    drawKeycap(graphics, font, Math.max(10, width - 88), Math.max(10, height - 58), 66, 18, "W A S D", step == 4);
  }

  private void drawFullbrightPreview(GuiGraphicsExtractor graphics, Font font, int[] focus) {
    graphics.fill(focus[0], focus[1], focus[0] + focus[2], focus[1] + focus[3], LauncherTheme.argb(230, 0xFFF2A8));
    graphics.fill(focus[0] + 8, focus[1] + 9, focus[0] + focus[2] - 8, focus[1] + focus[3] - 9, LauncherTheme.argb(90, 0xFFFFFF));
    graphics.centeredText(font, "FULLBRIGHT", focus[0] + focus[2] / 2, focus[1] + focus[3] / 2 - 4, 0xFF141414);
  }

  private void drawPill(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, int h, String label) {
    graphics.fill(x, y, x + w, y + h, LauncherTheme.argb(112, 0x000000));
    border(graphics, x, y, w, h, LauncherTheme.accentArgb(130));
    graphics.text(font, fit(label, w - 8), x + 5, y + 6, LauncherTheme.textColor());
  }

  private void drawKeycap(GuiGraphicsExtractor graphics, Font font, int x, int y, int w, int h, String label, boolean active) {
    graphics.fill(x, y, x + w, y + h, active ? LauncherTheme.accentArgb(120) : LauncherTheme.argb(95, 0xFFFFFF));
    border(graphics, x, y, w, h, active ? LauncherTheme.accentArgb(235) : LauncherTheme.argb(130, 0xFFFFFF));
    graphics.centeredText(font, fit(label, w - 8), x + w / 2, y + (h / 2) - 3, LauncherTheme.textColor());
  }

  private void drawSpotlight(GuiGraphicsExtractor graphics, int[] focus) {
    int pad = 5;
    int left = Math.max(0, focus[0] - pad);
    int top = Math.max(0, focus[1] - pad);
    int right = Math.min(width, focus[0] + focus[2] + pad);
    int bottom = Math.min(height, focus[1] + focus[3] + pad);
    int shade = LauncherTheme.argb(148, 0x000000);
    graphics.fill(0, 0, width, top, shade);
    graphics.fill(0, bottom, width, height, shade);
    graphics.fill(0, top, left, bottom, shade);
    graphics.fill(right, top, width, bottom, shade);
    graphics.fill(left, top, right, top + 2, LauncherTheme.accentArgb(235));
    graphics.fill(left, bottom - 2, right, bottom, LauncherTheme.accentArgb(235));
    graphics.fill(left, top, left + 2, bottom, LauncherTheme.accentArgb(235));
    graphics.fill(right - 2, top, right, bottom, LauncherTheme.accentArgb(235));
  }

  private void drawArrow(GuiGraphicsExtractor graphics, int[] focus, int[] card) {
    int cardCenterX = card[0] + (card[2] / 2);
    int cardCenterY = card[1] + (card[3] / 2);
    int focusCenterX = focus[0] + (focus[2] / 2);
    int focusCenterY = focus[1] + (focus[3] / 2);
    int dx = focusCenterX - cardCenterX;
    int dy = focusCenterY - cardCenterY;
    int startX;
    int startY;
    int endX;
    int endY;
    int directionX = 0;
    int directionY = 0;
    int margin = 10;
    if (Math.abs(dx) * Math.max(1, focus[3]) >= Math.abs(dy) * Math.max(1, focus[2])) {
      directionX = dx >= 0 ? 1 : -1;
      startX = directionX > 0 ? card[0] + card[2] + 2 : card[0] - 2;
      endX = directionX > 0 ? focus[0] - margin : focus[0] + focus[2] + margin;
      endY = clamp(cardCenterY, focus[1] + 5, focus[1] + focus[3] - 5);
      startY = clamp(endY, card[1] + 8, card[1] + card[3] - 8);
    } else {
      directionY = dy >= 0 ? 1 : -1;
      startY = directionY > 0 ? card[1] + card[3] + 2 : card[1] - 2;
      endY = directionY > 0 ? focus[1] - margin : focus[1] + focus[3] + margin;
      endX = clamp(cardCenterX, focus[0] + 5, focus[0] + focus[2] - 5);
      startX = clamp(endX, card[0] + 8, card[0] + card[2] - 8);
    }
    int color = LauncherTheme.accentArgb(240);
    int shadow = LauncherTheme.argb(95, 0x000000);
    for (int i = 0; i <= 14; i += 1) {
      int x = startX + ((endX - startX) * i / 14);
      int y = startY + ((endY - startY) * i / 14);
      graphics.fill(x - 2, y - 2, x + 3, y + 3, shadow);
      graphics.fill(x - 1, y - 1, x + 2, y + 2, color);
    }
    drawArrowHead(graphics, endX, endY, directionX, directionY, color);
  }

  private void drawArrowHead(GuiGraphicsExtractor graphics, int x, int y, int directionX, int directionY, int color) {
    if (directionX != 0) {
      int tipX = x + (directionX * 6);
      graphics.fill(Math.min(x, tipX), y - 1, Math.max(x, tipX), y + 2, color);
      for (int i = 0; i < 5; i += 1) {
        int bx = x + (directionX * (4 - i));
        graphics.fill(Math.min(bx, bx + directionX * 2), y - 5 + i, Math.max(bx, bx + directionX * 2), y - 4 + i, color);
        graphics.fill(Math.min(bx, bx + directionX * 2), y + 5 - i, Math.max(bx, bx + directionX * 2), y + 6 - i, color);
      }
      return;
    }
    int tipY = y + (directionY * 6);
    graphics.fill(x - 1, Math.min(y, tipY), x + 2, Math.max(y, tipY), color);
    for (int i = 0; i < 5; i += 1) {
      int by = y + (directionY * (4 - i));
      graphics.fill(x - 5 + i, Math.min(by, by + directionY * 2), x - 4 + i, Math.max(by, by + directionY * 2), color);
      graphics.fill(x + 5 - i, Math.min(by, by + directionY * 2), x + 6 - i, Math.max(by, by + directionY * 2), color);
    }
  }

  private void drawCard(GuiGraphicsExtractor graphics, Font font, int[] card) {
    int x = card[0];
    int y = card[1];
    int w = card[2];
    int h = card[3];
    graphics.fill(x + 2, y + 2, x + w + 2, y + h + 2, LauncherTheme.argb(82, 0x000000));
