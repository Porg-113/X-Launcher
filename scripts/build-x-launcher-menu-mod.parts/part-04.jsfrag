  'dev/xlauncher/client/XClientJoinErrorScreen.java': String.raw`
package dev.xlauncher.client;

import java.lang.reflect.Field;
import java.util.Locale;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.client.gui.components.Button;
import net.minecraft.client.gui.screens.ConnectScreen;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.client.multiplayer.ServerData;
import net.minecraft.client.multiplayer.resolver.ServerAddress;
import net.minecraft.network.DisconnectionDetails;
import net.minecraft.network.chat.Component;

public final class XClientJoinErrorScreen extends Screen {
  private static final Component TITLE = Component.literal("X-Client hat den Fehler behoben");
  private static final Component DESCRIPTION = Component.literal("Die Verbindung wurde unterbrochen.");
  private static ServerData lastServer;
  private final Screen parent;
  private final ServerData server;

  private XClientJoinErrorScreen(Screen parent, ServerData server) {
    super(TITLE);
    this.parent = parent;
    this.server = server;
  }

  public static void remember(ServerData server) {
    if (server != null) lastServer = server;
  }

  public static Screen create(Screen parent, ServerData server, DisconnectionDetails details) {
    remember(server);
    if (details == null || !isHandledReason(details.reason()) || lastServer == null) return null;
    return new XClientJoinErrorScreen(parent, lastServer);
  }

  public static Screen createForFailedLogin(Screen parent, ServerData server, DisconnectionDetails details) {
    // ClientHandshakePacketListenerImpl always labels this callback with
    // CommonComponents.CONNECT_FAILED ("Failed to connect to the server").
    // That title is not part of DisconnectionDetails.reason(), so this exact
    // login callback must be treated as the fourth handled case directly.
    remember(server);
    if (details == null || lastServer == null || !isHandledLoginReason(details.reason())) return null;
    return new XClientJoinErrorScreen(parent, lastServer);
  }

  public static Screen createFromVanilla(Screen vanilla, ServerData server, DisconnectionDetails details) {
    Screen parent = vanilla == null ? null : screenField(vanilla, "parent");
    return create(parent, server, details);
  }

  @Override
  protected void init() {
    int buttonY = Math.min(height - 54, (height / 2) + 42);
    addRenderableWidget(Button.builder(Component.literal("Reconnect"), button -> reconnect())
        .bounds((width - 200) / 2, buttonY, 200, 20).build());
    addRenderableWidget(Button.builder(Component.literal("Cancel"), button -> cancel())
        .bounds((width - 200) / 2, buttonY + 24, 200, 20).build());
  }

  @Override
  public void extractRenderState(GuiGraphicsExtractor graphics, int mouseX, int mouseY, float tickDelta) {
    super.extractRenderState(graphics, mouseX, mouseY, tickDelta);
    int centerY = Math.max(45, (height / 2) - 35);
    graphics.centeredText(font, TITLE, width / 2, centerY, 0xFFFFFFFF);
    graphics.centeredText(font, DESCRIPTION, width / 2, centerY + 26, 0xFFAAAAAA);
  }

  @Override
  public boolean shouldCloseOnEsc() {
    return false;
  }

  private void reconnect() {
    // This is Minecraft's ordinary connection entry point. It performs the
    // standard session/authentication handshake; no auth result is suppressed.
    ServerAddress address = ServerAddress.parseString(server.ip);
    ConnectScreen.startConnecting(parent == null ? this : parent, minecraft, address, server, false, null);
  }

  private void cancel() {
    minecraft.gui.setScreen(parent);
  }

  private static boolean isHandledReason(Component component) {
    String reason = component == null ? "" : component.getString().toLowerCase(Locale.ROOT);
    return reason.contains("failed to log in: invalid session")
        || reason.contains("ddos mitigation: please reconnect to the server")
        || reason.contains("internal exception: java.net.socketexception: connection reset")
        || reason.contains("failed to connect to the server");
  }

  private static boolean isHandledLoginReason(Component component) {
    if (isHandledReason(component)) return true;
    String reason = component == null ? "" : component.getString().toLowerCase(Locale.ROOT);
    // These are client/network failures behind Minecraft's generic
    // "Failed to connect to the server" heading. Any other text is kept as
    // the server supplied it (for example bans, kicks and whitelist reasons).
    return reason.contains("connection refused")
        || reason.contains("connection timed out")
        || reason.contains("timed out")
        || reason.contains("unknown host")
        || reason.contains("no route to host")
        || reason.contains("network is unreachable")
        || reason.contains("connection reset")
        || reason.contains("closed channel")
        || reason.contains("socketexception");
  }

  private static Screen screenField(Object target, String name) {
    try {
      Field field = target.getClass().getDeclaredField(name);
      field.setAccessible(true);
      Object value = field.get(target);
      return value instanceof Screen screen ? screen : null;
    } catch (Throwable ignored) {
      return null;
    }
  }
}
`,
  'dev/xlauncher/client/mixin/XLauncherLoginDisconnectMixin.java': String.raw`
package dev.xlauncher.client.mixin;

import dev.xlauncher.client.XClientJoinErrorScreen;
import net.minecraft.client.Minecraft;
import net.minecraft.client.multiplayer.ClientHandshakePacketListenerImpl;
import net.minecraft.client.multiplayer.ServerData;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.network.DisconnectionDetails;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Shadow;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;

@Mixin(ClientHandshakePacketListenerImpl.class)
public abstract class XLauncherLoginDisconnectMixin {
  @Shadow private Minecraft minecraft;
  @Shadow private ServerData serverData;
  @Shadow private Screen parent;

  @Inject(method = "onDisconnect", at = @At("HEAD"), cancellable = true, require = 1)
  private void xclient$replaceLoginDisconnect(DisconnectionDetails details, CallbackInfo callback) {
    Screen replacement = XClientJoinErrorScreen.createForFailedLogin(parent, serverData, details);
    if (replacement != null) {
      minecraft.gui.setScreen(replacement);
      callback.cancel();
    }
  }
}
