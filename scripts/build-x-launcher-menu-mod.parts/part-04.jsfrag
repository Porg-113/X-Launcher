  private static boolean invokeBlockAction(Object target, Object pos, Object direction, String... names) {
    if (target == null || pos == null) {
      return false;
    }
    for (String name : names) {
      for (Method method : target.getClass().getMethods()) {
        if (!name.equals(method.getName())) {
          continue;
        }
        Class<?>[] types = method.getParameterTypes();
        try {
          if (types.length == 1 && types[0].isInstance(pos)) {
            Object result = method.invoke(target, pos);
            return !(result instanceof Boolean bool) || bool.booleanValue();
          }
          if (direction != null && types.length == 2 && types[0].isInstance(pos) && types[1].isInstance(direction)) {
            Object result = method.invoke(target, pos, direction);
            return !(result instanceof Boolean bool) || bool.booleanValue();
          }
        } catch (Throwable ignored) {
          // Try the next overload or mapping name.
        }
      }
    }
    return false;
  }

