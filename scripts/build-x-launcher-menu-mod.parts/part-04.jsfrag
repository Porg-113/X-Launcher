          Object value = field.get(client);
          if (value != null) {
            return value;
          }
        } catch (Throwable ignored) {
          // Try the next render target field.
        }
      }
      type = type.getSuperclass();
    }
    return null;
  }

  private static boolean readBooleanField(Object target, boolean fallback, String... names) {
