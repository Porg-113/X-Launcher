  private static void updateNoBob(Options options) {
    if (moduleEnabled("nobob")) {
      if (previousBobView == null) {
        previousBobView = getOptionBoolean(options, "bobView");
      }
      forceOptionBoolean(options, "bobView", false);
      return;
    }
    if (previousBobView != null) {
      forceOptionBoolean(options, "bobView", previousBobView.booleanValue());
      previousBobView = null;
    }
  }

  private static void adjustFreecamSpeed(double yOffset) {
    if (yOffset > 0.0D) {
      freecamSpeed = Math.min(8.0D, freecamSpeed + (0.18D * Math.abs(yOffset)));
    } else if (yOffset < 0.0D) {
      freecamSpeed = Math.max(0.2D, freecamSpeed - (0.18D * Math.abs(yOffset)));
    }
  }

  private static void updateZoom(Minecraft client) {
    if (client == null || client.options == null) {
      return;
    }
    if (zoomApplied) {
      if (previousSmoothCamera != null) {
        setSmoothCamera(client.options, previousSmoothCamera.booleanValue());
      }
      restoreZoomSensitivity(client.options);
      previousFov = null;
      previousSmoothCamera = null;
      zoomJustActivated = false;
      currentZoomFactor = 1.0D;
      zoomApplied = false;
    } else {
      restoreZoomSensitivity(client.options);
    }
    syncInfiniteZoomKeyMapping(client);
  }

  public static double applyZoomFov(double originalFov) {
    lastBaseFov = originalFov;
    return originalFov;
  }

  private static void updateZoomSensitivity(Options options) {
    if (options == null) {
      return;
    }
    Number current = getOptionNumber(options, "sensitivity");
    if (current == null) {
      return;
    }
    if (previousMouseSensitivity == null) {
      previousMouseSensitivity = Double.valueOf(current.doubleValue());
    }
    double base = previousMouseSensitivity.doubleValue();
    double zoom = Math.max(1.0D, currentZoomFactor);
    double target = Math.max(0.005D, Math.min(1.0D, base / zoom));
    if (Math.abs(current.doubleValue() - target) > 0.0005D) {
      forceOptionNumber(options, "sensitivity", target);
    }
  }

  private static void restoreZoomSensitivity(Options options) {
    if (options == null || previousMouseSensitivity == null) {
      return;
    }
    forceOptionNumber(options, "sensitivity", previousMouseSensitivity.doubleValue());
    previousMouseSensitivity = null;
  }

  public static void applyDetachedCamera(Object camera) {
    Minecraft client = Minecraft.getInstance();
    if (camera == null || client == null || !moduleEnabled("freecam") || !hasWorld(client)) {
      if (freecamApplied) {
        log("Freecam disabled; vanilla camera and player input restored.");
      }
      updateFreecamChunkRendering(false);
      freecamApplied = false;
      freecamMouseReady = false;
      freecamChunkAvailable = null;
      lastFreecamMoveMs = 0L;
      return;
    }

    if (!freecamApplied) {
      initFreecam(camera, client);
    }
    updateFreecam(client);
    setCameraRotation(camera, freecamYaw, freecamPitch);
    setCameraPosition(camera, freecamX, freecamY, freecamZ);
    setBooleanFields(camera, true, "detached", "field_1874");
  }

