package dev.xlauncher.client.mixin;

import net.minecraft.client.Minecraft;
import net.minecraft.client.renderer.entity.LivingEntityRenderer;
import net.minecraft.world.entity.LivingEntity;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

@Mixin(LivingEntityRenderer.class)
public abstract class XLauncherOwnNameMixin {
  @Inject(
      method = "shouldShowName(Lnet/minecraft/world/entity/LivingEntity;D)Z",
      at = @At("RETURN"),
      cancellable = true,
      require = 1
  )
  private void xclient$showOwnThirdPersonName(
      LivingEntity entity,
      double distanceToCameraSq,
      CallbackInfoReturnable<Boolean> callback
  ) {
    // Never add a second label when vanilla (for example with a detached camera)
    // already decided to render this entity's name.
    if (Boolean.TRUE.equals(callback.getReturnValue())) {
      return;
    }

    Minecraft client = Minecraft.getInstance();
    if (client.player == null
        || entity != client.player
        || client.options.getCameraType().isFirstPerson()) {
      return;
    }

    // Mirror the vanilla local-player branch of LivingEntityRenderer. The one
    // condition intentionally omitted here is entity == client.getCameraEntity(),
    // which is precisely what hides the local name in third person.
    boolean withinSneakingRange = !entity.isDiscrete() || distanceToCameraSq < 1024.0D;
    boolean vanillaVisibility = !client.gui.hud.isHidden()
        && !entity.isInvisibleTo(client.player)
        && !entity.isVehicle();
    if (withinSneakingRange && vanillaVisibility) {
      callback.setReturnValue(true);
    }
  }
}
`,
