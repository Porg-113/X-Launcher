  }

  private static void addIntegratedServerEffect(Object client, Object effectInstance) {
    Object server = integratedServer(client);
    if (server == null || effectInstance == null) {
      return;
    }
    if (server instanceof Executor executor) {
      executor.execute(() -> addIntegratedServerEffectNow(server, client, effectInstance));
      return;
    }
    addIntegratedServerEffectNow(server, client, effectInstance);
  }

