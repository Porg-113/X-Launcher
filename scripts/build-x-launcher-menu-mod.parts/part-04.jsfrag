  }
  protected void init() { int x=(width-W)/2,y=(height-H)/2; addRenderableWidget(Button.builder(Component.literal("SAVE"),b->saveAndClose()).bounds(x+18,y+H-30,W-36,20).build()); }
  public void extractRenderState(GuiGraphicsExtractor g,int mx,int my,float dt) {
    super.extractRenderState(g,mx,my,dt); int x=(width-W)/2,y=(height-H)/2;
    g.fill(x+2,y+2,x+W+2,y+H+2,0x99000000); g.fill(x,y,x+W,y+H,0xF010151C); box(g,x,y,W,H,0xFF5B6875);
    g.centeredText(font,label,width/2,y+10,0xFFFFFFFF); int preview=(opacity<<24)|rgb();
    round(g,x+W-38,y+7,20,14,preview); box(g,x+W-38,y+7,20,14,0xFFFFFFFF);
    slider(g,x,y+32,"R",red,0xFFFF4A4A); slider(g,x,y+32+ROW,"G",green,0xFF43D66F); slider(g,x,y+32+ROW*2,"B",blue,0xFF4A8CFF); slider(g,x,y+32+ROW*3,"A",opacity,0xFFFFFFFF);
    if(allowRainbow){int ry=y+32+ROW*4; boolean rainbow=XClientColorModes.rainbow(target); round(g,x+18,ry,W-36,20,rainbow?preview:0xFF242B34);
    box(g,x+18,ry,W-36,20,rainbow?0xFFFFFFFF:0xFF697582); g.centeredText(font,rainbow?"RAINBOW: ON":"RAINBOW: OFF",width/2,ry+6,0xFFFFFFFF);}
  }
  public boolean mouseClicked(MouseButtonEvent e,boolean dbl) { int x=(width-W)/2,y=(height-H)/2;
    for(int row=0;row<4;row++){int ry=y+32+row*ROW;if(inside(e.x(),e.y(),x+18,ry,W-36,20)){dragging=row;update(e.x(),x);return true;}}
    int ry=y+32+ROW*4;if(allowRainbow&&inside(e.x(),e.y(),x+18,ry,W-36,20)){XClientColorModes.setRainbow(target,!XClientColorModes.rainbow(target));return true;}
    return super.mouseClicked(e,dbl);
  }
  public boolean mouseDragged(MouseButtonEvent e,double dx,double dy){if(dragging>=0){update(e.x(),(width-W)/2);return true;}return super.mouseDragged(e,dx,dy);}
  public boolean mouseReleased(MouseButtonEvent e){if(dragging>=0){dragging=-1;return true;}return super.mouseReleased(e);}
  public void onClose(){saveAndClose();}
  private void saveAndClose(){if(!allowRainbow||!XClientColorModes.rainbow(target))XClientColorModes.setColor(target,rgb());XClientColorModes.setOpacity(target,opacity);minecraft.gui.setScreen(parent);}
  private void slider(GuiGraphicsExtractor g,int px,int y,String name,int value,int color){int x=px+18,w=W-36;round(g,x,y,w,20,0xFF1C232C);box(g,x,y,w,20,0xFF596572);
    g.text(font,name,x+8,y+6,0xFFFFFFFF);int tx=x+30,tw=w-70;g.fill(tx,y+9,tx+tw,y+12,0xFF000000);int f=Math.round(value/255f*tw);g.fill(tx,y+9,tx+f,y+12,0xFF000000);g.fill(tx+f-2,y+5,tx+f+3,y+16,color);g.text(font,String.valueOf(value),x+w-31,y+6,0xFFFFFFFF);}
  private void update(double mx,int px){int tx=px+48,tw=W-106,v=Math.max(0,Math.min(255,(int)Math.round((mx-tx)/tw*255d)));if(dragging==0)red=v;if(dragging==1)green=v;if(dragging==2)blue=v;if(dragging==3){opacity=Math.max(XClientColorModes.MIN_OPACITY,v);XClientColorModes.setOpacity(target,opacity);}else XClientColorModes.setColor(target,rgb());}
  private int rgb(){return red<<16|green<<8|blue;} private static boolean inside(double mx,double my,int x,int y,int w,int h){return mx>=x&&mx<x+w&&my>=y&&my<y+h;}
  private static void round(GuiGraphicsExtractor g,int x,int y,int w,int h,int c){g.fill(x+2,y,x+w-2,y+h,c);g.fill(x,y+2,x+w,y+h-2,c);g.fill(x+1,y+1,x+w-1,y+h-1,c);}
  private static void box(GuiGraphicsExtractor g,int x,int y,int w,int h,int c){g.fill(x,y,x+w,y+1,c);g.fill(x,y+h-1,x+w,y+h,c);g.fill(x,y,x+1,y+h,c);g.fill(x+w-1,y,x+w,y+h,c);}
}
