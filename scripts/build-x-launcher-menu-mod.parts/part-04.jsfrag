  @Override
  public void onInitializeClient() {
    MenuModules.modules();
    AdminFlightModule.register();
    NativeHitboxController.setEnabled(moduleEnabled("hitboxes"));
    menuKey = new KeyMapping(MENU_KEY_ID, RIGHT_SHIFT, X_CLIENT_KEY_CATEGORY);
    syncModuleKeyMappings(null);
    syncZoomKeyMapping(null);
    tryFabricKeyBindingHelper();
    // Clear movement mappings before LocalPlayer consumes them. Freecam itself
    // reads GLFW directly, so its camera controls remain responsive.
    ClientTickEvents.START_CLIENT_TICK.register(XLauncherMenuClient::freezeFreecamPlayerBeforeTick);
    ClientTickEvents.END_CLIENT_TICK.register(XLauncherMenuClient::clientTick);
    log("26.2 client tick event registered.");
    HudOverlay.register();
    EspRenderPipeline26.register();
    TargetFrameRenderer.register();
    SocialManager.start();
    applyLauncherLocalSkin();
  }

  private static void applyLauncherLocalSkin() {
    String skinPath = System.getProperty("xlauncher.skin.path", "").trim();
    if (skinPath.isEmpty()) {
      return;
    }
    try {
      Path path = Path.of(skinPath);
      if (!Files.isRegularFile(path)) {
        log("Local skin file not found: " + skinPath);
        return;
      }
      String id = System.getProperty("xlauncher.skin.id", "active");
      String name = System.getProperty("xlauncher.skin.name", "Skin");
      String model = System.getProperty("xlauncher.skin.model", "classic");
      byte[] skinBytes = Files.readAllBytes(path);
      Object client = minecraftClientReflective();
      if (LocalSkinOverride.apply(client, id, name, skinBytes, model)) {
        log("Local launcher skin applied: " + name);
      } else {
        log("Local launcher skin could not be applied.");
      }
    } catch (Throwable error) {
      log("Local launcher skin failed: " + error.getClass().getSimpleName() + ": " + error.getMessage());
    }
  }

  private static Object minecraftClientReflective() {
    for (String className : new String[] { "net.minecraft.client.Minecraft", "net.minecraft.class_310" }) {
      try {
        Class<?> clientClass = Class.forName(className);
        for (String methodName : new String[] { "getInstance", "method_1551" }) {
          try {
            Method method = clientClass.getMethod(methodName);
            if (java.lang.reflect.Modifier.isStatic(method.getModifiers()) && method.getParameterCount() == 0) {
              return method.invoke(null);
            }
          } catch (Throwable ignored) {
            // Try the next accessor.
          }
        }
      } catch (Throwable ignored) {
        // Try the next client class name.
      }
    }
    return null;
  }

  static void toggleModule(int index) {
    MenuModules.Module module = MenuModules.toggle(index);
    if (module != null) {
      applyModule(module);
    }
  }

  static void setModuleEnabled(int index, boolean enabled) {
    MenuModules.Module module = MenuModules.setEnabled(index, enabled);
    if (module != null) {
      applyModule(module);
    }
  }

  static void refreshModule(int index) {
    MenuModules.Module[] modules = MenuModules.modules();
    if (index >= 0 && index < modules.length) {
      applyModule(modules[index]);
    }
  }

  static void setModuleKey(int index, int keyCode) {
    setModuleKey(index, keyCode, 0);
  }

  static void setModuleKey(int index, int keyCode, int keyModifiers) {
    MenuModules.Module module = MenuModules.setKeyCombo(index, keyCode, keyModifiers);
    resetModuleKeyMapping(index);
    if (module != null && "zoom".equals(module.id)) {
      try {
        Minecraft client = Minecraft.getInstance();
        if (client != null && client.options != null) {
          restoreZoomSensitivity(client.options);
        }
      } catch (Throwable ignored) {
        // The next client tick will finish cleanup if Minecraft is not ready.
      }
      zoomKeyHeld = false;
      zoomApplied = false;
      currentZoomFactor = 1.0D;
      zoomKey = null;
      zoomKeyCodeSnapshot = Integer.MIN_VALUE;
      zoomKeyRegistered = false;
      try {
        syncInfiniteZoomKeyMapping(Minecraft.getInstance());
      } catch (Throwable ignored) {
        // The next client tick will update the Infinite Zoom bridge.
      }
    }
  }

  static int getLeftCps() {
    return countRecentClicks(LEFT_CLICK_TIMES);
  }

  static int getRightCps() {
    return countRecentClicks(RIGHT_CLICK_TIMES);
  }

  static boolean isLeftMouseDown() {
    return leftMouseDown;
  }

  static boolean isRightMouseDown() {
    return rightMouseDown;
  }

  private static int countRecentClicks(long[] clickTimes) {
    long cutoff = System.currentTimeMillis() - 1000L;
    int count = 0;
    for (long clickTime : clickTimes) {
      if (clickTime >= cutoff) {
        count += 1;
      }
    }
    return count;
  }

  static boolean isKeyDown(Object client, int keyCode) {
    try {
      long handle = windowHandle(client);
      Class<?> glfw = Class.forName("org.lwjgl.glfw.GLFW");
      int press = glfw.getField("GLFW_PRESS").getInt(null);
      int state = ((Number) glfw.getMethod("glfwGetKey", long.class, int.class).invoke(null, handle, keyCode)).intValue();
      return state == press;
    } catch (Throwable ignored) {
      return false;
    }
  }

  static boolean isKeyComboDown(Object client, int keyCode, int keyModifiers) {
    if (keyCode <= 0 || !isKeyDown(client, keyCode)) {
      return false;
    }
    if ((keyModifiers & MOD_SHIFT) != 0 && !isAnyKeyDown(client, 340, 344)) {
      return false;
    }
    if ((keyModifiers & MOD_CONTROL) != 0 && !isAnyKeyDown(client, 341, 345)) {
      return false;
    }
    if ((keyModifiers & MOD_ALT) != 0 && !isAnyKeyDown(client, 342, 346)) {
      return false;
    }
    return (keyModifiers & MOD_SUPER) == 0 || isAnyKeyDown(client, 343, 347);
  }

  public static void setVirtualInput(Object client, int code, boolean mouseButton, boolean down) {
    if (client == null || code < 0) {
      return;
    }
    Object options = getAnyField(client, "options", "field_1690");
    Object mappings = getAnyField(options, "keyMappings", "field_1839");
    if (mappings == null || !mappings.getClass().isArray()) {
      return;
    }
    int length = java.lang.reflect.Array.getLength(mappings);
    for (int index = 0; index < length; index += 1) {
      Object mapping = java.lang.reflect.Array.get(mappings, index);
      if (mapping == null || !mappingMatches(mapping, code, mouseButton)) {
        continue;
      }
      setMappingDown(mapping, down);
    }
  }

  private static boolean mappingMatches(Object mapping, int code, boolean mouseButton) {
    Object key = getAnyField(mapping, "key", "boundKey", "field_1655");
    int value = readIntFromObject(key, Integer.MIN_VALUE, "getValue", "method_1444");
    if (value == Integer.MIN_VALUE) {
      value = readIntFromObject(mapping, Integer.MIN_VALUE, "getKey", "getDefaultKey");
    }
    if (mouseButton) {
      return value == code || value == -100 - code;
    }
    return value == code;
  }

  private static int readIntFromObject(Object target, int fallback, String... methods) {
    if (target instanceof Number number) {
      return number.intValue();
    }
    if (target == null) {
      return fallback;
    }
    for (String methodName : methods) {
      try {
        Object value = target.getClass().getMethod(methodName).invoke(target);
        if (value instanceof Number number) {
          return number.intValue();
        }
      } catch (Throwable ignored) {
      }
    }
    return fallback;
  }

  private static void setMappingDown(Object mapping, boolean down) {
    for (String methodName : new String[] { "setDown", "method_23481" }) {
      try {
        Method method = mapping.getClass().getMethod(methodName, Boolean.TYPE);
        method.invoke(mapping, Boolean.valueOf(down));
        return;
      } catch (Throwable ignored) {
      }
    }
    for (String fieldName : new String[] { "isDown", "pressed", "field_1653" }) {
      try {
        Field field = mapping.getClass().getDeclaredField(fieldName);
        field.setAccessible(true);
        if (field.getType() == Boolean.TYPE) {
          field.setBoolean(mapping, down);
          return;
        }
      } catch (Throwable ignored) {
      }
    }
  }

  private static boolean isAnyKeyDown(Object client, int leftKeyCode, int rightKeyCode) {
    return isKeyDown(client, leftKeyCode) || isKeyDown(client, rightKeyCode);
  }

  public static void clientTick(Minecraft client) {
    if (client == null) {
      return;
    }
    if (!clientTickStarted) {
      clientTickStarted = true;
      log("26.2 client tick active.");
    }
    runClientStage("session", client, 0);
    runClientStage("server-policy", client, 1);
    runClientStage("key-registration", client, 2);
    runClientStage("menu-key", client, 3);
    if (!isXClientMenuOpen(client)) {
      runClientStage("module-keys", client, 4);
    }
    runClientStage("clicks", client, 5);
    runClientStage("zoom", client, 6);
    runClientStage("fullbright", client, 7);
    runClientStage("modules", client, 8);
    runClientStage("timer", client, 9);
    runClientStage("admin-flight", client, 10);
  }

  private static void updateMenuKey(Minecraft client) {
    if (menuKey == null) {
      return;
    }
    int keyCode = keyCodeFromMapping(menuKey);
    boolean down = menuKey.isDown() || (keyCode > 0 && isKeyDown(client, keyCode));
    boolean pressed = menuKey.consumeClick() || (down && !watcherMenuWasDown);
    watcherMenuWasDown = down;
    if (pressed && System.currentTimeMillis() >= menuKeyConsumedUntilMs) {
      releaseConflictingMenuKeyMappings(client);
      toggleMenu(client);
    }
  }

  private static void updateSessionState(Minecraft client) {
    Object level = client.level;
    Object player = client.player;
    boolean inWorld = level != null && player != null;
    if (level == activeSessionLevel && player == activeSessionPlayer && inWorld == wasInWorld) {
      return;
    }
    activeSessionLevel = level;
    activeSessionPlayer = player;
    wasInWorld = inWorld;
    watcherMenuWasDown = false;
    menuKeyConsumedUntilMs = 0L;
    setMappingDown(menuKey, false);
    if (menuKey != null) {
      while (menuKey.consumeClick()) {
        // Remove clicks belonging to the previous world/session.
      }
    }
    for (MenuModules.Module module : MenuModules.modules()) {
      module.keyDown = false;
    }
    zoomKeyHeld = false;
    zoomJustActivated = false;
    freecamApplied = false;
    freecamMouseReady = false;
    freecamChunkAvailable = null;
    updateFreecamChunkRendering(false);
    lastFreecamMoveMs = 0L;
    leftMouseDown = false;
    rightMouseDown = false;
    speedApplied = false;
    resistanceApplied = false;
    invisibilityApplied = false;
    lastSpeedCommandAmplifier = -1;
    lastResistanceCommandAmplifier = -1;
    lastInvisibilityCommandAmplifier = -1;
    fullbrightAddedNightVision = false;
    lastFullbrightLightmapMs = 0L;
    MobCameraTracker.clear();
    LocalSkinOverride.clearRemoteCosmetics();
    EspRenderPipeline26.resetWorldState();
    NativeHitboxController.setEnabled(inWorld && moduleEnabled("hitboxes"));
    log(inWorld ? "World session initialized." : "World session cleared.");
  }

  private static void runClientStage(String stage, Minecraft client, int operation) {
    try {
      switch (operation) {
        case 0 -> updateSessionState(client);
        case 1 -> ServerModulePolicy.tick(client);
        case 2 -> ensureKeyRegistered(client);
        case 3 -> updateMenuKey(client);
        case 4 -> pollModuleKeys(client);
        case 5 -> updateClicks(client);
        case 6 -> updateZoom(client);
        case 7 -> updateFullbright(client);
        case 8 -> updateMovementTweaks(client);
        case 9 -> GameTimer.tick(client);
        case 10 -> AdminFlightModule.tick(client);
        default -> { }
      }
    } catch (Throwable error) {
      long now = System.currentTimeMillis();
      String signature = stage + ":" + error.getClass().getName() + ":" + String.valueOf(error.getMessage());
      if (!signature.equals(lastTickFailure) || now - lastTickFailureMs >= 10000L) {
        lastTickFailure = signature;
        lastTickFailureMs = now;
        log("Client tick recovered in " + stage + " from " + error.getClass().getSimpleName() + ": " + error.getMessage());
      }
    }
  }

  private static void toggleMenu(Minecraft client) {
    if (isXClientMenuOpen(client)) {
      setMenuScreenSafely(client, null);
      return;
    }
    Object current = currentScreen(client);
    if (shouldBlockFriendsScreen(current)) {
      setMenuScreenSafely(client, null);
    }
    setMenuScreenSafely(client, new XLauncherMenuScreen());
  }

  public static boolean handleMenuKeyPress(KeyEvent event, int action) {
    Minecraft client = Minecraft.getInstance();
    if (event != null && action == 1) KeyboardSoundPlayer.onKeyPressed();
    if (event == null || event.key() == 256) {
      return false;
    }
    boolean matches = menuKey == null ? event.key() == RIGHT_SHIFT : menuKey.matches(event);
    if (!matches || action != 1) {
      return false;
    }
    if (client == null) {
      return false;
    }
    menuKeyConsumedUntilMs = System.currentTimeMillis() + 250L;
    setMappingDown(menuKey, false);
    releaseConflictingMenuKeyMappings(client);
    toggleMenu(client);
    return true;
  }

  public static void openMenuFromPause() {
    Minecraft client = Minecraft.getInstance();
    if (client != null) {
      setMenuScreenSafely(client, new XLauncherMenuScreen());
    }
  }

  public static boolean closeMenuScreen(XLauncherMenuScreen screen) {
    Minecraft client = Minecraft.getInstance();
    if (client == null) {
      return false;
    }
    Object current = currentScreen(client);
    if (current != null && current != screen) {
      return false;
    }
    setMenuScreenSafely(client, null);
    return true;
  }

  private static void setMenuScreenSafely(Minecraft client, net.minecraft.client.gui.screens.Screen screen) {
    try {
      if (client != null) {
        client.setScreenAndShow(screen);
      }
    } catch (Throwable error) {
      System.out.println("[X Client] Menu screen failed to open: " + error.getClass().getSimpleName() + ": " + error.getMessage());
    }
  }

  private static boolean isXClientMenuOpen(Object client) {
    return currentScreen(client) instanceof XLauncherMenuScreen;
  }

  private static Object currentScreen(Object client) {
    if (!(client instanceof Minecraft minecraft) || minecraft.gui == null) {
      return null;
    }
    return minecraft.gui.screen();
  }

  public static boolean shouldBlockFriendsScreen(Object screen) {
    if (screen == null) {
      return false;
    }
    String name = screen.getClass().getName();
    return name.startsWith("net.minecraft.client.gui.screens.friends.")
        || name.contains("FriendsOverlayScreen")
        || name.endsWith(".SocialInteractionsScreen");
  }
  static void playMenuClickSound() {
    try {
      Minecraft client = Minecraft.getInstance();
      if (client != null) {
        AbstractWidget.playButtonClickSound(client.getSoundManager());
        AbstractWidget.playButtonClickSound(client.getSoundManager());
        AbstractWidget.playButtonClickSound(client.getSoundManager());
        AbstractWidget.playButtonClickSound(client.getSoundManager());
      }
    } catch (Throwable ignored) {
      // Missing sound APIs should not block menu interaction.
    }
  }

  private static int currentZoomKeyCode() {
    for (MenuModules.Module module : MenuModules.modules()) {
      if ("zoom".equals(module.id)) {
        return module.keyCode > 0 ? module.keyCode : -1;
      }
    }
    return -1;
  }

  private static void syncZoomKeyMapping(Minecraft client) {
    syncModuleKeyMappings(client);
    int zoomIndex = moduleIndex("zoom");
    zoomKey = zoomIndex >= 0 && zoomIndex < moduleKeys.length ? moduleKeys[zoomIndex] : null;
    zoomKeyRegistered = zoomKey == null || (zoomIndex >= 0 && zoomIndex < moduleKeyRegistered.length && moduleKeyRegistered[zoomIndex]);
  }

  private static void syncModuleKeyMappings(Minecraft client) {
    MenuModules.Module[] modules = MenuModules.modules();
    ensureModuleKeyArrays(modules.length);
    for (int index = 0; index < modules.length; index += 1) {
      MenuModules.Module module = modules[index];
      if (!module.keyBindable) {
        moduleKeys[index] = null;
        moduleKeyRegistered[index] = true;
        moduleKeyCodeSnapshots[index] = Integer.MIN_VALUE;
        continue;
      }
      int keyCode = module.keyCode > 0 ? module.keyCode : -1;
      String keyId = moduleKeyId(module);
      if (moduleKeys[index] != null && moduleKeyCodeSnapshots[index] == keyCode && isNamedKey(moduleKeys[index], keyId)) {
        continue;
      }
      moduleKeys[index] = "zoom".equals(module.id) ? new BridgedZoomKeyMapping(index, keyCode) : new ModuleKeyMapping(index, keyCode);
      moduleKeyCodeSnapshots[index] = keyCode;
      moduleKeyRegistered[index] = false;
      if ("zoom".equals(module.id)) {
        zoomKey = moduleKeys[index];
        zoomKeyCodeSnapshot = keyCode;
        zoomKeyRegistered = false;
      }
    }
  }

  private static void ensureModuleKeyArrays(int length) {
    if (moduleKeys.length == length && moduleKeyCodeSnapshots.length == length && moduleKeyRegistered.length == length) {
      return;
    }
    moduleKeys = Arrays.copyOf(moduleKeys, length);
    int oldLength = moduleKeyCodeSnapshots.length;
    moduleKeyCodeSnapshots = Arrays.copyOf(moduleKeyCodeSnapshots, length);
    moduleKeyRegistered = Arrays.copyOf(moduleKeyRegistered, length);
    for (int index = oldLength; index < length; index += 1) {
      moduleKeyCodeSnapshots[index] = Integer.MIN_VALUE;
      moduleKeyRegistered[index] = false;
    }
  }

  private static void resetModuleKeyMapping(int index) {
    ensureModuleKeyArrays(MenuModules.modules().length);
    if (index < 0 || index >= moduleKeys.length) {
      return;
    }
    moduleKeyCodeSnapshots[index] = Integer.MIN_VALUE;
    moduleKeyRegistered[index] = false;
    if ("zoom".equals(MenuModules.modules()[index].id)) {
      zoomKey = null;
      zoomKeyCodeSnapshot = Integer.MIN_VALUE;
      zoomKeyRegistered = false;
    }
  }

  private static String moduleKeyId(MenuModules.Module module) {
    return MODULE_KEY_PREFIX + module.id;
  }

  private static int moduleIndex(String id) {
    MenuModules.Module[] modules = MenuModules.modules();
    for (int index = 0; index < modules.length; index += 1) {
      if (modules[index].id.equals(id)) {
        return index;
      }
    }
    return -1;
  }

  private static void syncInfiniteZoomKeyMapping(Minecraft client) {
    try {
      Class<?> infiniteZoomClient = Class.forName("de.n8M4.infinitezoom.client.InfinitezoomClient");
      Field keyField = infiniteZoomClient.getField("KEY_TOGGLE_ZOOM");
      Object currentKey = keyField.get(null);
      if (!originalInfiniteZoomKeyCaptured) {
        originalInfiniteZoomKey = currentKey;
        originalInfiniteZoomKeyCaptured = true;
      }
      MenuModules.Module module = zoomModule();
      if (module == null || module.keyCode <= 0) {
        if (originalInfiniteZoomKey != null && keyField.getType().isInstance(originalInfiniteZoomKey)
            && currentKey != originalInfiniteZoomKey) {
          keyField.set(null, originalInfiniteZoomKey);
        }
        return;
      }
      syncZoomKeyMapping(client);
      if (zoomKey != null && keyField.getType().isInstance(zoomKey) && currentKey != zoomKey) {
        keyField.set(null, zoomKey);
      }
    } catch (Throwable ignored) {
      // Infinite Zoom is optional at runtime; the launcher installs it for normal X Client profiles.
    }
  }

  private static class ModuleKeyMapping extends KeyMapping {
    private final int moduleIndex;

    ModuleKeyMapping(int moduleIndex, int keyCode) {
      super(moduleKeyId(MenuModules.modules()[moduleIndex]), keyCode, X_CLIENT_KEY_CATEGORY);
      this.moduleIndex = moduleIndex;
    }

    @Override
    public boolean isDown() {
      MenuModules.Module[] modules = MenuModules.modules();
      if (moduleIndex < 0 || moduleIndex >= modules.length) {
        return false;
      }
      MenuModules.Module module = modules[moduleIndex];
      Minecraft client = Minecraft.getInstance();
      if (module.keyModifiers == 0) {
        return super.isDown() || (module.keyCode > 0 && client != null && isKeyComboDown(client, module.keyCode, 0));
      }
      return module.keyCode > 0 && client != null && isKeyComboDown(client, module.keyCode, module.keyModifiers);
    }
  }

  private static final class BridgedZoomKeyMapping extends ModuleKeyMapping {
    BridgedZoomKeyMapping(int moduleIndex, int keyCode) {
      super(moduleIndex, keyCode);
    }
  }

  private static boolean isZoomKeyDown(Minecraft client, MenuModules.Module module) {
    if (module == null) {
      return false;
    }
    if (module.keyModifiers != 0 && module.keyCode > 0) {
      return isKeyComboDown(client, module.keyCode, module.keyModifiers);
    }
    try {
      syncZoomKeyMapping(client);
      if (zoomKey != null && zoomKey.isDown()) {
        return true;
      }
    } catch (RuntimeException ignored) {
      // Fall back to direct GLFW polling below.
    }
    return isKeyComboDown(client, module.keyCode, module.keyModifiers);
  }

  private static boolean isModuleKeyDown(Minecraft client, int index, MenuModules.Module module) {
    if ("zoom".equals(module.id)) {
      return isZoomKeyDown(client, module);
    }
    if (module.keyModifiers != 0 && module.keyCode > 0) {
      return isKeyComboDown(client, module.keyCode, module.keyModifiers);
    }
    try {
      syncModuleKeyMappings(client);
      KeyMapping keyMapping = index >= 0 && index < moduleKeys.length ? moduleKeys[index] : null;
      if (keyMapping != null && keyMapping.isDown()) {
        return true;
      }
    } catch (RuntimeException ignored) {
      // Fall back to direct GLFW polling below.
    }
    return module.keyCode > 0 && isKeyComboDown(client, module.keyCode, module.keyModifiers);
  }

  private static void pollModuleKeys(Minecraft client) {
    MenuModules.Module[] modules = MenuModules.modules();
    for (int index = 0; index < modules.length; index += 1) {
      MenuModules.Module module = modules[index];
      if (!module.keyBindable || !MenuModules.isUnlocked(module.id)) {
        if ("zoom".equals(module.id)) {
          zoomKeyHeld = false;
        }
        module.keyDown = false;
        continue;
      }
      boolean down = isModuleKeyDown(client, index, module);
      if ("zoom".equals(module.id)) {
        zoomKeyHeld = down;
        module.keyDown = down;
        continue;
      }
      if (down && !module.keyDown) {
        final int moduleIndex = index;
        if ("mobtrack".equals(module.id)) {
          ((Executor) client).execute(() -> triggerMobTrackKey(client, moduleIndex));
        } else if ("smartscreenshot".equals(module.id)) {
          ((Executor) client).execute(() -> triggerSmartScreenshot(client));
        } else if ("ui".equals(module.id)) {
          ((Executor) client).execute(() -> openUiEditor(client));
        } else if ("code".equals(module.id)) {
          ((Executor) client).execute(() -> openModulePanel(client, "code"));
        } else if (module.toggleable) {
          ((Executor) client).execute(() -> toggleModule(moduleIndex));
        } else {
          module.keyDown = down;
        }
      }
      module.keyDown = down;
    }
  }

  private static void openUiEditor(Minecraft client) {
    XLauncherMenuScreen screen = new XLauncherMenuScreen();
    screen.openUiEditorShortcut();
    setMenuScreenSafely(client, screen);
  }

  private static void openModulePanel(Minecraft client, String moduleId) {
    XLauncherMenuScreen screen = new XLauncherMenuScreen();
    screen.openModuleShortcut(moduleId);
    setMenuScreenSafely(client, screen);
  }

  private static void triggerMobTrackKey(Object client, int index) {
    MenuModules.Module[] modules = MenuModules.modules();
    if (index < 0 || index >= modules.length) {
      return;
    }
    if (modules[index].enabled) {
      MobCameraTracker.clear();
      MenuModules.Module module = MenuModules.setEnabled(index, false);
      if (module != null) {
        applyModule(module);
      }
      return;
    }
    if (MobCameraTracker.lockLookedAt(client)) {
      MenuModules.Module module = MenuModules.setEnabled(index, true);
      if (module != null) {
        applyModule(module);
      }
      return;
    }
    toggleModule(index);
  }

  private static void triggerSmartScreenshot(Object client) {
    if (client == null || smartScreenshotRunning || !isGameplayFocused(client)) {
      return;
    }
    smartScreenshotRunning = true;
    Object options = getAnyField(client, "options", "field_1690");
    boolean previousHideGui = readBooleanField(options, false, "hideGui", "field_1842");
    setBooleanFields(options, true, "hideGui", "field_1842");
    Thread worker = new Thread(() -> {
      sleepQuietly(SMART_SCREENSHOT_CAPTURE_DELAY_MS);
      runOnClient(client, () -> {
        try {
          boolean saved = captureScreenshot(client);
          if (saved) {
            HudOverlay.showSmartScreenshotToast();
          }
          ScreenshotGallery.refresh(client);
        } finally {
          setBooleanFields(options, previousHideGui, "hideGui", "field_1842");
          smartScreenshotRunning = false;
        }
      });
    }, "X Client Smart Screenshot");
    worker.setDaemon(true);
    worker.start();
  }

  private static void runOnClient(Object client, Runnable task) {
    if (client instanceof Executor executor) {
      executor.execute(task);
      return;
    }
    task.run();
  }

  private static boolean captureScreenshot(Object client) {
    Object renderTarget = mainRenderTarget(client);
    if (renderTarget == null) {
      log("Smart Screenshot failed: render target not found.");
      return false;
    }
    File gameDirectory = gameDirectory(client);
    Consumer<Object> messageConsumer = message -> log("Smart Screenshot saved.");
    for (String className : new String[] {
        "net.minecraft.client.Screenshot",
        "net.minecraft.client.util.ScreenshotRecorder",
        "net.minecraft.class_318"
    }) {
      if (invokeScreenshotClass(className, gameDirectory, renderTarget, messageConsumer)) {
        return true;
      }
    }
    log("Smart Screenshot failed: screenshot API not found.");
    return false;
  }

  private static boolean invokeScreenshotClass(String className, File gameDirectory, Object renderTarget, Consumer<Object> messageConsumer) {
    try {
      Class<?> screenshotClass = Class.forName(className);
      for (Method method : screenshotClass.getMethods()) {
        if (invokeScreenshotMethod(method, gameDirectory, renderTarget, messageConsumer)) {
          return true;
        }
      }
      for (Method method : screenshotClass.getDeclaredMethods()) {
        method.setAccessible(true);
        if (invokeScreenshotMethod(method, gameDirectory, renderTarget, messageConsumer)) {
          return true;
        }
      }
    } catch (Throwable ignored) {
      // Try the next screenshot class name.
    }
    return false;
  }

  private static boolean invokeScreenshotMethod(Method method, File gameDirectory, Object renderTarget, Consumer<Object> messageConsumer) {
    if (!java.lang.reflect.Modifier.isStatic(method.getModifiers())) {
      return false;
    }
    Object[] args = screenshotArguments(method, gameDirectory, renderTarget, messageConsumer);
    if (args == null) {
      return false;
    }
    try {
      method.invoke(null, args);
      return true;
    } catch (Throwable ignored) {
      return false;
    }
  }

  private static Object[] screenshotArguments(Method method, File gameDirectory, Object renderTarget, Consumer<Object> messageConsumer) {
    Class<?>[] types = method.getParameterTypes();
    if (types.length < 3 || types.length > 5) {
      return null;
    }
    Object[] args = new Object[types.length];
    boolean usedFile = false;
    boolean usedRenderTarget = false;
    boolean usedConsumer = false;
    for (int index = 0; index < types.length; index += 1) {
      Class<?> type = types[index];
      if (File.class.isAssignableFrom(type)) {
        args[index] = gameDirectory;
        usedFile = true;
      } else if (Path.class.isAssignableFrom(type)) {
        args[index] = gameDirectory.toPath();
        usedFile = true;
      } else if (String.class.equals(type)) {
        args[index] = null;
      } else if (Consumer.class.isAssignableFrom(type)) {
        args[index] = messageConsumer;
        usedConsumer = true;
      } else if (renderTarget != null && type.isInstance(renderTarget)) {
        args[index] = renderTarget;
        usedRenderTarget = true;
      } else if (!type.isPrimitive() && !usedRenderTarget) {
        args[index] = renderTarget;
        usedRenderTarget = true;
      } else {
        return null;
      }
    }
    return usedFile && usedRenderTarget && usedConsumer ? args : null;
  }

  private static File gameDirectory(Object client) {
    Object value = getAnyField(client, "gameDirectory", "runDirectory", "field_1697", "field_1703");
    if (value instanceof File file) {
      return file;
    }
    if (value instanceof Path path) {
      return path.toFile();
    }
    String appData = System.getenv("APPDATA");
    if (appData == null || appData.isBlank()) {
      appData = Path.of(System.getProperty("user.home"), "AppData", "Roaming").toString();
    }
    return Path.of(appData, ".minecraft").toFile();
  }

  private static Object mainRenderTarget(Object client) {
