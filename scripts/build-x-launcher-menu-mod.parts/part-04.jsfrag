  private static boolean shouldPauseInOwnWorld(Object client) {
    if (client == null || getAnyField(client, "player", "field_1724") == null) {
      return false;
    }
    if (SocialManager.keepHostedWorldOnline() && SocialManager.hasHostedWorld()) {
      return false;
    }
    Boolean singleplayer = invokeAnyBoolean(client, "isSingleplayer", "hasSingleplayerServer", "isLocalServer");
    if (Boolean.TRUE.equals(singleplayer)) {
      return true;
    }
    return getAnyField(client, "singleplayerServer", "integratedServer", "field_1747") != null;
  }

