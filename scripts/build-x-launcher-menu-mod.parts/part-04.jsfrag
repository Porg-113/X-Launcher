  }

  private static void updateSpeedEffect(Minecraft client) {
    if (client == null) {
      return;
    }
    if (moduleEnabled("speed")) {
      applySpeedEffect(client);
      return;
    }
    if (speedApplied) {
      clearSpeedEffect(client);
    }
  }

  private static void applySpeedEffect(Minecraft client) {
    try {
      LocalPlayer player = client.player;
      if (player == null) {
        return;
      }
      int amplifier = MenuModules.effectLevel("speed");
      MobEffectInstance effect = new MobEffectInstance(MobEffects.SPEED, SPEED_EFFECT_DURATION_TICKS, amplifier, false, true, true);
      forceEffectValues(effect, SPEED_EFFECT_DURATION_TICKS, amplifier, true, true);
      if (!speedApplied || lastSpeedCommandAmplifier != amplifier) {
        sendEffectGiveCommand(client, "speed", amplifier);
        addIntegratedServerEffect(client, effect);
        lastSpeedCommandAmplifier = amplifier;
      }
      MobEffectInstance current = player.getEffect(MobEffects.SPEED);
      if (current != null && (current.getDuration() < 0 || current.getDuration() > SPEED_EFFECT_REFRESH_THRESHOLD_TICKS)
          && current.getAmplifier() >= amplifier) {
        forceEffectValues(current, SPEED_EFFECT_DURATION_TICKS, amplifier, true, true);
      }
      speedApplied = true;
    } catch (Throwable ignored) {
      // Speed is client-side best-effort and should never break the watcher.
    }
  }

  private static void clearSpeedEffect(Minecraft client) {
    sendEffectClearCommand(client, "speed");
    clearIntegratedServerEffect(client, MobEffects.SPEED);
    lastSpeedCommandAmplifier = -1;
    try {
      LocalPlayer player = client == null ? null : client.player;
      if (player != null) {
        MobEffectInstance current = player.getEffect(MobEffects.SPEED);
        if (current != null && (current.getAmplifier() >= MenuModules.effectLevel("speed") || (!current.isVisible() && !current.showIcon()))) {
          player.removeEffect(MobEffects.SPEED);
        }
      }
    } catch (Throwable ignored) {
      // Leave external speed effects untouched when cleanup fails.
    }
    speedApplied = false;
  }

