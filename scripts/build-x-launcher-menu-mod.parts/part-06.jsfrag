  private static int countRecentClicks(long[] clickTimes) {
    long cutoff = System.currentTimeMillis() - 1000L;
    int count = 0;
    for (long clickTime : clickTimes) {
      if (clickTime >= cutoff) {
        count += 1;
      }
    }
    return count;
  }

  static boolean isKeyDown(Object client, int keyCode) {
