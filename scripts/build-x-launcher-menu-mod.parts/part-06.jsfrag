  private static void applyNightVisionEffect(class_310 client) {
    try {
      Object player = getAnyField(client, "field_1724", "player");
      Object nightVision = nightVisionEffect();
      if (player == null || nightVision == null) {
        return;
      }
      Object current = invokeEffectMethod(player, nightVision, "method_6112", "getEffect");
      if ((effectDuration(current) < 0 || effectDuration(current) > NIGHT_VISION_REFRESH_THRESHOLD_TICKS)
          && effectAmplifier(current) >= NIGHT_VISION_EFFECT_AMPLIFIER) {
        return;
      }
      Object instance = createNightVisionInstance(nightVision);
      if (instance != null) {
        skipEffectBlending(instance);
        invokeEffectMethod(player, instance, "method_6092", "addEffect");
        fullbrightAddedNightVision = true;
      }
    } catch (Throwable ignored) {
      // Shader fullbright still falls back to gamma and lightmap changes.
    }
  }

  private static void clearNightVisionEffect(class_310 client) {
    try {
      Object player = client == null ? null : getAnyField(client, "field_1724", "player");
      Object nightVision = nightVisionEffect();
      if (player != null && nightVision != null) {
        Object current = invokeEffectMethod(player, nightVision, "method_6112", "getEffect");
        if (current != null && (fullbrightAddedNightVision
            || (!effectBoolean(current, "method_5591", "isVisible") && !effectBoolean(current, "method_5592", "showIcon")))) {
          invokeEffectMethod(player, nightVision, "method_6016", "removeEffect");
        }
      }
    } catch (Throwable ignored) {
      // Leave externally supplied night vision untouched when cleanup fails.
    }
    fullbrightAddedNightVision = false;
  }

