    if ((keyModifiers & MOD_SHIFT) != 0 && !isAnyKeyDown(client, 340, 344)) {
      return false;
    }
    if ((keyModifiers & MOD_CONTROL) != 0 && !isAnyKeyDown(client, 341, 345)) {
      return false;
    }
    if ((keyModifiers & MOD_ALT) != 0 && !isAnyKeyDown(client, 342, 346)) {
      return false;
    }
    return (keyModifiers & MOD_SUPER) == 0 || isAnyKeyDown(client, 343, 347);
  }

