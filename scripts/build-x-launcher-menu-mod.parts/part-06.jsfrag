  private void draw(class_332 graphics, int mouseX, int mouseY) {
    class_327 font = class_310.method_1551().field_1772;
    if (uiEditorMode) {
      drawUiEditor(graphics, font, mouseX, mouseY);
      return;
    }
    if (galleryMode) {
      drawScreenshotGallery(graphics, font, mouseX, mouseY);
      return;
    }
    int accent = LauncherTheme.accent();
    int[] layout = layout();
    int startX = layout[0];
    int startY = layout[1];
    int totalWidth = layout[2];
    int gridHeight = layout[3];
    int boxX = layout[4];
    int boxY = layout[5];
    int boxW = layout[6];
    int boxH = layout[7];
    int columns = layout[8];
    int tileWidth = layout[9];
    int visibleCount = visibleCount();
    int maxVisibleTiles = maxVisibleTiles(layout);
    clampScroll(layout);
    float open = openProgress();
    int panelShift = Math.round((1.0F - open) * 9.0F);
    if (panelShift > 0) {
      startY += panelShift;
      boxY += panelShift;
      layout[1] = startY;
      layout[5] = boxY;
    }

    boolean lightMode = LauncherTheme.isLightMode();
    graphics.method_25294(0, 0, field_22789, field_22790, lightMode ? 0x18FFFFFF : 0x24DDEBFA);
    graphics.method_25294(0, 0, field_22789, 18, 0x00000000);
    graphics.method_25294(0, field_22790 - 18, field_22789, field_22790, 0x00000000);
    roundedFill(graphics, boxX + 5, boxY + 6, boxW, boxH, lightMode ? 0x36000000 : 0x52000000);
    roundedFill(graphics, boxX, boxY, boxW, boxH, lightMode ? 0xB8F3F7FA : 0xAA0C141D);
    roundedFill(graphics, boxX + 1, boxY + 1, boxW - 2, boxH - 2, lightMode ? 0xA8FDFEFF : 0x8E111C27);
    roundedFill(graphics, boxX + 1, boxY + 1, boxW - 2, PANEL_HEADER_HEIGHT - 1, lightMode ? 0xBCF4F9FD : 0x9A101923);
    graphics.method_25294(boxX + 12, boxY + PANEL_HEADER_HEIGHT - 3, boxX + boxW - 12, boxY + PANEL_HEADER_HEIGHT - 2, 0x00000000);
    graphics.method_25294(boxX + 12, boxY + PANEL_HEADER_HEIGHT - 1, boxX + boxW - 12, boxY + PANEL_HEADER_HEIGHT + 1, 0x00000000);
    graphics.method_25294(boxX + 9, boxY + 9, boxX + 12, boxY + boxH - 9, 0x00000000);
    border(graphics, boxX, boxY, boxW, boxH, lightMode ? 0xDD5B6D7B : LauncherTheme.accentArgb(210));
    drawSearchBar(graphics, font, layout);
    drawHeaderActions(graphics, font, layout);

    if (selectedIndex >= 0) {
      drawDetail(graphics, font, layout);
      return;
    }

    MenuModules.Module[] modules = MenuModules.modules();
    int visibleIndex = 0;
    int matchedIndex = 0;
    int firstVisibleIndex = scrollOffset * columns;
    for (int index = 0; index < modules.length; index += 1) {
      if (!matchesModule(modules[index])) {
        continue;
      }
      if (matchedIndex < firstVisibleIndex) {
        matchedIndex += 1;
        continue;
      }
      if (visibleIndex >= maxVisibleTiles) {
        break;
      }
      int column = visibleIndex % columns;
      int row = visibleIndex / columns;
      int x = startX + (column * (tileWidth + GAP));
      int y = startY + (row * tileRowStep());
      drawTile(graphics, font, modules[index], x, y, tileWidth, TILE_HEIGHT, isInside(mouseX, mouseY, x, y, tileWidth, TILE_LABEL_HEIGHT + TILE_HEIGHT), accent);
      visibleIndex += 1;
      matchedIndex += 1;
    }
    if (visibleCount == 0) {
      centeredText(graphics, font, "NO MODULES", field_22789 / 2, startY + 13, LauncherTheme.mutedTextColor());
    }
    drawScrollbar(graphics, layout, visibleCount, maxVisibleTiles);

  }

