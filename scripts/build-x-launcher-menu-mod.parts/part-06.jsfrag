package dev.xlauncher.client;

import java.lang.reflect.InvocationHandler;
import java.lang.reflect.Method;
import java.lang.reflect.Proxy;
import java.util.Collections;
import java.util.Optional;
import net.minecraft.class_2561;

final class TextBridge {
  private TextBridge() {
  }

  static class_2561 literal(String text) {
    Class<?> componentClass = class_2561.class;
    for (String methodName : new String[] { "method_30163", "literal", "a", "b", "c" }) {
      try {
        Method method = componentClass.getMethod(methodName, String.class);
        Object value = method.invoke(null, text);
        if (componentClass.isInstance(value)) {
          return (class_2561) value;
        }
      } catch (Throwable ignored) {
        // Different Minecraft mappings expose the same factory under different names.
      }
    }
    return fallbackComponent(text, componentClass);
  }

  private static class_2561 fallbackComponent(String text, Class<?> componentClass) {
    if (!componentClass.isInterface()) {
      return null;
    }
    InvocationHandler handler = (Object proxy, Method method, Object[] args) -> {
      String name = method.getName();
      if ("toString".equals(name) || "getString".equals(name) || "getLiteralString".equals(name) || "method_10851".equals(name)) {
        return text;
      }
      if ("hashCode".equals(name)) {
        return text.hashCode();
      }
      if ("equals".equals(name)) {
        return args != null && args.length == 1 && proxy == args[0];
      }
      Class<?> returnType = method.getReturnType();
      if (returnType == Void.TYPE) {
        return null;
      }
      if (returnType == Boolean.TYPE) {
        return false;
      }
      if (returnType == Byte.TYPE) {
        return (byte) 0;
      }
      if (returnType == Short.TYPE) {
        return (short) 0;
      }
      if (returnType == Integer.TYPE) {
        return 0;
      }
      if (returnType == Long.TYPE) {
        return 0L;
      }
      if (returnType == Float.TYPE) {
        return 0.0F;
      }
      if (returnType == Double.TYPE) {
        return 0.0D;
      }
      if (returnType == Character.TYPE) {
        return '\0';
      }
      if (String.class.equals(returnType)) {
        return text;
      }
      if (Optional.class.equals(returnType)) {
        return Optional.empty();
      }
      if (java.util.List.class.equals(returnType)) {
        return Collections.emptyList();
      }
      if (returnType.isInstance(proxy)) {
        return proxy;
      }
      return null;
    };
    return (class_2561) Proxy.newProxyInstance(componentClass.getClassLoader(), new Class<?>[] { componentClass }, handler);
  }
