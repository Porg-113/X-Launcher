  private static void pollModuleKeys(class_310 client) {
    MenuModules.Module[] modules = MenuModules.modules();
    for (int index = 0; index < modules.length; index += 1) {
      MenuModules.Module module = modules[index];
      if (!module.keyBindable || !MenuModules.isUnlocked(module.id)) {
        if ("zoom".equals(module.id)) {
          zoomKeyHeld = false;
        }
        module.keyDown = false;
        continue;
      }
      boolean down = isModuleKeyDown(client, index, module);
      if ("zoom".equals(module.id)) {
        zoomKeyHeld = down;
        module.keyDown = down;
        continue;
      }
      if (down && !module.keyDown) {
        final int moduleIndex = index;
        if ("mobtrack".equals(module.id)) {
          ((Executor) client).execute(() -> triggerMobTrackKey(client, moduleIndex));
        } else if ("smartscreenshot".equals(module.id)) {
          ((Executor) client).execute(() -> triggerSmartScreenshot(client));
        } else if ("ui".equals(module.id)) {
          ((Executor) client).execute(() -> openUiEditor(client));
        } else if ("code".equals(module.id)) {
          ((Executor) client).execute(() -> openModulePanel(client, "code"));
        } else if (module.toggleable) {
          ((Executor) client).execute(() -> toggleModule(moduleIndex));
        } else {
          module.keyDown = down;
        }
      }
      module.keyDown = down;
    }
  }

