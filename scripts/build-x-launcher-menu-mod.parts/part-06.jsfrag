      Class<?> glfw = Class.forName("org.lwjgl.glfw.GLFW");
      int press = glfw.getField("GLFW_PRESS").getInt(null);
      int state = ((Number) glfw.getMethod("glfwGetKey", long.class, int.class).invoke(null, handle, keyCode)).intValue();
      return state == press;
    } catch (Throwable ignored) {
      return false;
    }
  }

  static boolean isKeyComboDown(Object client, int keyCode, int keyModifiers) {
    if (keyCode <= 0 || !isKeyDown(client, keyCode)) {
      return false;
