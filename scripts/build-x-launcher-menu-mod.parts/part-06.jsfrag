  private static void invokeSetScreen(Object client, Object screen) throws ReflectiveOperationException {
    ReflectiveOperationException failure = null;
    Class<?> wantedScreenType = screen != null ? screen.getClass() : XLauncherMenuScreen.class;
    for (String methodName : new String[] { "method_1507", "setScreen", "a", "m_91152_" }) {
      ReflectiveOperationException namedFailure = tryInvokeScreenMethod(client, screen, wantedScreenType, methodName);
      if (namedFailure == null) {
