    int activeMenuKey = menuKey == null ? RIGHT_SHIFT : keyCodeFromMapping(menuKey);
    if (activeMenuKey <= 0) {
      activeMenuKey = RIGHT_SHIFT;
    }
    if (keyCode != activeMenuKey || action != 1) {
