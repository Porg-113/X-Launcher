  private static void syncZoomKeyMapping(class_310 client) {
    syncModuleKeyMappings(client);
    int zoomIndex = moduleIndex("zoom");
    zoomKey = zoomIndex >= 0 && zoomIndex < moduleKeys.length ? moduleKeys[zoomIndex] : null;
    zoomKeyRegistered = zoomKey == null || (zoomIndex >= 0 && zoomIndex < moduleKeyRegistered.length && moduleKeyRegistered[zoomIndex]);
