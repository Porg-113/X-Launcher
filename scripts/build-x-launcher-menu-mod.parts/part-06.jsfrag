    ReflectiveOperationException scannedFailure = tryInvokeScreenMethod(client, screen, wantedScreenType, null);
    if (scannedFailure == null) {
      return;
    }
    throw failure != null ? failure : scannedFailure;
  }

  private static ReflectiveOperationException tryInvokeScreenMethod(Object client, Object screen, Class<?> wantedScreenType, String methodName) {
    ReflectiveOperationException failure = null;
    Class<?> type = client.getClass();
    while (type != null) {
      for (Method method : type.getDeclaredMethods()) {
        if (methodName != null && !methodName.equals(method.getName())) {
          continue;
        }
        if (method.getParameterCount() != 1 || method.getReturnType() != Void.TYPE) {
          continue;
        }
        Class<?> parameterType = method.getParameterTypes()[0];
        if (!parameterType.isAssignableFrom(wantedScreenType)) {
          continue;
        }
        try {
          method.setAccessible(true);
          method.invoke(client, screen);
          return null;
        } catch (ReflectiveOperationException exception) {
          failure = exception;
        }
      }
      type = type.getSuperclass();
    }
    return failure == null ? new NoSuchMethodException(methodName == null ? "screen setter" : methodName) : failure;
  }
