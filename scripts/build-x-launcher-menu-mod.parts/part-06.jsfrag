      resizingOverlay = false;
      return true;
    }
    if (galleryMode) {
      galleryMode = false;
      galleryScrollOffset = 0;
      return true;
    }
    if (selectedIndex >= 0) {
      selectedIndex = -1;
      capturingKey = false;
      codeFocused = false;
      pendingRemoveFriendUuid = null;
      pendingRemoveFriendName = "";
      return true;
    }
    closeMenu();
    return true;
  }

  private void closeMenu() {
    if (closing) {
      return;
    }
    class_310 client = class_310.method_1551();
    if (client == null) {
      return;
    }
    closing = true;
    client.execute(() -> {
      if (!XLauncherMenuClient.closeMenuScreen(this)) {
        closing = false;
      }
    });
  }

