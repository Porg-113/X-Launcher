  private static void triggerMobTrackKey(Object client, int index) {
    MenuModules.Module[] modules = MenuModules.modules();
    if (index < 0 || index >= modules.length) {
      return;
    }
    if (modules[index].enabled) {
      MobCameraTracker.clear();
      MenuModules.Module module = MenuModules.setEnabled(index, false);
      if (module != null) {
        applyModule(module);
      }
      return;
    }
    if (MobCameraTracker.lockLookedAt(client)) {
      MenuModules.Module module = MenuModules.setEnabled(index, true);
      if (module != null) {
        applyModule(module);
      }
      return;
    }
    toggleModule(index);
  }

  private static void triggerSmartScreenshot(Object client) {
