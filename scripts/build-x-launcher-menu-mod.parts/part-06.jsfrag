    setFloatFields(player, freecamYaw, "field_6031", "field_5982", "yRot", "yaw", "yRotO", "lastYaw");
    setFloatFields(player, freecamPitch, "field_5965", "field_6030", "xRot", "pitch", "xRotO", "lastPitch");
