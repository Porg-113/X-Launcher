      return;
    }
    smartScreenshotRunning = true;
    Object options = getAnyField(client, "field_1690", "options");
    boolean previousHideGui = readBooleanField(options, false, "field_1842", "hideGui");
    setBooleanFields(options, true, "field_1842", "hideGui");
    Thread worker = new Thread(() -> {
      sleepQuietly(SMART_SCREENSHOT_CAPTURE_DELAY_MS);
      runOnClient(client, () -> {
        try {
          boolean saved = captureScreenshot(client);
          if (saved) {
            HudOverlay.showSmartScreenshotToast();
          }
          ScreenshotGallery.refresh(client);
        } finally {
          setBooleanFields(options, previousHideGui, "field_1842", "hideGui");
          smartScreenshotRunning = false;
        }
      });
    }, "X Client Smart Screenshot");
    worker.setDaemon(true);
    worker.start();
  }

  private static void runOnClient(Object client, Runnable task) {
    if (client instanceof Executor executor) {
      executor.execute(task);
      return;
    }
    task.run();
