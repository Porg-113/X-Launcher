  private static int moduleIndex(String id) {
    MenuModules.Module[] modules = MenuModules.modules();
    for (int index = 0; index < modules.length; index += 1) {
      if (modules[index].id.equals(id)) {
        return index;
      }
    }
    return -1;
  }

  private static void syncInfiniteZoomKeyMapping(class_310 client) {
    try {
      Class<?> infiniteZoomClient = Class.forName("de.n8M4.infinitezoom.client.InfinitezoomClient");
      Field keyField = infiniteZoomClient.getField("KEY_TOGGLE_ZOOM");
      Object currentKey = keyField.get(null);
      if (!originalInfiniteZoomKeyCaptured) {
        originalInfiniteZoomKey = currentKey;
        originalInfiniteZoomKeyCaptured = true;
      }
      MenuModules.Module module = zoomModule();
      if (module == null || module.keyCode <= 0) {
        if (originalInfiniteZoomKey != null && keyField.getType().isInstance(originalInfiniteZoomKey)
            && currentKey != originalInfiniteZoomKey) {
          keyField.set(null, originalInfiniteZoomKey);
        }
        return;
      }
      syncZoomKeyMapping(client);
      if (zoomKey != null && keyField.getType().isInstance(zoomKey) && currentKey != zoomKey) {
        keyField.set(null, zoomKey);
      }
    } catch (Throwable ignored) {
      // Infinite Zoom is optional at runtime; the launcher installs it for normal X Client profiles.
    }
  }

