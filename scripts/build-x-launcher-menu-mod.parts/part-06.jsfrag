  @Override
  public boolean method_25402(class_11909 event, boolean doubleClick) {
    if (event.method_74245() == 0) {
      if (galleryMode) {
        boolean handled = handleGalleryClick(event.comp_4798(), event.comp_4799());
        if (handled) {
          XLauncherMenuClient.playMenuClickSound();
        }
        return handled;
      }
      if (uiEditorMode) {
        boolean handled = handleUiEditorClick(event.comp_4798(), event.comp_4799());
        if (handled) {
          XLauncherMenuClient.playMenuClickSound();
        }
        return handled;
      }
      int[] layout = layout();
      if (handleHeaderClick(event.comp_4798(), event.comp_4799(), layout)) {
        XLauncherMenuClient.playMenuClickSound();
        return true;
      }
      if (isInside(event.comp_4798(), event.comp_4799(), searchX(layout), searchY(layout), searchWidth(layout), SEARCH_HEIGHT)) {
        XLauncherMenuClient.playMenuClickSound();
        selectedIndex = -1;
        capturingKey = false;
        uiEditorMode = false;
        searchFocused = true;
        codeFocused = false;
        pendingRemoveFriendUuid = null;
        return true;
      }
      if (selectedIndex >= 0) {
        boolean handled = handleDetailClick(event.comp_4798(), event.comp_4799(), layout);
        if (handled) {
          XLauncherMenuClient.playMenuClickSound();
        }
        return handled;
      }
      int index = hitModule(event.comp_4798(), event.comp_4799());
      if (index >= 0) {
        XLauncherMenuClient.playMenuClickSound();
        String moduleId = MenuModules.modules()[index].id;
        if ("ui".equals(moduleId)) {
          uiEditorMode = true;
          galleryMode = false;
          selectedIndex = -1;
          capturingKey = false;
          draggingOverlay = null;
          resizingOverlay = false;
          pendingRemoveFriendUuid = null;
          return true;
        }
        selectedIndex = index;
        searchFocused = false;
        codeFocused = "fakefps".equals(moduleId);
        capturingKey = false;
        pendingRemoveFriendUuid = null;
        if ("fakefps".equals(moduleId)) {
          codeInput = String.valueOf(MenuModules.fakeFps());
          codeStatus = "Wert wird zu den echten FPS addiert.";
        }
        return true;
      }
    }
    return false;
  }

  public boolean method_25403(class_11909 event, double dragX, double dragY) {
    if (uiEditorMode && draggingOverlay != null) {
