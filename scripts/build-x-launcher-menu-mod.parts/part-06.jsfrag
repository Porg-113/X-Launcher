  private static void updateZoomSensitivity(class_315 options) {
    if (options == null) {
      return;
    }
    Number current = getOptionNumber(options, "method_42495", "sensitivity", "mouseSensitivity", "field_1843");
    if (current == null) {
      return;
    }
    if (previousMouseSensitivity == null) {
      previousMouseSensitivity = Double.valueOf(current.doubleValue());
    }
    double base = previousMouseSensitivity.doubleValue();
    double zoom = Math.max(1.0D, currentZoomFactor);
    double target = Math.max(0.005D, Math.min(1.0D, base / zoom));
    if (Math.abs(current.doubleValue() - target) > 0.0005D) {
      forceOptionNumber(options, target, "method_42495", "sensitivity", "mouseSensitivity", "field_1843");
    }
  }

