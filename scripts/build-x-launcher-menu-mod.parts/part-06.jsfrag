  private float openProgress() {
    float raw = Math.min(1.0F, (System.currentTimeMillis() - openedMs) / 170.0F);
    return raw * raw * (3.0F - (2.0F * raw));
  }

  private float animationPhase() {
    return (System.currentTimeMillis() % 1800L) / 1800.0F;
