  private boolean drawGalleryTexture(Object graphics, ScreenshotGallery.Entry entry, int x, int y, int w, int h) {
    Object texture = ScreenshotGallery.textureId(entry, class_310.method_1551());
    if (texture == null) {
      return false;
    }
    int sourceW = Math.max(1, entry.width);
    int sourceH = Math.max(1, entry.height);
    double sourceAspect = sourceW / (double) sourceH;
    double frameAspect = Math.max(1, w) / (double) Math.max(1, h);
    int srcX = 0;
    int srcY = 0;
    int srcW = sourceW;
    int srcH = sourceH;
    if (sourceAspect > frameAspect) {
      srcW = Math.min(sourceW, Math.max(1, (int) Math.round(sourceH * frameAspect)));
      srcX = Math.max(0, (sourceW - srcW) / 2);
    } else if (sourceAspect < frameAspect) {
      srcH = Math.min(sourceH, Math.max(1, (int) Math.round(sourceW / frameAspect)));
      srcY = Math.max(0, (sourceH - srcH) / 2);
    }
    float u0 = srcX / (float) sourceW;
    float u1 = (srcX + srcW) / (float) sourceW;
    float v0 = srcY / (float) sourceH;
    float v1 = (srcY + srcH) / (float) sourceH;
    for (java.lang.reflect.Method method : graphics.getClass().getMethods()) {
      Class<?>[] types = method.getParameterTypes();
      if (types.length == 9 && types[0].isInstance(texture)
          && types[1] == Integer.TYPE && types[2] == Integer.TYPE && types[3] == Integer.TYPE && types[4] == Integer.TYPE
          && types[5] == Float.TYPE && types[6] == Float.TYPE && types[7] == Float.TYPE && types[8] == Float.TYPE) {
        try {
          method.invoke(graphics, texture, x, y, w, h, u0, u1, v0, v1);
          return true;
        } catch (Throwable ignored) {
          // Try another compatible blit method.
        }
      }
    }
    Object pipeline = renderPipeline();
    if (pipeline == null) {
      return false;
    }
    for (java.lang.reflect.Method method : graphics.getClass().getMethods()) {
      Class<?>[] types = method.getParameterTypes();
      if (types.length < 10 || !types[0].isInstance(pipeline) || !types[1].isInstance(texture)) {
        continue;
      }
      try {
