    if (module.keyModifiers != 0 && module.keyCode > 0) {
      return isKeyComboDown(client, module.keyCode, module.keyModifiers);
    }
    try {
      syncModuleKeyMappings(client);
      class_304 keyMapping = index >= 0 && index < moduleKeys.length ? moduleKeys[index] : null;
      if (keyMapping != null && keyMapping.method_1434()) {
        return true;
