  private static void syncModuleKeyMappings(class_310 client) {
    MenuModules.Module[] modules = MenuModules.modules();
    ensureModuleKeyArrays(modules.length);
    for (int index = 0; index < modules.length; index += 1) {
      MenuModules.Module module = modules[index];
      if (!module.keyBindable) {
        moduleKeys[index] = null;
        moduleKeyRegistered[index] = true;
        moduleKeyCodeSnapshots[index] = Integer.MIN_VALUE;
        continue;
      }
      int keyCode = module.keyCode > 0 ? module.keyCode : -1;
      String keyId = moduleKeyId(module);
      if (moduleKeys[index] != null && moduleKeyCodeSnapshots[index] == keyCode && isNamedKey(moduleKeys[index], keyId)) {
        continue;
      }
      moduleKeys[index] = "zoom".equals(module.id) ? new BridgedZoomKeyMapping(index, keyCode) : new ModuleKeyMapping(index, keyCode);
      moduleKeyCodeSnapshots[index] = keyCode;
      moduleKeyRegistered[index] = false;
      if ("zoom".equals(module.id)) {
        zoomKey = moduleKeys[index];
        zoomKeyCodeSnapshot = keyCode;
        zoomKeyRegistered = false;
      }
    }
  }

  private static void ensureModuleKeyArrays(int length) {
    if (moduleKeys.length == length && moduleKeyCodeSnapshots.length == length && moduleKeyRegistered.length == length) {
      return;
    }
    moduleKeys = Arrays.copyOf(moduleKeys, length);
    int oldLength = moduleKeyCodeSnapshots.length;
    moduleKeyCodeSnapshots = Arrays.copyOf(moduleKeyCodeSnapshots, length);
    moduleKeyRegistered = Arrays.copyOf(moduleKeyRegistered, length);
    for (int index = oldLength; index < length; index += 1) {
      moduleKeyCodeSnapshots[index] = Integer.MIN_VALUE;
      moduleKeyRegistered[index] = false;
    }
  }

  private static void resetModuleKeyMapping(int index) {
    ensureModuleKeyArrays(MenuModules.modules().length);
    if (index < 0 || index >= moduleKeys.length) {
      return;
    }
    moduleKeyCodeSnapshots[index] = Integer.MIN_VALUE;
    moduleKeyRegistered[index] = false;
    if ("zoom".equals(MenuModules.modules()[index].id)) {
      zoomKey = null;
      zoomKeyCodeSnapshot = Integer.MIN_VALUE;
      zoomKeyRegistered = false;
    }
  }

  private static String moduleKeyId(MenuModules.Module module) {
    return MODULE_KEY_PREFIX + module.id;
