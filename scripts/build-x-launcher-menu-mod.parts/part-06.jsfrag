  private static Class<?> wrapType(Class<?> type) {
    if (!type.isPrimitive()) {
      return type;
    }
    if (type == Double.TYPE) {
      return Double.class;
    }
    if (type == Float.TYPE) {
      return Float.class;
    }
    if (type == Integer.TYPE) {
      return Integer.class;
    }
    if (type == Long.TYPE) {
      return Long.class;
    }
    return type;
  }

  private static float clampFloat(float value, float min, float max) {
    return Math.max(min, Math.min(max, value));
  }

  private static float wrapDegrees(float value) {
    float result = value % 360.0F;
    if (result >= 180.0F) {
      result -= 360.0F;
    }
    if (result < -180.0F) {
      result += 360.0F;
    }
    return result;
  }

  private static double smoothZoomFactor(double current, double target) {
    double delta = target - current;
    if (Math.abs(delta) < 0.01D) {
      return target;
    }
    return current + (delta * MenuModules.zoomSmoothness());
  }

  private static boolean moduleEnabled(String id) {
    for (MenuModules.Module module : MenuModules.modules()) {
      if (module.id.equals(id)) {
        return MenuModules.isUnlocked(module.id) && module.enabled;
      }
    }
    return false;
  }

  private static void log(String message) {
    System.out.println("[X Client] " + message);
  }

  private static void applyModule(MenuModules.Module module) {
    class_310 client = class_310.method_1551();
    if (client == null || client.field_1690 == null) {
      return;
    }

    if ("bright".equals(module.id)) {
      updateFullbright(client);
    } else if ("weather".equals(module.id) || "time".equals(module.id)) {
      updateClientWorldOverrides(client);
    } else if ("speed".equals(module.id)) {
      updateSpeedEffect(client);
    } else if ("resistance".equals(module.id)) {
      updateResistanceEffect(client);
    } else if ("invisibility".equals(module.id)) {
      updateInvisibilityEffect(client);
    } else if ("zoom".equals(module.id)) {
      updateZoom(client);
    } else if ("flight".equals(module.id)) {
      AdminFlightModule.moduleChanged(client, module.enabled);
    }
  }

  private static void updateFullbright(class_310 client) {
    if (client == null || client.field_1690 == null) {
      return;
    }

    if (moduleEnabled("bright")) {
      if (!fullbrightApplied) {
        previousGamma = getOptionNumber(client.field_1690, "method_42473", "gamma", "getGamma", "field_1840", "method_42495");
        previousDarknessScale = getOptionNumber(client.field_1690, "darknessEffectScale", "getDarknessEffectScale", "method_42472", "field_55190");
      }
      forceOptionNumber(client.field_1690, FULLBRIGHT_GAMMA, "method_42473", "gamma", "getGamma", "field_1840", "method_42495");
      forceOptionNumber(client.field_1690, 0.0D, "darknessEffectScale", "getDarknessEffectScale", "method_42472", "field_55190");
      boostLightTexture(client);
      fullbrightApplied = true;
      return;
    }

    if (fullbrightApplied) {
      clearNightVisionEffect(client);
    }
    if (fullbrightApplied && previousGamma != null) {
      forceOptionNumber(client.field_1690, previousGamma.doubleValue(), "method_42473", "gamma", "getGamma", "field_1840", "method_42495");
      if (previousDarknessScale != null) {
        forceOptionNumber(client.field_1690, previousDarknessScale.doubleValue(), "darknessEffectScale", "getDarknessEffectScale", "method_42472", "field_55190");
      }
    }
    fullbrightApplied = false;
    previousGamma = null;
    previousDarknessScale = null;
  }

  /** Applies visual-only world settings every client tick; no packet is sent. */
  private static void updateClientWorldOverrides(class_310 client) {
    if (client == null) return;
    Object level = getAnyField(client, "field_1687", "level", "world");
    if (level == null) return;
    if (moduleEnabled("time")) {
      long ticks = switch (MenuModules.timeMode()) {
        case 0 -> 23000L;
        case 2 -> 12000L;
        case 3 -> 18000L;
        default -> 6000L;
      };
      invokeWorldNumber(level, Long.valueOf(ticks), "setTimeFromServer", "setTimeOfDay", "method_8448", "method_8430");
    }
    if (moduleEnabled("weather")) {
      int mode = MenuModules.weatherMode();
      float rain = mode == 0 ? 0.0F : 1.0F;
      float thunder = mode == 2 ? 1.0F : 0.0F;
      invokeWorldNumber(level, Float.valueOf(rain), "setRainLevel", "setRainGradient", "method_24784");
      invokeWorldNumber(level, Float.valueOf(thunder), "setThunderLevel", "setThunderGradient", "method_24785");
    }
  }

  private static boolean invokeWorldNumber(Object target, Number value, String... names) {
    if (target == null || value == null) return false;
    Class<?> type = target.getClass();
    while (type != null) {
      for (Method method : type.getDeclaredMethods()) {
        if (method.getParameterCount() != 1 || !matchesName(method.getName(), names)) continue;
        Object argument = numericArgument(value, method.getParameterTypes()[0]);
        if (argument == null) continue;
        try {
          method.setAccessible(true);
          method.invoke(target, argument);
          return true;
        } catch (Throwable ignored) {
          // Continue with the alternate runtime mapping.
        }
      }
      type = type.getSuperclass();
    }
    return false;
  }

  private static boolean matchesName(String candidate, String... names) {
