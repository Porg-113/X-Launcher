  const iconTarget = path.join(resourcesDir, 'assets', 'x-client', 'icon.png');
  if (fs.existsSync(MOD_ICON_SOURCE)) {
    ensureDir(path.dirname(iconTarget));
    fs.copyFileSync(MOD_ICON_SOURCE, iconTarget);
  }
  const backgroundTarget = path.join(resourcesDir, 'assets', 'x-client', 'textures', 'gui', 'menu_blur.png');
  if (fs.existsSync(MOD_MENU_BACKGROUND_SOURCE)) {
    ensureDir(path.dirname(backgroundTarget));
    fs.copyFileSync(MOD_MENU_BACKGROUND_SOURCE, backgroundTarget);
  }
  for (const [source, fileName] of [
    [MOD_FAVORITE_ICON_SOURCE, 'favorite_star.png'],
    [MOD_PICTURES_ICON_SOURCE, 'pictures_square.png']
  ]) {
    if (!fs.existsSync(source)) continue;
    const target = path.join(resourcesDir, 'assets', 'x-client', 'textures', 'gui', fileName);
    ensureDir(path.dirname(target));
    fs.copyFileSync(source, target);
  }
  const keySoundNames = ['alpaca', 'blackink', 'bluealps', 'boxnavy', 'cream', 'holypanda', 'mxblack', 'mxblue', 'mxbrown', 'redink', 'topre', 'turquoise'];
  const soundDefinitions = {};
  for (let index = 0; index < keySoundNames.length; index += 1) {
    const name = keySoundNames[index];
    const source = path.join(MOD_KEY_SOUND_SOURCE, `${name}.mp3`);
    if (!fs.existsSync(source)) throw new Error(`Missing X Client key sound: ${source}`);
    const target = path.join(resourcesDir, 'assets', 'x-client', 'sounds', 'keyboard', `${name}.ogg`);
    ensureDir(path.dirname(target));
    run(FFMPEG_PATH, ['-y', '-i', source, '-acodec', 'libvorbis', '-q:a', '5', target]);
    soundDefinitions[`keyboard.${index + 1}`] = { sounds: [`x-client:keyboard/${name}`] };
  }
  writeFile(path.join(resourcesDir, 'assets', 'x-client', 'sounds.json'), `${JSON.stringify(soundDefinitions, null, 2)}\n`);
}

const commonSources = {
  'dev/xlauncher/client/XAdminFlightProtocol.java': String.raw`
package dev.xlauncher.client;

import net.minecraft.network.RegistryFriendlyByteBuf;
import net.minecraft.network.codec.ByteBufCodecs;
import net.minecraft.network.codec.StreamCodec;
import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
import net.minecraft.resources.Identifier;

public final class XAdminFlightProtocol {
  public static final CustomPacketPayload.Type<FlightRequest> REQUEST_TYPE =
      new CustomPacketPayload.Type<>(Identifier.fromNamespaceAndPath("x-client", "admin_flight_request"));
  public static final CustomPacketPayload.Type<FlightAuthorization> AUTHORIZATION_TYPE =
      new CustomPacketPayload.Type<>(Identifier.fromNamespaceAndPath("x-client", "admin_flight_authorization"));
  public static final StreamCodec<RegistryFriendlyByteBuf, FlightRequest> REQUEST_CODEC = StreamCodec.composite(
      ByteBufCodecs.BOOL, FlightRequest::enable, FlightRequest::new);
  public static final StreamCodec<RegistryFriendlyByteBuf, FlightAuthorization> AUTHORIZATION_CODEC = StreamCodec.composite(
      ByteBufCodecs.BOOL, FlightAuthorization::authorized, FlightAuthorization::new);

  private XAdminFlightProtocol() {}

  public record FlightRequest(boolean enable) implements CustomPacketPayload {
    @Override public Type<? extends CustomPacketPayload> type() { return REQUEST_TYPE; }
  }

  public record FlightAuthorization(boolean authorized) implements CustomPacketPayload {
    @Override public Type<? extends CustomPacketPayload> type() { return AUTHORIZATION_TYPE; }
  }
}
`,
  'dev/xlauncher/client/XAdminFlightServer.java': String.raw`
package dev.xlauncher.client;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.HashMap;
import java.util.HashSet;
import java.util.Map;
import java.util.Set;
import java.util.UUID;
import net.fabricmc.api.ModInitializer;
import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
import net.fabricmc.fabric.api.networking.v1.ServerPlayConnectionEvents;
import net.fabricmc.fabric.api.networking.v1.ServerPlayNetworking;
import net.fabricmc.loader.api.FabricLoader;
import net.minecraft.server.level.ServerPlayer;

public final class XAdminFlightServer implements ModInitializer {
  private static final Path FLIGHT_PERMISSION_FILE = FabricLoader.getInstance().getConfigDir().resolve("x-client-flight-players.txt");
  private static final Set<UUID> AUTHORIZED = new HashSet<>();
  private static final Map<UUID, Boolean> ORIGINAL_MAYFLY = new HashMap<>();
  private static final Map<UUID, Boolean> ORIGINAL_FLYING = new HashMap<>();

  @Override
  public void onInitialize() {
    PayloadTypeRegistry.serverboundPlay().register(XAdminFlightProtocol.REQUEST_TYPE, XAdminFlightProtocol.REQUEST_CODEC);
    PayloadTypeRegistry.clientboundPlay().register(XAdminFlightProtocol.AUTHORIZATION_TYPE, XAdminFlightProtocol.AUTHORIZATION_CODEC);
    ServerPlayNetworking.registerGlobalReceiver(XAdminFlightProtocol.REQUEST_TYPE, (payload, context) ->
        context.server().execute(() -> handleRequest(context.server(), context.player(), payload.enable())));
    ServerPlayConnectionEvents.DISCONNECT.register((handler, server) -> revoke(handler.player));
  }

  private static void handleRequest(net.minecraft.server.MinecraftServer server, ServerPlayer player, boolean enable) {
    if (player == null) {
        return;
    }

    UUID uuid = player.getUUID();

    if (!enable) {
        revoke(player);
        ServerPlayNetworking.send(
            player,
            new XAdminFlightProtocol.FlightAuthorization(false)
        );
        return;
    }

    if (!isFlightAuthorized(server, uuid)) {
        ServerPlayNetworking.send(
            player,
            new XAdminFlightProtocol.FlightAuthorization(false)
        );
        return;
    }

    ORIGINAL_MAYFLY.putIfAbsent(uuid, player.getAbilities().mayfly);
    ORIGINAL_FLYING.putIfAbsent(uuid, player.getAbilities().flying);

    AUTHORIZED.add(uuid);

    player.getAbilities().mayfly = true;
    player.getAbilities().flying = true;
    player.onUpdateAbilities();

    ServerPlayNetworking.send(
        player,
        new XAdminFlightProtocol.FlightAuthorization(true)
    );
}

  private static void revoke(ServerPlayer player) {
    if (player == null) return;
    UUID uuid = player.getUUID();
    if (!AUTHORIZED.remove(uuid)) return;
    boolean original = ORIGINAL_MAYFLY.remove(uuid) == Boolean.TRUE;
    boolean originalFlying = ORIGINAL_FLYING.remove(uuid) == Boolean.TRUE;
    player.getAbilities().flying = originalFlying;
    player.getAbilities().mayfly = original;
    player.resetFallDistance();
    player.onUpdateAbilities();
  }

  private static boolean isFlightAuthorized(net.minecraft.server.MinecraftServer server, UUID uuid) {
    if (!server.isDedicatedServer()
        && server.getSingleplayerProfile() != null
      && uuid.equals(server.getSingleplayerProfile().id())) {
      return true;
    }
    try {
      if (!Files.exists(FLIGHT_PERMISSION_FILE)) return false;
      String expected = uuid.toString().replace("-", "").toUpperCase(java.util.Locale.ROOT);
      for (String rawLine : Files.readAllLines(FLIGHT_PERMISSION_FILE, StandardCharsets.UTF_8)) {
        String line = rawLine.trim();
        if (line.isEmpty() || line.startsWith("#")) continue;
        String configured = line.replace("-", "").toUpperCase(java.util.Locale.ROOT);
        if (expected.equals(configured)) return true;
      }
    } catch (IOException ignored) {
      return false;
    }
    return false;
  }
}
`,
  'dev/xlauncher/client/AdminFlightModule.java': String.raw`
package dev.xlauncher.client;

import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
import net.minecraft.client.Minecraft;
import net.minecraft.client.player.LocalPlayer;
import net.minecraft.network.chat.Component;
import net.minecraft.world.entity.player.Abilities;
import net.minecraft.world.phys.Vec3;

final class AdminFlightModule {
  private static Object sessionLevel;
  private static boolean requested;
  private static boolean authorized;
  private static boolean applied;
  private static boolean originalMayfly;
  private static boolean originalFlying;
  private static float originalFlyingSpeed;

  private AdminFlightModule() {}

  static void register() {
    ClientPlayNetworking.registerGlobalReceiver(XAdminFlightProtocol.AUTHORIZATION_TYPE, (payload, context) ->
        context.client().execute(() -> acceptAuthorization(context.client(), payload.authorized())));
  }

  static void tick(Minecraft client) {
    if (client.level != sessionLevel) {
      disable(client, false);
      sessionLevel = client.level;
      requested = false;
      authorized = false;
    }
    LocalPlayer player = client.player;
    boolean selected = MenuModules.enabled("flight");
    if (player == null || client.level == null || !selected) {
      disable(client, selected);
      return;
    }
    if (!authorized) {
      if (!requested && ClientPlayNetworking.canSend(XAdminFlightProtocol.REQUEST_TYPE)) {
        requested = true;
        ClientPlayNetworking.send(new XAdminFlightProtocol.FlightRequest(true));
      }
      return;
    }
    if (!applied) {
      Abilities abilities = player.getAbilities();
      originalMayfly = abilities.mayfly;
      originalFlying = abilities.flying;
      originalFlyingSpeed = abilities.getFlyingSpeed();
      abilities.mayfly = true;
      abilities.flying = true;
      player.onUpdateAbilities();
      applied = true;
      notify(player, "X Client Flight: ON");
    }
    applyMovement(client, player);
  }

  static void moduleChanged(Minecraft client, boolean enabled) {
    if (!enabled) disable(client, true);
  }

  private static void acceptAuthorization(Minecraft client, boolean value) {
    authorized = value;
    if (!value) rejectConfiguredModule(client, "X Client Flight authorization denied");
  }

  private static void applyMovement(Minecraft client, LocalPlayer player) {
    double forward = (client.options.keyUp.isDown() ? 1.0D : 0.0D) - (client.options.keyDown.isDown() ? 1.0D : 0.0D);
    double strafe = (client.options.keyRight.isDown() ? 1.0D : 0.0D) - (client.options.keyLeft.isDown() ? 1.0D : 0.0D);
    double vertical = (client.options.keyJump.isDown() ? 1.0D : 0.0D) - (client.options.keyShift.isDown() ? 1.0D : 0.0D);
    double length = Math.sqrt((forward * forward) + (strafe * strafe));
    if (length > 1.0D) { forward /= length; strafe /= length; }
    double yaw = Math.toRadians(player.getYRot());
    double speed = MenuModules.flightSpeedBlocksPerTick();
    double x = ((-Math.sin(yaw) * forward) + (Math.cos(yaw) * strafe)) * speed;
    double z = ((Math.cos(yaw) * forward) + (Math.sin(yaw) * strafe)) * speed;
    player.setDeltaMovement(new Vec3(x, vertical * speed, z));
    player.fallDistance = 0.0D;
    player.getAbilities().mayfly = true;
    player.getAbilities().flying = true;
  }

  private static void rejectConfiguredModule(Minecraft client, String reason) {
    MenuModules.setEnabledById("flight", false);
    disable(client, false);
    if (client.player != null) notify(client.player, "X Client Flight: OFF (" + reason + ")");
  }

  private static void disable(Minecraft client, boolean notifyOff) {
    if (requested && client.player != null && ClientPlayNetworking.canSend(XAdminFlightProtocol.REQUEST_TYPE)) {
      ClientPlayNetworking.send(new XAdminFlightProtocol.FlightRequest(false));
    }
    requested = false;
    authorized = false;
    LocalPlayer player = client.player;
    if (applied && player != null) {
      Abilities abilities = player.getAbilities();
      abilities.flying = originalFlying;
      abilities.mayfly = originalMayfly;
      abilities.setFlyingSpeed(originalFlyingSpeed);
      player.setDeltaMovement(Vec3.ZERO);
      player.fallDistance = 0.0D;
      player.onUpdateAbilities();
      if (notifyOff) notify(player, "X Client Flight: OFF");
    }
    applied = false;
  }

  private static void notify(LocalPlayer player, String message) {
    player.sendOverlayMessage(Component.literal(message));
  }
}
