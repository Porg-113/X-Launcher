  private static boolean physicalForwardDown(Object client) {
    try {
      Object window = invokeValue(client, new String[] { "getWindow", "method_22683" });
      Object handle = invokeValue(window, new String[] { "getWindow", "handle", "method_4490" });
      if (!(handle instanceof Number number)) return false;
