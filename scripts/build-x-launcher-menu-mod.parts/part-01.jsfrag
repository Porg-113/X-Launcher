    injectors: {
      defaultRequire: 0
    }
  }, null, 2)}\n`);
  writeFile(path.join(resourcesDir, 'assets', 'x-client', 'lang', 'en_us.json'), `${JSON.stringify({
    'key.category.x-client.keybinds': 'X Client',
    'key.xclient.menu': 'Open Menu',
