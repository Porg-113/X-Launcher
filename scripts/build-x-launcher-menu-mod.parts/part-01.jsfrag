    for (String name : names) try { if (Class.forName(name).isInstance(value)) return true; } catch (Throwable ignored) {}
    return false;
  }

  private static void setForward(Object client, boolean down) {
    Object options = field(client, "options", "field_1690");
    Object key = field(options, "keyUp", "forwardKey", "field_1894");
    invoke(key, new String[] { "setDown", "setPressed", "method_1416" }, down);
