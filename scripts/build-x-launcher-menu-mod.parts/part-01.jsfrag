package dev.xlauncher.client;

import java.io.File;
import java.io.InputStream;
import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.concurrent.ConcurrentHashMap;
import java.util.function.Supplier;
import javax.imageio.ImageIO;
import javax.imageio.ImageReader;
import javax.imageio.stream.ImageInputStream;

final class ScreenshotGallery {
  private static final int MAX_ENTRIES = 60;
  private static final long REFRESH_INTERVAL_MS = 5000L;
  private static final Object LOAD_LOCK = new Object();
  private static final Map<String, TextureHandle> TEXTURES = new ConcurrentHashMap<>();
  private static volatile List<Entry> cachedEntries = List.of();
  private static volatile long nextRefreshMs;
  private static volatile boolean loading;
  private static volatile boolean refreshAfterLoad;
  private static volatile Path lastLoadDir;

  private ScreenshotGallery() {
  }

  static List<Entry> entries(Object client) {
    long now = System.currentTimeMillis();
    if (now >= nextRefreshMs) {
      scheduleLoad(screenshotsDir(client), false);
    }
    return cachedEntries;
  }

  static void refresh(Object client) {
    scheduleLoad(screenshotsDir(client), true);
  }

  static boolean isLoading() {
    return loading;
  }

  private static void scheduleLoad(Path dir, boolean force) {
    if (dir == null || !Files.isDirectory(dir)) {
      cachedEntries = List.of();
      nextRefreshMs = System.currentTimeMillis() + REFRESH_INTERVAL_MS;
      return;
    }
    long now = System.currentTimeMillis();
    if (!force && now < nextRefreshMs && !cachedEntries.isEmpty()) {
      return;
    }
    synchronized (LOAD_LOCK) {
      lastLoadDir = dir;
      if (loading) {
        refreshAfterLoad = true;
        return;
      }
      loading = true;
      nextRefreshMs = now + REFRESH_INTERVAL_MS;
    }
    Thread worker = new Thread(() -> {
      try {
        cachedEntries = load(dir);
      } finally {
        Path retryDir = null;
        synchronized (LOAD_LOCK) {
          loading = false;
          if (refreshAfterLoad) {
            refreshAfterLoad = false;
            retryDir = lastLoadDir;
          }
        }
        if (retryDir != null) {
          scheduleLoad(retryDir, true);
        }
      }
    }, "X Client Screenshot Gallery");
    worker.setDaemon(true);
    worker.start();
  }

  private static List<Entry> load(Path dir) {
    if (dir == null || !Files.isDirectory(dir)) {
      return List.of();
    }
    try (var stream = Files.list(dir)) {
      List<Path> files = stream
          .filter(Files::isRegularFile)
          .filter(path -> path.getFileName().toString().toLowerCase(Locale.ROOT).endsWith(".png"))
          .sorted(Comparator.comparingLong(ScreenshotGallery::modifiedMs).reversed())
          .limit(MAX_ENTRIES)
          .toList();
      List<Entry> entries = new ArrayList<>();
      for (Path file : files) {
        Entry entry = readEntry(file);
        if (entry != null) {
          entries.add(entry);
        }
      }
      return List.copyOf(entries);
    } catch (Throwable ignored) {
      return List.of();
    }
  }

  private static Entry readEntry(Path file) {
    try {
      long modified = modifiedMs(file);
      long size = Files.size(file);
      int[] dimensions = dimensions(file);
      return new Entry(file, file.getFileName().toString(), modified, size, dimensions[0], dimensions[1]);
    } catch (Throwable ignored) {
      return null;
    }
  }

  private static int[] dimensions(Path file) {
    try (ImageInputStream input = ImageIO.createImageInputStream(file.toFile())) {
      if (input == null) {
        return new int[] { 0, 0 };
      }
      var readers = ImageIO.getImageReaders(input);
      if (!readers.hasNext()) {
        return new int[] { 0, 0 };
      }
      ImageReader reader = readers.next();
      try {
        reader.setInput(input, true, true);
        return new int[] { reader.getWidth(0), reader.getHeight(0) };
      } finally {
        reader.dispose();
      }
    } catch (Throwable ignored) {
      return new int[] { 0, 0 };
    }
  }

  static Object textureId(Entry entry, Object client) {
    if (entry == null || entry.path == null || client == null) {
      return null;
    }
    String key = textureKey(entry);
    TextureHandle handle = TEXTURES.computeIfAbsent(key, ignored -> new TextureHandle(entry.path, entry.modifiedMs));
    Object existingId = handle.textureId;
    if (existingId != null) {
      return existingId;
    }
    Object nativeImage = handle.nativeImage;
    if (nativeImage != null) {
      Object registered = registerTexture(client, key, nativeImage);
      if (registered != null) {
        handle.textureId = registered;
        handle.nativeImage = null;
        return registered;
      }
    }
    if (!handle.loading && !handle.failed) {
      handle.loading = true;
      Thread worker = new Thread(() -> {
        try {
          handle.nativeImage = readNativeImage(handle.path);
          if (handle.nativeImage == null) {
            handle.failed = true;
          }
        } catch (Throwable ignored) {
          handle.failed = true;
        } finally {
          handle.loading = false;
        }
      }, "X Client Screenshot Texture");
      worker.setDaemon(true);
      worker.start();
    }
    return null;
  }

  static boolean textureLoading(Entry entry) {
    if (entry == null) {
      return false;
    }
    TextureHandle handle = TEXTURES.get(textureKey(entry));
    return handle != null && handle.loading;
  }

  private static Object readNativeImage(Path path) {
    Class<?> nativeImageClass = classForNames(
        "com.mojang.blaze3d.platform.NativeImage",
        "net.minecraft.class_1011");
    if (nativeImageClass == null) {
      return null;
    }
    try (InputStream input = Files.newInputStream(path)) {
      Method read = nativeImageClass.getMethod("read", InputStream.class);
      return read.invoke(null, input);
    } catch (Throwable ignored) {
      return null;
    }
  }

  private static Object registerTexture(Object client, String key, Object nativeImage) {
    Object textureManager = textureManager(client);
    if (textureManager == null || nativeImage == null) {
      return null;
    }
    Object texture = dynamicTexture(nativeImage);
    if (texture == null) {
      return null;
    }
    applyHighQualityFiltering(texture);
    Object id = identifier("x-client", "screenshots/" + safeId(key));
    if (id == null) {
      return null;
    }
    for (Method method : textureManager.getClass().getMethods()) {
      if (method.getParameterCount() != 2) {
        continue;
      }
      Class<?>[] types = method.getParameterTypes();
      if (!types[0].isInstance(id) || !types[1].isInstance(texture)) {
        continue;
      }
      try {
        method.invoke(textureManager, id, texture);
        return id;
      } catch (Throwable ignored) {
        // Try the next texture manager registration signature.
      }
    }
    closeQuietly(texture);
    return null;
  }

  private static Object dynamicTexture(Object nativeImage) {
    Class<?> dynamicTextureClass = classForNames(
        "net.minecraft.client.renderer.texture.DynamicTexture",
        "net.minecraft.class_1043");
    if (dynamicTextureClass == null) {
      return null;
    }
    for (var constructor : dynamicTextureClass.getConstructors()) {
