  'dev/xlauncher/client/OwnerAccess.java': String.raw`
package dev.xlauncher.client;

import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Locale;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

final class OwnerAccess {
  private static final String OWNER_UUID = "990911BD9C284FC69ED6A7C9E231C1F2";
  private static long lastReadMs;
  private static String permissionState = "";

  private OwnerAccess() {}

  static boolean hasPermission() {
    return OWNER_UUID.equals(normalize(System.getProperty("xclient.accountUuid", "")));
  }

  static boolean hasPermission(String moduleId) {
    if (hasPermission()) return true;
    String target = String.valueOf(moduleId == null ? "" : moduleId).trim().toLowerCase(Locale.ROOT);
    refreshPermissions();
    String uuid = normalize(System.getProperty("xclient.accountUuid", ""));
    if (uuid.isEmpty() || target.isEmpty()) return false;
    Matcher player = Pattern.compile("\\\"" + Pattern.quote(uuid) + "\\\"\\s*:\\s*\\{([^}]*)\\}", Pattern.CASE_INSENSITIVE | Pattern.DOTALL).matcher(permissionState);
    if (!player.find()) return false;
    return Pattern.compile("\\\"xclient_" + Pattern.quote(target) + "\\\"\\s*:\\s*true", Pattern.CASE_INSENSITIVE).matcher(player.group(1)).find();
  }

  private static void refreshPermissions() {
    long now = System.currentTimeMillis();
    if (now - lastReadMs < 500L) return;
    lastReadMs = now;
    try {
      String appData = System.getenv("APPDATA");
      if (appData == null || appData.isBlank()) appData = Path.of(System.getProperty("user.home"), "AppData", "Roaming").toString();
      Path path = Path.of(appData, ".minecraft-launcher", "admin-directory.json");
      permissionState = Files.exists(path) ? Files.readString(path, StandardCharsets.UTF_8) : "";
    } catch (Exception ignored) {
      permissionState = "";
    }
  }

  private static String normalize(String uuid) {
    return String.valueOf(uuid == null ? "" : uuid)
        .replace("-", "")
        .trim()
        .toUpperCase(Locale.ROOT);
  }
}
