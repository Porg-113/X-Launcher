  'dev/xlauncher/client/ServerModulePolicy.java': String.raw`
package dev.xlauncher.client;

import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.LinkedHashMap;
import java.util.LinkedHashSet;
import java.util.Locale;
import java.util.Map;
import java.util.Set;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * Applies address-specific X Client module rules without changing the user's
 * persistent module choices. Rules live in x-client-server-rules.json.
 */
public final class ServerModulePolicy {
  private static final Pattern RULE_PATTERN = Pattern.compile("\"([^\"]+)\"\\s*:\\s*\\[(.*?)\\]", Pattern.DOTALL);
  private static final Pattern STRING_PATTERN = Pattern.compile("\"([^\"]+)\"");
  // Ordinary multiplayer must not silently override persisted toggles. Server
  // owners can still block modules through x-client-server-rules.json.
  private static final Set<String> DEFAULT_MULTIPLAYER_BLOCKS = Set.of(
      "speed", "resistance", "invisibility");
  private static final Map<String, Set<String>> RULES = new LinkedHashMap<>();
  private static final Map<String, Boolean> PREFERRED = new LinkedHashMap<>();
  private static boolean loaded;
  private static String activeServer = "";
  private static Set<String> blocked = Set.of();

  private ServerModulePolicy() {
  }

  public static synchronized void tick(Object client) {
    load();
    String server = currentServerAddress(client);
    if (server.equals(activeServer)) {
      enforce();
      return;
    }
    restore();
    activeServer = server;
    blocked = server.isEmpty() ? Set.of() : blockedFor(server);
    if (!blocked.isEmpty()) {
      for (MenuModules.Module module : MenuModules.modules()) {
        if (blocked.contains(module.id)) {
          PREFERRED.put(module.id, module.enabled);
          module.enabled = false;
          module.keyDown = false;
        }
      }
    }
  }

  static synchronized boolean isBlocked(String moduleId) {
    return blocked.contains(moduleId);
  }

  static synchronized boolean preferredEnabled(MenuModules.Module module) {
    if (module == null) {
      return false;
    }
    Boolean preferred = PREFERRED.get(module.id);
    return preferred != null ? preferred.booleanValue() : module.enabled;
  }

  static synchronized String activeServer() {
    return activeServer;
  }

  static synchronized Set<String> blockedModules() {
    return Set.copyOf(blocked);
  }

  private static void enforce() {
    if (blocked.isEmpty()) {
      return;
    }
    for (MenuModules.Module module : MenuModules.modules()) {
      if (blocked.contains(module.id)) {
        module.enabled = false;
        module.keyDown = false;
      }
    }
  }

  private static void restore() {
    if (PREFERRED.isEmpty()) {
      return;
    }
    for (MenuModules.Module module : MenuModules.modules()) {
      Boolean enabled = PREFERRED.get(module.id);
      if (enabled != null) {
        module.enabled = enabled.booleanValue();
        module.keyDown = false;
      }
    }
    PREFERRED.clear();
  }

  private static Set<String> blockedFor(String server) {
    Set<String> result = new LinkedHashSet<>();
    for (Map.Entry<String, Set<String>> entry : RULES.entrySet()) {
      if (matches(entry.getKey(), server)) {
        result.addAll(entry.getValue());
      }
    }
    return Set.copyOf(result);
  }

  private static boolean matches(String pattern, String server) {
    String rule = normalizeAddress(pattern);
    if ("*".equals(rule)) {
      return true;
    }
    if (rule.startsWith("*.")) {
      String suffix = rule.substring(1);
      return server.endsWith(suffix) || server.equals(rule.substring(2));
    }
    return server.equals(rule);
  }

  private static void load() {
    if (loaded) {
      return;
    }
    loaded = true;
    Path path = rulesPath();
    try {
      if (!Files.exists(path)) {
        Files.createDirectories(path.getParent());
        Files.writeString(path,
            "{\n"
            + "  \"*\": [\"speed\", \"resistance\", \"invisibility\"],\n"
            + "  \"example.org\": [\"hitboxes\"]\n"
            + "}\n",
            StandardCharsets.UTF_8);
      }
      String json = Files.readString(path, StandardCharsets.UTF_8);
      Matcher ruleMatcher = RULE_PATTERN.matcher(json);
      while (ruleMatcher.find()) {
        String address = normalizeAddress(ruleMatcher.group(1));
        Set<String> ids = new LinkedHashSet<>();
        Matcher idMatcher = STRING_PATTERN.matcher(ruleMatcher.group(2));
        while (idMatcher.find()) {
          ids.add(idMatcher.group(1).trim().toLowerCase(Locale.ROOT));
        }
        // Migrate the launcher-created legacy wildcard. Address-specific rules
        // remain authoritative and can still explicitly block these modules.
        if ("*".equals(address) && ids.containsAll(Set.of(
            "mobtrack", "ghostblocks", "speed", "resistance", "invisibility"))) {
          ids.remove("mobtrack");
          ids.remove("ghostblocks");
        }
        if (!address.isEmpty()) {
          RULES.put(address, Set.copyOf(ids));
        }
      }
      if (RULES.isEmpty()) {
        RULES.put("*", DEFAULT_MULTIPLAYER_BLOCKS);
      }
    } catch (Throwable ignored) {
      RULES.clear();
      RULES.put("*", DEFAULT_MULTIPLAYER_BLOCKS);
