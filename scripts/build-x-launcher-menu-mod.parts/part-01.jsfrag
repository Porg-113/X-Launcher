  'dev/xlauncher/client/LauncherTheme.java': String.raw`
package dev.xlauncher.client;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public final class LauncherTheme {
  private static final Pattern PRIMARY_COLOR_PATTERN = Pattern.compile("\"primaryColor\"\\s*:\\s*\"(#[0-9a-fA-F]{6})\"");
  private static final Pattern HIGHLIGHT_COLOR_PATTERN = Pattern.compile("\"highlightColor\"\\s*:\\s*\"(#[0-9a-fA-F]{6})\"");
  private static final Pattern PANEL_COLOR_PATTERN = Pattern.compile("\"panelColor\"\\s*:\\s*\"(#[0-9a-fA-F]{6})\"");
  private static final Pattern BUTTON_COLOR_PATTERN = Pattern.compile("\"buttonColor\"\\s*:\\s*\"(#[0-9a-fA-F]{6})\"");
  private static final Pattern BORDER_COLOR_PATTERN = Pattern.compile("\"borderColor\"\\s*:\\s*\"(#[0-9a-fA-F]{6})\"");
  private static final Pattern HOVER_COLOR_PATTERN = Pattern.compile("\"hoverColor\"\\s*:\\s*\"(#[0-9a-fA-F]{6})\"");
  private static final Pattern APPEARANCE_MODE_PATTERN = Pattern.compile("\"appearanceMode\"\\s*:\\s*\"(light|dark)\"");
  private static final int DEFAULT_ACCENT = 0x00D9FF;
  private static final String DEFAULT_APPEARANCE_MODE = "dark";
  // Theme files are launcher state, not frame state. Polling the filesystem at
  // refresh rate causes avoidable I/O jitter, especially on synced folders.
  private static final long CHECK_INTERVAL_MS = 1000L;
  private static long lastCheckMs;
  private static long lastLiveModifiedMs = -2L;
  private static long lastConfigModifiedMs = -2L;
  private static boolean lastSourceWasLive;
  private static int accent = DEFAULT_ACCENT;
  private static int highlight = 0x78B8FF;
  private static int panel = 0x111A26;
  private static int button = 0x182536;
  private static int border = 0x34475D;
  private static int hover = 0x22354B;
  private static String appearanceMode = DEFAULT_APPEARANCE_MODE;

  private LauncherTheme() {
  }

  public static int accent() {
    return accent;
  }

  static int secondColor() {
    return panel;
  }

  static int highlightArgb(int alpha) { return rawArgb(alpha, highlight); }
  static int buttonArgb(int alpha) { return rawArgb(alpha, button); }
  static int borderArgb(int alpha) { return rawArgb(alpha, border); }
  static int hoverArgb(int alpha) { return rawArgb(alpha, hover); }

  static int argb(int alpha, int rgb) {
    refresh();
    return ((alpha & 0xFF) << 24) | themeRgb(rgb);
  }

  static int accentArgb(int alpha) {
    return rawArgb(alpha, accent());
  }

  static int secondArgb(int alpha) {
    return rawArgb(alpha, secondColor());
  }

  static int rawArgb(int alpha, int rgb) {
    return ((alpha & 0xFF) << 24) | (rgb & 0xFFFFFF);
  }

  static int textColor() {
    return 0xFFFFFFFF;
  }

  static int mutedTextColor() {
    return 0xFFFFFFFF;
  }

  static int accentTextColor() {
    return 0xFF000000 | accent();
  }

  static int textOnAccentColor() {
    int color = accent();
    int red = (color >> 16) & 0xFF;
    int green = (color >> 8) & 0xFF;
    int blue = color & 0xFF;
    int luminance = (red * 299) + (green * 587) + (blue * 114);
    return luminance >= 150000 ? 0xFF050708 : 0xFFFFFFFF;
  }

  static boolean isLightMode() {
    refresh();
    return isLightModeNow();
  }

  static void toggleAppearanceMode() {
    setAppearanceMode("dark");
  }

  static int pixelIconColor() {
    return 0xFF000000 | accent();
  }

  static int pixelIconAltColor() {
    return 0xFF000000;
  }

  private static void refresh() {
    long now = System.currentTimeMillis();
    if (now - lastCheckMs < CHECK_INTERVAL_MS) {
      return;
    }
    lastCheckMs = now;

    Path liveThemePath = getLiveThemePath();
    Path configPath = getConfigPath();
    try {
      if (Files.exists(liveThemePath)) {
        long liveModified = Files.getLastModifiedTime(liveThemePath).toMillis();
        if (lastSourceWasLive && liveModified == lastLiveModifiedMs) {
          return;
        }
        String liveConfig = Files.readString(liveThemePath, StandardCharsets.UTF_8);
        int liveAccent = readAccent(liveConfig);
        if (liveAccent >= 0) {
          lastSourceWasLive = true;
          lastLiveModifiedMs = liveModified;
          accent = liveAccent;
        }
        readPalette(liveConfig);
        appearanceMode = readAppearanceMode(liveConfig, appearanceMode);
        return;
      }

      long configModified = Files.exists(configPath) ? Files.getLastModifiedTime(configPath).toMillis() : -1L;
      if (!lastSourceWasLive && configModified == lastConfigModifiedMs) {
        return;
      }
      lastSourceWasLive = false;
      lastConfigModifiedMs = configModified;
      if (configModified < 0L) {
        accent = DEFAULT_ACCENT;
        appearanceMode = DEFAULT_APPEARANCE_MODE;
        return;
      }

      String config = Files.readString(configPath, StandardCharsets.UTF_8);
      int configAccent = readAccent(config);
      accent = configAccent >= 0 ? configAccent : DEFAULT_ACCENT;
      readPalette(config);
      appearanceMode = readAppearanceMode(config, DEFAULT_APPEARANCE_MODE);
    } catch (IOException | RuntimeException ignored) {
      // Keep the last valid accent. The launcher may be updating the live file right now.
    }
  }

  private static int readAccent(String config) {
    Matcher matcher = PRIMARY_COLOR_PATTERN.matcher(config);
    return matcher.find() ? parseHexColor(matcher.group(1)) : -1;
  }

  private static int readColor(Pattern pattern, String config, int fallback) {
    Matcher matcher = pattern.matcher(config);
    int value = matcher.find() ? parseHexColor(matcher.group(1)) : -1;
    return value >= 0 ? value : fallback;
  }

  private static void readPalette(String config) {
    highlight = readColor(HIGHLIGHT_COLOR_PATTERN, config, highlight);
    panel = readColor(PANEL_COLOR_PATTERN, config, panel);
    button = readColor(BUTTON_COLOR_PATTERN, config, button);
    border = readColor(BORDER_COLOR_PATTERN, config, border);
    hover = readColor(HOVER_COLOR_PATTERN, config, hover);
  }

  private static String readAppearanceMode(String config, String fallback) {
    Matcher matcher = APPEARANCE_MODE_PATTERN.matcher(config);
    return matcher.find() ? normalizeAppearanceMode(matcher.group(1)) : normalizeAppearanceMode(fallback);
  }

  private static boolean isLightModeNow() {
    return "light".equals(appearanceMode);
  }

  private static int themeRgb(int rgb) {
    int value = rgb & 0xFFFFFF;
    int activeAccent = accent();
    if (value == 0xFFFFFF || value == (activeAccent & 0xFFFFFF)) {
      return value;
    }
    int red = (value >> 16) & 0xFF;
    int green = (value >> 8) & 0xFF;
    int blue = value & 0xFF;
    int max = Math.max(red, Math.max(green, blue));
    int min = Math.min(red, Math.min(green, blue));
    if (max - min > 42 && max > 70) {
      return value;
    }
    int accentValue = activeAccent & 0xFFFFFF;
    int accentRed = (accentValue >> 16) & 0xFF;
    int accentGreen = (accentValue >> 8) & 0xFF;
    int accentBlue = accentValue & 0xFF;
    if (isLightModeNow()) {
      int level = Math.max(220, 252 - (max / 7));
      red = ((level * 88) + (accentRed * 12)) / 100;
      green = ((level * 88) + (accentGreen * 12)) / 100;
      blue = ((level * 88) + (accentBlue * 12)) / 100;
    } else {
      red = ((red * 84) + (accentRed * 16)) / 100;
      green = ((green * 84) + (accentGreen * 16)) / 100;
      blue = ((blue * 84) + (accentBlue * 16)) / 100;
    }
    return (red << 16) | (green << 8) | blue;
  }

  private static void setAppearanceMode(String value) {
    appearanceMode = normalizeAppearanceMode(value);
    try {
      writeThemeState();
    } catch (IOException | RuntimeException ignored) {
      // The menu still changes immediately in memory; the launcher will resync on the next successful write.
    }
  }

  private static void writeThemeState() throws IOException {
    Path liveThemePath = getLiveThemePath();
    String mode = normalizeAppearanceMode(appearanceMode);
    Files.createDirectories(liveThemePath.getParent());
    String color = String.format(java.util.Locale.ROOT, "#%06x", accent() & 0xFFFFFF);
    Files.writeString(liveThemePath, "{\"primaryColor\":\"" + color + "\",\"appearanceMode\":\"" + mode
        + "\",\"lightMode\":" + ("light".equals(mode) ? "true" : "false")
        + ",\"updatedAt\":\"" + java.time.Instant.now().toString() + "\"}\n", StandardCharsets.UTF_8);
    lastLiveModifiedMs = -2L;
    lastConfigModifiedMs = -2L;
  }

  private static Path getConfigPath() {
    String appData = System.getenv("APPDATA");
    if (appData == null || appData.isBlank()) {
      appData = Path.of(System.getProperty("user.home"), "AppData", "Roaming").toString();
    }
    return Path.of(appData, ".minecraft-launcher", "launcher-config.json");
  }

  private static Path getLiveThemePath() {
    String appData = System.getenv("APPDATA");
    if (appData == null || appData.isBlank()) {
      appData = Path.of(System.getProperty("user.home"), "AppData", "Roaming").toString();
    }
    return Path.of(appData, ".minecraft-launcher", "x-launcher-theme.json");
  }

  private static int parseHexColor(String value) {
    String normalized = value == null ? "" : value.trim();
    if (normalized.startsWith("#")) {
      normalized = normalized.substring(1);
    }
    if (!normalized.matches("[0-9a-fA-F]{6}")) {
      return -1;
    }
    return Integer.parseInt(normalized, 16) & 0xFFFFFF;
  }

  private static String normalizeAppearanceMode(String value) {
    return "light".equalsIgnoreCase(value) ? "light" : "dark";
  }
}
