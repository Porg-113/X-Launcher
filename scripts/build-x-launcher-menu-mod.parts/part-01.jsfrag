package dev.xlauncher.client;

import java.lang.reflect.Field;
import java.lang.reflect.Method;

/** Owner-only combat helper. It never scans the world: Minecraft's crosshair hit is authoritative. */
final class AutoHitController {
  private static Object pendingTarget;
  private static boolean syntheticForward;
  private static boolean releaseForwardAfterHit;
  private static int forwardReleaseDelayTicks;

  private AutoHitController() {}

  static void update(Object client, boolean enabled) {
    // Do not rely on menu visibility as the security boundary.
    if (!enabled || !OwnerAccess.hasPermission() || client == null) {
      reset(client);
      return;
    }
    Object player = field(client, "player", "field_1724");
    Object gameMode = field(client, "gameMode", "interactionManager", "field_1761");
    if (player == null || gameMode == null) {
      reset(client);
      return;
    }

    if (releaseForwardAfterHit) {
      // Never cancel W while the player is still physically holding it.
      if (forwardReleaseDelayTicks > 0) {
        forwardReleaseDelayTicks--;
        setForward(client, true);
      } else if (!physicalForwardDown(client)) {
        setForward(client, false);
        syntheticForward = false;
        releaseForwardAfterHit = false;
      } else {
        setForward(client, true);
      }
    }

    Object lookedAt = crosshairEntity(client);
    if (!validTarget(player, lookedAt)) {
      if (pendingTarget != null && syntheticForward) releaseForwardAfterHit = true;
      pendingTarget = null;
      return;
    }

    if (pendingTarget != lookedAt) {
      if (attackStrength(player) < 0.999F) return;
      pendingTarget = lookedAt;
      // Keep forward active through the attack packet; releasing it before attack makes
      // sprint hits unreliable on remote servers.
      setForward(client, true);
      syntheticForward = true;
      invoke(player, new String[] { "setSprinting", "method_5728" }, true);
    }

    if (attackStrength(player) < 0.999F) return;
    if (!validTarget(player, pendingTarget) || crosshairEntity(client) != pendingTarget) {
      pendingTarget = null;
      return;
    }
    if (invoke(gameMode, new String[] { "attack", "attackEntity", "method_2918" }, player, pendingTarget)) {
      invoke(player, new String[] { "swing", "swingHand", "method_6104" }, mainHand());
      pendingTarget = null;
      releaseForwardAfterHit = true;
      // A short stable follow-through avoids a one-tick W flicker and feels smoother,
      // while remaining brief enough not to turn into permanent automatic movement.
      forwardReleaseDelayTicks = 2;
    }
  }

  private static float attackStrength(Object player) {
    Object value = invokeValue(player, new String[] { "getAttackStrengthScale", "getAttackCooldownProgress", "method_7261" }, 0.0F);
    return value instanceof Number number ? number.floatValue() : 0.0F;
  }

