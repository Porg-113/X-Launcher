  private static Path gameDir(Object client) {
    Object value = field(client, "gameDirectory", "runDirectory", "field_1697", "field_1703");
    if (value instanceof File file) {
      return file.toPath();
    }
    if (value instanceof Path path) {
      return path;
    }
    return null;
  }

  private static Object field(Object target, String... names) {
    if (target == null) {
      return null;
    }
    for (String name : names) {
      Class<?> type = target.getClass();
      while (type != null) {
