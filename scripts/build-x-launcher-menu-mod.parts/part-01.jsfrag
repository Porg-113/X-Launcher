  static String shortDate(long modifiedMs) {
    if (modifiedMs <= 0L) {
      return "";
    }
    java.time.LocalDateTime date = java.time.LocalDateTime.ofInstant(
        java.time.Instant.ofEpochMilli(modifiedMs),
        java.time.ZoneId.systemDefault());
    return String.format(Locale.ROOT, "%02d.%02d. %02d:%02d", date.getDayOfMonth(), date.getMonthValue(), date.getHour(), date.getMinute());
  }

  static String sizeLabel(long bytes) {
    if (bytes >= 1024L * 1024L) {
      return String.format(Locale.ROOT, "%.1f MB", bytes / (1024.0D * 1024.0D));
    }
    if (bytes >= 1024L) {
      return String.format(Locale.ROOT, "%.0f KB", bytes / 1024.0D);
    }
    return bytes + " B";
  }

  static final class Entry {
    final Path path;
    final String name;
    final long modifiedMs;
    final long sizeBytes;
    final int width;
