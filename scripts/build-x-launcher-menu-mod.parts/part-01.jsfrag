  'dev/xlauncher/client/MenuModules.java': String.raw`
package dev.xlauncher.client;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.LinkedHashSet;
import java.util.Set;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

final class MenuModules {
  private static final Pattern ENABLED_PATTERN = Pattern.compile("\"enabled\"\\s*:\\s*\\[(.*?)\\]", Pattern.DOTALL);
  private static final Pattern UNLOCKED_PATTERN = Pattern.compile("\"unlocked\"\\s*:\\s*\\[(.*?)\\]", Pattern.DOTALL);
  private static final Pattern FAVORITES_PATTERN = Pattern.compile("\"favorites\"\\s*:\\s*\\[(.*?)\\]", Pattern.DOTALL);
  private static final Pattern KEYS_PATTERN = Pattern.compile("\"keys\"\\s*:\\s*\\{(.*?)\\}", Pattern.DOTALL);
  private static final Pattern KEY_MODIFIERS_PATTERN = Pattern.compile("\"keyModifiers\"\\s*:\\s*\\{(.*?)\\}", Pattern.DOTALL);
  private static final Pattern LEVELS_PATTERN = Pattern.compile("\"levels\"\\s*:\\s*\\{(.*?)\\}", Pattern.DOTALL);
  private static final Pattern ZOOM_STRENGTH_PATTERN = Pattern.compile("\"zoomStrength\"\\s*:\\s*(\\d+)");
  private static final Pattern ZOOM_SMOOTHNESS_PATTERN = Pattern.compile("\"zoomSmoothness\"\\s*:\\s*(\\d+)");
  private static final Pattern BREAK_SPEED_PATTERN = Pattern.compile("\"breakSpeed\"\\s*:\\s*(\\d+)");
  private static final Pattern FLIGHT_SPEED_PATTERN = Pattern.compile("\"flightSpeed\"\\s*:\\s*(\\d+)");
  private static final Pattern FAKE_FPS_PATTERN = Pattern.compile("\"fakeFps\"\\s*:\\s*(-?\\d+)");
  private static final Pattern KEYBOARD_SOUND_PATTERN = Pattern.compile("\"keyboardSound\"\\s*:\\s*(\\d+)");
  private static final Pattern KEYBOARD_VOLUME_PATTERN = Pattern.compile("\"keyboardVolume\"\\s*:\\s*(\\d+)");
  private static final Pattern KEY_ENTRY_PATTERN = Pattern.compile("\"([^\"]+)\"\\s*:\\s*(-?\\d+)");
  private static final Pattern STRING_PATTERN = Pattern.compile("\"([^\"]+)\"");
  private static final int MOD_SHIFT = 1;
  private static final int MOD_CONTROL = 2;
  private static final int MOD_ALT = 4;
  private static final int MOD_SUPER = 8;
  private static final int MODIFIER_MASK = MOD_SHIFT | MOD_CONTROL | MOD_ALT | MOD_SUPER;
  static final int MIN_ZOOM_STRENGTH = 125;
  static final int MAX_ZOOM_STRENGTH = 1200;
  static final int MIN_ZOOM_SMOOTHNESS = 5;
  static final int MAX_ZOOM_SMOOTHNESS = 100;
  static final int MIN_BREAK_SPEED = 25;
  static final int MAX_BREAK_SPEED = 800;
  static final int MIN_FLIGHT_SPEED = 25;
  static final int MAX_FLIGHT_SPEED = 500;
  static final int MIN_KEYBOARD_VOLUME = 0;
  static final int MAX_KEYBOARD_VOLUME = 100;
  private static final int DEFAULT_ZOOM_STRENGTH = 300;
  private static final int DEFAULT_ZOOM_SMOOTHNESS = 32;
  private static final int DEFAULT_BREAK_SPEED = 100;
  private static final int DEFAULT_FLIGHT_SPEED = 100;
  private static final Set<String> unlocked = new LinkedHashSet<>();
  private static final Set<String> favorites = new LinkedHashSet<>();
  private static final Set<String> OWNER_ONLY_MODULES = Set.of("mobtrack", "xray", "autohit", "atribute", "flight");
  private static boolean loaded;
  private static int zoomStrength = DEFAULT_ZOOM_STRENGTH;
  private static int zoomSmoothness = DEFAULT_ZOOM_SMOOTHNESS;
  private static int breakSpeed = DEFAULT_BREAK_SPEED;
  private static int flightSpeed = DEFAULT_FLIGHT_SPEED;
  private static int fakeFps;
  private static int keyboardSound = 1;
  private static int keyboardVolume = 4;

  static final Module[] MODULES = {
      new Module("sprint", "Sprint", "Sprint", "Sprintet beim Vorwärtslaufen automatisch, ohne die Sprinttaste zu halten.", true, true),
      new Module("bright", "Fullbright", "Fullbright", "Erhellt Höhlen clientseitig mit Gamma, Night Vision und Lightmap-Boost.", true, true),
      new Module("zoom", "Zoom", "Zoom", "Verbindet den X-Client-Key mit Infinite Zoom. Mausrad-Zoom kommt direkt von Infinite Zoom.", true, true),
      new Module("blockoutline", "Block Outline", "Outline", "Passt Farbe und Dicke der normalen Block-Markierung an.", true, false),
      new Module("freecam", "Free Cam", "Freie Kamera", "Loest die Kamera lokal vom Spieler. WASD/Leertaste/Shift bewegen nur die Kamera; der Spieler bleibt am Server unveraendert.", true, true),
      new Module("flight", "Admin Flight", "Authorized", "Server-authorized admin flight. Requires the X Admin Flight server companion and a server-granted UUID permission; WASD, Space and Shift control movement.", true, true),
      new Module("xray", "Xray", "Erze", "Markiert ausgewaehlte Erze, Spawner, Spieler und Kisten aus bereits geladenen Server-Chunks. Reichweite und Ziele sind frei einstellbar.", true, true),
      new Module("mobtrack", "MobTrack", "Target", "Keybind lockt Mob oder Spieler instant mit Höhe und gedämpftem Projektil-Vorhalten.", true, true, true),
      new Module("autohit", "Auto-Hit", "Combat", "Greift Mobs oder Spieler im Fadenkreuz mit Vorwärtsimpuls und bei vollem Hit-Cooldown an.", true, true),
      new Module("atribute", "Atribute", "Hotbar Hit", "Fuehrt beim Wechsel des ausgewaehlten Hotbar-Slots noch im selben Client-Tick einen normalen Linksklick aus.", true, true),
      new Module("sounddisplay", "Sound Display", "Sounds", "Zeigt erkannte Spielgeräusche kurz und übersichtlich im HUD an.", true, false),
      new Module("keysounds", "Key Sounds", "Keyboard", "Spielt bei jedem Tastendruck den ausgewählten mechanischen Tastatur-Sound ab.", true, false),
      new Module("fps", "FPS", "Counter", "Zeigt deine aktuellen FPS oben links im HUD.", true, false),
      new Module("fakefps", "Fake FPS", "FPS Bonus", "Addiert den eingestellten Wert zur FPS-Anzeige.", true, false),
      new Module("coords", "Coords", "Coords", "Zeigt deine aktuelle X/Y/Z-Position im HUD.", true, false),
      new Module("nethercoords", "Nether Coords", "Portal", "Zeigt in der Overworld die passenden Nether-Koordinaten und im Nether die passenden Overworld-Koordinaten.", true, false),
      new Module("keys", "Keys", "Keys", "Zeigt WASD, Springen und Sneak live im HUD.", true, false),
      new Module("cps", "CPS", "Clicks", "Zählt linke Mausklicks pro Sekunde im HUD.", true, false),
      new Module("armor", "Armor Status", "Armor", "Zeigt echte Ruestungs-Items mit Haltbarkeit im HUD.", true, false),
      new Module("crosshair", "Crosshair", "Crosshair", "Eigenes pixelbares Crosshair mit Vorlagen und Reichweiten-Farbe.", true, false),
      new Module("clock", "Clock", "Clock", "Zeigt die lokale Uhrzeit im HUD.", true, false),
      new Module("uptimer", "Timer", "Timer", "Zaehlt ohne Hintergrund von null aufwaerts: Tage, Stunden, Minuten und Sekunden.", true, false),
      new Module("ui", "Editor", "Editor", "Positioniert HUD-Overlays per Drag auf dem Bildschirm.", false, false)
  };
  private static final java.util.Map<String, Module> MODULES_BY_ID = indexModules();
  private static Module[] cachedAvailableModules;
  private static int cachedPermissionMask = Integer.MIN_VALUE;

  private MenuModules() {
  }

  static Module[] modules() {
    load();
    if (OwnerAccess.hasPermission()) {
      return MODULES;
    }
    int permissionMask = 0;
    int bit = 1;
    for (String id : OWNER_ONLY_MODULES) {
      if (OwnerAccess.hasPermission(id)) permissionMask |= bit;
      bit <<= 1;
    }
    if (cachedAvailableModules != null && cachedPermissionMask == permissionMask) return cachedAvailableModules;
    int count = 0;
    for (Module module : MODULES) {
      if (!OWNER_ONLY_MODULES.contains(module.id) || OwnerAccess.hasPermission(module.id)) count++;
    }
    Module[] available = new Module[count];
    int index = 0;
    for (Module module : MODULES) {
      if (!OWNER_ONLY_MODULES.contains(module.id) || OwnerAccess.hasPermission(module.id)) available[index++] = module;
    }
    cachedPermissionMask = permissionMask;
    cachedAvailableModules = available;
    return available;
  }

  /** Allocation-free lookup for tick and render hot paths. */
  static boolean enabled(String id) {
    load();
    Module module = MODULES_BY_ID.get(id);
    if (module == null || !module.enabled) return false;
    if (OWNER_ONLY_MODULES.contains(module.id) && !OwnerAccess.hasPermission(module.id)) return false;
    return !module.hiddenUntilUnlocked || unlocked.contains(module.id);
  }

  private static java.util.Map<String, Module> indexModules() {
    java.util.HashMap<String, Module> result = new java.util.HashMap<>(MODULES.length * 2);
    for (Module module : MODULES) result.put(module.id, module);
    return java.util.Collections.unmodifiableMap(result);
  }

  static Module toggle(int index) {
    load();
    Module[] availableModules = modules();
    if (index < 0 || index >= availableModules.length) {
      return null;
    }
    Module module = availableModules[index];
    if (ServerModulePolicy.isBlocked(module.id)) {
      module.enabled = false;
      module.keyDown = false;
      return module;
    }
    if (module.hiddenUntilUnlocked && !unlocked.contains(module.id)) {
      module.enabled = false;
      return module;
    }
    if (!module.toggleable) {
      return module;
    }
    module.enabled = !module.enabled;
    save();
    return module;
  }

  static Module setEnabled(int index, boolean enabled) {
    load();
    Module[] availableModules = modules();
    if (index < 0 || index >= availableModules.length) {
      return null;
    }
    Module module = availableModules[index];
    if (enabled && ServerModulePolicy.isBlocked(module.id)) {
      module.enabled = false;
      module.keyDown = false;
      return module;
    }
    if (module.hiddenUntilUnlocked && !unlocked.contains(module.id)) {
      module.enabled = false;
      return module;
    }
    if (!module.toggleable) {
      return module;
    }
    module.enabled = enabled;
    save();
    return module;
  }

  static Module setEnabledById(String id, boolean enabled) {
    load();
    Module module = byId(id);
    if (module == null || !module.toggleable) return module;
    if (enabled && (ServerModulePolicy.isBlocked(module.id)
        || (OWNER_ONLY_MODULES.contains(module.id) && !OwnerAccess.hasPermission(module.id)))) {
      enabled = false;
    }
    module.enabled = enabled;
    module.keyDown = false;
    save();
    return module;
  }

  static Module setKeyCode(int index, int keyCode) {
    return setKeyCombo(index, keyCode, 0);
  }

  static boolean isFavorite(String id) {
    load();
    Module module = byId(id);
    return module != null && favorites.contains(module.id);
  }

  static boolean toggleFavorite(String id) {
    load();
    Module module = byId(id);
    if (module == null) {
      return false;
    }
    boolean favorite;
    if (favorites.contains(module.id)) {
      favorites.remove(module.id);
      favorite = false;
    } else {
      favorites.add(module.id);
      favorite = true;
    }
    save();
    return favorite;
  }

  static String unlockCode(String code) {
    load();
    String moduleId = moduleIdForCode(code);
    if (moduleId.isEmpty()) {
      return "";
    }
    boolean changed = unlocked.add(moduleId);
    if (changed) {
      save();
    }
    return moduleId;
  }

  private static String moduleIdForCode(String code) {
    String normalized = String.valueOf(code == null ? "" : code).trim().toLowerCase(java.util.Locale.ROOT);
    if ("speed".equals(normalized)) {
      return "speed";
    }
    if ("tracking".equals(normalized) || "track".equals(normalized) || "mobtrack".equals(normalized)) {
      return "mobtrack";
    }
    if ("resistance".equals(normalized) || "resistenc".equals(normalized) || "resistenz".equals(normalized)) {
      return "resistance";
    }
    if ("invisibility".equals(normalized) || "invisible".equals(normalized) || "invis".equals(normalized)
        || "invisebiliti".equals(normalized) || "invisibiliti".equals(normalized) || "unsichtbar".equals(normalized)) {
      return "invisibility";
    }
    return "";
  }

  static boolean isUnlocked(String id) {
    load();
    Module module = byId(id);
    if (module != null && OWNER_ONLY_MODULES.contains(module.id) && !OwnerAccess.hasPermission(module.id)) {
      module.enabled = false;
      module.keyDown = false;
      return false;
    }
    return module == null || !module.hiddenUntilUnlocked || unlocked.contains(module.id);
  }

  static boolean isOwnerOnly(String id) {
    return OWNER_ONLY_MODULES.contains(id);
  }

  static int effectLevel(String id) {
    load();
    Module module = byId(id);
    return hasEffectLevel(module) ? clampEffectLevel(module.effectLevel) : 255;
  }

  static void setEffectLevel(String id, int level) {
    load();
    Module module = byId(id);
    if (!hasEffectLevel(module)) {
      return;
    }
    module.effectLevel = clampEffectLevel(level);
    save();
  }

  static int zoomStrengthPercent() {
    load();
    return clampZoomStrength(zoomStrength);
  }

  static double zoomStrength() {
    return zoomStrengthPercent() / 100.0D;
  }

  static void setZoomStrengthPercent(int percent) {
    load();
    zoomStrength = clampZoomStrength(percent);
    save();
  }

  static void setZoomStrength(double factor) {
    setZoomStrengthPercent((int) Math.round(factor * 100.0D));
  }

  static int zoomSmoothnessPercent() {
    load();
    return clampZoomSmoothness(zoomSmoothness);
  }

  static double zoomSmoothness() {
    return zoomSmoothnessPercent() / 100.0D;
  }

  static void setZoomSmoothnessPercent(int percent) {
    load();
    zoomSmoothness = clampZoomSmoothness(percent);
    save();
  }

  static int breakSpeedPercent() {
    load();
    return clampBreakSpeed(breakSpeed);
  }

  static double breakSpeedMultiplier() {
    double ratio = (breakSpeedPercent() - MIN_BREAK_SPEED) / (double) Math.max(1, MAX_BREAK_SPEED - MIN_BREAK_SPEED);
    return 0.25D * Math.pow(3200000.0D, Math.max(0.0D, Math.min(1.0D, ratio)));
  }

  static void setBreakSpeedPercent(int percent) {
    load();
    breakSpeed = clampBreakSpeed(percent);
    save();
  }

  static int flightSpeedPercent() {
    load();
    return clampFlightSpeed(flightSpeed);
  }

  static double flightSpeedBlocksPerTick() {
    return flightSpeedPercent() / 100.0D;
  }

  static void setFlightSpeedPercent(int percent) {
    load();
    flightSpeed = clampFlightSpeed(percent);
    save();
  }

  static int fakeFps() {
    load();
    return fakeFps;
  }

  static void setFakeFps(int value) {
    load();
    fakeFps = value;
    save();
  }

  static int keyboardSound() {
    load();
    return keyboardSound;
  }

  static void setKeyboardSound(int value) {
    load();
    keyboardSound = Math.max(1, Math.min(12, value));
    save();
  }

  static int keyboardVolumePercent() {
    load();
    return keyboardVolume;
  }

  static void setKeyboardVolumePercent(int percent) {
    load();
    keyboardVolume = clampKeyboardVolume(percent);
    save();
  }


  static Module setKeyCombo(int index, int keyCode, int keyModifiers) {
    load();
    Module[] availableModules = modules();
    if (index < 0 || index >= availableModules.length) {
      return null;
    }
    Module module = availableModules[index];
    if (module.hiddenUntilUnlocked && !unlocked.contains(module.id)) {
      module.keyCode = -1;
      module.keyModifiers = 0;
      save();
      return module;
    }
    if (!module.keyBindable) {
      module.keyCode = -1;
      module.keyModifiers = 0;
      save();
      return module;
    }
    module.keyCode = keyCode;
    module.keyModifiers = keyCode > 0 ? normalizeModifiersForKey(keyCode, keyModifiers) : 0;
    save();
    return module;
  }

  private static void load() {
    if (loaded) {
      return;
    }
    loaded = true;
    unlocked.add("mobtrack");
    Path path = statePath();
    if (!Files.exists(path)) {
      return;
    }

    try {
      String json = Files.readString(path, StandardCharsets.UTF_8);
      Matcher enabledMatcher = ENABLED_PATTERN.matcher(json);
      if (enabledMatcher.find()) {
        Set<String> enabledIds = new LinkedHashSet<>();
        Matcher stringMatcher = STRING_PATTERN.matcher(enabledMatcher.group(1));
        while (stringMatcher.find()) {
          enabledIds.add(stringMatcher.group(1));
        }
        for (Module module : MODULES) {
          module.enabled = module.toggleable && enabledIds.contains(module.id);
        }
      }
      Matcher unlockedMatcher = UNLOCKED_PATTERN.matcher(json);
      if (unlockedMatcher.find()) {
        Matcher stringMatcher = STRING_PATTERN.matcher(unlockedMatcher.group(1));
        while (stringMatcher.find()) {
          Module module = byId(stringMatcher.group(1));
          if (module != null && module.hiddenUntilUnlocked) {
            unlocked.add(module.id);
          }
        }
      }
      Matcher favoritesMatcher = FAVORITES_PATTERN.matcher(json);
      if (favoritesMatcher.find()) {
        favorites.clear();
        Matcher stringMatcher = STRING_PATTERN.matcher(favoritesMatcher.group(1));
        while (stringMatcher.find()) {
          Module module = byId(stringMatcher.group(1));
          if (module != null) {
            favorites.add(module.id);
          }
        }
      }
      Matcher keysMatcher = KEYS_PATTERN.matcher(json);
      if (keysMatcher.find()) {
        Matcher keyEntryMatcher = KEY_ENTRY_PATTERN.matcher(keysMatcher.group(1));
        while (keyEntryMatcher.find()) {
          Module module = byId(keyEntryMatcher.group(1));
          if (module != null && module.keyBindable) {
            module.keyCode = Integer.parseInt(keyEntryMatcher.group(2));
          }
        }
      }
      Matcher keyModifiersMatcher = KEY_MODIFIERS_PATTERN.matcher(json);
      if (keyModifiersMatcher.find()) {
        Matcher keyModifierEntryMatcher = KEY_ENTRY_PATTERN.matcher(keyModifiersMatcher.group(1));
        while (keyModifierEntryMatcher.find()) {
          Module module = byId(keyModifierEntryMatcher.group(1));
          if (module != null && module.keyBindable && module.keyCode > 0) {
            module.keyModifiers = normalizeModifiersForKey(module.keyCode, Integer.parseInt(keyModifierEntryMatcher.group(2)));
          }
        }
      }
      Matcher levelsMatcher = LEVELS_PATTERN.matcher(json);
      if (levelsMatcher.find()) {
        Matcher levelEntryMatcher = KEY_ENTRY_PATTERN.matcher(levelsMatcher.group(1));
        while (levelEntryMatcher.find()) {
          Module module = byId(levelEntryMatcher.group(1));
          if (hasEffectLevel(module)) {
            module.effectLevel = clampEffectLevel(Integer.parseInt(levelEntryMatcher.group(2)));
          }
        }
      }
      Matcher zoomStrengthMatcher = ZOOM_STRENGTH_PATTERN.matcher(json);
      if (zoomStrengthMatcher.find()) {
        zoomStrength = clampZoomStrength(Integer.parseInt(zoomStrengthMatcher.group(1)));
      }
      Matcher zoomSmoothnessMatcher = ZOOM_SMOOTHNESS_PATTERN.matcher(json);
      if (zoomSmoothnessMatcher.find()) {
        zoomSmoothness = clampZoomSmoothness(Integer.parseInt(zoomSmoothnessMatcher.group(1)));
      }
      Matcher breakSpeedMatcher = BREAK_SPEED_PATTERN.matcher(json);
      if (breakSpeedMatcher.find()) {
        breakSpeed = clampBreakSpeed(Integer.parseInt(breakSpeedMatcher.group(1)));
      }
      Matcher flightSpeedMatcher = FLIGHT_SPEED_PATTERN.matcher(json);
      if (flightSpeedMatcher.find()) {
        flightSpeed = clampFlightSpeed(Integer.parseInt(flightSpeedMatcher.group(1)));
      }
      Matcher fakeFpsMatcher = FAKE_FPS_PATTERN.matcher(json);
      if (fakeFpsMatcher.find()) {
        long parsed = Long.parseLong(fakeFpsMatcher.group(1));
        fakeFps = (int) Math.max(Integer.MIN_VALUE, Math.min(Integer.MAX_VALUE, parsed));
      }
      Matcher keyboardSoundMatcher = KEYBOARD_SOUND_PATTERN.matcher(json);
      if (keyboardSoundMatcher.find()) keyboardSound = Math.max(1, Math.min(12, Integer.parseInt(keyboardSoundMatcher.group(1))));
      Matcher keyboardVolumeMatcher = KEYBOARD_VOLUME_PATTERN.matcher(json);
      if (keyboardVolumeMatcher.find()) keyboardVolume = clampKeyboardVolume(Integer.parseInt(keyboardVolumeMatcher.group(1)) > MAX_KEYBOARD_VOLUME ? MAX_KEYBOARD_VOLUME : Integer.parseInt(keyboardVolumeMatcher.group(1)));
      normalizeLoadedDefaults();
    } catch (IOException | RuntimeException ignored) {
      // Broken state should never prevent the menu from opening.
    }
  }

  private static void normalizeLoadedDefaults() {
    zoomStrength = clampZoomStrength(zoomStrength);
    zoomSmoothness = clampZoomSmoothness(zoomSmoothness);
    breakSpeed = clampBreakSpeed(breakSpeed);
    flightSpeed = clampFlightSpeed(flightSpeed);
    keyboardSound = Math.max(1, Math.min(12, keyboardSound));
    keyboardVolume = clampKeyboardVolume(keyboardVolume);
    for (Module module : MODULES) {
      if (OWNER_ONLY_MODULES.contains(module.id) && !OwnerAccess.hasPermission(module.id)) {
        module.enabled = false;
        module.keyDown = false;
        module.keyCode = -1;
        module.keyModifiers = 0;
        favorites.remove(module.id);
        continue;
      }
      if (module.hiddenUntilUnlocked && !unlocked.contains(module.id)) {
        module.enabled = false;
        module.keyDown = false;
      }
    }
  }

  private static void save() {
    Path path = statePath();
    try {
      Files.createDirectories(path.getParent());
      StringBuilder enabled = new StringBuilder();
      for (Module module : MODULES) {
        if (OWNER_ONLY_MODULES.contains(module.id) && !OwnerAccess.hasPermission(module.id)) {
          continue;
        }
        if (!module.toggleable || !ServerModulePolicy.preferredEnabled(module)) {
          continue;
        }
        if (enabled.length() > 0) {
          enabled.append(", ");
        }
        enabled.append('"').append(module.id).append('"');
      }
      StringBuilder unlockedIds = new StringBuilder();
      for (String id : unlocked) {
        Module module = byId(id);
        if (module == null || !module.hiddenUntilUnlocked) {
          continue;
        }
        if (unlockedIds.length() > 0) {
          unlockedIds.append(", ");
        }
        unlockedIds.append('"').append(module.id).append('"');
      }
      StringBuilder favoritesJson = new StringBuilder();
      for (String id : favorites) {
        Module module = byId(id);
        if (module == null) {
          continue;
        }
        if (favoritesJson.length() > 0) {
          favoritesJson.append(", ");
        }
        favoritesJson.append('"').append(module.id).append('"');
      }
      StringBuilder keys = new StringBuilder();
      StringBuilder keyModifiers = new StringBuilder();
      StringBuilder levels = new StringBuilder();
      for (Module module : MODULES) {
        if (module.keyBindable && module.keyCode != 0) {
          if (keys.length() > 0) {
            keys.append(", ");
          }
          keys.append('"').append(module.id).append("\": ").append(module.keyCode);
          if (module.keyModifiers > 0) {
            if (keyModifiers.length() > 0) {
              keyModifiers.append(", ");
            }
            keyModifiers.append('"').append(module.id).append("\": ").append(module.keyModifiers);
          }
        }
        if (hasEffectLevel(module)) {
          if (levels.length() > 0) {
            levels.append(", ");
          }
          levels.append('"').append(module.id).append("\": ").append(clampEffectLevel(module.effectLevel));
        }
      }
      Files.writeString(path, "{\n  \"enabled\": [" + enabled + "],\n  \"unlocked\": [" + unlockedIds + "],\n  \"favorites\": [" + favoritesJson + "],\n  \"keys\": {" + keys + "},\n  \"keyModifiers\": {" + keyModifiers + "},\n  \"levels\": {" + levels + "},\n  \"zoomStrength\": " + clampZoomStrength(zoomStrength) + ",\n  \"zoomSmoothness\": " + clampZoomSmoothness(zoomSmoothness) + ",\n  \"breakSpeed\": " + clampBreakSpeed(breakSpeed) + ",\n  \"flightSpeed\": " + clampFlightSpeed(flightSpeed) + ",\n  \"keyboardSound\": " + keyboardSound + ",\n  \"keyboardVolume\": " + clampKeyboardVolume(keyboardVolume) + ",\n  \"fakeFps\": " + fakeFps + "\n}\n", StandardCharsets.UTF_8);
    } catch (IOException ignored) {
      // Settings persistence is optional.
    }
  }

  private static boolean hasEffectLevel(Module module) {
    return module != null && "mobtrack".equals(module.id);
  }

  private static int clampEffectLevel(int level) {
    return Math.max(30, Math.min(100, level));
  }

  private static int clampZoomStrength(int percent) {
    return Math.max(MIN_ZOOM_STRENGTH, Math.min(MAX_ZOOM_STRENGTH, percent));
  }

  private static int clampZoomSmoothness(int percent) {
    return Math.max(MIN_ZOOM_SMOOTHNESS, Math.min(MAX_ZOOM_SMOOTHNESS, percent));
  }

  private static int clampBreakSpeed(int percent) {
    return Math.max(MIN_BREAK_SPEED, Math.min(MAX_BREAK_SPEED, percent));
  }

  private static int clampFlightSpeed(int percent) {
    return Math.max(MIN_FLIGHT_SPEED, Math.min(MAX_FLIGHT_SPEED, percent));
  }

  private static int clampKeyboardVolume(int percent) {
    return Math.max(MIN_KEYBOARD_VOLUME, Math.min(MAX_KEYBOARD_VOLUME, percent));
  }

  private static int readInt(String json, Pattern pattern, int fallback) {
    Matcher matcher = pattern.matcher(json);
    return matcher.find() ? Integer.parseInt(matcher.group(1)) : fallback;
  }

  private static int normalizeModifiersForKey(int keyCode, int keyModifiers) {
    int modifiers = keyModifiers & MODIFIER_MASK;
    if (keyCode == 340 || keyCode == 344) {
      modifiers &= ~MOD_SHIFT;
    } else if (keyCode == 341 || keyCode == 345) {
      modifiers &= ~MOD_CONTROL;
    } else if (keyCode == 342 || keyCode == 346) {
      modifiers &= ~MOD_ALT;
    } else if (keyCode == 343 || keyCode == 347) {
      modifiers &= ~MOD_SUPER;
    }
    return modifiers;
  }

  private static Module byId(String id) {
    return MODULES_BY_ID.get(id);
  }

  private static Path statePath() {
    String profileSettingsFile = System.getenv("X_LAUNCHER_PROFILE_SETTINGS_FILE");
    if (profileSettingsFile != null && !profileSettingsFile.isBlank()) {
      return Path.of(profileSettingsFile).toAbsolutePath().normalize();
    }
    String appData = System.getenv("APPDATA");
    if (appData == null || appData.isBlank()) {
      appData = Path.of(System.getProperty("user.home"), "AppData", "Roaming").toString();
    }
    return Path.of(appData, ".minecraft-launcher", "x-launcher-menu.json");
  }

  static final class Module {
    final String id;
    final String title;
    final String subtitle;
    final String description;
    final boolean toggleable;
    final boolean keyBindable;
    final boolean hiddenUntilUnlocked;
    boolean enabled;
    int keyCode;
    int keyModifiers;
    int effectLevel;
    boolean keyDown;

    Module(String id, String title, String subtitle, String description, boolean toggleable, boolean keyBindable) {
      this(id, title, subtitle, description, toggleable, keyBindable, false, 0, 0);
    }

    Module(String id, String title, String subtitle, String description, boolean toggleable, boolean keyBindable, boolean hiddenUntilUnlocked) {
      this(id, title, subtitle, description, toggleable, keyBindable, hiddenUntilUnlocked, 0, 0);
    }

    Module(String id, String title, String subtitle, String description, boolean toggleable, boolean keyBindable, int keyCode, int keyModifiers) {
      this(id, title, subtitle, description, toggleable, keyBindable, false, keyCode, keyModifiers);
    }

    Module(String id, String title, String subtitle, String description, boolean toggleable, boolean keyBindable, boolean hiddenUntilUnlocked, int keyCode, int keyModifiers) {
      this.id = id;
      this.title = title;
      this.subtitle = subtitle;
      this.description = description;
      this.toggleable = toggleable;
      this.keyBindable = keyBindable;
      this.hiddenUntilUnlocked = hiddenUntilUnlocked;
      this.keyCode = keyCode;
      this.keyModifiers = keyCode > 0 ? normalizeModifiersForKey(keyCode, keyModifiers) : 0;
      this.effectLevel = "mobtrack".equals(id) ? 100 : 1;
    }
  }
}
