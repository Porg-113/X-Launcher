  'dev/xlauncher/client/XClientColorModes.java': String.raw`
package dev.xlauncher.client;

import java.awt.Color;
import java.util.prefs.Preferences;

public final class XClientColorModes {
  public static final int MIN_OPACITY = 48;
  private static final Preferences PREFS = Preferences.userNodeForPackage(XClientColorModes.class);

  private XClientColorModes() {}

  public static int resolve(String target, int fallback) {
    String key = safe(target);
    int alpha = opacity(target);
    if (PREFS.getBoolean(key + ".rainbow", false)) {
      float hue = (System.currentTimeMillis() % 6000L) / 6000.0F;
      return (alpha << 24) | (Color.HSBtoRGB(hue, 0.88F, 1.0F) & 0xFFFFFF);
    }
    return (alpha << 24) | (PREFS.getInt(key + ".color", fallback) & 0xFFFFFF);
  }

  public static int staticColor(String target, int fallback) {
    return PREFS.getInt(safe(target) + ".color", fallback) & 0xFFFFFF;
  }

  public static void setColor(String target, int rgb) {
    String key = safe(target);
    PREFS.putInt(key + ".color", rgb & 0xFFFFFF);
    PREFS.putBoolean(key + ".rainbow", false);
  }

  public static boolean rainbow(String target) {
    return PREFS.getBoolean(safe(target) + ".rainbow", false);
  }

  public static void setRainbow(String target, boolean enabled) {
    PREFS.putBoolean(safe(target) + ".rainbow", enabled);
  }

  public static int opacity(String target) {
    return Math.max(MIN_OPACITY, Math.min(255, PREFS.getInt(safe(target) + ".opacity", 255)));
  }

  public static void setOpacity(String target, int value) {
    PREFS.putInt(safe(target) + ".opacity", Math.max(MIN_OPACITY, Math.min(255, value)));
  }

  public static boolean option(String target, boolean fallback) {
    return PREFS.getBoolean(safe(target) + ".option", fallback);
  }

  public static void setOption(String target, boolean enabled) {
    PREFS.putBoolean(safe(target) + ".option", enabled);
  }

  private static String safe(String target) {
    return String.valueOf(target == null ? "color" : target).replaceAll("[^a-zA-Z0-9_.-]", "_");
  }
}
