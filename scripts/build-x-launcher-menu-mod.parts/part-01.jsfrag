      }
      owner = new java.awt.Frame();
      owner.setAlwaysOnTop(true);
      dialog = new java.awt.FileDialog(owner, "Screenshot speichern", java.awt.FileDialog.SAVE);
      Path initialDir = picturesDir();
      if (initialDir != null) {
        dialog.setDirectory(initialDir.toString());
