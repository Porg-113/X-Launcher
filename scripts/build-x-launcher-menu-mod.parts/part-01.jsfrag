    'key.xclient.smartscreenshot': 'Smart Screenshot',
    'key.xclient.code': 'Code',
    'key.xclient.ui': 'UI Editor'
  }, null, 2)}\n`);
  writeFile(path.join(resourcesDir, 'assets', 'x-client', 'lang', 'de_de.json'), `${JSON.stringify({
    'key.category.x-client.keybinds': 'X Client',
    'key.xclient.menu': 'Menü öffnen',
    'key.xclient.zoom': 'Zoom',
    'key.xclient.sprint': 'Sprint',
    'key.xclient.nobob': 'NoBob',
    'key.xclient.bright': 'Fullbright',
    'key.xclient.flight': 'Admin Flight',
    'key.xclient.xray': 'Xray',
    'key.xclient.mobtrack': 'MobTrack',
    'key.xclient.autohit': 'Auto-Hit',
    'key.xclient.atribute': 'Atribute',
    'key.xclient.sounddisplay': 'Sound Display',
    'key.xclient.speed': 'Speed',
    'key.xclient.resistance': 'Resistance',
    'key.xclient.invisibility': 'Invisibility',
    'key.xclient.fps': 'FPS',
    'key.xclient.fakefps': 'Fake FPS',
    'key.xclient.coords': 'Koordinaten',
    'key.xclient.nethercoords': 'Nether Coords',
    'key.xclient.direction': 'Richtung & Biom',
    'key.xclient.keys': 'Keystrokes',
    'key.xclient.cps': 'CPS',
    'key.xclient.armor': 'Armor Status',
    'key.xclient.inventory': 'Inventar HUD',
    'key.xclient.combo': 'Combo-Zähler',
    'key.xclient.session': 'Sitzungsstatistik',
    'key.xclient.crosshair': 'Crosshair',
