#!/usr/bin/env node

const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawnSync } = require('child_process');

const PROJECT_ROOT = path.join(__dirname, '..');
const BUILD_DIR = path.join(PROJECT_ROOT, 'build', 'x-launcher-menu');
const OUTPUT_DIR = path.join(PROJECT_ROOT, 'assets', 'required-mods');
const MINECRAFT_DIR = path.join(process.env.APPDATA || path.join(os.homedir(), 'AppData', 'Roaming'), '.minecraft');
const LIBRARIES_DIR = path.join(MINECRAFT_DIR, 'libraries');
const VERSIONS_DIR = path.join(MINECRAFT_DIR, 'versions');
const MOD_VERSION = '1.0.155';
const MOD_ICON_SOURCE = path.join(PROJECT_ROOT, 'icons', 'icon.png');
const MOD_MENU_BACKGROUND_SOURCE = path.join(PROJECT_ROOT, 'assets', 'x-client', 'menu-blur.png');
const MOD_FAVORITE_ICON_SOURCE = path.join(PROJECT_ROOT, 'assets', 'x-client', 'icons', 'favorite-star.png');
const MOD_PICTURES_ICON_SOURCE = path.join(PROJECT_ROOT, 'assets', 'x-client', 'icons', 'pictures-square.png');
const MOD_KEY_SOUND_SOURCE = path.join(PROJECT_ROOT, 'assets', 'sounds', 'typersguild');
const FFMPEG_PATH = path.join(PROJECT_ROOT, 'build', 'ffmpeg-tool', 'package', process.platform === 'win32' ? 'ffmpeg.exe' : 'ffmpeg');

function ensureDir(targetPath) {
  fs.mkdirSync(targetPath, { recursive: true });
}

function writeFile(filePath, content) {
  ensureDir(path.dirname(filePath));
  fs.writeFileSync(filePath, content.replace(/\r?\n/g, '\n'), 'utf8');
}

function removeDir(targetPath) {
  fs.rmSync(targetPath, { recursive: true, force: true });
}

function removeFile(targetPath) {
  fs.rmSync(targetPath, { force: true });
}

function run(command, args, options = {}) {
  const result = spawnSync(command, args, {
    cwd: options.cwd || PROJECT_ROOT,
    stdio: 'inherit',
    shell: false
  });

  if (result.error) {
    throw result.error;
  }
  if (result.status !== 0) {
    throw new Error(`${command} failed with exit code ${result.status}`);
  }
}

function collectFiles(dir, extension) {
  const result = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const fullPath = path.join(dir, entry.name);
    if (entry.isDirectory()) {
      result.push(...collectFiles(fullPath, extension));
    } else if (entry.isFile() && entry.name.endsWith(extension)) {
      result.push(fullPath);
    }
  }
  return result;
}

function writeArgFile(filePath, args) {
  const lines = args.map((arg) => `"${String(arg).replace(/\\/g, '/')}"`);
  writeFile(filePath, `${lines.join('\n')}\n`);
  return filePath;
}

function readJson(filePath) {
  return JSON.parse(fs.readFileSync(filePath, 'utf8'));
}

function mavenNameToPath(name) {
  const [groupId, artifactId, version] = String(name || '').split(':');
  if (!groupId || !artifactId || !version) {
    return '';
  }
  return path.join(LIBRARIES_DIR, ...groupId.split('.'), artifactId, version, `${artifactId}-${version}.jar`);
}

function resolveLibraryJar(library) {
  const artifactPath = library?.downloads?.artifact?.path;
  if (artifactPath) {
    return path.join(LIBRARIES_DIR, artifactPath);
  }
  return mavenNameToPath(library?.name);
}

function getVersionClasspath(versionId) {
  const versionJsonPath = path.join(VERSIONS_DIR, versionId, `${versionId}.json`);
  const versionJarPath = path.join(VERSIONS_DIR, versionId, `${versionId}.jar`);
  if (!fs.existsSync(versionJsonPath) || !fs.existsSync(versionJarPath)) {
    throw new Error(`Minecraft ${versionId} is not installed in ${VERSIONS_DIR}`);
  }

  const versionJson = readJson(versionJsonPath);
  const classpath = [versionJarPath];
  for (const library of versionJson.libraries || []) {
    const jarPath = resolveLibraryJar(library);
    if (jarPath && fs.existsSync(jarPath)) {
      classpath.push(jarPath);
    }
  }
  classpath.push(findLatestFabricLoaderJar());
  return Array.from(new Set(classpath));
}

function compareVersionLabels(left, right) {
  const leftParts = String(left || '').split(/[^0-9]+/).filter(Boolean).map(Number);
  const rightParts = String(right || '').split(/[^0-9]+/).filter(Boolean).map(Number);
  const length = Math.max(leftParts.length, rightParts.length);
  for (let index = 0; index < length; index += 1) {
    const diff = (leftParts[index] || 0) - (rightParts[index] || 0);
    if (diff) {
      return diff;
    }
  }
  return String(left || '').localeCompare(String(right || ''), undefined, { numeric: true });
}

function findLatestFabricLoaderJar() {
  const loaderRoot = path.join(LIBRARIES_DIR, 'net', 'fabricmc', 'fabric-loader');
  if (!fs.existsSync(loaderRoot)) {
    throw new Error(`Fabric Loader library not found: ${loaderRoot}`);
  }

  const versions = fs.readdirSync(loaderRoot)
    .filter((entry) => fs.existsSync(path.join(loaderRoot, entry, `fabric-loader-${entry}.jar`)))
    .sort(compareVersionLabels);
  const latest = versions[versions.length - 1];
  if (!latest) {
    throw new Error(`No Fabric Loader JAR found in ${loaderRoot}`);
  }
  return path.join(loaderRoot, latest, `fabric-loader-${latest}.jar`);
}

function compileJava(sourceDir, classDir, classpath) {
  ensureDir(classDir);
  const sources = collectFiles(sourceDir, '.java');
  const argFile = writeArgFile(path.join(classDir, 'sources.args'), sources);
  const args = [
    '--release',
    '21',
    '-encoding',
    'UTF-8'
  ];
  if (classpath.length > 0) {
    args.push('-cp', classpath.join(path.delimiter));
  }
  args.push('-d', classDir, `@${argFile}`);
  run('javac', args);
}

function compileJavaFromSourceDirs(sourceDirs, classDir, classpath = []) {
  ensureDir(classDir);
  const sources = sourceDirs.flatMap((sourceDir) => collectFiles(sourceDir, '.java'));
  const argFile = writeArgFile(path.join(classDir, 'sources.args'), sources);
  const args = [
    '--release',
    '21',
    '-encoding',
    'UTF-8'
  ];
  if (classpath.length > 0) {
    args.push('-cp', classpath.join(path.delimiter));
  }
  args.push('-d',
    classDir,
    `@${argFile}`);
  run('javac', args);
}

function getFabricApiClasspath(workDir) {
  const modsDir = path.join(MINECRAFT_DIR, 'mods');
  const fabricApi = fs.existsSync(modsDir)
    ? fs.readdirSync(modsDir).filter((name) => /^fabric-api-.*26\.2.*\.jar$/i.test(name)).sort().pop()
    : '';
  if (!fabricApi) {
    throw new Error('Fabric API for Minecraft 26.2 is not installed.');
  }
  const dependencyDir = path.join(workDir, 'fabric-api-dependencies');
  ensureDir(dependencyDir);
  run('jar', ['--extract', '--file', path.join(modsDir, fabricApi)], { cwd: dependencyDir });
  return collectFiles(path.join(dependencyDir, 'META-INF', 'jars'), '.jar');
}

function packageJar(outputPath, classDir, resourcesDir) {
  ensureDir(path.dirname(outputPath));
  const args = ['--create', '--file', outputPath, '-C', classDir, '.'];
  if (fs.existsSync(resourcesDir)) {
    args.push('-C', resourcesDir, '.');
  }
  run('jar', args);
}

function manifestFor(dependsMinecraft, entrypointClass) {
  return `${JSON.stringify({
    schemaVersion: 1,
    id: 'x-client',
    version: MOD_VERSION,
    name: 'X Client',
    description: 'X Client menu with server-authorized admin tools.',
    authors: ['X Client'],
    icon: 'assets/x-client/icon.png',
    environment: '*',
    entrypoints: {
      main: ['dev.xlauncher.client.XAdminFlightServer'],
      client: [entrypointClass]
    },
    mixins: [
      'x-client.mixins.json'
    ],
    depends: {
      fabricloader: '>=0.18.0',
      'fabric-lifecycle-events-v1': '*',
      'fabric-networking-api-v1': '*',
      'fabric-rendering-v1': '*',
      minecraft: dependsMinecraft,
      java: '>=21'
    }
  }, null, 2)}\n`;
}

function writeCommonResources(resourcesDir, dependsMinecraft, entrypointClass) {
  writeFile(path.join(resourcesDir, 'fabric.mod.json'), manifestFor(dependsMinecraft, entrypointClass));
  writeFile(path.join(resourcesDir, 'x-client.mixins.json'), `${JSON.stringify({
    required: false,
    package: 'dev.xlauncher.client.mixin',
    compatibilityLevel: 'JAVA_21',
    client: [
      'XLauncherGammaValidationMixin',
      'XLauncherFullbrightMixin',
