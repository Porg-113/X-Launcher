    // The EntityHitResult is produced by Minecraft's own reach/visibility ray cast and also
    // works on remote multiplayer servers. A separately cached targetedEntity may be stale.
    Object hit = field(client, "hitResult", "field_1765");
    Object entity = invokeValue(hit, new String[] { "getEntity", "method_17782" });
    return entity != null ? entity : field(client, "crosshairPickEntity", "targetedEntity", "field_3213", "field_1692");
  }

  private static boolean validTarget(Object player, Object entity) {
    if (entity == null || entity == player || !isLiving(entity)) return false;
    Object alive = invokeValue(entity, new String[] { "isAlive", "method_5805" });
    if (alive instanceof Boolean bool && !bool) return false;
    return true;
  }

  private static boolean isLiving(Object entity) {
    return isInstance(entity, "net.minecraft.world.entity.LivingEntity", "net.minecraft.class_1309")
        || invokeValue(entity, new String[] { "getHealth", "method_6032" }) instanceof Number;
  }

