  private static boolean invokeWindowsShare(Path path) {
    if (path == null || !Files.exists(path)) {
      return false;
    }
    String psPath = psSingleQuoted(path.toAbsolutePath().normalize().toString());
    String script = "$p=" + psPath + ";"
        + "$shell=New-Object -ComObject Shell.Application;"
        + "$folder=$shell.Namespace((Split-Path -LiteralPath $p));"
        + "if($null -eq $folder){exit 1};"
        + "$item=$folder.ParseName((Split-Path -Leaf $p));"
        + "if($null -eq $item){exit 1};"
        + "$done=$false;"
        + "foreach($verbName in @('share','Share','Windows.ModernShare','ModernShare')){"
        + "try{$item.InvokeVerb($verbName);$done=$true;break}catch{}"
        + "};"
        + "if(-not $done){foreach($verb in $item.Verbs()){"
        + "$name=$verb.Name.Replace('&','');"
        + "if($name -match 'Share|Teilen|Freigeben'){ $verb.DoIt(); $done=$true; break }"
        + "}};"
        + "if(-not $done){"
        + "Start-Process explorer.exe -ArgumentList ('/select,\"' + $p + '\"');"
        + "Start-Sleep -Milliseconds 900;"
        + "$ws=New-Object -ComObject WScript.Shell;"
        + "$folderName=Split-Path -Leaf (Split-Path -Parent $p);"
        + "$ws.AppActivate($folderName)|Out-Null;"
        + "Start-Sleep -Milliseconds 180;"
        + "$ws.SendKeys('+{F10}');"
        + "Start-Sleep -Milliseconds 220;"
        + "$ws.SendKeys('f');"
        + "Start-Sleep -Milliseconds 120;"
        + "$ws.SendKeys('{ENTER}');"
        + "$done=$true"
        + "};"
        + "if($done){exit 0}else{exit 1}";
    try {
      Process process = new ProcessBuilder(windowsPowerShell(), "-NoProfile", "-NonInteractive", "-Command", script).start();
      if (!process.waitFor(2L, java.util.concurrent.TimeUnit.SECONDS)) {
        return true;
      }
      return process.exitValue() == 0;
    } catch (Throwable ignored) {
      return false;
    }
  }

  private static void showInExplorer(Entry entry) {
    try {
      if (entry == null || entry.path == null) {
        return;
      }
      Path path = entry.path.toAbsolutePath().normalize();
      if (isWindows()) {
        new ProcessBuilder("explorer.exe", "/select," + path).start();
      } else if (java.awt.Desktop.isDesktopSupported()) {
        java.awt.Desktop.getDesktop().open(path.toFile());
      }
    } catch (Throwable ignored) {
      // Native integration is best-effort.
    }
  }

  private static Path picturesDir() {
    try {
