  'dev/xlauncher/client/NameTagSettings.java': String.raw`
package dev.xlauncher.client;

import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import net.minecraft.client.Minecraft;

public final class NameTagSettings {
  public static final int[] COLORS = {
      0xFFFFFF, 0x55FFFF, 0x55FF55, 0xFFFF55,
      0xFFAA00, 0xFF5555, 0xFF55FF, 0xAA55FF
  };
  private static int color = 0xFFFFFF;
  private static boolean loaded;

  private NameTagSettings() {
  }

  public static synchronized int color() {
    load();
    return XClientColorModes.resolve("nametag", color) & 0xFFFFFF;
  }

  public static synchronized void setColor(int rgb) {
    color = rgb & 0xFFFFFF;
    loaded = true;
    try {
      Path file = file();
      Files.createDirectories(file.getParent());
      Files.writeString(file, String.format(java.util.Locale.ROOT, "%06X", color), StandardCharsets.UTF_8);
    } catch (Throwable ignored) {
      // The selected color remains active for this session if persistence fails.
    }
  }

  private static void load() {
    if (loaded) return;
    loaded = true;
    try {
      String value = Files.readString(file(), StandardCharsets.UTF_8).trim();
      if (value.matches("[0-9a-fA-F]{6}")) color = Integer.parseInt(value, 16);
    } catch (Throwable ignored) {
      color = 0xFFFFFF;
    }
  }

  private static Path file() {
    return Minecraft.getInstance().gameDirectory.toPath().resolve("config").resolve("x-client-name-color.txt");
  }
}
