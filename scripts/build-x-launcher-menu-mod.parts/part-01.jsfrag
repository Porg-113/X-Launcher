  }

  private static boolean isWindows() {
    return System.getProperty("os.name", "").toLowerCase(Locale.ROOT).contains("win");
  }

  private static String windowsPowerShell() {
    String root = System.getenv("SystemRoot");
    if (root != null && !root.isBlank()) {
      Path bundled = Path.of(root, "System32", "WindowsPowerShell", "v1.0", "powershell.exe");
      if (Files.isRegularFile(bundled)) {
        return bundled.toString();
      }
    }
    return "powershell.exe";
  }

  private static String psSingleQuoted(String value) {
    return "'" + String.valueOf(value).replace("'", "''") + "'";
  }

  private static String defaultFileName(Entry entry) {
    String name = entry.name == null || entry.name.isBlank() ? "screenshot.png" : entry.name;
    return ensurePngFileName(name);
  }

  private static String ensurePngFileName(String value) {
    String safe = String.valueOf(value == null ? "screenshot" : value).trim();
    if (safe.isEmpty()) {
      safe = "screenshot";
    }
    return safe.toLowerCase(Locale.ROOT).endsWith(".png") ? safe : safe + ".png";
  }

  private static Path screenshotsDir(Object client) {
    Path gameDir = gameDir(client);
    if (gameDir != null) {
      return gameDir.resolve("screenshots");
    }
    String appData = System.getenv("APPDATA");
    if (appData == null || appData.isBlank()) {
      appData = Path.of(System.getProperty("user.home"), "AppData", "Roaming").toString();
    }
