package dev.xlauncher.client;

import java.io.IOException;
import java.lang.reflect.Method;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.LocalDate;
import java.util.concurrent.Executor;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

final class GameTimer {
  private static final Pattern MINUTES_PATTERN = Pattern.compile("\"minutes\"\\s*:\\s*(\\d+)");
  private static final Pattern AUTO_PATTERN = Pattern.compile("\"autoStartDaily\"\\s*:\\s*(true|false)");
  private static final Pattern LAST_AUTO_DATE_PATTERN = Pattern.compile("\"lastAutoDate\"\\s*:\\s*\"([^\"]*)\"");
  private static final int DEFAULT_MINUTES = 30;
  private static final int MIN_MINUTES = 1;
  private static final int MAX_MINUTES = 1440;
  private static final long NOTICE_MS = 3500L;
  private static final Object UNSUPPORTED_ARG = new Object();
  private static boolean loaded;
  private static int minutes = DEFAULT_MINUTES;
  private static boolean autoStartDaily;
  private static String lastAutoDate = "";
  private static boolean running;
  private static boolean finished;
  private static boolean startedFromAuto;
  private static boolean halfwayNotified;
  private static boolean tenPercentNotified;
  private static boolean leaveQueued;
  private static boolean moduleWasEnabled;
  private static boolean pausedByScreen;
  private static long totalMs;
  private static long remainingMs;
  private static long lastTickMs;
  private static long noticeUntilMs;
  private static String noticeText = "";

  private GameTimer() {
  }

  static synchronized void tick(Object client) {
    load();
    boolean enabled = moduleEnabled();
    long now = System.currentTimeMillis();
    if (!enabled) {
      resetRun();
      moduleWasEnabled = false;
      pausedByScreen = false;
      return;
    }
    if (!moduleWasEnabled) {
      resetRun();
      finished = false;
      moduleWasEnabled = true;
    }

    boolean inWorld = hasWorld(client);
    boolean screenOpen = hasOpenScreen(client);
    pausedByScreen = inWorld && screenOpen;
    if (!inWorld) {
      lastTickMs = now;
      return;
    }
    if (!running && !finished) {
      if (autoStartDaily) {
        if (!today().equals(lastAutoDate)) {
          start(now, true);
        }
      } else {
        start(now, false);
      }
    }
    if (!running) {
      lastTickMs = now;
      return;
    }
    if (screenOpen) {
      lastTickMs = now;
      return;
    }
    if (lastTickMs <= 0L) {
      lastTickMs = now;
      return;
    }

    long elapsed = Math.max(0L, now - lastTickMs);
    lastTickMs = now;
    if (elapsed <= 0L) {
      return;
    }
    remainingMs = Math.max(0L, remainingMs - elapsed);
    if (!halfwayNotified && remainingMs <= totalMs / 2L) {
      halfwayNotified = true;
      showNotice("Timer: Hälfte erreicht");
    }
    if (!tenPercentNotified && remainingMs <= Math.max(1L, totalMs / 10L)) {
      tenPercentNotified = true;
      showNotice("Timer: noch 10 Prozent");
    }
    if (remainingMs <= 0L) {
      finish(client);
    }
  }

  static synchronized int minutes() {
    load();
    return minutes;
  }

  static synchronized void adjustMinutes(int delta) {
    setMinutes(minutes() + delta);
  }

  static synchronized void setMinutes(int value) {
    load();
    int next = clamp(value, MIN_MINUTES, MAX_MINUTES);
    if (next == minutes) {
      return;
    }
    minutes = next;
    lastAutoDate = "";
    resetRun();
    finished = false;
    save();
    showNotice("Timer: " + minutes + " min");
  }

  static synchronized boolean autoStartDaily() {
    load();
    return autoStartDaily;
  }

  static synchronized void setAutoStartDaily(boolean enabled) {
    load();
    if (autoStartDaily == enabled) {
      return;
    }
    autoStartDaily = enabled;
    lastAutoDate = "";
    resetRun();
    finished = false;
    save();
    showNotice(enabled ? "Timer: Auto täglich an" : "Timer: Auto aus");
  }

  static synchronized String remainingText() {
    load();
    return remainingLabel();
  }

  static synchronized String statusText() {
    load();
    if (!moduleEnabled()) {
      return "Aus";
    }
    if (running && pausedByScreen) {
      return "Pausiert im Menü";
    }
    if (running) {
      return "Läuft";
    }
    if (finished) {
      return autoStartDaily && today().equals(lastAutoDate) ? "Heute fertig" : "Fertig";
    }
    return autoStartDaily ? "Wartet auf Tagesstart" : "Wartet auf Welt";
  }

  static synchronized float progress() {
    load();
    if (totalMs <= 0L) {
      return 0.0F;
    }
    return Math.max(0.0F, Math.min(1.0F, 1.0F - (remainingMs / (float) totalMs)));
  }

  static synchronized String noticeText() {
    if (noticeUntilMs <= System.currentTimeMillis()) {
      return "";
    }
    return noticeText + " - Rest " + remainingLabel();
  }

  static synchronized String pauseOverlayText() {
    load();
    if (!moduleEnabled() || !pausedByScreen || (!running && !finished && totalMs <= 0L)) {
      return "";
    }
    return "Timer Rest " + remainingLabel();
  }

  private static void start(long now, boolean autoStarted) {
    totalMs = Math.max(60000L, minutes * 60000L);
    remainingMs = totalMs;
    lastTickMs = now;
    running = true;
    finished = false;
    startedFromAuto = autoStarted;
    halfwayNotified = false;
    tenPercentNotified = false;
    leaveQueued = false;
    showNotice("Timer gestartet: " + minutes + " min");
  }

  private static void finish(Object client) {
    running = false;
    finished = true;
    remainingMs = 0L;
    lastTickMs = System.currentTimeMillis();
    if (startedFromAuto) {
      lastAutoDate = today();
      save();
    }
    showNotice("Timer abgelaufen");
    if (leaveQueued) {
      return;
    }
    leaveQueued = true;
    Runnable task = () -> leaveWorld(client);
    if (client instanceof Executor executor) {
      executor.execute(task);
    } else {
      task.run();
    }
  }

  private static void resetRun() {
    running = false;
    finished = false;
    startedFromAuto = false;
    halfwayNotified = false;
    tenPercentNotified = false;
    leaveQueued = false;
    pausedByScreen = false;
    totalMs = 0L;
    remainingMs = 0L;
    lastTickMs = 0L;
  }

  private static boolean moduleEnabled() {
    return MenuModules.enabled("timer");
  }

  private static boolean hasWorld(Object client) {
    return getAnyField(client, "player", "field_1724") != null || getAnyField(client, "level", "world", "field_1687") != null;
  }

  private static boolean hasOpenScreen(Object client) {
    return getAnyField(client, "screen", "field_1755") != null;
  }

  private static void showNotice(String text) {
    noticeText = text;
    noticeUntilMs = System.currentTimeMillis() + NOTICE_MS;
  }

  private static String remainingLabel() {
    if (running || finished || totalMs > 0L) {
      return formatTime(remainingMs);
    }
    return minutes + " min";
  }

  private static String formatTime(long millis) {
    long seconds = Math.max(0L, (millis + 999L) / 1000L);
    long minutesPart = seconds / 60L;
    long secondsPart = seconds % 60L;
    return minutesPart + ":" + (secondsPart < 10L ? "0" : "") + secondsPart;
  }

  private static void leaveWorld(Object client) {
    if (client == null) {
      return;
    }
    boolean disconnected = invokeDisconnect(client);
    if (!disconnected) {
      Object connection = getAnyField(client, "connection", "field_1705");
      Object player = getAnyField(client, "player", "field_1724");
      if (connection == null && player != null) {
        connection = getAnyField(player, "connection", "networkHandler", "field_3944");
      }
      disconnected = invokeDisconnect(connection);
    }
    Object titleScreen = titleScreen();
    if (titleScreen != null || disconnected) {
      setScreen(client, titleScreen);
    }
  }

  private static boolean invokeDisconnect(Object target) {
    if (target == null) {
      return false;
    }
    for (Method method : allMethods(target.getClass())) {
      if (!isDisconnectMethod(method.getName())) {
        continue;
      }
      Object[] args = argsFor(method.getParameterTypes());
      if (args == null) {
        continue;
      }
      try {
        method.setAccessible(true);
        method.invoke(target, args);
        return true;
      } catch (Throwable ignored) {
        // Try another runtime mapping/signature.
      }
    }
    return false;
  }

  private static boolean isDisconnectMethod(String name) {
    return "disconnect".equals(name) || "clearLevel".equals(name) || "method_18096".equals(name)
        || "method_2951".equals(name) || "method_48296".equals(name) || "method_52787".equals(name);
  }

  private static Object[] argsFor(Class<?>[] parameterTypes) {
    Object[] args = new Object[parameterTypes.length];
    for (int index = 0; index < parameterTypes.length; index += 1) {
      Object value = argumentFor(parameterTypes[index]);
      if (value == UNSUPPORTED_ARG) {
        return null;
      }
      args[index] = value;
    }
    return args;
  }

  private static Object argumentFor(Class<?> type) {
    if (type == Boolean.TYPE || type == Boolean.class) {
      return Boolean.FALSE;
    }
    if (type == String.class) {
      return "X Client Timer";
    }
    if (isComponentType(type)) {
      Object component = literalComponent("Timer abgelaufen");
      return component == null ? UNSUPPORTED_ARG : component;
    }
    if (isScreenType(type)) {
      return titleScreen();
    }
    if (!type.isPrimitive()) {
      return null;
    }
    return UNSUPPORTED_ARG;
  }

  private static void setScreen(Object client, Object screen) {
    for (Method method : allMethods(client.getClass())) {
      if (!("setScreen".equals(method.getName()) || "method_1507".equals(method.getName())) || method.getParameterCount() != 1) {
        continue;
      }
      Class<?> type = method.getParameterTypes()[0];
      if (screen != null && !type.isInstance(screen)) {
        continue;
      }
      try {
        method.setAccessible(true);
        method.invoke(client, screen);
        return;
      } catch (Throwable ignored) {
        // Try another screen setter.
      }
    }
  }

  private static Object titleScreen() {
    for (String className : new String[] { "net.minecraft.client.gui.screens.TitleScreen", "net.minecraft.class_442" }) {
      try {
        java.lang.reflect.Constructor<?> constructor = Class.forName(className).getDeclaredConstructor();
        constructor.setAccessible(true);
        return constructor.newInstance();
      } catch (Throwable ignored) {
        // Try the next known title screen class.
      }
    }
    return null;
  }

  private static Object literalComponent(String text) {
    for (String className : new String[] { "net.minecraft.network.chat.Component", "net.minecraft.class_2561" }) {
      try {
        Class<?> componentClass = Class.forName(className);
        for (String methodName : new String[] { "literal", "method_30163", "a", "b", "c" }) {
          try {
            Object value = componentClass.getMethod(methodName, String.class).invoke(null, text);
            if (componentClass.isInstance(value)) {
              return value;
            }
          } catch (Throwable ignored) {
            // Try the next text factory.
          }
        }
      } catch (Throwable ignored) {
        // Try the next component class.
      }
    }
    return null;
  }

  private static boolean isScreenType(Class<?> type) {
    String name = type.getName();
    return name.endsWith(".Screen") || name.endsWith(".class_437") || name.contains("gui.screens") || "net.minecraft.class_437".equals(name);
  }

  private static boolean isComponentType(Class<?> type) {
    String name = type.getName();
    return name.endsWith(".Component") || "net.minecraft.class_2561".equals(name);
  }

  private static Method[] allMethods(Class<?> type) {
    Method[] publicMethods = type.getMethods();
    Method[] declaredMethods = type.getDeclaredMethods();
    Method[] methods = new Method[publicMethods.length + declaredMethods.length];
    System.arraycopy(publicMethods, 0, methods, 0, publicMethods.length);
    System.arraycopy(declaredMethods, 0, methods, publicMethods.length, declaredMethods.length);
    return methods;
  }

  private static Object getAnyField(Object target, String... names) {
    if (target == null) {
      return null;
    }
    for (String name : names) {
      try {
        return target.getClass().getField(name).get(target);
      } catch (Throwable ignored) {
        try {
          java.lang.reflect.Field field = target.getClass().getDeclaredField(name);
          field.setAccessible(true);
          return field.get(target);
        } catch (Throwable alsoIgnored) {
          // Try the next known field name.
        }
      }
    }
    return null;
  }

  private static void load() {
    if (loaded) {
      return;
    }
    loaded = true;
    Path path = statePath();
    if (!Files.exists(path)) {
      return;
    }
    try {
      String json = Files.readString(path, StandardCharsets.UTF_8);
      Matcher minutesMatcher = MINUTES_PATTERN.matcher(json);
      if (minutesMatcher.find()) {
        minutes = clamp(Integer.parseInt(minutesMatcher.group(1)), MIN_MINUTES, MAX_MINUTES);
      }
      Matcher autoMatcher = AUTO_PATTERN.matcher(json);
      if (autoMatcher.find()) {
        autoStartDaily = Boolean.parseBoolean(autoMatcher.group(1));
      }
      Matcher dateMatcher = LAST_AUTO_DATE_PATTERN.matcher(json);
      if (dateMatcher.find()) {
        lastAutoDate = dateMatcher.group(1);
      }
    } catch (IOException | RuntimeException ignored) {
      minutes = DEFAULT_MINUTES;
      autoStartDaily = false;
      lastAutoDate = "";
    }
  }

  private static void save() {
    Path path = statePath();
    try {
      Files.createDirectories(path.getParent());
      Files.writeString(path, "{\n  \"minutes\": " + minutes + ",\n  \"autoStartDaily\": " + autoStartDaily
          + ",\n  \"lastAutoDate\": \"" + escape(lastAutoDate) + "\"\n}\n", StandardCharsets.UTF_8);
    } catch (IOException ignored) {
      // Timer persistence is optional.
    }
  }

  private static Path statePath() {
    String appData = System.getenv("APPDATA");
    if (appData == null || appData.isBlank()) {
      appData = Path.of(System.getProperty("user.home"), "AppData", "Roaming").toString();
    }
    return Path.of(appData, ".minecraft-launcher", "x-client-timer.json");
  }

  private static String today() {
    return LocalDate.now().toString();
  }

  private static int clamp(int value, int min, int max) {
    return Math.max(min, Math.min(max, value));
  }

  private static String escape(String value) {
    return String.valueOf(value == null ? "" : value).replace("\\", "\\\\").replace("\"", "\\\"");
  }
