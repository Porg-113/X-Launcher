package dev.xlauncher.client;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

final class GlowSettings {
  static final int MODE_SELECTED = 0;
  static final int MODE_MOBS = 1;
  static final int MODE_PLAYERS = 2;
  static final int MODE_ALL = 3;
  private static final Pattern MODE_PATTERN = Pattern.compile("\"mode\"\\s*:\\s*(-?\\d+)");
  private static boolean loaded;
  private static int mode = MODE_SELECTED;

  private GlowSettings() {
  }

  static int mode() {
    load();
    return mode;
  }

  static String modeLabel() {
    return switch (mode()) {
      case MODE_MOBS -> "Mobs";
      case MODE_PLAYERS -> "Players";
      case MODE_ALL -> "All";
      default -> "Selected";
    };
  }

  static void nextMode() {
    load();
    mode = (mode + 1) % 4;
    save();
  }
